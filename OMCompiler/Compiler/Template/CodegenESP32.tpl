// This file defines templates for transforming Modelica models into an
// ESP-IDF project that can be built and flashed onto an ESP32 board
// (developed for and tested on the ESP32-C6).
//
// The generated project is self contained: it has no dependency on the
// OpenModelica simulation runtime and no dependency on the FMI headers. The
// equations, functions and expressions are the same ones the experimental
// embedded C target generates, which is why most of the low level templates
// are imported from CodegenEmbeddedC instead of being duplicated here.
//
// Four templates are called by the code generator, one per generated file:
//
//   projectCMakeFile   <prefix>_esp32/CMakeLists.txt
//   componentCMakeFile <prefix>_esp32/main/CMakeLists.txt
//   sdkconfigFile      <prefix>_esp32/sdkconfig.defaults
//   modelHeaderFile    <prefix>_esp32/main/<prefix>_model.h
//   modelSourceFile    <prefix>_esp32/main/<prefix>_model.c
//   appMainFile        <prefix>_esp32/main/main.c
//   readmeFile         <prefix>_esp32/README.md

package CodegenESP32

import interface SimCodeTV;
import interface SimCodeBackendTV;

import CodegenUtil.*;
import CodegenUtilSimulation.*;
import CodegenEmbeddedC.*;

template projectCMakeFile(SimCode simCode)
 "Top level CMakeLists.txt of the generated ESP-IDF project."
::=
let modelNamePrefixStr = modelNamePrefix(simCode)
match simCode
case simCode as SIMCODE(modelInfo=MODELINFO(__)) then
<<
# Generated by OpenModelica from <%dotPath(modelInfo.name)%>
cmake_minimum_required(VERSION 3.16)

include($ENV{IDF_PATH}/tools/cmake/project.cmake)
project(<%modelNamePrefixStr%>_esp32 C)
>>
end projectCMakeFile;

template componentCMakeFile(SimCode simCode)
 "CMakeLists.txt of the main component of the generated ESP-IDF project."
::=
let modelNamePrefixStr = modelNamePrefix(simCode)
<<
# Generated by OpenModelica
idf_component_register(SRCS "main.c" "<%modelNamePrefixStr%>_model.c"
                       INCLUDE_DIRS ".")
>>
end componentCMakeFile;

template sdkconfigFile(SimCode simCode)
 "sdkconfig.defaults of the generated ESP-IDF project."
::=
<<
# Generated by OpenModelica
# The chip the model is built for. Override with `idf.py set-target <chip>`.
CONFIG_IDF_TARGET="esp32c6"
# Print the results on UART0, which is the port the USB-serial bridge of the
# devkit is wired to, and therefore the same port the board is flashed over.
# Replace this with CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y to print them on the
# built in USB-Serial-JTAG port instead, which enumerates as a port of its own.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# The reduced formatting of newlib-nano does not print doubles, and the whole
# output of the simulation is doubles.
CONFIG_NEWLIB_NANO_FORMAT=n
# The model is solved in floating point, so keep the FPU related optimizations
# and compile for speed rather than for size.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
>>
end sdkconfigFile;

template modelHeaderFile(SimCode simCode)
 "Public interface of the generated model, used by main.c."
::=
let modelNamePrefixStr = modelNamePrefix(simCode)
match simCode
case simCode as SIMCODE(simulationSettingsOpt=NONE()) then
  error(sourceInfo(), "Missing simulation settings")
case simCode as SIMCODE(modelInfo=MODELINFO(varInfo=varInfo as VARINFO(__)),
                        simulationSettingsOpt=SOME(settings as SIMULATION_SETTINGS(__))) then
<<
/* Generated by OpenModelica from <%dotPath(modelInfo.name)%> */
#ifndef OM_<%modelNamePrefixStr%>_MODEL_H
#define OM_<%modelNamePrefixStr%>_MODEL_H

#define OM_MODEL_NAME "<%dotPath(modelInfo.name)%>"
#define OM_START_TIME (<%settings.startTime%>)
#define OM_STOP_TIME  (<%settings.stopTime%>)
#define OM_STEP_SIZE  (<%settings.stepSize%>)
#define OM_NUM_REAL   (<%nVariablesReal(varInfo)%>)

/* The same scalar types the embedded C target uses, so that the equations and
   the functions below are generated by the very same templates. They are
   spelled out here instead of being included from fmi2TypesPlatform.h to keep
   the generated project free of any OpenModelica include path. */
typedef double fmi2Real;
typedef int fmi2Integer;
typedef int fmi2Boolean;
typedef char fmi2Char;
typedef const fmi2Char* fmi2String;

#define fmi2True 1
#define fmi2False 0

typedef enum {
  fmi2OK = 0,
  fmi2Warning,
  fmi2Discard,
  fmi2Error,
  fmi2Fatal,
  fmi2Pending
} fmi2Status;

typedef struct <%symbolName(modelNamePrefixStr,"fmi2Component_s")%>* fmi2Component;

/* Names of the real variables, in the order <%symbolName(modelNamePrefixStr,"getReal")%>
   indexes them: the states first, then the state derivatives, then the
   algebraic and the discrete real variables. */
extern const char * const <%symbolName(modelNamePrefixStr,"realNames")%>[OM_NUM_REAL];

/* The single statically allocated instance of the model. There is no heap
   allocation anywhere in the generated code. */
fmi2Component <%symbolName(modelNamePrefixStr,"instantiate")%>(void);
/* Sets the time and evaluates the equations once, so that the variables are
   consistent before the first step is taken. */
fmi2Status <%symbolName(modelNamePrefixStr,"initialize")%>(fmi2Component comp, fmi2Real startTime);
/* One explicit Euler step of size stepSize, taken from currentTime. */
fmi2Status <%symbolName(modelNamePrefixStr,"step")%>(fmi2Component comp, fmi2Real currentTime, fmi2Real stepSize);
fmi2Real <%symbolName(modelNamePrefixStr,"getTime")%>(fmi2Component comp);
fmi2Real <%symbolName(modelNamePrefixStr,"getReal")%>(fmi2Component comp, int index);

#endif /* OM_<%modelNamePrefixStr%>_MODEL_H */
>>
end modelHeaderFile;

template modelSourceFile(SimCode simCode)
 "The model itself: state, equations and the fixed step solver."
::=
let modelNamePrefixStr = modelNamePrefix(simCode)
match simCode
case simCode as SIMCODE(simulationSettingsOpt=NONE()) then
  error(sourceInfo(), "Missing simulation settings")
case simCode as SIMCODE(modelInfo=MODELINFO(functions=functions, varInfo=varInfo as VARINFO(__), vars=vars as SIMVARS(__)),
                        extObjInfo=extObjInfo as EXTOBJINFO(vars=extObjVars),
                        simulationSettingsOpt=SOME(settings as SIMULATION_SETTINGS(__))) then
<<
/* Generated by OpenModelica from <%dotPath(modelInfo.name)%> */
#include "<%modelNamePrefixStr%>_model.h"

#include <math.h>
#include <stdarg.h>
#include <stdio.h>

void ModelicaFormatMessage(const char *fmt, ...)
{
  va_list args;
  va_start(args, fmt);
  vprintf(fmt, args);
  va_end(args);
}

struct <%symbolName(modelNamePrefixStr,"fmi2Component_s")%> {
  fmi2Real currentTime;
  <% match nVariablesReal(varInfo)
    case 0 then ""
    case n then 'fmi2Real fmi2RealVars[<%n%>];<%\n%>'
  %><% match varInfo.numIntAlgVars
    case 0 then ""
    case n then 'fmi2Integer fmi2IntegerVars[<%n%>];<%\n%>'
  %><% match varInfo.numBoolAlgVars
    case 0 then ""
    case n then 'fmi2Boolean fmi2BooleanVars[<%n%>];<%\n%>'
  %><% match varInfo.numStringAlgVars
    case 0 then ""
    else error(sourceInfo(), "String variables not supported yet")
  %><% match varInfo.numParams
    case 0 then ""
    case n then 'fmi2Real fmi2RealParameter[<%n%>];<%\n%>'
  %><% match varInfo.numIntParams
    case 0 then ""
    case n then 'fmi2Integer fmi2IntegerParameter[<%n%>];<%\n%>'
  %><% match varInfo.numBoolParams
    case 0 then ""
    case n then 'fmi2Boolean fmi2BooleanParameter[<%n%>];<%\n%>'
  %><% match listLength(extObjVars)
    case 0 then ""
    case n then 'void* extObjs[<%n%>];<%\n%>'
  %>
};

static struct <%symbolName(modelNamePrefixStr,"fmi2Component_s")%> <%symbolName(modelNamePrefixStr,"component")%> = {
  .currentTime = <%settings.startTime%>,
  <% match nVariablesReal(varInfo)
    case 0 then ""
    else
    <<
    .fmi2RealVars = {
      <%vars.stateVars |> var => startValue(var) %>
      <%vars.derivativeVars |> var => startValue(var) %>
      <%vars.algVars |> var => startValue(var) %>
      <%vars.discreteAlgVars |> var => startValue(var) %>
      <%vars.realOptimizeConstraintsVars |> var => startValue(var) %>
      <%vars.realOptimizeFinalConstraintsVars |> var => startValue(var) %>
    },<%\n%>
    >>
  %><% match varInfo.numIntAlgVars
    case 0 then ""
    else
    <<
    .fmi2IntegerVars = {
      <%vars.intAlgVars |> var => startValue(var) %>
    },<%\n%>
    >>
  %><% match varInfo.numBoolAlgVars
    case 0 then ""
    else
    <<
    .fmi2BooleanVars = {
      <%vars.boolAlgVars |> var => startValue(var) %>
    },<%\n%>
    >>
  %><% match varInfo.numParams
    case 0 then ""
    else
    <<
    .fmi2RealParameter = {
      <%vars.paramVars |> var => startValue(var) %>
    },<%\n%>
    >>
  %><% match varInfo.numIntParams
    case 0 then ""
    else
    <<
    .fmi2IntegerParameter = {
      <%vars.intParamVars |> var => startValue(var) %>
    },<%\n%>
    >>
  %><% match varInfo.numBoolParams
    case 0 then ""
    else
    <<
    .fmi2BooleanParameter = {
      <%vars.boolParamVars |> var => startValue(var) %>
    },<%\n%>
    >>
  %>
};

const char * const <%symbolName(modelNamePrefixStr,"realNames")%>[OM_NUM_REAL] = {
  <%vars.stateVars |> var => realVarName(var) %>
  <%vars.derivativeVars |> var => realVarName(var) %>
  <%vars.algVars |> var => realVarName(var) %>
  <%vars.discreteAlgVars |> var => realVarName(var) %>
  <%vars.realOptimizeConstraintsVars |> var => realVarName(var) %>
  <%vars.realOptimizeFinalConstraintsVars |> var => realVarName(var) %>
};

/* TODO: Generate used builtin functions before SimCode */
static inline double om_mod(double x, double y)
{
  return x-floor(x/y)*y;
}

<%functionsFile(functions, literals, externalFunctionIncludes)%>

/* Evaluates every equation of the model for the current time and the current
   state, which leaves both the state derivatives and the algebraic variables
   up to date. */
static fmi2Status <%symbolName(modelNamePrefixStr,"functionEquations")%>(fmi2Component comp)
{
  <% match allEquations
  case {} then ""
  case {eqs} then (eqs |> eq => equation_(eq); separator="\n")
  else (allEquations |> eqs => (eqs |> eq => equation_(eq); separator="\n"); separator="\n")
  %>
  return fmi2OK;
}

fmi2Component <%symbolName(modelNamePrefixStr,"instantiate")%>(void)
{
  return &<%symbolName(modelNamePrefixStr,"component")%>;
}

fmi2Status <%symbolName(modelNamePrefixStr,"initialize")%>(fmi2Component comp, fmi2Real startTime)
{
  comp->currentTime = startTime;
  <%callExternalObjectConstructors(extObjInfo)%>
  return <%symbolName(modelNamePrefixStr,"functionEquations")%>(comp);
}

fmi2Status <%symbolName(modelNamePrefixStr,"step")%>(fmi2Component comp, fmi2Real currentTime, fmi2Real stepSize)
{
  fmi2Status status;
  comp->currentTime = currentTime;
  /* The derivatives are evaluated before the states are advanced, which makes
     the step below a plain explicit Euler step. */
  status = <%symbolName(modelNamePrefixStr,"functionEquations")%>(comp);
  if (status != fmi2OK) {
    return status;
  }
  <%match varInfo.numStateVars
  case 0 then ""
  else
  <<
  {
    int i;
    for (i=0; i<<%varInfo.numStateVars%>; i++) {
      comp->fmi2RealVars[i] += comp->fmi2RealVars[i+<%varInfo.numStateVars%>]*stepSize;
    }
  }
  >>
  %>
  comp->currentTime = currentTime + stepSize;
  /* Report the algebraic variables at the time the states were advanced to. */
  return <%symbolName(modelNamePrefixStr,"functionEquations")%>(comp);
}

fmi2Real <%symbolName(modelNamePrefixStr,"getTime")%>(fmi2Component comp)
{
  return comp->currentTime;
}

fmi2Real <%symbolName(modelNamePrefixStr,"getReal")%>(fmi2Component comp, int index)
{
  <% match nVariablesReal(varInfo)
  case 0 then
  <<
  (void)comp;
  (void)index;
  return 0.0;
  >>
  else
  <<
  if (index < 0 || index >= OM_NUM_REAL) {
    return 0.0;
  }
  return comp->fmi2RealVars[index];
  >>
  %>
}
>>
end modelSourceFile;

template realVarName(SimVar var)
 "One entry of the name table of the real variables."
::=
  match var
  case SIMVAR(__) then '"<%Util.escapeModelicaStringToCString(crefStr(name))%>",<%\n%>'
end realVarName;

template appMainFile(SimCode simCode)
 "The ESP-IDF application: runs the model in a task and prints the results."
::=
let modelNamePrefixStr = modelNamePrefix(simCode)
match simCode
case simCode as SIMCODE(modelInfo=MODELINFO(__)) then
<<
/* Generated by OpenModelica from <%dotPath(modelInfo.name)%> */
#include <stdio.h>
#include <stdint.h>
#include <unistd.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_timer.h"

#include "<%modelNamePrefixStr%>_model.h"

/* Print one line every OM_PRINT_EVERY steps. Printing every step of a model
   solved with a small step size floods the console and slows the solver down
   more than the solver itself costs. */
#ifndef OM_PRINT_EVERY
#define OM_PRINT_EVERY 1
#endif

/* Run the simulation in real time, that is, spend OM_STEP_SIZE seconds of
   wall clock time on every step. Set it to 0 to solve as fast as the chip
   can, which is what you want when the results are only printed. */
#ifndef OM_REALTIME
#define OM_REALTIME 0
#endif

/* Solve forever instead of stopping at OM_STOP_TIME. */
#ifndef OM_RUN_FOREVER
#define OM_RUN_FOREVER 0
#endif

/* The stack of the task the model is solved in. Every variable of the model
   is statically allocated, so this only has to hold the function calls. */
#ifndef OM_TASK_STACK_SIZE
#define OM_TASK_STACK_SIZE 8192
#endif

/* Hand the CPU back at least this often, in microseconds, so that the idle
   task gets to run and feed the task watchdog. How many steps that is depends
   on the model and on how fast the results are printed, which is why it is a
   time and not a number of steps. */
#ifndef OM_YIELD_INTERVAL_US
#define OM_YIELD_INTERVAL_US 200000
#endif

static void om_print_header(void)
{
  int i;
  printf("time");
  for (i=0; i<OM_NUM_REAL; i++) {
    printf(",%s", <%symbolName(modelNamePrefixStr,"realNames")%>[i]);
  }
  printf("\n");
}

static void om_print_values(fmi2Component comp)
{
  int i;
  printf("%g", (double)<%symbolName(modelNamePrefixStr,"getTime")%>(comp));
  for (i=0; i<OM_NUM_REAL; i++) {
    printf(",%g", (double)<%symbolName(modelNamePrefixStr,"getReal")%>(comp, i));
  }
  printf("\n");
}

static void om_simulation_task(void *arg)
{
  fmi2Component comp;
  fmi2Status status = fmi2OK;
  double time = OM_START_TIME;
  const double h = OM_STEP_SIZE;
  uint32_t step = 0;
  int64_t wallClockStart;
  int64_t lastYield;

  (void)arg;

  comp = <%symbolName(modelNamePrefixStr,"instantiate")%>();
  if (comp == NULL) {
    printf("Failed to instantiate " OM_MODEL_NAME "\n");
    vTaskDelete(NULL);
    return;
  }

  printf("# OpenModelica " OM_MODEL_NAME " on %s\n", CONFIG_IDF_TARGET);
  <%symbolName(modelNamePrefixStr,"initialize")%>(comp, OM_START_TIME);
  om_print_header();
  om_print_values(comp);

  wallClockStart = esp_timer_get_time();
  lastYield = wallClockStart;

  while (OM_RUN_FOREVER || time < OM_STOP_TIME) {
    status = <%symbolName(modelNamePrefixStr,"step")%>(comp, time, h);
    if (status != fmi2OK) {
      printf("# step failed at time %g\n", time);
      break;
    }
    step++;
    time = OM_START_TIME + h*(double)step;

    if ((step % OM_PRINT_EVERY) == 0) {
      om_print_values(comp);
    }

    if (OM_REALTIME) {
      /* Sleep until the wall clock has caught up with the simulated time. */
      int64_t due = wallClockStart + (int64_t)((time - OM_START_TIME)*1e6);
      int64_t now = esp_timer_get_time();
      if (due > now) {
        usleep((useconds_t)(due - now));
        lastYield = esp_timer_get_time();
      }
    }
    /* A step shorter than a tick does not sleep above, and solving as fast as
       possible never does, so give the idle task a tick of its own whenever it
       has been waiting for too long. */
    if (esp_timer_get_time() - lastYield >= OM_YIELD_INTERVAL_US) {
      vTaskDelay(1);
      lastYield = esp_timer_get_time();
    }
  }

  printf("# done at time %g after %u steps\n", time, (unsigned)step);
  vTaskDelete(NULL);
}

void app_main(void)
{
  xTaskCreate(om_simulation_task, "om_sim", OM_TASK_STACK_SIZE, NULL, 5, NULL);
}
>>
end appMainFile;

template readmeFile(SimCode simCode)
 "How to build the generated project and flash it onto the board."
::=
let modelNamePrefixStr = modelNamePrefix(simCode)
match simCode
case simCode as SIMCODE(modelInfo=MODELINFO(__)) then
<<
# <%dotPath(modelInfo.name)%> on an ESP32

This is an [ESP-IDF](https://docs.espressif.com/projects/esp-idf) project
generated by OpenModelica with `--simCodeTarget=ESP32`. It solves the model
with a fixed step explicit Euler solver and prints the results as CSV on the
console of the board. It needs neither the OpenModelica simulation runtime nor
the FMI headers, only ESP-IDF itself.

## Build and flash

The default chip is the ESP32-C6, with the results printed on UART0, which is
the port the USB-serial bridge of the devkit is wired to. It is the same port
the board is flashed over: a `COMx` on Windows, a `/dev/ttyUSBx` on Linux.
Boards with a built in USB-Serial-JTAG port enumerate a second port; set
`CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y` in `sdkconfig.defaults` to print the
results there instead.

```
. $IDF_PATH/export.sh
idf.py set-target esp32c6
idf.py build
idf.py -p COM6 flash monitor
```

Use `idf.py set-target esp32` (or `esp32s3`, `esp32c3`, ...) for another chip.

## What is generated

| File | Contents |
| ---- | -------- |
| `main/<%modelNamePrefixStr%>_model.h` | Model interface: the number of variables, the simulation settings and the functions below |
| `main/<%modelNamePrefixStr%>_model.c` | The statically allocated model state, the equations, the model functions and the solver step |
| `main/main.c` | `app_main`, which solves the model in a FreeRTOS task and prints the results |

## Tuning the application

`main/main.c` starts with a handful of defines that you can change, or
override from `main/CMakeLists.txt` with `target_compile_definitions`:

| Define | Default | Meaning |
| ------ | ------- | ------- |
| `OM_PRINT_EVERY` | 1 | Print one line of results every N steps |
| `OM_REALTIME` | 0 | Spend `OM_STEP_SIZE` seconds of wall clock time on every step |
| `OM_RUN_FOREVER` | 0 | Keep solving instead of stopping at `OM_STOP_TIME` |
| `OM_TASK_STACK_SIZE` | 8192 | Stack of the task the model is solved in |
| `OM_YIELD_INTERVAL_US` | 200000 | Hand the CPU back at least this often, so the task watchdog stays fed |

To drive the hardware from the model, read the variables with
`<%symbolName(modelNamePrefixStr,"getReal")%>` and write them to a peripheral
instead of printing them. `<%symbolName(modelNamePrefixStr,"realNames")%>`
holds the name of every variable, in the same order.

## Limitations

The target inherits the limitations of the experimental embedded C target it
shares its equation generation with: no algebraic loops, no events, no arrays,
no records and no strings. Models that use them fail to generate.
>>
end readmeFile;

annotation(__OpenModelica_Interface="codegen");
end CodegenESP32;

