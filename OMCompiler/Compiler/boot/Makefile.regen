# Minimal driver for regenerating the bootstrap sources with an already-built
# omc, without a full autotools configure. Provides just the variables that
# Makefile.common's *generation* rules need (the compile/link rules are unused).
TOP_DIR = $(abspath ../..)
OMHOME = $(OPENMODELICAHOME)
OMBUILDDIR = $(OMHOME)
LIB_OMC = lib/x86_64-linux-gnu/omc
OMC_EXTRA_FLAGS = -d=checkDefUse
defaultMakefileTarget = Makefile.regen
CC = cc
SHREXT = .so
EXE_EXT =
EXE_SUFFIX =

include Makefile.common

# The CMake build already generated Compiler/Template/*.mo and
# Compiler/Script/OpenModelicaScriptingAPI.mo, so skip the autotools recursion.
templates:
	@echo "  [regen] using pre-generated Template/*.mo"
scripting:
	@echo "  [regen] using pre-generated Script/OpenModelicaScriptingAPI.mo"
