# Script-mode generator (`cmake -P`) that turns the Makefile testsuite's test
# list into a CTestTestfile.cmake, one CTest test per test file, so
# `ctest --test-dir <OUTPUT_DIR>` can drive it.
#
# This is kept out of the normal CMake configure on purpose: the CI stages
# that use this only unstash an installed omc, not a configured build tree
# (see ctestCMakeStashed() in .CI/common.groovy), and reconfiguring the whole
# OpenModelica project just to register tests would dwarf the cost of this
# Perl-only discovery step. It is also why this only picks up tests from
# testsuite/: discovery is delegated entirely to runtests.pl, which never
# looks outside the testsuite Makefiles.
#
# Test discovery, suite filtering and ordering are all delegated to
# runtests.pl (-printtests -nodb), so the set of tests and their order match
# exactly what an unpartitioned Makefile testsuite run would use. Splitting
# into reproducible shards is then just `ctest -I <M>,,<N>`: CTest numbers
# tests in the (stable) order they were added below.
#
# runtest.pl uses an inverted exit code (0 means the test FAILED; the
# process otherwise exits non-zero, encoding the elapsed time for partest's
# own scheduling heuristic - see testsuite/partest/runtest.pl). CTest's
# WILL_FAIL test property exists for exactly this case: it flips CTest's
# usual "zero exit = pass" interpretation around.
#
# Required (-D):
#   TESTSUITE_DIR     Absolute path to the testsuite/ source directory.
#   OUTPUT_DIR        Directory to (re-)write CTestTestfile.cmake into.
# Optional:
#   TESTSUITE_SUITES  Forwarded to runtests.pl's -suites= flag.
#   PERL_EXECUTABLE   Defaults to "perl".

if(NOT TESTSUITE_DIR)
  message(FATAL_ERROR "GenerateCTestFile.cmake: TESTSUITE_DIR must be set")
endif()
if(NOT OUTPUT_DIR)
  message(FATAL_ERROR "GenerateCTestFile.cmake: OUTPUT_DIR must be set")
endif()
if(NOT PERL_EXECUTABLE)
  set(PERL_EXECUTABLE perl)
endif()

set(list_args -nodb -printtests)
if(TESTSUITE_SUITES)
  list(APPEND list_args "-suites=${TESTSUITE_SUITES}")
endif()

# Must run from testsuite/partest/: runtests.pl refuses to start otherwise.
execute_process(
  COMMAND "${PERL_EXECUTABLE}" runtests.pl ${list_args}
  WORKING_DIRECTORY "${TESTSUITE_DIR}/partest"
  RESULT_VARIABLE result
  OUTPUT_VARIABLE test_list_raw
  ERROR_VARIABLE test_list_err)

if(NOT result EQUAL 0)
  message(FATAL_ERROR "runtests.pl -printtests failed (${result}):\n${test_list_err}")
endif()

string(STRIP "${test_list_raw}" test_list_raw)
if(test_list_raw STREQUAL "")
  message(FATAL_ERROR "runtests.pl -printtests returned no tests; refusing to write an empty CTestTestfile.cmake")
endif()
string(REPLACE "\n" ";" test_list "${test_list_raw}")
list(REMOVE_DUPLICATES test_list)

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(out_file "${OUTPUT_DIR}/CTestTestfile.cmake")
file(WRITE "${out_file}" "# Generated by testsuite/CTest/Partest/GenerateCTestFile.cmake. Do not edit.\n")

list(LENGTH test_list n_tests)
foreach(test_path IN LISTS test_list)
  # "./flattening/modelica/scodeinst/Foo.mos" -> name "flattening.modelica.scodeinst.Foo.mos", label "flattening"
  # The extension is kept: a handful of directories have both a Foo.mo and a
  # Foo.mos, which would otherwise collide on the (required to be unique) name.
  string(REGEX REPLACE "^\\./" "" rel_path "${test_path}")
  string(REPLACE "/" "." test_name "${rel_path}")
  string(REGEX MATCH "^[^/]+" label "${rel_path}")

  file(APPEND "${out_file}"
    "add_test(\"${test_name}\" \"${PERL_EXECUTABLE}\" \"${TESTSUITE_DIR}/partest/runtest.pl\" \"${test_path}\" \"--no-colour\")\n"
    "set_tests_properties(\"${test_name}\" PROPERTIES\n"
    "  WORKING_DIRECTORY \"${TESTSUITE_DIR}\"\n"
    "  WILL_FAIL TRUE\n"
    "  LABELS \"${label}\"\n"
    "  TIMEOUT 950)\n")
endforeach()

message(STATUS "Generated ${n_tests} CTest tests from the Makefile testsuite: ${out_file}")
