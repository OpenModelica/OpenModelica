// Name:     StateSetArrayEq
// keywords: index reduction, smooth, array equation, state selection
// status:   correct
//
// Index reduction of an array equation with an array valued if-expression
// inside smooth(). The differentiated array equation has to be scalarized,
// otherwise it ends up as constraint equation of a dynamic state set and
// createResidualSetEquations fails.
//
// StateSetArrayEq:         the if-expression is written in the equation.
// StateSetArrayEqFunction: the if-expression only shows up after the backend
//                          inlined the function, the frontend can't scalarize
//                          it. Same as for Modelica.Math.Vectors.normalize.
//
// See https://github.com/OpenModelica/OpenModelica/issues/15432

loadString("
model StateSetArrayEq
  Real r[2](start = {1, 0.5}, each fixed = true);
  Real v[2](start = {0, 1}, each fixed = true);
  Real e[2];
  Real s, w, a;
equation
  der(r) = v;
  der(v) = -r;
  e = smooth(0, if r[1] > 0 then r else 2*r);
  s = e[1] + 2*e[2];
  w = der(s);
  a = der(w);
end StateSetArrayEq;

model StateSetArrayEqFunction
  function f
    input Real x[2];
    output Real y[2];
  algorithm
    y := smooth(0, if x[1] > 0 then x else 2*x);
    annotation(Inline = true);
  end f;
  Real r[2](start = {1, 0.5}, each fixed = true);
  Real v[2](start = {0, 1}, each fixed = true);
  Real e[2];
  Real s, w, a;
equation
  der(r) = v;
  der(v) = -r;
  e = f(r);
  s = e[1] + 2*e[2];
  w = der(s);
  a = der(w);
end StateSetArrayEqFunction;
"); getErrorString();
simulate(StateSetArrayEq); getErrorString();
val(s, 1);
val(w, 1);
val(a, 1);
simulate(StateSetArrayEqFunction); getErrorString();
val(s, 1);
val(w, 1);
val(a, 1);

// Result:
// true
