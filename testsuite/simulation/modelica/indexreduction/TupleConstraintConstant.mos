// Name:     TupleConstraintConstant
// keywords: index reduction, tuple, nonlinear system, #17061
// status:   correct
//
// Pendulum whose length constraint is the first output of a tuple equation.
// After alias elimination r2 = 1 the equation is (1.0, a) = g(x, y), solved for
// {y, a} by a non-linear solver: the constant output needs its own residual
// 1.0 - tmp, the other outputs are crefs.
// Reference: the same model with scalar equations r2 = x*x + y*y, a = x + y
// gives x(1) = -0.98628976351336, y(1) = -0.16502273294536.
// TupleConstantLoop has the same tuple equation inside a torn algebraic loop,
// where it becomes residual equations of the loop. The scalar version gives
// x(1) = 0.49306424237240, y(1) = 0.86999290393297.

loadString("
model TupleConstraintConstant
  function g
    input Real x;
    input Real y;
    output Real r2;
    output Real a;
  algorithm
    r2 := x*x + y*y;
    a := x + y;
  end g;
  Real x(start=1, fixed=true), y(start=0), vx, vy(start=0, fixed=true), F, a;
  Real r2;
equation
  der(x) = vx;
  der(y) = vy;
  der(vx) = -F*x;
  der(vy) = -F*y - 9.81;
  r2 = 1;
  (r2, a) = g(x, y);
end TupleConstraintConstant;

model TupleConstantLoop
  function g
    input Real x;
    input Real y;
    output Real r2;
    output Real a;
  algorithm
    r2 := x*x + y*y;
    a := x + y;
  end g;
  Real x, y(start=0.9), a, r2;
equation
  r2 = 1;
  (r2, a) = g(x, y);
  x = 0.3*a + 0.1*sin(time);
end TupleConstantLoop;
"); getErrorString();
simulate(TupleConstraintConstant, stopTime=1); getErrorString();
abs(val(x, 1) + 0.98628976351336) < 1e-6;
abs(val(y, 1) + 0.16502273294536) < 1e-6;
abs(val(x, 1)^2 + val(y, 1)^2 - 1) < 1e-8;
abs(val(a, 1) - val(x, 1) - val(y, 1)) < 1e-8;
simulate(TupleConstantLoop, stopTime=1); getErrorString();
abs(val(x, 1) - 0.49306424237240) < 1e-8;
abs(val(y, 1) - 0.86999290393297) < 1e-8;

