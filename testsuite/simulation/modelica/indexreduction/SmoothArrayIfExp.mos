// Name:     SmoothArrayIfExp
// keywords: index reduction, smooth, array equation, state selection
// status:   correct
//
// Index reduction of an array equation with an array valued if-expression
// inside smooth(). The differentiated array equation has to be scalarized,
// otherwise it ends up as constraint equation of a dynamic state set.
// See https://github.com/OpenModelica/OpenModelica/issues/15432

loadString("
model SmoothArrayIfExp
  Real r[2](start = {1, 0.5}, each fixed = true);
  Real v[2](start = {0, 1}, each fixed = true);
  Real e[2];
  Real s, w, a;
equation
  der(r) = v;
  der(v) = -r;
  e = smooth(0, if r[1] > 0 then r else 2*r);
  s = e[1] + 2*e[2];
  w = der(s);
  a = der(w);
end SmoothArrayIfExp;
"); getErrorString();
simulate(SmoothArrayIfExp); getErrorString();
val(s, 1);
val(w, 1);
val(a, 1);
// Result:
// true
// ""
// record SimulationResult
//     resultFile = "SmoothArrayIfExp_res.mat",
