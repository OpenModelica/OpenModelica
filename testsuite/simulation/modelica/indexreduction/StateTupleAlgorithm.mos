// Name:     StateTupleAlgorithm
// keywords: index reduction, algorithm, state selection, tuple, #17060
// status:   correct
//
// The model of #17060: two states assigned by tuple assignments of the same
// two-output function in an algorithm section. The section becomes the tuple
// equations (c1, b1) = content(p); (c2, b2) = content(p).
// c1(t) = c2(t) = 1 - 0.5*exp(-t/2), c1(1) = 0.69673467...

loadString("
model StateTupleAlgorithm
  function content
    input Real p;
    output Real total;
    output Real bound;
  algorithm
    bound := p/(1 + p);
    total := 0.03*p + bound;
  end content;
  Real c1(start=0.5, fixed=true);
  Real c2(start=0.5);
  Real p;
  Real q;
  Real b1;
  Real b2;
equation
  der(c1) = 1 - q;
  der(c2) = q - c2;
algorithm
  (c1, b1) := content(p);
  (c2, b2) := content(p);
end StateTupleAlgorithm;
"); getErrorString();
simulate(StateTupleAlgorithm, stopTime=1); getErrorString();
val(c1, 1);
val(c2, 1);
val(b1, 1) - val(b2, 1);

