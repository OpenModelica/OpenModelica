// Name:     DerivativeOfInput
// keywords: index reduction, input, derivative
// status:   correct
// teardown_command: rm -rf Feedthrough.fmu Feedthrough.log Feedthrough_info.json Feedthrough.fmutmp InverseWithOutput.log InverseWithOutput.fmutmp
//
// Derivatives of top-level inputs are not supported. Check that omc reports
// them instead of taking them as zero, see #9802.
// A Co-Simulation FMU provides the derivatives of its outputs. If an output
// depends on an input, that needs der(u), which is 0 for inputs held constant
// between communication points. This alone must not stop the export.

loadFile("DerivativeOfInput.mo"); getErrorString();

translateModel(DerivativeOfInput.Alias); getErrorString();
translateModel(DerivativeOfInput.NegatedAliasChain); getErrorString();
translateModel(DerivativeOfInput.IndexReduction); getErrorString();
translateModel(DerivativeOfInput.SecondDerivative); getErrorString();
translateModel(DerivativeOfInput.DerOfExpression); getErrorString();
translateModel(DerivativeOfInput.NoDerivative); getErrorString();

buildModelFMU(DerivativeOfInput.Feedthrough, version = "2.0", fmuType = "cs", platforms = {"static"}); getErrorString();
buildModelFMU(DerivativeOfInput.InverseWithOutput, version = "2.0", fmuType = "cs", platforms = {"static"}); getErrorString();

