// Name:     StateSetDerivativeCandidate
// keywords: index reduction, dynamic state selection, #13295
// status:   correct
//
// a = der(d) with d = der(m2) needs the second derivative of m2 = v1*m1.
// The dynamic state selection then makes a state set with the candidate
// der(m1), which is not a variable of the system.

loadString("
model StateSetDerivativeCandidate
  Real m1, v1(start = 1, fixed = true), m2(start = 1, fixed = true), v2(start = 1, fixed = true), p, d, a;
equation
  v1*der(m1) = 10 - p - m1^2;
  der(v1) = -m1;
  v2*der(m2) = p - 1 - m2^2;
  der(v2) = -m2;
  m2 = v1*m1;
  d = der(m2);
  a = der(d);
end StateSetDerivativeCandidate;
"); getErrorString();
simulate(StateSetDerivativeCandidate, stopTime = 0.5); getErrorString();

