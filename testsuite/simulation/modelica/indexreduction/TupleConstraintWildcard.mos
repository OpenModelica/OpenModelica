// Name:     TupleConstraintWildcard
// keywords: index reduction, state selection, tuple, wildcard, #17061
// status:   correct
//
// Like TupleConstraintEquation, but the second output is ignored. Splitting
// the inlined constraint (c1, ) = (f1(p), f2(p)) must not give an equation
// for the ignored output, else state selection gets one constraint too many.
// c1(t) = c2(t) = 1 - 0.5*exp(-t/2), c1(1) = 0.69673467...

loadString("
model TupleConstraintWildcard
  function content
    input Real p;
    output Real total;
    output Real bound;
  algorithm
    bound := p/(1 + p);
    total := 0.03*p + bound;
  end content;
  Real c1(start=0.5, fixed=true);
  Real c2(start=0.5);
  Real p;
  Real q;
equation
  der(c1) = 1 - q;
  der(c2) = q - c2;
  (c1, ) = content(p);
  (c2, ) = content(p);
end TupleConstraintWildcard;
"); getErrorString();
simulate(TupleConstraintWildcard, stopTime=1); getErrorString();
val(c1, 1);
val(c2, 1);

