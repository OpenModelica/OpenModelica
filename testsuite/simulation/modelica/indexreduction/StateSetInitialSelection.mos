// Name:     StateSetInitialSelection
// keywords: index reduction, dynamic state selection, initialization, #18218
// status:   correct
//
// revolute2.w(fixed = true) is a candidate of a state set. The default
// selection is singular at the initial point, and the first selection makes
// revolute2.w a state. It must keep its start value 2*pi. StaticState has
// revolute2.w as a static state.

loadModel(ModelicaTest, {"4.1.0"}); getErrorString();
loadString("
model StaticState
  extends ModelicaTest.MultiBody.Joints.RevolutePlanarLoopConstraint(revolute2(stateSelect = StateSelect.always));
end StaticState;
"); getErrorString();
simulate(ModelicaTest.MultiBody.Joints.RevolutePlanarLoopConstraint, stopTime = 0.3, fileNamePrefix = "StateSetInitialSelection"); getErrorString();
val(revolute2.w, 0, "StateSetInitialSelection_res.mat");
simulate(StaticState, stopTime = 0.3); getErrorString();
diffSimulationResults("StateSetInitialSelection_res.mat", "StaticState_res.mat", "StateSetInitialSelection_diff", vars = {"revolute2.phi", "revolute2.w", "revolute3.phi", "revolute3.w"}); getErrorString();

