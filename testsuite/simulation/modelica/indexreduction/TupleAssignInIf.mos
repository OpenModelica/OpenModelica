// Name:     TupleAssignInIf
// keywords: index reduction, algorithm, differentiation, tuple, #17060
// status:   correct
//
// A state assigned by a tuple assignment inside an if statement: the
// algorithm stays an algorithm and index reduction differentiates it,
// which gives the assignment der(x) := ... for the tuple element x.
// Same result as the scalar assignment, v = der(x) = cos(time).

loadString("
package TupleAssignInIf
  function f
    input Real t;
    output Real a;
    output Real b;
  algorithm
    a := sin(t);
    b := cos(t);
  end f;
  model Tuple
    Real x, b, v;
  equation
    der(x) = v;
  algorithm
    if time > 0.5 then
      (x, b) := f(time);
    else
      (x, b) := f(time);
    end if;
  end Tuple;
  model Scalar
    Real x, v;
  equation
    der(x) = v;
  algorithm
    if time > 0.5 then
      x := sin(time);
    else
      x := sin(time);
    end if;
  end Scalar;
end TupleAssignInIf;
"); getErrorString();
simulate(TupleAssignInIf.Tuple, stopTime=1); getErrorString();
simulate(TupleAssignInIf.Scalar, stopTime=1); getErrorString();
diffSimulationResults("TupleAssignInIf.Tuple_res.mat", "TupleAssignInIf.Scalar_res.mat", "TupleAssignInIf_diff", vars = {"x", "v"}); getErrorString();
val(v, 1, "TupleAssignInIf.Tuple_res.mat");

