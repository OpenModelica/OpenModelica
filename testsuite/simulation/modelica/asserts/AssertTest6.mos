// name:     AssertTest6
// keywords: assert
// status:   correct
// teardown_command: rm -rf Test6* output.log
//
//
loadFile("AssertTest6.mo");
getErrorString();

// The assert in f stops the integrator where x reaches 0.5.
echo(false);
res := simulate(Test6, numberOfIntervals=10);
messages := res.messages;
echo(true);
res.resultFile;
regexBool(messages, "Simulation terminated at time 0.5\n");
getErrorString();

