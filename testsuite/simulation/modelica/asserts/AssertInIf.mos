// name:     AssertInIf
// keywords: assert if
// status:   correct
//
// An assert(false, ...) in a branch of an if-equation or if-statement must
// only trigger if the branch is selected, #14791.
//

loadString("
model AssertInIfEq
  Real x = time;
equation
  if x > -1 then
  else
    assert(false, \"else branch of if-equation\");
  end if;
end AssertInIfEq;

model AssertInInitialIfEq
  parameter Real a = 3 annotation(Evaluate = false);
  Real x = time;
initial equation
  if a > 2 then
    assert(a > 0, \"then branch of initial if-equation\");
  else
    assert(false, \"else branch of initial if-equation\");
  end if;
end AssertInInitialIfEq;

model AssertInInitialIfEqEmpty
  parameter Real a = 3 annotation(Evaluate = false);
  Real x = time;
initial equation
  if a > 2 then
  else
    assert(false, \"else branch of initial if-equation\");
  end if;
end AssertInInitialIfEqEmpty;

model AssertInIfStmt
  Real x = time;
  Real y;
algorithm
  y := 1;
  if x > -1 then
  else
    y := 2;
    assert(false, \"else branch of if-statement\");
  end if;
end AssertInIfStmt;
"); getErrorString();

simulate(AssertInIfEq, numberOfIntervals = 10); getErrorString();
simulate(AssertInInitialIfEq, numberOfIntervals = 10); getErrorString();
simulate(AssertInInitialIfEq, numberOfIntervals = 10, simflags = "-override=a=1"); getErrorString();
simulate(AssertInInitialIfEqEmpty, numberOfIntervals = 10); getErrorString();
simulate(AssertInIfStmt, numberOfIntervals = 10); getErrorString();
val(y, 1.0);

