// name:     AssertValues
// keywords: assert
// status:   correct
//
// A failed assert prints the values of the variables in its condition.
//

loadString("
model AssertValues
  Real x(start = 0, fixed = true);
  Real y;
  Integer i = integer(10*x);
  Boolean b = x > 0.2;
  Real a[3] = {1, 2, 3}*x;
  Integer k = integer(10*x) + 1;
equation
  der(x) = 4;
  y = x^2 + 0.23;
  assert(pre(b) or not b, \"b became true\", AssertionLevel.warning);
  assert(i < 3, \"i is too big\", AssertionLevel.warning);
  assert(a[k] < 0.3 and a[min(k, 3)] < 0.6, \"a is too big\", AssertionLevel.warning);
  assert(x < y, \"x is too big\");
end AssertValues;
"); getErrorString();
simulate(AssertValues); getErrorString();

