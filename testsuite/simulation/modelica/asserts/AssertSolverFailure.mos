// name:     AssertSolverFailure
// keywords: assert cvode ida
// status:   correct
// teardown_command: rm -rf AssertSolverFailure_* AssertSolverFailure AssertSolverFailure.exe AssertSolverFailure.c AssertSolverFailure.libs AssertSolverFailure.log AssertSolverFailure.makefile AssertSolverFailure.o
//
// An assert makes CVODE and IDA fail. The last evaluation at the failure
// time uses the last accepted states, which do not violate the assert
// (#18408). The result file has a last row at the failure time.

loadString("
model AssertSolverFailure
  function f
    input Real x;
    output Real y;
  algorithm
    assert(x >= 0.5, \"x out of limit\");
    y := 1;
  end f;
  Real x(start = 1, fixed = true);
equation
  der(x) = -f(x);
end AssertSolverFailure;
"); getErrorString();

simulate(AssertSolverFailure, method = "cvode"); getErrorString();
readSimulationResultSize("AssertSolverFailure_res.mat"); getErrorString();
val(x, 0.4999, "AssertSolverFailure_res.mat"); getErrorString();

simulate(AssertSolverFailure, method = "ida"); getErrorString();
readSimulationResultSize("AssertSolverFailure_res.mat"); getErrorString();
val(x, 0.4999, "AssertSolverFailure_res.mat"); getErrorString();

