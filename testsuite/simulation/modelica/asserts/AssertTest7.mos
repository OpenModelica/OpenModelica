// name:     AssertTest7
// keywords: assert
// status:   correct
// teardown_command: rm -rf Test7* output.log
//
//
loadFile("AssertTest7.mo");
getErrorString();

// The assert in f stops the integrator where x reaches 0.5.
echo(false);
res := simulate(Test7, numberOfIntervals=7);
messages := res.messages;
echo(true);
res.resultFile;
regexBool(messages, "Simulation terminated at time 0.5\n");
getErrorString();

