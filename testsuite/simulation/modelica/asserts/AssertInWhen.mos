// name:     AssertInWhen
// keywords: assert when event
// status:   correct
// teardown_command: rm -rf AssertInWhen* output.log
//
// A when-body runs only at the event that activates it, so a violated assert
// there ends the simulation (#17213). An assert outside a when that is violated
// only in an intermediate event iteration is still excused.

loadString("
package AssertInWhen
  model Equation
    Boolean y = time > 0.1;
  equation
    when time > 0.26 then
      assert(not y, \"Test violation that should interrupt execution\");
    end when;
  end Equation;

  model Algorithm
    Boolean y = time > 0.1;
  algorithm
    when time > 0.26 then
      if y then
        assert(time < 0.2, \"Test violation that should interrupt execution\");
      end if;
    end when;
  end Algorithm;

  model IntermediateIteration
    discrete Real a(start = 0, fixed = true);
    discrete Real b(start = 0, fixed = true);
  equation
    when time > 0.5 then
      a = 1;
    end when;
    when pre(a) > 0.5 then
      b = 1;
    end when;
    assert(a <= b, \"a is ahead of b\");
  end IntermediateIteration;
end AssertInWhen;
"); getErrorString();

simulate(AssertInWhen.Equation); getErrorString();
simulate(AssertInWhen.Algorithm); getErrorString();
simulate(AssertInWhen.IntermediateIteration); getErrorString();

