// name:     AssertFunction
// keywords: assert
// status:   correct
//
// A failed assert in a function names the function and gives the values of
// its scalar inputs and of the variables in the condition.
//

loadString("
package AssertFunction
  record R
    Real a;
  end R;

  function f
    input Real x;
    input Integer n;
    input Boolean b;
    input Real v[2];
    input R r;
    output Real y;
  protected
    Real z = 2*x;
  algorithm
    assert(z < 0.2 or b, \"z is big\", AssertionLevel.warning);
    y := z + n + v[1] + r.a;
    assert(y < 2.5, \"y is too big\");
  annotation(Inline = false);
  end f;

  model M
    Real x = if time < 0.25 then 0 else if time < 0.5 then 0.25 else 1;
    Real y = f(x, 1, false, {0, 0}, R(0));
  end M;
end AssertFunction;
"); getErrorString();
simulate(AssertFunction.M); getErrorString();

// Result:
// true
// ""
