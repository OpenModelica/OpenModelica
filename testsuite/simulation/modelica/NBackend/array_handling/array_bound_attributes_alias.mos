// name: array_bound_attributes_alias
// keywords: NewBackend array min max alias
// status: correct
// suite: cSources
//
// Alias sets of non-scalarized array variables merge array min and max
// attributes element-wise: cap.T and cap.port.T get the larger min and the
// smaller max of the two.

loadString("
package array_bound_attributes_alias
  type Temp = Real(min = 0, max = 1000, start = 288.15, nominal = 300);
  connector Port
    Temp T;
    flow Real Q;
  end Port;
  model Cap
    Port port;
    Temp T(start = 293.15, fixed = true);
  equation
    T = port.T;
    der(T) = port.Q;
  end Cap;
  model Cond
    Port a, b;
  equation
    a.Q + b.Q = 0;
    a.Q = a.T - b.T;
  end Cond;
  model M
    parameter Integer N = 4;
    Cap cap[N](port(T(min = {1, 2, 3, 4})), each T(max = 500));
    Cond cond[N - 1];
  equation
    for i in 1:N - 1 loop
      connect(cap[i].port, cond[i].a);
      connect(cond[i].b, cap[i + 1].port);
    end for;
  end M;
end array_bound_attributes_alias;
"); getErrorString();

setCommandLineOptions("--newBackend -d=arrayConnect --simCodeScalarize=false"); getErrorString();

simulate(array_bound_attributes_alias.M, stopTime=1.0, simflags="-lv=LOG_INIT_V"); getErrorString();

val(cap[1].T, 1.0);

// Result:
// true
// ""
// true
