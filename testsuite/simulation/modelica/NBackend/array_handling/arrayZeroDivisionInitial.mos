// name: arrayZeroDivisionInitial
// keywords: NewBackend
// status: correct
//
// 0/0 in an array division is 0 during initialization, like scalar divisions.

loadString("
model ArrayZeroDivision
  Real a[2](each start = 1);
  Real r;
  Real x[2];
equation
  r = sum(a);
  x = a / r;
  a = {0, 0} * time;
end ArrayZeroDivision;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(ArrayZeroDivision, stopTime = 0); getErrorString();
val(x[1], 0);

