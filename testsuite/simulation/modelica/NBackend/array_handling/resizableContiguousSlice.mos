// name: resizableContiguousSlice
// keywords: NewBackend resizable slice
// status: correct
// cflags: --newBackend --resizableArrays
// suite: cSources
// teardown_command: rm -f resizableContiguousSlice resizableContiguousSlice_* resizableContiguousSlice.log resizableContiguousSlice.c resizableContiguousSlice.o resizableContiguousSlice.makefile resizableContiguousSlice.libs
//
// A row of an array with a resizable leading dimension is contiguous storage,
// so it is used in place instead of being copied with an index spec.

loadString("
model resizableContiguousSlice
  parameter Integer N = 3;
  Real x[N, 4](each start = 1, each fixed = true);
  Real y[N];
equation
  for i in 1:N loop
    y[i] = x[i, :] * {1, 2, 3, 4};
    der(x[i, :]) = -y[i] * x[i, :];
  end for;
end resizableContiguousSlice;
"); getErrorString();

setCommandLineOptions("--newBackend --resizableArrays"); getErrorString();
buildModel(resizableContiguousSlice); getErrorString();
system("grep -q index_alloc_real_array resizableContiguousSlice_*.c");
system("./resizableContiguousSlice -override=N=5", "resizableContiguousSlice.log");
val(y[5], 1, "resizableContiguousSlice_res.mat");
// Result:
// true
// ""
