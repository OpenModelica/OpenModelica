// generated: connections of many single elements next to array connections, see literalConnects.mos
package literalConnects
  import Modelica.Electrical.Analog.Basic;
  model Separate "a connector array connected only with literal indices and one connected in a for loop"
    Basic.Resistor c[310](each R = 1);
    Basic.Resistor a[10](each R = 1);
    Modelica.Electrical.Analog.Sources.ConstantVoltage v(V = 1);
    Basic.Ground g;
