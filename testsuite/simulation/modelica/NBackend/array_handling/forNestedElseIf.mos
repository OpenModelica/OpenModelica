// name: forNestedElseIf
// keywords: NewBackend for-equation if-equation
// status: correct
// cflags: --newBackend
//
// Single iterations of a for-equation with nested if-equations in the else branches.

loadString("
model forNestedElseIf
  Real a(start = 1, fixed = true), b;
  Real p[4];
equation
  der(a) = -a;
  b = 2 * a;
  for i in 1:4 loop
    if i == 1 then p[1] = a;
    else if i == 2 then p[2] = b;
    else if i == 3 then p[3] = a + b;
    else
      p[i] = 0;
    end if; end if; end if;
  end for;
end forNestedElseIf;
"); getErrorString();

simulate(forNestedElseIf, stopTime = 1); getErrorString();
val(p[3], 1);
val(p[4], 1);
