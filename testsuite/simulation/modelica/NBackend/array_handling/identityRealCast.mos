// name: identityRealCast
// keywords: NewBackend, identity, cast
// status: correct
//
// identity(n) in a Real context is a Real identity matrix, see #18074.

loadString("
package IdentityRealCast
  model Binding
    parameter Integer N = 2;
    Real x = 1;
    Real y[N, N] = x*identity(N);
  end Binding;

  model Equation
    parameter Integer N = 2;
    Real x;
    Real y[N, N];
  equation
    x = 1;
    y = x*identity(N);
  end Equation;

  model Plain
    parameter Integer N = 2;
    Real y[N, N];
  equation
    y = identity(N);
  end Plain;

  model Scaled
    parameter Integer N = 2;
    Real y[N, N];
  equation
    y = time*identity(N);
  end Scaled;

  model Mixed
    Integer k[2, 2] = identity(2);
    Real y[2, 2] = identity(2);
    Real w[2, 2] = time*identity(2);
  end Mixed;

  model State
    parameter Integer N = 2;
    Real z[N](each start = 1, each fixed = true);
  equation
    der(z) = -identity(N)*z;
  end State;
end IdentityRealCast;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

setCommandLineOptions("-d=bltdump"); getErrorString();
simulate(IdentityRealCast.Scaled); getErrorString();
setCommandLineOptions("-d=-bltdump"); getErrorString();
val(y[2,2], 0.5); val(y[1,2], 0.5); getErrorString();

simulate(IdentityRealCast.Binding); getErrorString();
val(y[1,1], 0.5); val(y[1,2], 0.5); getErrorString();

simulate(IdentityRealCast.Equation); getErrorString();
val(y[1,1], 0.5); val(y[2,1], 0.5); getErrorString();

simulate(IdentityRealCast.Plain); getErrorString();
val(y[2,2], 0.5); val(y[2,1], 0.5); getErrorString();

simulate(IdentityRealCast.Mixed); getErrorString();
val(k[1,1], 0.5); val(y[2,2], 0.5); val(y[1,2], 0.5); val(w[1,1], 0.5); getErrorString();

setCommandLineOptions("--generateDynamicJacobian=symbolic"); getErrorString();
simulate(IdentityRealCast.State); getErrorString();
val(z[1], 1.0); getErrorString();

