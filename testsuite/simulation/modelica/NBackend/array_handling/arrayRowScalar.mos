// name: arrayRowScalar
// keywords: NewBackend array equation solve
// status: correct
// cflags: --newBackend
//
// One row of an array equation solves a scalar, the other rows solve array elements.

loadString("
model arrayRowScalar
  Real v[3], x;
equation
  v[1] = 2 * time;
  v = fill(1.0, 3) .* x;
end arrayRowScalar;
"); getErrorString();

simulate(arrayRowScalar, stopTime = 1); getErrorString();
val(x, 1);
val(v[3], 1);
