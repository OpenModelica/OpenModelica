// name: nestedForConnectRange
// keywords: NewBackend for-equation connect
// status: correct
// cflags: --newBackend
//
// The range of the inner connect loop depends on the outer iterator.

loadString("
model nestedForConnectRange
  connector C
    Real e;
    flow Real f;
  end C;
  model M
    C c;
  equation
    c.f = c.e - 1;
  end M;
  parameter Integer N = 2;
  parameter Integer K = 2;
  M a[N*K], z[N];
equation
  for i in 1:N loop
    for j in 1+K*(i-1):i*K loop
      connect(a[j].c, z[i].c);
    end for;
  end for;
end nestedForConnectRange;
"); getErrorString();

simulate(nestedForConnectRange, stopTime = 1); getErrorString();
val(a[4].c.e, 1);
