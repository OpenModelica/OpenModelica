// name: resizableSparseLoop
// keywords: NewBackend resizable sparsity
// status: correct
// cflags: --newBackend --resizableArrays -d=arrayConnect
// teardown_command: rm -f resizableSparseLoop_res.mat
//
// The grid's loop is one system of 2*N*M unknowns. Translated at N = M = 10 and
// run at N = M = 100, it is too large for a dense Jacobian: its sparsity has to
// be expanded for the sizes it runs with.

loadModel(ScalableTestSuite); getErrorString();
simulate(ScalableTestSuite.Electrical.DistributionSystemDC.ScaledExperiments.DistributionSystemModelica_N_10_M_10,
  stopTime = 0.01, numberOfIntervals = 10, fileNamePrefix = "resizableSparseLoop",
  variableFilter = "V_source.i", simflags = "-override=N=100,M=100"); getErrorString();
val(V_source.i, 0.01);

