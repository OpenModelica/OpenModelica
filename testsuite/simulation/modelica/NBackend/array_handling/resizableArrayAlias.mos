// name: resizableArrayAlias
// keywords: NewBackend resizable alias
// status: correct
// cflags: --newBackend --resizableArrays -d=dumprepl
// suite: cSources
// teardown_command: rm -f resizableArrayAlias resizableArrayAlias_* resizableArrayAlias.log
//
// A for-equation over 1:N that equates two whole arrays of size N is an alias.

loadString("
model resizableArrayAlias
  parameter Integer N = 3;
  Real x[N], y[N], z[N];
equation
  for i in 1:N loop
    x[i] = y[i];
  end for;
  for i in 1:N loop
    der(y[i]) = -i*z[i];
    z[i] = sin(x[i]) + time;
  end for;
end resizableArrayAlias;
"); getErrorString();

simulate(resizableArrayAlias, stopTime = 0.1, simflags = "-override=N=5"); getErrorString();
val(x[5], 0.1);
