// name: resizableConnectIf
// keywords: NewBackend resizable connect if
// status: correct
// cflags: --newBackend --resizableArrays
//
// Connects in if equations in for equations over resizable parameters, with
// conditions comparing the iterator with the size parameter (TLK_Battery). The
// branches restrict the loop ranges.

loadString("
connector Port
  Real T;
  flow Real Q;
end Port;

model Cap
  Port a, b;
  Real T(start = 0, fixed = true);
equation
  der(T) = a.Q + b.Q;
  a.Q = 2 * (a.T - T);
  b.Q = 2 * (b.T - T);
end Cap;

model Fixed
  parameter Real T = 1;
  Port p;
equation
  p.T = T;
end Fixed;

model resizableConnectIf
  parameter Integer N = 4;
  parameter Integer M = 3;
  Cap c[M, N];
  Fixed hot[M](each T = 1), cold[M](each T = 0);
equation
  for i in 1:M loop
    for k in 1:N loop
      if k == 1 then
        connect(c[i, k].a, hot[i].p);
      end if;
      if N > k then
        connect(c[i, k].b, c[i, k + 1].a);
      else
        connect(c[i, k].b, cold[i].p);
      end if;
    end for;
  end for;
end resizableConnectIf;
"); getErrorString();

instantiateModel(resizableConnectIf); getErrorString();
