// name: eachScalarProduct
// keywords: NewBackend binding each scalar product
// status: correct
// cflags: --newBackend
//
// An each binding with a scalar product of two vectors keeps the scalar product.

loadString("
model eachScalarProduct
  record R
    Real m;
    Real h;
    Real H;
  end R;
  parameter Integer N = 3;
  Real m[N] = {1, 2, 3} * time;
  Real h[N] = {4, 5, 6};
  R r[N](m = m, h = h, each H = m * h);
end eachScalarProduct;
"); getErrorString();

simulate(eachScalarProduct, stopTime = 1); getErrorString();
val(r[2].H, 1);
