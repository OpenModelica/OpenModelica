// name: resizableEvaluate
// keywords: NewBackend resizable Evaluate annotation
// status: correct
// cflags: --newBackend --resizableArrays -d=dumpResizable
// suite: cSources
// teardown_command: rm -f resizableEvaluate_*
//
// A parameter with annotation(Evaluate = true) is not resizable.

loadString("
model resizableEvaluate
  parameter Integer n = 3 annotation(Evaluate = true);
  parameter Integer N = 4;
  Real x[N, n](each start = 1, each fixed = true);
equation
  for i in 1:N, j in 1:n loop
    der(x[i, j]) = -j*x[i, j];
  end for;
end resizableEvaluate;
"); getErrorString();

simulate(resizableEvaluate, stopTime = 1); getErrorString();
val(x[4, 3], 1);
// Result:
// true
// ""
// =================================================================
//   [dumpResizable] Evaluated Optimal Resizable Parameter Values:
// =================================================================
//
//   N ..... OPTIMAL: 3 (ORIGINAL: 4)
//
// record SimulationResult
//     resultFile = "resizableEvaluate_res.mat",
//     simulationOptions = "startTime = 0.0, stopTime = 1.0, numberOfIntervals = 500, tolerance = 1e-6, method = 'dassl', fileNamePrefix = 'resizableEvaluate', options = '', outputFormat = 'mat', variableFilter = '.*', cflags = '', simflags = ''",
//     messages = "LOG_SUCCESS       | info    | The initialization finished successfully without homotopy method.
// LOG_SUCCESS       | info    | The simulation finished successfully.
// "
// end SimulationResult;
// ""
// 0.04978810534858747
// endResult
