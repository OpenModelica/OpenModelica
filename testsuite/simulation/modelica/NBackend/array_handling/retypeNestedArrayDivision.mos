// name: retypeNestedArrayDivision
// keywords: NewBackend
// status: correct
// A typed array ./ array is a division with array type. Retyping the
// parameter binding must accept it inside other operations.

loadString("
model RetypeNestedArrayDivision
  parameter Real a[3] = {1, 2, 3};
  parameter Real c[3] = {4, 5, 6};
  parameter Real q = 1/(a*(ones(3) ./ c));
  Real x = q*time;
end RetypeNestedArrayDivision;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(RetypeNestedArrayDivision); getErrorString();
val(q, 0.0);
val(x, 1.0);
