// name: arrayComponentElementNames
// keywords: NewBackend, array, result file, init xml
// status: correct
// teardown_command: rm -f *ArrayComponentElementNames*
//
// Element names of non-scalarized array variables whose dimensions belong to
// several components. init.xml marks each dimension with ':', e.g.
// s[:].p.v[:], and the result file has s[1].p.v[2] instead of s.p.v[1,2].

loadString("
model ArrayComponentElementNames
  model Source
    Real v[2];
    Real u[2] = v \"alias of v\";
    parameter Real k = 1;
  equation
    v = {k*time, 2*k};
  end Source;
  Source s[2](k = {1, 3});
  Real w[2, 2] = s.v \"alias of s.v\";
end ArrayComponentElementNames;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();
simulate(ArrayComponentElementNames, stopTime = 1, numberOfIntervals = 2); getErrorString();

system("grep -o 'name = \"[^\"]*\"' ArrayComponentElementNames_init.xml | grep '\\[' > ArrayComponentElementNames_names.txt"); getErrorString();
readFile("ArrayComponentElementNames_names.txt"); getErrorString();
readSimulationResultVars("ArrayComponentElementNames_res.mat"); getErrorString();
val(s[2].v[1], 1); getErrorString();
val(s[2].v[2], 1); getErrorString();
val(w[2,2], 1); getErrorString();
val(s[2].u[2], 1); getErrorString();

