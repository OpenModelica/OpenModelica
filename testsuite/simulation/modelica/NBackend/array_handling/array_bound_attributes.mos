// name: array_bound_attributes
// keywords: NewBackend array min max nominal
// status: correct
// suite: cSources
//
// Checks the C runtime log of the updated attributes.
//
// min, max and nominal attributes that depend on parameters are evaluated in
// updateBoundVariableAttributes, for scalar variables as well as for
// non-scalarized array variables with one value per element or `each`.

loadString("
model array_bound_attributes
  parameter Real p = 2;
  parameter Real n[3] = {1, 2, 3};
  parameter Integer q = 4;
  Real x[3](each min = -p, max = n*10, nominal = n*p, each start = 1, each fixed = true);
  Real y(min = -p, nominal = 10*p, start = 1, fixed = true);
  discrete Integer k[2](min = {-q, 0}, each max = q, each start = 0, each fixed = true);
equation
  der(x) = -x;
  der(y) = -y;
  when sample(0.5, 0.5) then
    k = pre(k) + {1, 1};
  end when;
end array_bound_attributes;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();

simulate(array_bound_attributes, stopTime=1.0, simflags="-lv=LOG_INIT_V"); getErrorString();

val(x[3], 1.0);
val(k[2], 1.0);

// Result:
// true
// ""
// true
// ""
