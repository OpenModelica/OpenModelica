// name: wholeSubscriptSparsity
// keywords: NewBackend array jacobian sparsity algebraic loop
// status: correct
// cflags: --newBackend
// teardown_command: rm -f wholeSubscriptSparsity_res.mat
//
// T[i] only depends on h[i, :], the rows of the loop Jacobian depend on T[i]
// and not on every element of T.

loadString("
model wholeSubscriptSparsity
  Real T[3](each start = 1);
  Real h[3, 2];
equation
  for i in 1:3, j in 1:2 loop
    h[i, j] = T[i]*(1 + j*T[i]);
  end for;
  for i in 1:3 loop
    sum(h[i, :]) = i*(1 + time);
  end for;
end wholeSubscriptSparsity;
"); getErrorString();

simulate(wholeSubscriptSparsity, stopTime = 1); getErrorString();
// no row depends on single literal elements of T
system("grep -q 'NLS_JAC_[0-9]*\\.T\\[[0-9]' wholeSubscriptSparsity_12jac.c");
val(T[3], 1);

// Result:
// endResult
