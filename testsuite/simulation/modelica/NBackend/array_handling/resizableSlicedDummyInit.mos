// name: resizableSlicedDummyInit
// keywords: NewBackend resizable index reduction initial equation cat
// status: correct
// cflags: --newBackend --resizableArrays
// teardown_command: rm -f resizableSlicedDummyInit resizableSlicedDummyInit_* resizableSlicedDummyInit.log
//
// The initial equations are only active for 1:N-1, the flags are inlined from
// cat() as init[N] = false for the symbolic N.

loadString("
model resizableSlicedDummyInit
  parameter Integer N = 6;
  parameter Boolean init[N] = cat(1, fill(true, N - 1), {false});
  parameter Real pSink = 2;
  Real p[N](each start = 1);
  Real w[N + 1];
equation
  w[1] = 1 + sin(time);
  for i in 1:N loop
    der(p[i]) = w[i] - w[i + 1];
  end for;
  for i in 1:N - 1 loop
    w[i + 1] = p[i] - p[i + 1];
  end for;
  p[N] = pSink;
initial equation
  for i in 1:N loop
    if init[i] then
      der(p[i]) = 0;
    end if;
  end for;
end resizableSlicedDummyInit;
"); getErrorString();

simulate(resizableSlicedDummyInit, stopTime = 1, simflags = "-override=N=9"); getErrorString();
val(p[1], 1);
val(p[8], 1);
val(w[10], 1);
