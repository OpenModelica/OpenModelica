//     resultFile = "resizableTearStart_res.mat",
//     simulationOptions = "startTime = 0.0, stopTime = 1.0, numberOfIntervals = 500, tolerance = 1e-6, method = 'dassl', fileNamePrefix = 'resizableTearStart', options = '', outputFormat = 'mat', variableFilter = '.*', cflags = '', simflags = '-override=N=7'",
