// name: arrayEquationRowLoop
// keywords: NewBackend
// status: correct
//
// One row of an array equation in an initial algebraic loop, the sparsity of v[:, {1, 2}].

loadString("
model arrayEquationRowLoop
  Real v[3, 3];
  Real f[3, 2];
initial equation
  der(v) = zeros(3, 3);
equation
  f = v[:, {1, 2}] - v[:, {2, 3}];
  der(v[1, :]) = {1, 2, 3} - v[1, :];
  der(v[2, :]) = {3, 2, 1} - v[2, :];
  der(v[3, 1]) = 0.5*sin(f[3, 2]) + 1 - v[3, 1];
  der(v[3, 2]) = 0.5*sin(f[3, 1]) + 2 - v[3, 2];
  der(v[3, 3]) = 3 - v[3, 3];
end arrayEquationRowLoop;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(arrayEquationRowLoop); getErrorString();
val(v[3, 1], 0.0);
val(v[3, 2], 0.0);
