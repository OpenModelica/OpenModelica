// name: sparsityRowsArrayComponents
// keywords: NewBackend jacobian sparsity array of components
// status: correct
// cflags: --newBackend
//
// The rows of der(c[i].x) = ... are all elements of x for each i, not one row per i.
// With rows missing from the sparsity pattern DASSL takes thousands of steps.

loadString("
model sparsityRowsArrayComponents
  model C
    parameter Real k;
    Real x[3](each start = 1, each fixed = true);
  equation
    der(x) = -k * x + {x[3], x[1], x[2]};
  end C;
  C c[4](k = {1e3, 2e3, 3e3, 4e3});
end sparsityRowsArrayComponents;
"); getErrorString();

echo(false);
res := simulate(sparsityRowsArrayComponents, stopTime = 1, simflags = "-lv=LOG_STATS");
messages := res.messages;
echo(true);
getErrorString();
regexBool(messages, "The simulation finished successfully");
regexBool(messages, " [0-9]{1,3} steps taken");
// Result:
// true
// ""
// true
// ""
// true
// true
// endResult
