// name: array_start_int_bool_string
// keywords: NewBackend array start Integer Boolean String
// status: correct
//
// Non-scalarized Integer, Boolean and String array variables and parameters
// with element-wise start values. The start attributes are read from the init
// XML file as arrays, every array element has to get its own start value.

loadString("
model array_start_int_bool_string
  parameter Integer p[3] = {10, 20, 30} annotation(Evaluate=false);
  parameter Boolean q[2] = {true, false} annotation(Evaluate=false);
  parameter String s[2] = {\"a\", \"b c\"} annotation(Evaluate=false);
  discrete Integer k[3](start = {1, 2, 3}, each fixed = true);
  discrete Boolean c[2](start = {false, true}, each fixed = true);
equation
  when sample(0.5, 0.5) then
    k = pre(k) + p;
    c = q;
  end when;
end array_start_int_bool_string;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();

simulate(array_start_int_bool_string, stopTime=1.0); getErrorString();

val(k[1], 0.0);
val(k[2], 0.0);
val(k[3], 0.0);
val(c[1], 0.0);
val(c[2], 0.0);
val(k[1], 1.0);
val(k[2], 1.0);
val(k[3], 1.0);
val(c[1], 1.0);
val(c[2], 1.0);

// Result:
// true
// ""
// true
// ""
