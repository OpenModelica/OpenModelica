// name: sumRecordArraySlice
// keywords: NewBackend
// status: correct
//
// An element of a record array field solved from sum() in an entwined for-loop.

loadString("
record C
  Real m_flow;
  Real p;
end C;

model Vol
  C ports[3];
  Real mb;
equation
  mb = sum(ports.m_flow);
  ports.p = fill(1, 3);
end Vol;

model sumRecordArraySlice
  Vol con[3];
  Real k(start = 1);
equation
  der(k) = -k;
  con[1].ports[1].m_flow = time;
  for i in 2:3 loop
    con[i].ports[1].m_flow = con[i-1].ports[2].m_flow;
  end for;
  for i in 1:3 loop
    con[i].ports[3].m_flow = i*time;
    con[i].mb = 3*time + k;
  end for;
end sumRecordArraySlice;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(sumRecordArraySlice); getErrorString();
val(con[1].ports[2].m_flow, 1.0);
val(con[3].ports[2].m_flow, 1.0);
