// name: emptyArrayTupleArgument
// keywords: NewBackend empty array function call #17394
// status: correct
// cflags: --newBackend
//
// An empty array argument of a function keeps its dimensions, when it replaces x
// in the generated code and when the function is inlined.

loadString("
package EmptyArrayTupleArgument
  function twoOut
    input Real h[:, 2];
    output Real s;
    output Real m;
  protected
    Integer n = size(h, 1);
    Real t[n] = h[:, 1];
  algorithm
    s := sum(t);
    m := size(h, 2);
  end twoOut;

  function oneOut
    input Real h[:, 2];
    output Real s;
  protected
    Integer n = size(h, 1);
    Real t[n] = h[:, 1];
  algorithm
    s := sum(t);
  end oneOut;

  model M
    Real x[0, 2] = fill(time, 0, 2);
    Real s, m;
  equation
    (s, m) = twoOut(x);
  end M;

  model P
    parameter Real hist[:, 2] = fill(0.0, 0, 2);
    parameter Real s(fixed = false);
    Real x = s + time;
  initial equation
    s = oneOut(hist);
  end P;
end EmptyArrayTupleArgument;
"); getErrorString();

simulate(EmptyArrayTupleArgument.M, stopTime = 1); getErrorString();
val(s, 1);
val(m, 1);
simulate(EmptyArrayTupleArgument.P, stopTime = 1); getErrorString();
val(x, 1);
