// name: scalarProductSlice
// keywords: NewBackend
// status: correct
//
// An element of a vector solved from a scalar product inside an algebraic loop.

loadString("
model scalarProductSlice
  Real X[3];
  Real R;
equation
  X[1] = 0.1;
  X[2] = 0.2;
  R = {1, 2, 3}*X;
  R = 2 + time + 0.1*sin(X[3]);
end scalarProductSlice;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(scalarProductSlice); getErrorString();
val(X[3], 1.0);
