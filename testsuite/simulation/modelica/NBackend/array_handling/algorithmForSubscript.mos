// name:     algorithmForSubscript
// keywords: NewBackend algorithm for array
// status:   correct
// cflags:   --newBackend
// teardown_command: rm -rf algorithmForSubscript algorithmForSubscript.exe algorithmForSubscript.c algorithmForSubscript_* algorithmForSubscript.makefile algorithmForSubscript.libs algorithmForSubscript.log output.log
//
// An array assigned with a computed subscript in a for loop. a[4] only occurs
// as a[i+1] on a left hand side, but is still an output of the algorithm.

loadString("
model algorithmForSubscript
  parameter Integer N = 4;
  Real a[N];
algorithm
  a[1] := 1.0;
  for i in 1:N-1 loop
    a[i+1] := a[i] + 1.0;
  end for;
end algorithmForSubscript;
"); getErrorString();

simulate(algorithmForSubscript, stopTime = 1); getErrorString();
val(a[1], 1);
val(a[2], 1);
val(a[3], 1);
val(a[4], 1);

