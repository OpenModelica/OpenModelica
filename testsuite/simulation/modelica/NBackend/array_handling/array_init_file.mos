// name: array_init_file
// keywords: NewBackend array iif initialization file
// status: correct
// suite: cSources
// teardown_command: rm -f array_init_file_first.mat
//
// Start values of non-scalarized array variables are imported from an
// initialization file (-iif), one value per element named `x[i,j]`.

loadString("
model array_init_file
  Real x[2,2](each start = 1, each fixed = true);
  discrete Integer k[2](start = {1, 2}, each fixed = true);
  discrete Boolean b[2](start = {false, true}, each fixed = true);
equation
  der(x) = {{1, 2}, {3, 4}};
  when x[1,1] > 1.5 then
    k = pre(k) + {10, 20};
    b = {true, false};
  end when;
end array_init_file;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();

simulate(array_init_file, stopTime=1.0, simflags="-r=array_init_file_first.mat"); getErrorString();

// start at the end of the first simulation
simulate(array_init_file, startTime=1.0, stopTime=1.0, simflags="-iif=array_init_file_first.mat -iit=1"); getErrorString();
val(x[1,1], 1.0);
val(x[1,2], 1.0);
val(x[2,1], 1.0);
val(x[2,2], 1.0);
val(k[1], 1.0);
val(k[2], 1.0);
val(b[1], 1.0);
val(b[2], 1.0);

// Result:
// true
// ""
// true
// ""
