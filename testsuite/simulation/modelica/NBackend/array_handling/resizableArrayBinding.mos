// name: resizableArrayBinding
// keywords: NewBackend resizable parameter binding
// status: correct
// cflags: --newBackend --resizableArrays
// suite: cSources
// teardown_command: rm -f resizableArrayBinding resizableArrayBinding_* resizableArrayBinding.log
//
// An array binding of a resizable array is only a start value if it is a
// scalar that can be repeated for every element.

loadString("
model resizableArrayBinding
  parameter Integer N = 3;
  parameter Real X[N + 1, 2] = fill({0.3, 0.7}, N + 1);
  Real y[N](each start = 0, each fixed = true);
equation
  for i in 1:N loop
    der(y[i]) = X[i + 1, 2] - y[i];
  end for;
end resizableArrayBinding;
"); getErrorString();

simulate(resizableArrayBinding, stopTime = 1, simflags = "-override=N=5"); getErrorString();
val(X[6, 2], 0);
val(y[5], 1);
// Result:
// true
// ""
