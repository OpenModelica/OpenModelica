// name: entwinedOrderResizable
// keywords: NewBackend entwined for-equation resizable
// status: correct
//
// Entwined for-equations are called in periods, in the order of the iterations
// for every size of resizable ranges, forward and backward, with scalar
// equations inside the chain. Without resizable ranges the same order is used.

loadString("
model entwinedForward
  parameter Integer N = 3;
  Real a[N], b[N];
equation
  a[1] = 0;
  for i in 1:N loop
    b[i] = a[i] + 1;
  end for;
  a[2] = b[1];
  for i in 2:N-1 loop
    b[i] = a[i + 1];
  end for;
end entwinedForward;

model entwinedBackward
  parameter Integer N = 5;
  Real a[N], b[N];
equation
  a[N] = 0;
  for i in 1:N loop
    b[i] = a[i] + 1;
  end for;
  a[N - 1] = b[N];
  for i in 2:N-1 loop
    b[i] = a[i - 1];
  end for;
end entwinedBackward;
"); getErrorString();
setCommandLineOptions("--newBackend --resizableArrays"); getErrorString();

simulate(entwinedForward, stopTime = 1); getErrorString();
val(a[3], 1);
val(b[3], 1);
simulate(entwinedForward, stopTime = 1, simflags = "-override=N=6"); getErrorString();
val(a[6], 1);
val(b[6], 1);

setCommandLineOptions("--resizableArrays=false"); getErrorString();
simulate(entwinedBackward, stopTime = 1); getErrorString();
val(a[1], 1);
val(b[1], 1);
