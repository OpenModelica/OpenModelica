// name: array_inputs
// keywords: NewBackend array input csvInput
// status: correct
// suite: cSources
// teardown_command: rm -f array_inputs.csv
//
// Non-scalarized array inputs get one value per element, from their start
// values or from an input file (-csvInput) with a column per element.

loadString("
model array_inputs
  input Real u[3](start = {1, 2, 3});
  input Real v(start = 5);
  Real x[3](each start = 0, each fixed = true);
  Real w;
equation
  der(x) = u;
  w = v;
end array_inputs;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();

// start values
simulate(array_inputs, stopTime=1.0); getErrorString();
val(x[1], 1.0);
val(x[2], 1.0);
val(x[3], 1.0);
val(w, 1.0);

// input file
writeFile("array_inputs.csv", "time,u[1],u[2],u[3],v\n0,1,10,100,2\n1,1,10,100,2\n"); getErrorString();
simulate(array_inputs, stopTime=1.0, simflags="-csvInput=array_inputs.csv"); getErrorString();
val(x[1], 1.0);
val(x[2], 1.0);
val(x[3], 1.0);
val(w, 1.0);

// Result:
