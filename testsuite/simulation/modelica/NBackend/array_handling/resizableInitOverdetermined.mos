// name: resizableInitOverdetermined
// keywords: NewBackend resizable initialization overdetermined
// status: correct
// cflags: --newBackend --resizableArrays
// teardown_command: rm -f resizableInitOverdetermined resizableInitOverdetermined_* resizableInitOverdetermined.log
//
// The iterations of a for-equation that remain after an overdetermined
// initialization is balanced have to be loops over the symbolic range.

loadString("
model resizableInitOverdetermined
  parameter Integer N = 6;
  Real x[N](each start = 1);
initial equation
  for i in 1:N loop
    x[i] = i;
  end for;
equation
  for i in 1:N - 1 loop
    der(x[i]) = -x[i] + x[i + 1];
  end for;
  x[N] = 2 + time;
end resizableInitOverdetermined;
"); getErrorString();

simulate(resizableInitOverdetermined, stopTime = 0.1, simflags = "-override=N=8"); getErrorString();
val(x[1], 0.0);
val(x[7], 0.0);
val(x[7], 0.1);
// Result:
