// name: resizableManySizes
// keywords: NewBackend resizable size table
// status: correct
// cflags: --newBackend --resizableArrays
// teardown_command: rm -f resizableManySizes_res.mat
//
// Three hundred parts, each with an array sized by its own parameter: every
// region after the first of those arrays starts at its own runtime-sized
// offset. The loops of the top model solve for variables placed behind all of
// them.

loadString("
package resizableManySizes
  model Part
    parameter Integer n = 1;
    Real x[n](each start = 1, each fixed = true);
  equation
    der(x) = -x;
  end Part;
end resizableManySizes;
"); getErrorString();
parts := "";
for i in 1:300 loop
  parts := parts + "  Part p" + String(i) + "(n = " + String(mod(i, 3) + 1) + ");\n";
end for;
loadString("within resizableManySizes;
model Many
" + parts + "  Real y(start = 1);
  Real a, b;
equation
  y^3 + y = p1.x[1] + p299.x[3];
  a + b = y;
  a - 2*b = p2.x[3];
end Many;
"); getErrorString();
simulate(resizableManySizes.Many, stopTime = 1, fileNamePrefix = "resizableManySizes"); getErrorString();
abs(val(y, 1, "resizableManySizes_res.mat") - 0.5600736263193281) < 1e-6;
abs(val(a, 1, "resizableManySizes_res.mat") - 0.49600890139087767) < 1e-6;
abs(val(b, 1, "resizableManySizes_res.mat") - 0.06406472492845044) < 1e-6;
abs(val(p299.x[3], 1, "resizableManySizes_res.mat") - 0.36787944117144233) < 1e-6;
// Result:
// true
// ""
// ""
//
// true
