// name: resizableFill
// keywords: NewBackend resizable fill array constructor
// status: correct
// cflags: --newBackend --resizableArrays
// suite: cSources
// teardown_command: rm -f resizableFill_32.mat resizableFill_32.log
//
// An array constructor with several iterators: the last iterator is the
// outermost dimension, a 2x3 matrix is not filled as 3x2.

loadString("
model resizableFill
  parameter Integer M = 2;
  parameter Integer N = 3;
  Real y = 1 + time;
  Real z[M, N];
equation
  z = fill(y, M, N);
end resizableFill;
"); getErrorString();

simulate(resizableFill, stopTime = 1); getErrorString();
{val(z[1,3], 1), val(z[2,1], 1), val(z[2,3], 1)};
system("./resizableFill -override=M=3,N=2 -r=resizableFill_32.mat", "resizableFill_32.log");
{val(z[3,1], 1, "resizableFill_32.mat"), val(z[1,2], 1, "resizableFill_32.mat"), val(z[3,2], 1, "resizableFill_32.mat")};
