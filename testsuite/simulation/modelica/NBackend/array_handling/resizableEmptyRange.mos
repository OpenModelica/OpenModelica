// name: resizableEmptyRange
// keywords: NewBackend resizable for-equation empty range
// status: correct
// cflags: --newBackend --resizableArrays
// suite: cSources
// teardown_command: rm -f resizableEmptyRange resizableEmptyRange_* resizableEmptyRange.log
//
// A for-equation over a resizable range that is empty at runtime (2:N-1 with
// N = 2) is not evaluated.

loadString("
model resizableEmptyRange
  parameter Integer N = 4;
  parameter Real V = 1, k = 1e-4;
  Real n[N](each start = 1, each fixed = true);
  Real rho[N], p[N];
  Real q[N + 1];
equation
  for i in 1:N loop
    der(n[i]) = q[i] - q[i + 1];
    p[i] = 287*300*rho[i];
  end for;
  rho[1] = 2*(N - 1)*n[1]/V;
  for i in 2:N - 1 loop
    rho[i] = (N - 1)*n[i]/V;
  end for;
  rho[N] = 2*(N - 1)*n[N]/V;
  q[1] = k*(2e5 - p[1]);
  for i in 1:N - 1 loop
    q[i + 1] = k*(p[i] - p[i + 1]);
  end for;
  q[N + 1] = 0.1 + time;
end resizableEmptyRange;
"); getErrorString();

buildModel(resizableEmptyRange, stopTime = 1); getErrorString();
system("./resizableEmptyRange -override=N=2", "resizableEmptyRange.log");
val(rho[2], 0, "resizableEmptyRange_res.mat");
val(n[2], 1, "resizableEmptyRange_res.mat");
// Result:
// true
// ""
// {"resizableEmptyRange", "resizableEmptyRange_init.xml"}
// ""
// 0
// 2.0
// 1.0502712607819775
// endResult
