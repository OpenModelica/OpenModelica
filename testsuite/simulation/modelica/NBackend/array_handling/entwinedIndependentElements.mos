// name: entwinedIndependentElements
// keywords: NewBackend entwined for-equation resizable
// status: correct
//
// A scalar equation entwines a resizable for-equation whose other elements
// are independent. Sorting can call them in any order, the entwined component
// needs the order of the iterations.

loadString("
model entwinedStart
  parameter Integer N = 8;
  Real x[N], y[N];
equation
  x[1] = 10*time;
  x[2] = 10;
  x[3] = y[2];
  for i in 4:N loop
    x[i] = time*i;
  end for;
  for i in 1:N loop
    y[i] = 10*x[i];
  end for;
end entwinedStart;

model entwinedEnd
  parameter Integer N = 8;
  Real x[N], y[N];
equation
  x[N] = 10*time;
  x[N - 1] = 10;
  x[N - 2] = y[N - 1];
  for i in 1:N-3 loop
    x[i] = time*i;
  end for;
  for i in 1:N loop
    y[i] = 10*x[i];
  end for;
end entwinedEnd;
"); getErrorString();
setCommandLineOptions("--newBackend --resizableArrays"); getErrorString();

simulate(entwinedStart, stopTime = 1); getErrorString();
val(y[3], 1);
val(y[8], 1);
simulate(entwinedStart, stopTime = 1, simflags = "-override=N=12"); getErrorString();
val(y[3], 1);
val(y[12], 1);

simulate(entwinedEnd, stopTime = 1); getErrorString();
val(y[6], 1);
val(y[1], 1);
simulate(entwinedEnd, stopTime = 1, simflags = "-override=N=12"); getErrorString();
val(y[10], 1);
val(y[1], 1);
