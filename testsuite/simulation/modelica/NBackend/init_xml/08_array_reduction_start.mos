// name: 08_array_reduction_start
// keywords: NewBackend array start init.xml
// status: correct
// suite: cSources
//
// Start values given by an array constructor with an array body.

loadString("
model array_reduction_start
  parameter Real a[3, 2] = array({1.0, 2.0} for i in 1:3) annotation(Evaluate = false);
  parameter Real b[4, 3, 2] = array(array({5.0, 6.0} for i in 1:3) for j in 1:4) annotation(Evaluate = false);
  Real x = a[3, 2] + b[4, 3, 1];
end array_reduction_start;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();
simulate(array_reduction_start, stopTime = 0); getErrorString();
val(x, 0);

