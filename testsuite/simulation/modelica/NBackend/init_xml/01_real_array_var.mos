// name: 01_real_array_var
// keywords: NewBackend
// status: correct
// suite: cSources
// teardown_command: rm -f *RealArrayVariable*
//
// Check if init XML has array variable for x with size=5

setCommandLineOptions("--newBackend --simCodeScalarize=false");

loadString("
model RealArrayVariable
  parameter Integer p = 5;
  Real x[p];
equation
  for i in 1:p loop
    x[i] = i;
  end for;
end RealArrayVariable;
"); getErrorString();

buildModel(RealArrayVariable); getErrorString();

// Life's too short to learn regex. LLM to the rescue!
initFileContent := readInitFile("RealArrayVariable_init.bin");

// Result:
// true
// true
// ""
// {"RealArrayVariable", "RealArrayVariable_init.bin"}
// ""
// "model RealArrayVariable
// sizes numberOfRealAlgebraicVariables=1 numberOfIntegerParameters=1
// experiment startTime=0.0 stopTime=1.0 stepSize=0.002 tolerance=1e-6 solver=dassl outputFormat=mat variableFilter=\".*\"
// rAlg x Real continuous hideResult=false dimensions=[5]
// iPar p Integer parameter causality=parameter changeable fixed hideResult=false start=5
// "
// endResult
