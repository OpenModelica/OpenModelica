// name: zeroSizeRecordField
// keywords: NewBackend record zero size array
// status: correct
// suite: cSources
//
// A record equation with a zero size array field must not fail when resolving its skips.

loadString("
model ZeroSizeRecordField
  record R
    Real a;
    Real x[0];
    Real b;
  end R;
  parameter R p(a = 1, x = zeros(0), b = 2);
  R r1;
  R r2;
equation
  r1 = p;
  r2.a = time * r1.b;
  r2.x = r1.x;
  r2.b = r2.a + r1.a;
end ZeroSizeRecordField;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(ZeroSizeRecordField); getErrorString();
val(r2.b, 1.0);

