// name: recordConstantArgument
// keywords: NewBackend
// status: correct

loadString("
package RecordConstantArgument
  record Base
    constant Boolean fixed;
    constant Integer ncp(min=1);
    final constant Integer nc = if fixed then 1 else ncp;
    parameter Real w[ncp] = ones(ncp);
  end Base;
  record Sub
    extends Base(final fixed = false, final ncp = 2, final w = {1, 2});
  end Sub;
  function inlined
    input Base b;
    input Real x;
    output Real y;
  algorithm
    y := x * sum(b.w) + b.nc;
  end inlined;
  function notInlined
    input Base b;
    input Real x;
    output Real y;
  algorithm
    y := 0;
    for i in 1:b.ncp loop
      y := y + x * b.w[i];
    end for;
    y := y + b.nc;
  end notInlined;
  model M
    parameter Sub s;
    parameter Base t = Sub();
    Real y1 = inlined(s, time);
    Real y2 = notInlined(t, time);
  end M;
end RecordConstantArgument;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(RecordConstantArgument.M); getErrorString();
val(y1, 1);
val(y2, 1);
