// name: nestedRecordBinding
// keywords: NewBackend records
// status: correct
//
// A record parameter bound to another record parameter, where the record
// contains a nested record with array fields. The nested record was assigned
// as a whole in the generated algorithm and the C code did not compile.

setCommandLineOptions("--newBackend"); getErrorString();

loadString("
  record Eff
    parameter Real y[3] = {0.1, 0.5, 1.0};
    parameter Real eta[3] = {0.5, 0.8, 0.9};
  end Eff;

  record Per
    parameter Boolean have = false;
    parameter Real speeds[1] = {1.0};
    parameter Eff eff = Eff();
  end Per;

  model Inner
    parameter Per per;
    Real x(start = 0, fixed = true);
  equation
    der(x) = per.speeds[1] * sum(per.eff.y);
  end Inner;

  model nestedRecordBinding
    parameter Per per = Per();
    Inner inn(per = per);
    Real z;
  equation
    z = inn.x;
  end nestedRecordBinding;
"); getErrorString();

simulate(nestedRecordBinding, stopTime=1.0); getErrorString();
val(z, 1.0);

