// name: constantRecordField
// keywords: NewBackend record constant
// status: correct
// suite: cSources
//
// Record bindings must not assign constant fields, they have no storage.

loadString("
model ConstantRecordField
  record R
    Real a;
    constant Integer n = 2;
    constant Real c = 1.5;
  end R;
  parameter R p(a = 2);
  parameter R q = p;
  Real x(start = 1, fixed = true);
equation
  der(x) = -q.a * q.c * x / q.n;
end ConstantRecordField;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(ConstantRecordField); getErrorString();
val(x, 1.0);

