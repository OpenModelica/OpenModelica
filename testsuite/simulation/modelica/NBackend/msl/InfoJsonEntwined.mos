// name: InfoJsonEntwined
// keywords: NewBackend, msl, info.json
// status: correct
//
// The single calls of entwined for-loops are listed once in the
// _info.json. -emit_protected makes the runtime parse it.

loadModel(Modelica, {"4.1.0"}); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(Modelica.StateGraph.Examples.ShowCompositeStep, simflags="-emit_protected"); getErrorString();

