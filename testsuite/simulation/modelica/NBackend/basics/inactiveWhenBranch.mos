// name: inactiveWhenBranch
// keywords: NewBackend, discrete, state
// status: correct
//
// x is only assigned in a when-equation of an inactive if-branch with a parameter condition.
// It is not discrete, the derivative in the active branch must not become zero. x = 1 - exp(-t).

loadString("
model inactiveWhenBranch
  parameter Real Ts = 0;
  Real x(start = 0, fixed = true);
equation
  if Ts > 0 then
    when sample(0, Ts) then
      x = pre(x) + Ts * (1 - pre(x));
    end when;
  else
    der(x) = 1 - x;
  end if;
end inactiveWhenBranch;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(inactiveWhenBranch); getErrorString();
val(x, 1);

