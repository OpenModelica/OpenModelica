// name: algebraicPartitionElements
// keywords: NewBackend
// status: correct
// teardown_command: rm -f SplitArrayVariable SplitArrayVariable_* SplitArrayVariable.log
//
// Only y[1] is needed for der(x). The partitions get whole variables,
// y must not be split into the ODE and an algebraic partition, otherwise
// the ODE Jacobian misses the dependency on y[1].

loadString("
model SplitArrayVariable
  Real x(start = 1, fixed = true);
  Real y[2];
equation
  y[1] = x + x^3;
  y[2] = cos(x);
  der(x) = -1e4 * y[1];
end SplitArrayVariable;
"); getErrorString();

setCommandLineOptions("--newBackend -d=backenddaeinfo"); getErrorString();
simulate(SplitArrayVariable); getErrorString();
val(y[2], 1);
