// name: loadResource
// keywords: NewBackend, modelica://
// status: correct
//
// The simulation resolves a modelica:// URI with the classes the compiler has
// loaded.

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadString("
model M
  Real J;
equation
  // depends on time, so that the simulation resolves the URI
  J = Modelica.Utilities.Examples.readRealParameter(Modelica.Utilities.Files.loadResource(
    if time < 10 then \"modelica://Modelica/Resources/Data/Utilities/Examples_readRealParameters.txt\"
    else \"modelica://Modelica/Resources/Data/Utilities/Examples_readRealParameters2.txt\"), \"J\");
end M;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(M, stopTime = 0); getErrorString();
val(J, 0);

// Result:
// true
// ""
// true
