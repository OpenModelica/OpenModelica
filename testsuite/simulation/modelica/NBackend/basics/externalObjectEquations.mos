// name: externalObjectEquations
// keywords: NewBackend, external object
// status: correct
// teardown_command: rm -f ExternalObjectEquations.Chain*
//
// External objects passed on by equations, also through elements of
// connector arrays, are assigned in the initialization before they are used.

loadModel(Modelica, {"4.1.0"}); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();

loadString("
package ExternalObjectEquations
  connector TableIn
    input Modelica.Blocks.Types.ExternalCombiTable1D tab;
  end TableIn;

  connector TableOut
    output Modelica.Blocks.Types.ExternalCombiTable1D tab;
  end TableOut;

  block Source
    TableOut tableOut(tab = Modelica.Blocks.Types.ExternalCombiTable1D(\"NoName\", \"NoName\", [0, 0; 1, 2], {2},
      Modelica.Blocks.Types.Smoothness.LinearSegments, Modelica.Blocks.Types.Extrapolation.LastTwoPoints, false));
  end Source;

  block Pass
    parameter Integer n = 1;
    TableIn tableIn;
    TableOut tableOut[n];
  equation
    tableOut.tab = fill(tableIn.tab, n);
  end Pass;

  block Eval
    TableIn tableIn;
    Real y = Modelica.Blocks.Tables.Internal.getTable1DValueNoDer(tableIn.tab, 1, time);
    parameter Boolean useTable = true;
    Integer n;
  equation
    when initial() then
      n = if useTable then integer(Modelica.Blocks.Tables.Internal.getTable1DAbscissaUmax(tableIn.tab)) else -1;
    end when;
  end Eval;

  model Chain
    Source source;
    Pass pass1;
    Pass pass2;
    Eval eval;
  equation
    connect(source.tableOut, pass1.tableIn);
    connect(pass1.tableOut[1], pass2.tableIn);
    connect(pass2.tableOut[1], eval.tableIn);
  end Chain;
end ExternalObjectEquations;
"); getErrorString();

simulate(ExternalObjectEquations.Chain, stopTime = 1); getErrorString();
val(eval.y, 0.5);
val(eval.y, 1);
val(eval.n, 1);
// Result:
