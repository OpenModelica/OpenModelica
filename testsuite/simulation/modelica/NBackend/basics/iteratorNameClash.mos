// name: iteratorNameClash
// keywords: NewBackend
// status: correct
// An array constructor iterator with the name of a parameter.

loadString("
model IteratorNameClash
  parameter Real k = 10;
  parameter Real p[3] = {sin(-k*0.1) for k in 1:3};
  Real y[3] = {sin(time + k) for k in 1:3};
  Real z = k*time;
end IteratorNameClash;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(IteratorNameClash); getErrorString();
val(p[2], 0.0);
val(y[2], 1.0);
val(z, 1.0);
