// name: algebraicPartition
// keywords: NewBackend
// status: correct
// teardown_command: rm -f AlgebraicOutputs AlgebraicOutputs_* AlgebraicOutputs.log
//
// k is not needed for der(x) or an event, it moves to an algebraic partition
// and is only evaluated for the output. e is needed for the event and stays.

loadString("
model AlgebraicOutputs
  Real x(start = 1);
  Real k;
  Real e;
  Integer cnt(start = 0, fixed = true);
equation
  der(x) = -x;
  k = sin(x);
  e = 2 * x;
  when e < 1 then
    cnt = pre(cnt) + 1;
  end when;
end AlgebraicOutputs;
"); getErrorString();

setCommandLineOptions("--newBackend -d=backenddaeinfo"); getErrorString();
buildModel(AlgebraicOutputs); getErrorString();
system("./AlgebraicOutputs", "AlgebraicOutputs.log");
val(k, 1, "AlgebraicOutputs_res.mat");
val(cnt, 1, "AlgebraicOutputs_res.mat");
