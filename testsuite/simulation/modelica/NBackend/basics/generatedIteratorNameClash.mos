// name: generatedIteratorNameClash
// keywords: NewBackend
// status: correct
// The frontend names the iterators of vectorized calls $i0, $i1, ... and
// the for-loop iterator is renamed to $i1. Run first in a new omc, an
// earlier instantiation gives other iterator names.

loadString("
model GeneratedIteratorNameClash
  Real x[3](each start = 1, each fixed = true);
  Real z[3] = {1, 2, 3} * time;
  Real y[3, 3];
  Real w[3, 3];
equation
  for i in 1:3 loop
    der(x[i]) = -x[i];
    y[i, :] = sqrt(z) * x[i];
    w[i, :] = exp(z) * x[i];
  end for;
end GeneratedIteratorNameClash;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(GeneratedIteratorNameClash); getErrorString();
val(y[2, 3], 1.0);
val(w[2, 3], 1.0);
// Result:
// true
// ""
// true
// ""
