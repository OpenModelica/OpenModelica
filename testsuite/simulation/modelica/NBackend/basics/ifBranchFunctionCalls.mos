// name: ifBranchFunctionCalls
// keywords: NewBackend
// status: correct
// Function calls in if-expression branches are only evaluated if the branch is active.

loadString("
model IfBranchFunctionCalls
  parameter Real dp = 0;
  parameter Real kFixed = if dp > 0 then 1/sqrt(dp) else 0;
  parameter Real k = if dp > 0 then sqrt(1/(1/kFixed^2 + 1)) else 1;
  Real x = time - 0.5;
  Real y = if x > 0 then log(x) else 0;
end IfBranchFunctionCalls;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(IfBranchFunctionCalls); getErrorString();
val(k, 0.0);
val(y, 0.25);
val(y, 1.0);
