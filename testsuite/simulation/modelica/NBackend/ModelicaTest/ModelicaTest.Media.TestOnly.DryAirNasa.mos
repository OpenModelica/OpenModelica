// name: ModelicaTest.Media.TestOnly.DryAirNasa
// keywords: NewBackend
// status: correct

loadModel(ModelicaTest, {"4.0.0"});getErrorString();

simulate(ModelicaTest.Media.TestOnly.DryAirNasa, fileNamePrefix="ModelicaTest.Media.TestOnly.DryAirNasa_ref"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(ModelicaTest.Media.TestOnly.DryAirNasa); getErrorString();
diffSimulationResults("ModelicaTest.Media.TestOnly.DryAirNasa_res.mat", "ModelicaTest.Media.TestOnly.DryAirNasa_ref_res.mat", "ModelicaTest.Media.TestOnly.DryAirNasa_diff.csv", 1e-8);

