// name: ifNoEventCondition
// keywords: NewBackend, events, noEvent, if equation
// status: correct
//
// The condition of an if equation in noEvent() is evaluated directly. It was
// replaced by a zero crossing that only changed at events, so the else branch
// divided by w = 0 (like Modelica.Thermal.FluidHeatFlow.Sources.IdealPump).

loadString("
model ifNoEventCondition
  Real w = noEvent(max(0, 1 - 2 * time));
  Real tau;
equation
  if noEvent(abs(w) < 1e-10) then
    tau = 0;
  else
    tau * w = w ^ 2;
  end if;
end ifNoEventCondition;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(ifNoEventCondition, simflags="-lv=LOG_EVENTS"); getErrorString();
val(tau, 0.25); val(tau, 1);

// Result:
