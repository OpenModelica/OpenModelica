// name: discreteSampleCondition
// keywords: NewBackend
// status: correct
// sample() combined with a purely discrete condition is a composite time event.

loadString("
model DiscreteSampleCondition
  parameter Integer n = 3;
  Integer np(start = 0, fixed = true);
  Boolean sampling;
equation
  sampling = n > pre(np);
  when sampling and sample(0.1, 0.1) then
    np = pre(np) + 1;
  end when;
end DiscreteSampleCondition;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(DiscreteSampleCondition); getErrorString();
val(np, 0.25);
val(np, 1.0);
