// name: whenIfStatements
// keywords: NewBackend when if noretcall assert reinit elsewhen
// status: correct
// cflags: --newBackend
//
// Function calls, asserts, terminate and reinit inside if-equations of a
// when-equation (#13988, #12448): they are lowered into a when-algorithm
// next to the assignments of the if-equation.

loadString("
package whenIfStatements
  function pr
    input String s;
    external \"C\" ModelicaMessage(s) annotation(Include=\"#include \\\"ModelicaUtilities.h\\\"\");
  end pr;

  model IfCall
    Real x(start = 0, fixed = true);
    discrete Integer k(start = 0, fixed = true);
  equation
    der(x) = 1;
    when x > 0.5 then
      k = 1;
      if x > 0.7 then
        pr(\"late\\n\");
      else
        pr(\"early\\n\");
      end if;
    end when;
  end IfCall;

  model Mixed
    Real x(start = 0, fixed = true);
    discrete Integer k(start = 0, fixed = true);
    discrete Integer m(start = 0, fixed = true);
    parameter Boolean b = true;
  equation
    der(x) = 1;
    when x > 0.3 then
      m = 0;
      if x < 0.2 then
        k = 1;
        pr(\"never\\n\");
        terminate(\"never\");
      elseif b then
        k = 2;
        reinit(x, 0.35);
      else
        k = 3;
      end if;
    elsewhen x > 0.5 then
      k = 4;
      if x > 0.4 then
        assert(x > 0.45, \"x too small\");
        pr(\"second branch\\n\");
      end if;
      m = 1;
    end when;
  end Mixed;
end whenIfStatements;
"); getErrorString();

simulate(whenIfStatements.IfCall); getErrorString();
val(k, 1);
simulate(whenIfStatements.Mixed); getErrorString();
val(k, 0.35);
val(x, 0.31);
val(k, 0.8);
val(m, 0.8);
