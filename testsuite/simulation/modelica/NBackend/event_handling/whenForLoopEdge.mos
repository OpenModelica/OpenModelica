// name: whenForLoopEdge
// keywords: NewBackend
// status: correct
// When-equations in for-loops are only active when a condition becomes true.

loadString("
model WhenForLoopEdge
  Real x[3](each start = 0, each fixed = true);
  Integer n[3](each start = 0, each fixed = true);
  Integer m[3](each start = 0, each fixed = true);
equation
  for i in 1:3 loop
    der(x[i]) = i;
    when x[i] > 0.5 then
      n[i] = pre(n[i]) + 1;
    end when;
    when {x[i] > 0.5, x[i] > 1.5} then
      m[i] = pre(m[i]) + 1;
    end when;
  end for;
end WhenForLoopEdge;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(WhenForLoopEdge); getErrorString();
val(n[1], 1.0);
val(m[1], 1.0);
val(m[2], 1.0);
