// name: algorithmLocalBuffer
// keywords: NewBackend, algorithm, protected, #13604
// status: correct
//
// The protected buffer buf is only used by one algorithm. It is not part of the
// system, like a protected variable of a function, but keeps its values between
// the invocations of the algorithm (MLS 11.1.2). k uses pre() and stays in the system.

loadString("
model algorithmLocalBuffer
  parameter Integer n = 5;
  output Real s(start = 0, fixed = true);
protected
  Real buf[n](start = zeros(n), each fixed = true);
  Integer k(start = 0, fixed = true);
algorithm
  when sample(0.1, 0.1) then
    k := pre(k) + 1;
    if k <= n then
      buf[k] := time;
    end if;
    s := sum(buf);
  end when;
end algorithmLocalBuffer;
"); getErrorString();

setCommandLineOptions("--newBackend -d=backenddaeinfo,discreteinfo"); getErrorString();

simulate(algorithmLocalBuffer, stopTime = 1, simflags="-emit_protected"); getErrorString();
val(s, 0.35); val(s, 1.0); val(k, 1.0); val(buf[3], 1.0); getErrorString();

