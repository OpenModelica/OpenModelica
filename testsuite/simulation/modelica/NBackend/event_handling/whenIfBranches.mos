// name: whenIfBranches
// keywords: NewBackend when if-equation
// status: correct
// suite: cSources
//
// If-equations in when-equations can be nested, and branches can assign an
// array as a whole in one branch and as slices in another one.

loadString("
  model whenIfBranches
    discrete Real a(start = 0, fixed = true);
    discrete Real b(start = 0, fixed = true);
    Boolean g[4](each start = false, each fixed = true);
    Integer n(start = 0, fixed = true);
  equation
    when sample(0.1, 0.1) then
      n = pre(n) + 1;
      if n > 3 then
        a = pre(a) + 1;
        if n > 6 then
          b = 2;
        else
          b = 1;
        end if;
      else
        a = pre(a);
        b = 0;
      end if;
      if mod(n, 2) == 0 then
        g[{1, 2}] = pre(g[{2, 1}]);
        g[{3, 4}] = {true, false};
      else
        g = pre(g);
      end if;
    end when;
  end whenIfBranches;
"); getErrorString();

setCommandLineOptions("--newBackend");
simulate(whenIfBranches); getErrorString();
{val(a, 1.0), val(b, 0.35), val(b, 0.55), val(b, 0.75)};
{val(g[3], 0.15), val(g[3], 0.25), val(g[4], 1.0)};

// Result:
