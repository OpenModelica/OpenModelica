// name: algorithmWhenNoOutputs
// keywords: NewBackend when elsewhen algorithm events
// status: correct
// cflags: --newBackend
//
// A when-elsewhen statement in an algorithm without outputs (#17192): the
// conditions are computed by equations of their own in the simulation system.

loadString("
model algorithmWhenNoOutputs
  function pr
    input String s;
    external \"C\" ModelicaMessage(s) annotation(Include=\"#include \\\"ModelicaUtilities.h\\\"\");
  end pr;
  Real x(start = 0, fixed = true);
equation
  der(x) = 1;
algorithm
  when x > 0.3 then
    pr(\"a\\n\");
  elsewhen x > 0.5 then
    pr(\"b\\n\");
  end when;
end algorithmWhenNoOutputs;
"); getErrorString();

simulate(algorithmWhenNoOutputs); getErrorString();
