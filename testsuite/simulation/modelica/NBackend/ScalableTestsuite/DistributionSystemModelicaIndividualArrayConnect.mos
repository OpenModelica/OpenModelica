// name: DistributionSystemModelicaIndividualArrayConnect
// keywords: NewBackend, resizable, arrayConnect, mergeComponents
// status: correct
//
// -d=mergeComponents collects the components into arrays but keeps their
// connections scalar (literal indices). They are resolved by the scalar
// connection handler: the array handlers split the connector arrays into one
// piece per element, --resizableArrays failed above 300 elements
// ($Resistor2 has 820) and -d=arrayConnect alone did not finish (#17368).

setCommandLineOptions("--newBackend --resizableArrays -d=arrayConnect,mergeComponents"); getErrorString();
loadModel(ScalableTestSuite); getErrorString();
checkModel(ScalableTestSuite.Electrical.DistributionSystemDC.ScaledExperiments.DistributionSystemModelicaIndividual_N_20_M_20); getErrorString();
setCommandLineOptions("--resizableArrays=false"); getErrorString();
checkModel(ScalableTestSuite.Electrical.DistributionSystemDC.ScaledExperiments.DistributionSystemModelicaIndividual_N_20_M_20); getErrorString();
