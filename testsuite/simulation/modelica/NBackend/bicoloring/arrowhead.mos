// name: arrowhead
// keywords: NewBackend
// status: correct
// cflags: --newBackend --generateDynamicJacobian=bidirectional

loadString("
  model arrowhead
    parameter Integer n = 3;
    Real x[n](each start=1);
  equation
    der(x[1]) = sum(x);
    for i in 2:n loop
      der(x[i]) = x[i] + x[1];
    end for;
  end arrowhead;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=bidirectional"); getErrorString();
simulate(arrowhead, stopTime=1e-5, numberOfIntervals=1, simflags="-s=dassl -jacobian=bicoloredSymbolical -lv=LOG_JAC"); getErrorString();

