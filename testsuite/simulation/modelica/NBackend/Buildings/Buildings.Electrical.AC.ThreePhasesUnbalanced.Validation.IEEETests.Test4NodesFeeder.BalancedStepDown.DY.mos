simulate(Buildings.Electrical.AC.ThreePhasesUnbalanced.Validation.IEEETests.Test4NodesFeeder.BalancedStepDown.DY); getErrorString();
val(loadRL.load2.i[1], 1.0);
val(line1.i1[1], 1.0);

