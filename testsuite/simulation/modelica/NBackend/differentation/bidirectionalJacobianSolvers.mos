// name: bidirectionalJacobianSolvers
// keywords: NewBackend, differentiation, jacobian, adjoint, bidirectional, solver
// status: correct
//
// Checks that DASSL, IDA and GBODE all support the shared symbolic Jacobian evaluation
// modes (coloredSymbolical, coloredSymbolicalAdjoint, bicoloredSymbolical) and that all
// of them produce the same simulation result. The model has a strongly non-symmetric
// Jacobian, so a transposed/mixed up Jacobian would change the result.

loadString("
model bidirectionalJacobianSolvers
  Real x(start = 1.0, fixed = true);
  Real y(start = 1.0, fixed = true);
equation
  der(x) = -10.0*x + 1000.0*y;
  der(y) = -x;
end bidirectionalJacobianSolvers;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=bidirectional"); getErrorString();

buildModel(bidirectionalJacobianSolvers, stopTime = 1.0, tolerance = 1e-10); getErrorString();

system("./bidirectionalJacobianSolvers -s=dassl -jacobian=coloredNumerical -r=ref.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt"); // log file should be empty

// dassl
system("./bidirectionalJacobianSolvers -s=dassl -jacobian=coloredSymbolical -r=dassl_fwd.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");
system("./bidirectionalJacobianSolvers -s=dassl -jacobian=coloredSymbolicalAdjoint -r=dassl_adj.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");
system("./bidirectionalJacobianSolvers -s=dassl -jacobian=bicoloredSymbolical -r=dassl_bi.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");

// ida
system("./bidirectionalJacobianSolvers -s=ida -jacobian=coloredSymbolical -r=ida_fwd.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");
system("./bidirectionalJacobianSolvers -s=ida -jacobian=coloredSymbolicalAdjoint -r=ida_adj.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");
system("./bidirectionalJacobianSolvers -s=ida -jacobian=bicoloredSymbolical -r=ida_bi.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");

// gbode
system("./bidirectionalJacobianSolvers -s=gbode -jacobian=coloredSymbolical -r=gbode_fwd.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");
system("./bidirectionalJacobianSolvers -s=gbode -jacobian=coloredSymbolicalAdjoint -r=gbode_adj.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");
system("./bidirectionalJacobianSolvers -s=gbode -jacobian=bicoloredSymbolical -r=gbode_bi.mat -lv=-LOG_SUCCESS > log.txt 2>&1");
readFile("log.txt");

diffSimulationResults("dassl_fwd.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("dassl_adj.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("dassl_bi.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("ida_fwd.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("ida_adj.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("ida_bi.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("gbode_fwd.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("gbode_adj.mat", "ref.mat", "diff", vars = {"x", "y"});
diffSimulationResults("gbode_bi.mat", "ref.mat", "diff", vars = {"x", "y"});

