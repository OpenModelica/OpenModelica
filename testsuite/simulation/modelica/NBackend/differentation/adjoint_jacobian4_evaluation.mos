// name: adjoint_jacobian4_evaluation
// keywords: NewBackend, differentiation, jacobian, adjoint
// status: correct

loadString("
model AdjointJacobian4Evaluation
  parameter Integer N = 3;
  parameter Real v0 = 1;
  Real v(start=v0, fixed=true), w, y, z, a, b, c;
  Real x[N](each start=1, each fixed=true);
equation
  if v > 1.5 then
    w = v^2;
  else
    w = 0.5;
  end if;
  y + 3*z + cos(time) = 0;
  z + y/4 + v = 0;
  der(v) = y - 0.1*v + w + c;
  der(x[1]) = 1.0;
  for i in 2:N loop
    der(x[i]) = i*x[i-1];
  end for;
algorithm
  a := v*2.0;
  b := y + z;
  c := x[N] + a;
end AdjointJacobian4Evaluation;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=bidirectional"); getErrorString();
buildModel(AdjointJacobian4Evaluation, stopTime=1e-5, numberOfIntervals=1, tolerance=1e-6); getErrorString();

// Print the analytical Jacobian and its numerical comparison for both branches.
simulate(AdjointJacobian4Evaluation, simflags="-s=dassl -jacobian=coloredSymbolical -initialStepSize=1e-5 -lv=LOG_JAC -override=v0=1", resimulateExecutable="AdjointJacobian4Evaluation");
simulate(AdjointJacobian4Evaluation, simflags="-s=dassl -jacobian=coloredSymbolical -initialStepSize=1e-5 -lv=LOG_JAC -override=v0=2", resimulateExecutable="AdjointJacobian4Evaluation");
simulate(AdjointJacobian4Evaluation, simflags="-s=dassl -jacobian=coloredSymbolicalAdjoint -initialStepSize=1e-5 -lv=LOG_JAC -override=v0=1", resimulateExecutable="AdjointJacobian4Evaluation");
simulate(AdjointJacobian4Evaluation, simflags="-s=dassl -jacobian=coloredSymbolicalAdjoint -initialStepSize=1e-5 -lv=LOG_JAC -override=v0=2", resimulateExecutable="AdjointJacobian4Evaluation");

