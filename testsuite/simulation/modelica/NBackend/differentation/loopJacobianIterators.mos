// name: loopJacobianIterators
// keywords: NewBackend, differentiation, jacobian, sparsity, algebraic loop
// status: correct
// teardown_command: rm -f loopJacobianIterators_*
//
// The rows of an algebraic loop are its variables. The iterators of its
// for-equations do not select a row and their dependencies are all elements.

setCommandLineOptions("--newBackend --tearingMethod=minimalTearing"); getErrorString();

loadString("
model loopJacobianIterators
  Real x[3](each start = 1, each fixed = true);
  Real y(start = 0);
equation
  y + 0.1*sin(y*der(x[2])) = der(x[1]) + der(x[3]) + x[2];
  for i in 1:3 loop
    der(x[i]) + 0.1*sin(der(x[i])*y) = -i*x[i];
  end for;
end loopJacobianIterators;
"); getErrorString();

simulate(loopJacobianIterators, stopTime = 1); getErrorString();
val(x[1], 1);
val(x[3], 1);
// Result:
// true
// ""
// true
