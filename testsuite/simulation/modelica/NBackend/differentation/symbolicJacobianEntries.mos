// name: symbolicJacobianEntries
// keywords: NewBackend, differentiation, jacobian, adjoint, bidirectional, coloring, permutation
// status: correct
// teardown_command: rm -rf jacobianEntryPermutation*
//
// Regression test for the row/column *placement* and deterministic ordering of
// the colored symbolic Jacobian evaluation paths.
// The invariant is that the generated seed/result variable order matches the
// solver's x1,x2,x3,x4 state order exactly.
//
// It deliberately does NOT look at simulation trajectories: a row/column permuted
// Jacobian still produces trajectories that match the reference solution (only the
// Newton convergence degrades), which is why symbolicJacobianEvaluation.mos cannot
// detect such a bug.
//
// Instead the actual numerical Jacobian entries that DASSL reports via LOG_JAC are
// compared for
//   -jacobian=symbolical               (uncolored forward evaluation -> trusted reference)
//   -jacobian=coloredSymbolical        (forward / column mode, column coloring)
//   -jacobian=coloredSymbolicalAdjoint (adjoint / row mode, row coloring)
//   -jacobian=bicoloredSymbolical      (star bicoloring, column + row phase)
// All four must return the very same matrix.  The uncolored `symbolical` evaluation
// uses neither the sparsity pattern nor any coloring and therefore is an independent
// reference for the three colored variants.
//
// The model has a non-symmetric sparsity pattern
//
//        d der(x)/dx  =  [  0   2   0   3 ]
//                        [  5   0   7   0 ]
//                        [  0  11   0  13 ]
//                        [ 17   0  19   0 ]
//
// with pairwise distinct entries, so that any row permutation, column permutation
// or transposition relocates a distinct value and is immediately visible.  Scalar
// (non-array) states are used on purpose: the adjoint seed variables are held in a
// plain list, so only a scalar model can expose an ordering error in that list.
//
// The "Jacobian verification: analytical vs. numerical" block additionally compares
// the emitted matrix against DASSL's own finite difference Jacobian, which is by
// construction indexed by the state vector.  It therefore also pins down that the
// jacobian rows and columns are ordered like the state vector and not like the
// partition unknowns; the remaining difference is pure finite difference noise.
//
// Note: DASSL prints pd = J - cj*I, so the diagonal carries the -cj term.
// -initialStepSize pins the step size, hence cj (= 1e5) and the single reported
// Jacobian are reproducible.

loadString("
model jacobianEntryPermutation
  Real x1(start = 1.0, fixed = true);
  Real x2(start = 2.0, fixed = true);
  Real x3(start = 3.0, fixed = true);
  Real x4(start = 4.0, fixed = true);
equation
  der(x1) =  2.0*x2 +  3.0*x4;
  der(x2) =  5.0*x1 +  7.0*x3;
  der(x3) = 11.0*x2 + 13.0*x4;
  der(x4) = 17.0*x1 + 19.0*x3;
end jacobianEntryPermutation;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=bidirectional"); getErrorString();

buildModel(jacobianEntryPermutation, stopTime = 1e-5, numberOfIntervals = 1, tolerance = 1e-6); getErrorString();

// uncolored forward evaluation - independent reference
simulate(jacobianEntryPermutation, simflags="-s=dassl -jacobian=symbolical -initialStepSize=1e-5 -lv=LOG_JAC", resimulateExecutable="jacobianEntryPermutation");

// colored forward (column) evaluation
simulate(jacobianEntryPermutation, simflags="-s=dassl -jacobian=coloredSymbolical -initialStepSize=1e-5 -lv=LOG_JAC", resimulateExecutable="jacobianEntryPermutation");

// colored adjoint (row) evaluation
simulate(jacobianEntryPermutation, simflags="-s=dassl -jacobian=coloredSymbolicalAdjoint -initialStepSize=1e-5 -lv=LOG_JAC", resimulateExecutable="jacobianEntryPermutation");

// bidirectional (star bicoloring) evaluation
simulate(jacobianEntryPermutation, simflags="-s=dassl -jacobian=bicoloredSymbolical -initialStepSize=1e-5 -lv=LOG_JAC", resimulateExecutable="jacobianEntryPermutation");

// Result:
// true
// ""
// true
// ""
// {"jacobianEntryPermutation", "jacobianEntryPermutation_init.xml"}
// ""
// record SimulationResult
