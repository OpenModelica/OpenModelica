// name: higherFunctionDerivative
// keywords: NewBackend
// status: correct
// Second and third derivatives of functions. The time derivative of a
// derivative function also differentiates the inputs of the first derivative,
// for a generated derivative (#18448) and for a derivative annotation (#18493).
// In ConstrainedPoint, solve and the Jacobian need a derivative with a zero
// derivative of p, which is another function.

loadString("
package HigherFunctionDerivative
  function f
    input Real x;
    output Real y;
  algorithm
    y := x^3;
    annotation(Inline = false);
  end f;

  function f4
    input Real x;
    output Real y;
  algorithm
    y := x^4;
    annotation(Inline = false);
  end f4;

  function g
    input Real x;
    input Real z;
    output Real y;
  algorithm
    y := x^2*z;
    annotation(Inline = false);
  end g;

  function h
    input Real x;
    output Real y;
  algorithm
    y := 2*f(x);
    annotation(Inline = false);
  end h;

  function fu
    input Real x;
    output Real y;
  algorithm
    y := x^3;
    annotation(Inline = false, derivative = fu_der);
  end fu;

  function fu_der
    input Real x;
    input Real der_x;
    output Real der_y;
  algorithm
    der_y := 3*x^2*der_x;
    annotation(Inline = false);
  end fu_der;

  function fk
    input Real x;
    input Real k;
    output Real y;
  algorithm
    y := x^k;
    annotation(Inline = false, derivative(zeroDerivative = k) = fk_der);
  end fk;

  function fk_der
    input Real x;
    input Real k;
    input Real der_x;
    output Real der_y;
  algorithm
    der_y := k*x^(k - 1)*der_x;
    annotation(Inline = false);
  end fk_der;

  model Derivatives
    Real y = f4(time) \"y3 = 24*time\";
    Real y1, y2, y3;
    Real w = g(time, time^2) \"w2 = 12*time^2\";
    Real w1, w2;
    Real z = h(time) \"z2 = 12*time\";
    Real z1, z2;
    Real u = fu(time) \"u3 = 6\";
    Real u1, u2, u3;
    parameter Real k = 3;
    Real v = fk(time, k) \"v2 = 6*time\";
    Real v1, v2;
  equation
    y1 = der(y);
    y2 = der(y1);
    y3 = der(y2);
    w1 = der(w);
    w2 = der(w1);
    z1 = der(z);
    z2 = der(z1);
    u1 = der(u);
    u2 = der(u1);
    u3 = der(u2);
    v1 = der(v);
    v2 = der(v1);
  end Derivatives;

  model ConstrainedPoint
    Real p(start = 1), v, a;
  equation
    der(p) = v;
    der(v) = a;
    f(p) = 1 + 0.5*sin(time);
  end ConstrainedPoint;
end HigherFunctionDerivative;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(HigherFunctionDerivative.Derivatives); getErrorString();
val(y2, 0.5);
val(y3, 0.5);
val(w2, 0.5);
val(z2, 0.5);
val(u2, 0.5);
val(u3, 0.5);
val(v2, 0.5);
simulate(HigherFunctionDerivative.ConstrainedPoint); getErrorString();
// p^3 = 1 + 0.5*sin(time)
val(p, 1);
val(a, 1);
