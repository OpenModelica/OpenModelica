// name: higherFunctionDerivative
// keywords: NewBackend
// status: correct
// Second and third derivatives of functions without a derivative annotation.
// The time derivative of a generated derivative function also differentiates
// the inputs of the first derivative (#18448). In ConstrainedPoint, solve and
// the Jacobian need a derivative with a zero derivative of p, which is another
// function.

loadString("
package HigherFunctionDerivative
  function f
    input Real x;
    output Real y;
  algorithm
    y := x^3;
    annotation(Inline = false);
  end f;

  function f4
    input Real x;
    output Real y;
  algorithm
    y := x^4;
    annotation(Inline = false);
  end f4;

  function g
    input Real x;
    input Real z;
    output Real y;
  algorithm
    y := x^2*z;
    annotation(Inline = false);
  end g;

  function h
    input Real x;
    output Real y;
  algorithm
    y := 2*f(x);
    annotation(Inline = false);
  end h;

  model Derivatives
    Real y = f4(time) \"y3 = 24*time\";
    Real y1, y2, y3;
    Real w = g(time, time^2) \"w2 = 12*time^2\";
    Real w1, w2;
    Real z = h(time) \"z2 = 12*time\";
    Real z1, z2;
  equation
    y1 = der(y);
    y2 = der(y1);
    y3 = der(y2);
    w1 = der(w);
    w2 = der(w1);
    z1 = der(z);
    z2 = der(z1);
  end Derivatives;

  model ConstrainedPoint
    Real p(start = 1), v, a;
  equation
    der(p) = v;
    der(v) = a;
    f(p) = 1 + 0.5*sin(time);
  end ConstrainedPoint;
end HigherFunctionDerivative;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(HigherFunctionDerivative.Derivatives); getErrorString();
val(y2, 0.5);
val(y3, 0.5);
val(w2, 0.5);
val(z2, 0.5);
simulate(HigherFunctionDerivative.ConstrainedPoint); getErrorString();
// p^3 = 1 + 0.5*sin(time)
val(p, 1);
val(a, 1);
