// name: functionInputDerivative
// keywords: NewBackend
// status: correct
// Functions with function inputs can not be differentiated symbolically, the loop
// falls back to a numerical Jacobian. A local with the name of a for-loop iterator
// must not be differentiated or reported as unassigned.

loadString("
package FunctionInputDerivative
  partial function partialScalar
    input Real u;
    output Real y;
  end partialScalar;
  function cubic
    extends partialScalar;
    input Real c;
  algorithm
    y := u^3 - c;
  end cubic;
  function bisection
    input partialScalar f;
    input Real lo;
    input Real hi;
    output Real u;
  protected
    Real a = lo, b = hi;
  algorithm
    for k in 1:60 loop
      u := (a + b)/2;
      if f(a)*f(u) <= 0 then
        b := u;
      else
        a := u;
      end if;
    end for;
  end bisection;
  function cubicRoot
    input Real c;
    output Real u;
  algorithm
    u := bisection(function cubic(c = c), 0, 10);
  end cubicRoot;
  model M
    Real z(start = 1);
  equation
    z + cubicRoot(z) = 3 + time;
  end M;
  function shadowed
    input Real x;
    output Real y;
  protected
    Integer i \"shadowed by the iterator\";
  algorithm
    y := x;
    for i in 1:3 loop
      y := y + x^i;
    end for;
  end shadowed;
  model M2
    Real y(start = 1);
  equation
    shadowed(y) = 4 + time;
  end M2;
end FunctionInputDerivative;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(FunctionInputDerivative.M); getErrorString();
val(z, 1);
simulate(FunctionInputDerivative.M2); getErrorString();
val(y, 1);
