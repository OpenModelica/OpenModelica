// name: tupleAssignmentDerivative
// keywords: NewBackend
// status: correct
// Tuple assignments inside functions have to be differentiated, otherwise the
// derivatives of their outputs are used before they are assigned.

loadString("
package TupleAssignmentDerivative
  function g
    input Real x;
    output Real a;
    output Real b;
  algorithm
    a := x^3;
    b := 2*x;
  end g;
  function f
    input Real x;
    output Real y;
  protected
    Real a, b;
  algorithm
    (a, b) := g(x);
    y := a + b + x;
  end f;
  model M
    Real y(start = 1);
  equation
    f(y) = 4 + time;
  end M;
  function g2 \"with a discrete output\"
    input Real x;
    output Real a;
    output Integer err;
  algorithm
    a := x^3;
    err := if x > 100 then 1 else 0;
  end g2;
  function f2
    input Real x;
    output Real y;
  protected
    Real a;
    Integer e;
  algorithm
    (a, e) := g2(x);
    y := a + x;
  end f2;
  model M2
    Real y(start = 1);
  equation
    f2(y) = 2 + time;
  end M2;
end TupleAssignmentDerivative;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(TupleAssignmentDerivative.M); getErrorString();
val(y, 1);
simulate(TupleAssignmentDerivative.M2); getErrorString();
val(y, 1);
