// name: powerArrayJacobian
// keywords: NewBackend
// status: correct
// The derivative of an array power multiplies the arrays element-wise.

loadString("
model PowerArrayJacobian
  parameter Real b[3] = {1, 2, 3};
  Real x(start = 1);
  Real y[3];
equation
  y = {1, 1, 1} ./ (b * x) .^ 2.0;
  x = 2 + sin(time) - 0.1 * sum(y);
end PowerArrayJacobian;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(PowerArrayJacobian); getErrorString();
val(x, 1.0);
