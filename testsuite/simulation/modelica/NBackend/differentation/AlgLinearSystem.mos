// name: AlgLinearSystem
// keywords: NewBackend
// status: correct

loadString("
model AlgNonlinearSystem
  Real x(start = 0.0, fixed = true);
  Real a(start = -0.4);
  Real b(start = 0.6);
equation
  a = x - b ^ 2;
  b = 1.0 - x ^ 2 + a;
  der(x) = x + a;
end AlgNonlinearSystem;

model AlgLinearSystem
  Real x(start = 0.0, fixed = true);
  Real a(start = -0.4);
  Real b(start = 0.6);
equation
  a = x - 0.5 * b;
  b = 1.0 - 0.2 * x + 0.25 * a;
  der(x) = x + a;
end AlgLinearSystem;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=symbolic -d=NLSanalyticJacobian"); getErrorString();
simulate(AlgNonlinearSystem, stopTime=0.2, numberOfIntervals=20, fileNamePrefix="AlgNonlinearSystemAnalytic", simflags="-jacobian=coloredSymbolical"); getErrorString();

setCommandLineOptions("-d=-NLSanalyticJacobian"); getErrorString();
simulate(AlgNonlinearSystem, stopTime=0.2, numberOfIntervals=20, fileNamePrefix="AlgNonlinearSystemNumeric", simflags="-jacobian=coloredSymbolical"); getErrorString();

setCommandLineOptions("-d=NLSanalyticJacobian"); getErrorString();
simulate(AlgLinearSystem, stopTime=0.2, numberOfIntervals=20, simflags="-jacobian=coloredSymbolical"); getErrorString();

