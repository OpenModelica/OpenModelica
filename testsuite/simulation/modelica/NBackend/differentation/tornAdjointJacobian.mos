// name: tornAdjointJacobian
// keywords: NewBackend, differentiation, jacobian, adjoint, tearing
// status: correct

loadString("
model NBTornAdjoint
  Real x(start=1, fixed=true);
  Real y, z;
equation
  y + 3*z + cos(time) + x = 0;
  z + y/4 - x = 0;
  der(x) = y - 0.1*x;
end NBTornAdjoint;

model NBTornAdjointPositive
  Real x(start=1, fixed=true);
  Real y, z;
equation
  y + 3*z + cos(time) = 0;
  z + y/4 + x = 0;
  der(x) = y - 0.1*x;
end NBTornAdjointPositive;

model NBTornAdjointChain
  Real x(start=1, fixed=true);
  Real y(start=0) annotation(__OpenModelica_tearingSelect = TearingSelect.always);
  Real z(start=1) annotation(__OpenModelica_tearingSelect = TearingSelect.never);
  Real w(start=2) annotation(__OpenModelica_tearingSelect = TearingSelect.never);
  Real v(start=3) annotation(__OpenModelica_tearingSelect = TearingSelect.never);
equation
  z = x + 2*y;
  w = z*z + x;
  v = w + z*x;
  y + v + x*y = 3;
  der(x) = y + 2*z + 3*w + v - 0.1*x;
end NBTornAdjointChain;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=symbolicadjoint -d=symjacdump"); getErrorString();
buildModel(NBTornAdjoint); getErrorString();
buildModel(NBTornAdjointPositive); getErrorString();

setCommandLineOptions("--tearingMethod=guruTearing"); getErrorString();
buildModel(NBTornAdjointChain); getErrorString();

