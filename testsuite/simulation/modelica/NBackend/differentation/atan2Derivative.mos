// name: atan2Derivative
// keywords: NewBackend
// status: correct
// teardown_command: rm -rf Atan2Diff* linearized_model.mo
//
// Derivatives of atan2(u1, u2) (#18492): time derivatives, the derivative of
// a function and the symbolic Jacobian.

loadString("
package Atan2Diff
  function f
    input Real x;
    output Real y;
  algorithm
    y := atan2(x, 1 + x);
    annotation(Inline = false);
  end f;

  model Derivatives
    Real x = time + 0.5;
    Real g = atan2(x, 1 + x) \"g1 = 1/(2*x^2 + 2*x + 1)\";
    Real g1, g2;
    Real h = f(x);
    Real h1;
  equation
    g1 = der(g);
    g2 = der(g1);
    h1 = der(h);
  end Derivatives;

  model Linear
    Real x(start = 1, fixed = true);
  equation
    der(x) = atan2(x, 1 + x);
  end Linear;
end Atan2Diff;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=symbolic"); getErrorString();
simulate(Atan2Diff.Derivatives); getErrorString();
val(g1, 0.5);
val(g2, 0.5);
val(h1, 0.5);
linearize(Atan2Diff.Linear, stopTime = 0); getErrorString();
readFile("linearized_model.mo");
