// name: integerEnumDerivative
// keywords: NewBackend symbolic jacobian Integer enumeration
// status: correct
// teardown_command: rm -rf IntegerEnumDerivative*
//
// #18217: Integer() of an enumeration could not be differentiated.

loadString("
model IntegerEnumDerivative
  type E = enumeration(a, b, c);
  E e = if time < 0.5 then E.b else E.c;
  Real x(start = 0, fixed = true);
  Real y(start = 0, fixed = true);
equation
  der(x) = Integer(e)*x + 1;
  der(y) = Integer(e);
end IntegerEnumDerivative;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=symbolic"); getErrorString();
simulate(IntegerEnumDerivative); getErrorString();
val(x, 1.0);
val(y, 1.0);

