// name: cellierParameterCoefficient
// keywords: NewBackend, tearing
// status: correct
// teardown_command: rm -f ZeroFeedthrough ZeroFeedthrough_* ZeroFeedthrough.log ZeroFeedthrough.c ZeroFeedthrough.o ZeroFeedthrough.makefile ZeroFeedthrough.libs
//
// The feedthrough d of a strictly proper transfer function is zero. Cellier tearing solves
// tf.u from the loop equation with coefficient -1 and not from y = ... + d*u.

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadString("
model ZeroFeedthrough
  Modelica.Blocks.Continuous.TransferFunction tf(b = {1}, a = {0.1, 1}, initType = Modelica.Blocks.Types.Init.InitialOutput, y_start = 1);
  Real lim, ceil;
equation
  ceil = 0.1*exp(abs(tf.y))*tf.y;
  tf.u = lim - ceil;
  lim = min(max(2 - 0.5*tf.y, -5), 5);
end ZeroFeedthrough;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(ZeroFeedthrough); getErrorString();
val(tf.y, 1.0);
