// name: partialMatrixResidual
// keywords: NewBackend tearing array equation matrix residual
// status: correct
// suite: cSources
// teardown_command: rm -rf partialMatrixResidual_* partialMatrixResidual partialMatrixResidual.c partialMatrixResidual.o partialMatrixResidual.libs partialMatrixResidual.log partialMatrixResidual.makefile output.log
//
// Only column 1 of the matrix equation is in the algebraic loop with y.
// Its residuals are elements [1,1] and [2,1], the flat indices are row major.

loadString("
model partialMatrixResidual
  parameter Real B[2, 2] = {{2, 1}, {1, 3}};
  Real x[2, 3](each start = 1), y;
equation
  B*x + 0.1*x.^3 = {{1, 2, 3}, {4, 5, 6}}*(1 + time) + {{y, 0, 0}, {0, 0, 0}};
  y = 0.1*x[2, 1]^2;
end partialMatrixResidual;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
buildModel(partialMatrixResidual, stopTime = 1); getErrorString();
system("./partialMatrixResidual", "output.log");
val(x[1, 1], 1, "partialMatrixResidual_res.mat");
val(x[2, 1], 1, "partialMatrixResidual_res.mat");
val(y, 1, "partialMatrixResidual_res.mat");
// Result:
// true
// ""
// true
// ""
// {"partialMatrixResidual", "partialMatrixResidual_init.xml"}
// ""
// 0
// 0.1291257185892858
// 2.245972523166584
// 0.5044392574819272
// endResult
