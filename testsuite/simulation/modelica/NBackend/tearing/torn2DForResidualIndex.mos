// name: torn2DForResidualIndex
// keywords: tearing, resizable, torn nonlinear system, for-loop residual, SES_FOR_RESIDUAL
// status: correct
// teardown_command: rm -rf torn2DForResidualIndexTest* output.log
// cflags: --newBackend
//
// A 3-dimensional for-loop-wrapped nonlinear equation bundled by NBackend's
// tearing into a single large torn system (here 143 unknowns) with a
// SES_FOR_RESIDUAL residual (real for-loops kept in the generated C code,
// not scalarized). CodegenC.tpl's residual index for this case used to be
// the plain sum of each loop iterator's offset ("i1-1+i2-1+i3-1"), which is
// only bijective for a single iterator; with three nested iterators most of
// the 60 (a,b,c) combinations collapse onto the same handful of res[]
// slots, leaving most of the residual vector (KINSOL's kin_fval) never
// written -- reading it back is then a genuine uninitialized-memory read,
// occasionally corrupting the whole Newton step and crashing the solve.
// Fixed by flattening the index the same way array crefs are already
// indexed elsewhere in the same function (reusing forIteratorBody).
// Before the fix this model failed nondeterministically-but-mostly
// ("Solving non-linear system ... failed at time=0"); after the fix it
// solves cleanly and reproducibly to the values checked below.

loadString("
  model torn2DForResidualIndexTest
    parameter Integer N1=2, N2=10, N3=3;
    Real x[N1,N2,N3](each start=0, each fixed=false);
    Real bus(start=0, fixed=false);
  equation
    for a in 1:N1 loop
      for b in 1:N2 loop
        for c in 1:N3 loop
          exp(x[a,b,c]) = 1 + 0.001*a + 0.0001*b + 0.00001*c + 1e-6*bus;
        end for;
      end for;
    end for;
    bus = sum(sum(sum(x[a,b,c] for c in 1:N3) for b in 1:N2) for a in 1:N1) - 1.0;
  end torn2DForResidualIndexTest;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(torn2DForResidualIndexTest); getErrorString();
val(x[1,1,1], 0.0);
val(x[2,10,3], 0.0);
// Result:
// true
// ""
// true
// ""
// record SimulationResult
//     resultFile = "torn2DForResidualIndexTest_res.mat",
//     simulationOptions = "startTime = 0.0, stopTime = 1.0, numberOfIntervals = 500, tolerance = 1e-6, method = 'dassl', fileNamePrefix = 'torn2DForResidualIndexTest', options = '', outputFormat = 'mat', variableFilter = '.*', cflags = '', simflags = ''",
//     messages = "LOG_SUCCESS       | info    | The initialization finished successfully without homotopy method.
// LOG_SUCCESS       | info    | The simulation finished successfully.
// "
// end SimulationResult;
// ""
// 0.0011085093856299873
// 0.003024545456783473
// endResult
