// name: partialForArrayBodyLinear
// keywords: NewBackend
// status: correct
// cflags: --newBackend

loadString("
model partialForArrayBodyLinear
  Real a[2,3];
  Real b[3];
equation
  for i in 1:2 loop
    a[i,:] = b * i;
  end for;
  b[1] = a[1,2] + 1;
  b[2] = a[2,3] + time;
  b[3] = 4 * a[1,3] - a[2,1] + 1;
end partialForArrayBodyLinear;
"); getErrorString();

simulate(partialForArrayBodyLinear, stopTime = 1); getErrorString();
val(b[1], 1); val(b[2], 1); val(b[3], 1); val(a[2,3], 1);
