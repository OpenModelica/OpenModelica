// name: cellierZeroElementSubscript
// keywords: NewBackend tearing
// status: correct
// cflags: --newBackend
//
// The coefficient c[i].k^2 of c[i].x has to use the element of the binding
// {2.0, 3.0}, not the whole array.

loadString("
model cellierZeroElementSubscript
  model C
    parameter Real k;
    Real x;
  end C;
  C c[2](k = {2.0, 3.0});
  Real y[2];
equation
  for i in 1:2 loop
    c[i].k^2 * c[i].x + y[i] = sin(time);
    y[i] = c[i].x^3 + 1;
  end for;
end cellierZeroElementSubscript;
"); getErrorString();

simulate(cellierZeroElementSubscript, stopTime = 1); getErrorString();
val(c[1].x, 1);
val(c[2].x, 1);
