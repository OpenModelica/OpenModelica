// name: partialForArrayBody
// keywords: NewBackend tearing for-equation array
// status: correct
//
// A part of a for equation with an array valued body ends up in an algebraic
// loop. It has to be split into scalar residuals, the whole body used to be
// written into the residual array (heap corruption, "free(): invalid pointer").

setCommandLineOptions("--newBackend"); getErrorString();

loadString("
  model partialForArrayBody
    Real a[2,3];
    Real b[3];
  equation
    for i in 1:2 loop
      a[i,:] = b * i;
    end for;
    b[1] = 0.5 * a[1,1] + 1;
    b[2] = a[2,2] + time;
    b[3] = 4 * a[1,3] - a[2,3] + 1;
  end partialForArrayBody;
"); getErrorString();

simulate(partialForArrayBody, stopTime = 1); getErrorString();
val(b[1], 1); val(b[2], 1); val(b[3], 1);

// Result:
// true
// ""
// true
// ""
