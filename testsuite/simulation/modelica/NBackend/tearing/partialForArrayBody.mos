// name: partialForArrayBody
// keywords: NewBackend tearing for-equation array
// status: correct
//
// A part of a for equation with an array valued body ends up in an algebraic
// loop. The generated residual function wrote the whole body into the residual
// array and corrupted the heap ("free(): invalid pointer"). It is now reported
// as an error when building the model.

setCommandLineOptions("--newBackend"); getErrorString();

loadString("
  model partialForArrayBody
    Real a[2,3];
    Real b[3];
  equation
    for i in 1:2 loop
      a[i,:] = b * i;
    end for;
    b[1] = 0.5 * a[1,1] + 1;
    b[2] = a[2,2] + time;
    b[3] = 4 * a[1,3] - a[2,3] + 1;
  end partialForArrayBody;
"); getErrorString();

buildModel(partialForArrayBody); getErrorString();

// Result:
// true
// ""
// true
// ""
// {"", ""}
// "Error: Internal error NSimStrongComponent.Block.createResidual does not support a part of a for equation with an array valued body:
// [FOR-] (6) ($RES_SIM_3)
// [----] for $i1 in 1:2 loop
// [----]   [ARRY] (3) $RES_SIM_3[:, $i1] = b .* $i1 .- a[$i1, :]; ($RES_SIM_4)
// [----] end for;
// 	slice: {4, 5}
// "
// endResult
