// name: partialNestedFor
// keywords: NewBackend
// status: correct
//
// Parts of a nested for equation are torn, their rows are split into scalar
// residuals in row major order of the iterators.

setCommandLineOptions("--newBackend"); getErrorString();

loadString("
model partialNestedFor
  Real x[2,3];
  Real y[3];
equation
  for i in 1:2, j in 1:3 loop
    x[i,j] = sin(y[j]) * i + j;
  end for;
  y[1] = cos(x[1,2]) + 1;
  y[2] = x[2,3] + time;
  y[3] = 2 * x[1,3] - x[2,1];
end partialNestedFor;
"); getErrorString();

simulate(partialNestedFor, stopTime = 1); getErrorString();
val(y[1], 1); val(y[2], 1); val(y[3], 1);

