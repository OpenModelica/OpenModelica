// name: cellierArray
// keywords: NewBackend, tearing
// status: correct
//
// Cellier tearing after minimal tearing. Arrays and records are only solved as a whole,
// the discrete block of minimal tearing is kept and ordered after the inner equations it needs.

loadString("
package CellierArray
  record R
    Real a;
    Real b;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r := R(x, 2*x);
  end f;
  model Loop
    Real x[3], y[3], z, w;
    R r;
    Boolean b;
  equation
    for i in 1:3 loop
      x[i] = sin(y[i]) + time*i;
    end for;
    y = cos(x) + {z, z, z};
    z = sum(x) + r.a;
    r = f(w);
    b = z > 0.5;
    w = exp(-z) + r.b*0.1 + (if b then 0.01 else 0.0);
  end Loop;
  model Slice
    parameter Real c[3] = {1, 2, 3};
    parameter Real d[3] = {0.5, 0.1, 0.2};
    parameter Real X[3] = {0.2, 0.3, 0.5};
    Real T[2](each start = 1);
    Real g[2, 3];
    Real h[2, 3];
    Real hIn[2];
  equation
    for i in 1:2, j in 1:3 loop
      g[i, j] = T[i] * T[i] * c[j];
      h[i, j] = g[i, j] + d[j];
    end for;
    for i in 1:2 loop
      hIn[i] = h[i, :] * X;
    end for;
    hIn[1] = 2 + time;
    T[2] = 1 + time;
  end Slice;
  model Channel
    Real wIn(start = 1);
    Real wOut;
    Real ow;
  equation
    wOut = wIn * wIn + time;
    ow = -wOut;
  end Channel;
  model ComponentArray
    Channel c[3];
  equation
    c[1].wIn = 1 + time;
    c[2].ow + c[3].wIn * c[3].wIn * c[3].wIn = -3;
    c[3].ow + c[2].wIn * c[2].wIn * c[2].wIn = -4;
  end ComponentArray;
end CellierArray;
"); getErrorString();

setCommandLineOptions("--newBackend -d=tearingdump"); getErrorString();
simulate(CellierArray.Loop); getErrorString();
val(z, 1);
val(x[3], 1);
val(w, 1);
simulate(CellierArray.Slice); getErrorString();
val(T[1], 1);
// the torn elements of the component array are seeds on their own, the inner equations are differentiated w.r.t. them
setCommandLineOptions("-d=-tearingdump"); getErrorString();
simulate(CellierArray.ComponentArray, simflags = "-lv=LOG_NLS_DERIVATIVE_TEST"); getErrorString();
val(c[2].wIn, 1);

