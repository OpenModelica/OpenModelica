// name: cellierEntwined
// keywords: NewBackend, tearing, entwined, resizable
// status: correct
//
// Cellier tearing assigns the rows of two for-equations that alternate as one entwined component,
// with the scalar equation that starts the chain, instead of tearing a whole array. The order holds
// for every size of resizable arrays.

loadString("
package CellierEntwined
  model Forward
    parameter Integer N = 4;
    Real p[N], T[N], z;
  equation
    p[1] = z + 1;
    for i in 2:N loop
      p[i] = T[i - 1] + 1;
    end for;
    for i in 1:N loop
      T[i] = 0.5 * p[i] + 0.1 * sin(time);
    end for;
    z = cos(T[N]);
  end Forward;
  model Backward
    parameter Integer N = 4;
    Real p[N], T[N], z;
  equation
    p[N] = z + 1;
    for i in 1:N-1 loop
      p[i] = T[i + 1] + 1;
    end for;
    for i in 1:N loop
      T[i] = 0.5 * p[i] + 0.1 * sin(time);
    end for;
    z = cos(T[1]);
  end Backward;
  model Forward6 = Forward(N = 6);
  model Backward6 = Backward(N = 6);
end CellierEntwined;
"); getErrorString();

setCommandLineOptions("--newBackend -d=tearingdump"); getErrorString();
simulate(CellierEntwined.Forward); getErrorString();
val(z, 1);
val(T[4], 1);
setCommandLineOptions("-d=-tearingdump"); getErrorString();
simulate(CellierEntwined.Forward6); getErrorString();
val(z, 1);
val(T[6], 1);
simulate(CellierEntwined.Backward6); getErrorString();
val(z, 1);
val(T[1], 1);

setCommandLineOptions("--resizableArrays"); getErrorString();
simulate(CellierEntwined.Forward, simflags = "-override=N=6"); getErrorString();
val(z, 1);
val(T[6], 1);
simulate(CellierEntwined.Backward, simflags = "-override=N=6"); getErrorString();
val(z, 1);
val(T[1], 1);
