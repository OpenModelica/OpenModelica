// name: linearMatrixSingleComponent
// keywords: tearing, linearity, checkLinearity, LINEARSYSTEM, matrix
// status: correct
// teardown_command: rm -rf linearMatrixSingleComponentTest* output.log
// cflags: --newBackend
//
// A*x = B where x is a 2-element array var matched as one unit to the whole array
// equation (NBStrongComponent.SINGLE_COMPONENT: "solve for a single (possibly
// multidimensional) variable"), because A is not diagonal so neither row of x is
// solvable on its own. This is genuinely linear in x (A, B are parameters), but
// NBTearing.mo's implicit() hardcoded linear=false for SINGLE_COMPONENT (and
// RESIZABLE_COMPONENT) instead of checking like it already does for
// SLICED_COMPONENT, so it was always routed through NONLINEARSYSTEM/Newton instead
// of a direct LINEARSYSTEM solve. -lv=LOG_LS,LOG_NLS makes the routing visible
// directly in the simulation log ("1 linear systems" / "0 non-linear systems").
// (Model name deliberately differs from the file name so teardown_command's
// wildcard cleanup can't match and delete this .mos file itself.)

loadString("
  model linearMatrixSingleComponentTest
    parameter Real A[2,2] = [2,1;1,3];
    parameter Real B[2] = {5,10};
    Real x[2];
  equation
    A*x = B;
  end linearMatrixSingleComponentTest;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(linearMatrixSingleComponentTest, stopTime=0, simflags="-lv=LOG_LS,LOG_NLS"); getErrorString();
val(x[1], 0.0);
val(x[2], 0.0);
// Result:
// true
// ""
// true
// ""
