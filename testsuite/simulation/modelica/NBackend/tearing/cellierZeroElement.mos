// name: cellierZeroElement
// keywords: NewBackend tearing cellier
// status: correct
// cflags: --newBackend
//
// The coefficient of u[i] is zero for i = 1, so the for-equation must not be
// solved for u by tearing.

loadString("
model cellierZeroElement
  Real u[3], v[3], w;
equation
  for i in 1:3 loop
    ({0.0, 1.0, -1.0})[i] * u[i] = sin(time) + w - v[i];
    v[i] = 2 * i * w;
  end for;
  w = 0.1 * sum(u) + time;
end cellierZeroElement;
"); getErrorString();

simulate(cellierZeroElement, stopTime = 1); getErrorString();
val(u[1], 1);
val(u[2], 1);
val(u[3], 1);
val(w, 1);
// Result:
