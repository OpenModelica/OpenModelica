// name: simplifyResidual
// keywords: NewBackend
// status: correct
// cflags: --newBackend

loadString("
model SimplifyResidual
  Real p;
  Real x;
  Real y;
equation
  0 = (y - 2) * 3;
  0 = (x - 1) / p;
  p = exp(time);
end SimplifyResidual;
"); getErrorString();

setCommandLineOptions("-d=dumpSimplify"); getErrorString();
translateModel(SimplifyResidual); getErrorString();

