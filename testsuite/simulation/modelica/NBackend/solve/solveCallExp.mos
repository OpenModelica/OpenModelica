// name: solveCallExp
// keywords: NewBackend
// status: correct
// cflags: --newBackend -d=dumpSolve

loadString("
  model solveCallExp
    Real x \" = log(log(1/sin(2)))/log(4)\";
  equation
    exp(-(2^x)^2) = sin(2);
  end solveCallExp;
"); getErrorString();

translateModel(solveCallExp); getErrorString();

