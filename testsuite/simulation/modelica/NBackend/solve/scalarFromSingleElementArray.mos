// name: scalarFromSingleElementArray
// keywords: NewBackend solve array
// status: correct
//
// A scalar solved from an array equation of size one, mXi = m * Xi. The solved
// equation was array valued and the generated C code did not compile
// (div_alloc_scalar_real_array called with array arguments).

setCommandLineOptions("--newBackend"); getErrorString();

loadString("
  model scalarFromSingleElementArray
    Real m;
    Real mXi[1];
    Real Xi[1];
  equation
    Xi = {0.5};
    mXi = {1 + time};
    mXi = m * Xi;
  end scalarFromSingleElementArray;
"); getErrorString();

simulate(scalarFromSingleElementArray, stopTime=1.0); getErrorString();
val(m, 0.0);
val(m, 1.0);

