// name: functionOutputStartAlias
// keywords: NewBackend
// status: correct
// The start value of a function output must not refer to the start value of an
// alias variable (here x = time), aliases are resolved to their definition.

loadString("
package FunctionOutputStartAlias
  function f
    input Real x;
    output Real y;
  protected
    Real a;
  algorithm
    a := x^2;
    y := a + 1;
  end f;
  model M
    Real x = time;
    Real z(start = 1);
  equation
    z^3 + z = f(x);
  end M;
end FunctionOutputStartAlias;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(FunctionOutputStartAlias.M); getErrorString();
val(z, 1);
