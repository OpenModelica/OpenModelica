// name: homotopyStartValue
// keywords: NewBackend, initialization, homotopy, start
// status: correct
// cflags: --newBackend
//
// The start value equation of x may only set the initial guess before the
// homotopy path is followed, not reset it at every lambda step.

loadString("
model homotopyStartValue
  parameter Real x0 = -1.9;
  Real x(start = x0);
equation
  0 = homotopy(x*x - 4, x - 2);
end homotopyStartValue;
"); getErrorString();

simulate(homotopyStartValue, stopTime = 0); getErrorString();
val(x, 0.0);
simulate(homotopyStartValue, stopTime = 0, simflags = "-noHomotopyOnFirstTry"); getErrorString();
val(x, 0.0);

