// name: init_if_eq
// keywords: NewBackend, initialization, adjacency
// status: correct
// cflags: --newBackend

loadString("
model init_if_eq
  Real u, y;
equation
  if initial() then
    y + y^2 = 1;
  else
    u = 1;
  end if;
  y = u^3 + u;
end init_if_eq;
"); getErrorString();

setCommandLineOptions("-d=dumpSimCode"); getErrorString();
simulate(init_if_eq); getErrorString();

