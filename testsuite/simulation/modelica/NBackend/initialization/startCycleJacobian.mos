// name: startCycleJacobian
// keywords: NewBackend, initialization, start value, jacobian
// status: correct
//
// The start value of y depends on the parameter p, which is solved together
// with y in the initial system. $START.y is an inner variable of the jacobian
// of that algebraic loop and does not have a zero derivative.

loadString("
model startCycleJacobian
  parameter Real p(fixed = false, start = 1);
  Real y(start = p);
initial equation
  p = 0.5*y + 1;
equation
  y^3 + y = p + time;
end startCycleJacobian;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(startCycleJacobian, stopTime = 0.1); getErrorString();
abs(val(y, 0.0) - 0.835122348481) < 1e-6; getErrorString();

