// name: primaryParameterFor
// keywords: NewBackend
// status: correct
// cflags: --newBackend

loadString("
model primaryParameterFor
  model C
    parameter Real a = 2;
    parameter Real b = a*3;
  end C;
  parameter Integer n = 3;
  parameter Real g = 5;
  C c[n](a = {g*i for i in 1:n});
  parameter Real s = c[2].b + sum(c.a);
  Real x(start=1, fixed=true);
equation
  der(x) = -x*s/100;
end primaryParameterFor;
"); getErrorString();

simulate(primaryParameterFor, stopTime = 1); getErrorString();
val(s, 0); val(c[2].b, 0); val(c[3].a, 0);
