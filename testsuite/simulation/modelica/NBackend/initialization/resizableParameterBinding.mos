// name: resizableParameterBinding
// keywords: NewBackend resizable
// status: correct
// cflags: --newBackend --resizableArrays
//
// The binding of a resizable parameter that is bound to another parameter
// needs a binding equation, otherwise its value is zero.

loadString("
model Sub
  parameter Integer N = 2;
  Real x[N](each start = 1, each fixed = true);
  Real y;
equation
  for i in 1:N loop
    der(x[i]) = -x[i];
  end for;
  y = sum(x);
end Sub;

model resizableParameterBinding
  parameter Integer N = 3;
  Sub s(N = N);
end resizableParameterBinding;
"); getErrorString();

simulate(resizableParameterBinding, stopTime = 1); getErrorString();
val(s.N, 0);
abs(val(s.y, 1) - 3 * exp(-1)) < 1e-3;
// Result:
// true
