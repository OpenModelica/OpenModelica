// name: initialNoReturnCall
// keywords: NewBackend initialization when
// status: correct
// cflags: --newBackend
//
// Calls without result run at the initialization: in initial equations and
// algorithms and in active when-bodies, also when the call refers to a
// variable (#17162).

loadString("
model initialNoReturnCall
  discrete Integer v(start = 0, fixed = true);
  discrete Integer a(start = 0, fixed = true);
initial equation
  print(\"initial equation\\n\");
initial algorithm
  print(\"initial algorithm\\n\");
equation
  when initial() then
    v = 1;
  elsewhen time > 0.5 then
    v = 2;
  end when;
  when {initial(), change(v)} then
    a = v;
    print(\"equation: t=\" + String(time) + \", v=\" + String(v) + \"\\n\");
  end when;
algorithm
  when {initial(), change(v)} then
    print(\"algorithm: t=\" + String(time) + \", v=\" + String(v) + \"\\n\");
  end when;
end initialNoReturnCall;
"); getErrorString();

simulate(initialNoReturnCall, stopTime = 1); getErrorString();
val(a, 0);

// Result:
