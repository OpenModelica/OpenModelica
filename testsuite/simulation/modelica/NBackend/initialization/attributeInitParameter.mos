// name: attributeInitParameter
// keywords: NewBackend, attributes, initialization
// status: correct
// suite: cSources
//
// Attributes depending on parameters of the initialization are not evaluated before it.

loadString("
model AttributeInitParameter
  parameter Real p(fixed = false);
  Real x(start = 1, fixed = true, nominal = 1 / p);
initial equation
  p = 2;
equation
  der(x) = -p * x;
end AttributeInitParameter;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(AttributeInitParameter); getErrorString();
val(x, 1.0);

