// name: impureParameterBinding
// keywords: NewBackend
// status: correct
//
// Impure calls are not evaluated during translation, the binding of A
// is computed at initialization.

loadString("
model impureParameterBinding
  impure function f
    input Real x;
    output Real y[2];
  algorithm
    y := {x, 2*x};
  end f;
  final parameter Real A[2] = f(3.0);
  Real x(start = 1, fixed = true);
equation
  der(x) = -A[2]*x;
end impureParameterBinding;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(impureParameterBinding); getErrorString();
val(A[2], 0.0);
val(x, 1.0);
// Result:
