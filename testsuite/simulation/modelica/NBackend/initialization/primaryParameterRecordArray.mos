// name: primaryParameterRecordArray
// keywords: NewBackend
// status: correct
// cflags: --newBackend
//
// The binding of an array of records is inlined in the initialization,
// it is not solved as a whole in the parameter system.

loadString("
model primaryParameterRecordArray
  record R
    Real a;
    Real b;
  end R;
  parameter Real g = 5;
  parameter R r[2] = {R(g, 2*g), R(3*g, 4*g)};
  parameter Real s = r[1].a + r[2].b;
  Real x(start = 1, fixed = true);
equation
  der(x) = -x*s/100;
end primaryParameterRecordArray;
"); getErrorString();

simulate(primaryParameterRecordArray, stopTime = 1); getErrorString();
val(s, 0); val(r[2].a, 0);
