// name: whenAlgorithmArray
// keywords: NewBackend, initialization, algorithm, when, array
// status: correct
// suite: cSources
// teardown_command: rm -f whenAlgorithmArray_res.mat
//
// The algorithm of an array component becomes a for-statement around the
// when-statement. Its outputs need a pre variable for the initialization
// as well (ScalableTestSuite BreakerNetworkDelayed).

loadString("
model WhenAlgorithmComponent
  input Real u;
  Boolean triggered(start = false, fixed = true);
  discrete Real t0(start = 1e9, fixed = true);
algorithm
  when u > 0.5 then
    triggered := true;
    t0 := time;
  elsewhen u < 0.5 and triggered then
    triggered := false;
  end when;
end WhenAlgorithmComponent;

model whenAlgorithmArray
  WhenAlgorithmComponent c[3](u = {k*time for k in 1:3});
end whenAlgorithmArray;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(whenAlgorithmArray, stopTime = 1); getErrorString();
val(c[1].triggered, 0.4, "whenAlgorithmArray_res.mat");
val(c[1].triggered, 1, "whenAlgorithmArray_res.mat");
abs(val(c[1].t0, 1, "whenAlgorithmArray_res.mat") - 0.5) < 1e-6;
abs(val(c[2].t0, 1, "whenAlgorithmArray_res.mat") - 0.25) < 1e-6;
abs(val(c[3].t0, 1, "whenAlgorithmArray_res.mat") - 0.5/3) < 1e-6;
// Result:
// true
// ""
// true
// ""
