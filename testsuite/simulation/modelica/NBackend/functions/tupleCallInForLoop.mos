// name: tupleCallInForLoop
// keywords: NewBackend function tuple for-equation matching
// status: correct
// cflags: --newBackend
// teardown_command: rm -f TupleCallInForLoop*
//
// A function call with several outputs in a for-equation over more than one index. The rows of
// the equation are ordered by iteration first, so the rows of one output are a whole body
// apart. They used to be placed next to each other, which made the matching singular and started
// an index reduction that differentiates the function and, for a large function, runs out of
// memory. The outputs are solved together as one multi component.

loadString("
function f2
  input Real u;
  output Real a, b;
algorithm
  a := u;
  b := 2 * u;
end f2;

model TupleCallInForLoop
  Real a[3], b[3];
equation
  for i in 1:3 loop
    (a[i], b[i]) = f2(time + i);
  end for;
end TupleCallInForLoop;
"); getErrorString();

simulate(TupleCallInForLoop, stopTime = 1); getErrorString();
val(a[1], 1);
val(a[3], 1);
val(b[2], 1);
val(b[3], 1);

