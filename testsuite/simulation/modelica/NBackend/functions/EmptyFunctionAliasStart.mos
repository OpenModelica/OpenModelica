// name: EmptyFunctionAliasStart
// keywords: NewBackend, function alias, empty array
// status: correct
//
// A call with an empty array result gets no function alias, it has no elements
// to solve for. Before, the alias variable and its equation of size zero stopped
// the causalization, and the start equation of the alias had no variable to set.

loadString("
model EmptyFunctionAliasStart
  function f
    input Real u[:];
    output Real y[size(u, 1) - 1];
  algorithm
    for i in 1:size(y, 1) loop
      y[i] := u[i];
    end for;
  end f;
  function g
    input Real p;
    input Real x[:];
    output Real y;
  algorithm
    y := p + sum(x);
  end g;
  parameter Real r[1] = {1};
  Real a;
  Real b(start = 1, fixed = true);
equation
  a = g(b, f(r));
  der(b) = -a;
end EmptyFunctionAliasStart;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(EmptyFunctionAliasStart); getErrorString();
val(b, 1);

