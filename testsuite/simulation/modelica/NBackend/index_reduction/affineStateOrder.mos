// name: affineStateOrder
// keywords: NewBackend, index reduction
// status: correct
// v1 = k*der(x) + c is the state order of x. The constraint v2 = 3*der(x) - 1
// becomes v2 = 3*((v1 - c)/k) - 1. No alias for der(x) is necessary.
// affineStateOrderFor: the same for der(x[i]) = (v1[i] - 1)/k in a for-equation.

loadString("
model affineStateOrder
  parameter Real k = 2, c = 0.5;
  Real x(stateSelect = StateSelect.prefer, start = 1, fixed = true);
  Real v1(start = 0, fixed = true);
  Real v2, a1, a2;
equation
  v1 = k*der(x) + c;
  v2 = 3*der(x) - 1;
  a1 = der(v1);
  a2 = der(v2);
  a1 + a2 = -x;
end affineStateOrder;

model affineStateOrderFor
  parameter Integer n = 2;
  parameter Real k = 2;
  Real x[n](each stateSelect = StateSelect.prefer, each start = 1, each fixed = true);
  Real v1[n](each start = 0, each fixed = true);
  Real v2[n], a1[n], a2[n];
equation
  for i in 1:n loop
    der(x[i]) = (v1[i] - 1)/k;
    v2[i] = 3*der(x[i]) + x[i];
    a1[i] = der(v1[i]);
    a2[i] = der(v2[i]);
    a1[i] + a2[i] = -i*x[i];
  end for;
end affineStateOrderFor;
"); getErrorString();

setCommandLineOptions("--newBackend -d=stateselection"); getErrorString();
simulate(affineStateOrder); getErrorString();
val(x, 1);
simulate(affineStateOrderFor); getErrorString();
val(x[2], 1);
