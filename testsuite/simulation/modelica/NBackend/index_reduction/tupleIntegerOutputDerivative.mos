// name: tupleIntegerOutputDerivative
// keywords: NewBackend, index reduction, tuple, integer
// status: correct
//
// Differentiating (x, i) = f(...) gives a dummy for the derivative of the
// Integer output i. The dummy is an Integer variable, not a Real one.

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadString("
model tupleIntegerOutputDerivative
  parameter Real tabx[:] = {0, 1, 2, 3, 4, 5};
  parameter Real taby[:] = tabx .* tabx;
  Real x, y, xIntegrated;
  Integer i;
initial equation
  xIntegrated = x;
equation
  (x, i) = Modelica.Math.Vectors.interpolate(tabx, taby, time);
  y = der(x);
  der(xIntegrated) = y;
end tupleIntegerOutputDerivative;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(tupleIntegerOutputDerivative, stopTime = 5); getErrorString();
abs(val(xIntegrated, 5.0) - 25.0) < 1e-3; getErrorString();

