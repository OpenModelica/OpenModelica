// name: basic_IR
// keywords: NewBackend
// status: correct

loadString("
model basic_IR
  Real x(start = 1.0, fixed=true);
  Real y(start = 1.0);
  Real a;
  Real b;
equation
  der(x) = a * (1 + time);
  der(y) = b * (1 + time);
  x = a + b;
  y = x^2;
end basic_IR;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(basic_IR); getErrorString();

val(x, 0.0);
val(x, 1.0);
val(y, 0.0);
val(y, 1.0);
