// name: partialArrayState
// keywords: NewBackend
// status: correct
//
// Only x[1] occurs in the constraint, x[2] still has a derivative and
// must not loop the index reduction.

loadString("
model partialArrayState
  Real x[2](start = {0, 1}, fixed = {false, true});
  Real v[2](start = {1, 0}, fixed = {false, true});
  Real F;
equation
  der(x) = v;
  der(v) = {-x[1] + F, -x[2]};
  x[1] = sin(time);
end partialArrayState;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(partialArrayState); getErrorString();
val(F, 1.0);
// cos(1)
val(x[2], 1.0);
