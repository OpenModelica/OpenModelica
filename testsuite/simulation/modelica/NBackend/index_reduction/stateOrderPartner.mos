// name: stateOrderPartner
// keywords: NewBackend, index reduction
// status: correct
// v1 = der(x) is the state order of x. The constraint v2 = der(x) becomes
// v2 = v1 and its derivative is a2 = a1. No alias for der(x) is necessary.

loadString("
model stateOrderPartner
  Real x(stateSelect = StateSelect.prefer, start = 1, fixed = true);
  Real v1(start = 0, fixed = true);
  Real v2;
  Real a1, a2;
equation
  v1 = der(x);
  v2 = der(x);
  a1 = der(v1);
  a2 = der(v2);
  a1 + a2 = -x;
end stateOrderPartner;
"); getErrorString();

setCommandLineOptions("--newBackend -d=stateselection"); getErrorString();
simulate(stateOrderPartner); getErrorString();
val(x, 1);
// Result:
// true
// ""
// true
// ""
// [stateselection] (0) Forced states by StateSelect.ALWAYS:
// ***********************************************************
// 	<no states>
//
// [stateselection] (3) Natural states before index reduction:
// *************************************************************
// 	[STAT] (1) Real x (fixed = true, start = 1.0, StateSelect = prefer)
// 	[STAT] (1) Real v1 (fixed = true, start = 0.0)
// 	[STAT] (1) Real v2
//
// [stateselection] State Order:
// *******************************
// 	(x --d/dt--> v1)
// 	(v1 --d/dt--> a1)
// 	(v2 --d/dt--> a2)
//
// [stateselection] (0) State Derivatives Created by Differentiation
// *******************************************************************
// 	
//
