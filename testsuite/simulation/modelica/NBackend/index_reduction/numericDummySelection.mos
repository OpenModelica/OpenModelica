// name: numericDummySelection
// keywords: NewBackend
// status: correct
// The constraints a + b = x and 2*a + 2*b = x + y are linear with constant
// coefficients. a and b have the same coefficients, so they cannot both be
// dummy states, which the structural matching chose (DLR DistrictHeating
// Grid16Consumer).

loadString("
  model numericDummySelection
    Real a(start = 1, fixed = true), b, x, y, bx, by;
  equation
    der(x) = bx;
    der(y) = by;
    a + b = x;
    2*a + 2*b = x + y;
    der(a) = -a + sin(time);
    der(b) = -b;
  end numericDummySelection;
"); getErrorString();

setCommandLineOptions("--newBackend -d=stateselection");
simulate(numericDummySelection); getErrorString();
val(x, 1.0);
val(y, 1.0);

// Result:
// true
// ""
// true
// [stateselection] (0) Forced states by StateSelect.ALWAYS:
// ***********************************************************
// 	<no states>
//
// [stateselection] (4) Natural states before index reduction:
// *************************************************************
// 	[STAT] (1) Real x
// 	[STAT] (1) Real y
// 	[STAT] (1) Real a (fixed = true, start = 1.0)
// 	[STAT] (1) Real b
//
// [stateselection] State Order:
// *******************************
// 	(y --d/dt--> by)
// 	(x --d/dt--> bx)
//
// [stateselection] (0) State Derivatives Created by Differentiation
// *******************************************************************
// 	
//
// [stateselection] (2) Selected Dummy States
// ********************************************
// [DSTA] (1) Real a (fixed = true, start = 1.0)
// [DSTA] (1) Real y
