// name: partialArrayCandidate
// keywords: NewBackend
// status: correct
//
// #17724: only ps[1] occurs in the constraint equations, ps[2] must
// neither be selected as state nor make all of ps a dummy state.

loadString("
model partialArrayCandidate
  model Vol
    Real p;
    Real m(stateSelect = StateSelect.prefer);
    Real pp[2];
    Real mf[2];
  equation
    m = 2*p;
    der(m) = mf[1] + mf[2];
    for i in 1:2 loop
      pp[i] = p;
    end for;
  end Vol;
  parameter Real dp = 0;
  Vol vol;
  Real ps[2];
  Real mfo[2];
equation
  ps[1] = vol.pp[1] + dp;
  ps[2] = vol.pp[2] + dp;
  mfo = vol.mf;
  ps[1] = 1 + time;
  mfo[2] = -1;
end partialArrayCandidate;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(partialArrayCandidate); getErrorString();
val(mfo[1], 1.0);
val(vol.m, 1.0);
val(ps[2], 1.0);
