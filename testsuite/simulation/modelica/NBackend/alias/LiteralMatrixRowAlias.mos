// name: LiteralMatrixRowAlias
// keywords: NewBackend alias
// status: correct
//
// An evaluated parameter of an array of components is a literal matrix with
// one subscript per for-equation, the rows are alias of the whole matrix.

loadString("
model LiteralMatrixRowAlias
  model B
    parameter Real p[3] annotation(Evaluate = true);
    Real x[3];
    Real y(start = 0, fixed = true);
  equation
    x = p;
    der(y) = x[3];
  end B;
  B b[2](p = {{1, 2, 3}, {4, 5, 6}});
end LiteralMatrixRowAlias;
"); getErrorString();

setCommandLineOptions("--newBackend -d=dumprepl"); getErrorString();
simulate(LiteralMatrixRowAlias, stopTime = 1); getErrorString();
val(b[2].x[1], 1);
val(b[1].y, 1);
val(b[2].y, 1);

