// name: AliasZeroProduct
// keywords: NewBackend
// status: correct
//
// I = m * L becomes I = m * 0.0 after L is replaced. It has to be simplified to
// I = 0.0 before the next alias run, m cannot be solved from it.

loadString("
model AliasZeroProduct
  Real x(start = 1, fixed = true);
  Real m, I, J, L;
equation
  der(x) = -x + m + I + J;
  m = sin(time);
  L = 0.0;
  I = m * L;
  J = 0.5 * L ^ 2.0 * m;
end AliasZeroProduct;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(AliasZeroProduct); getErrorString();
val(x, 1.0);

