// name: ArrayAliasSizeOne
// keywords: NewBackend, alias, array
// status: correct
//
// Alias replacement on arrays of components with a dimension of size one.

loadString("
package ArrayAliasSizeOne
  connector Pin
    Real v[2];
    flow Real i[2];
  end Pin;

  model Source
    Pin p;
    parameter Real v_dc = 3;
  equation
    v_dc = p.v[1];
    p.v[2] = 0;
  end Source;

  model Load
    Pin p;
    Real v;
    Real i;
  equation
    p.v[1] = v;
    i = 2*v - 1;
    p.i[1] = i;
    p.i[2] = -i;
  end Load;

  model Vector
    parameter Integer n = 1;
    Source s[n](v_dc = {3 + k for k in 1:n});
    Load l[n];
  equation
    connect(s.p, l.p);
  end Vector;

  model Array3D
    parameter Integer n = 1;
    Source s[1, 1, n](each v_dc = 3);
    Load l[1, 1, n];
  equation
    connect(s.p, l.p);
  end Array3D;
end ArrayAliasSizeOne;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(ArrayAliasSizeOne.Vector, stopTime = 1, numberOfIntervals = 2); getErrorString();
val(l[1].v, 1); getErrorString();
val(l[1].i, 1); getErrorString();

simulate(ArrayAliasSizeOne.Array3D, stopTime = 1, numberOfIntervals = 2); getErrorString();
val(l[1,1,1].v, 1); getErrorString();
val(l[1,1,1].i, 1); getErrorString();

