// name: AliasFollowUpWhen
// keywords: NewBackend
// status: correct
// teardown_command: rm -f AliasFollowUpAux* AliasFollowUpRemovedWhen* AliasFollowUpRemovedWhenInit*
//
// Alias follow-up runs with the left hand sides of when-equations:
// AliasFollowUpAux: the auxiliary equation h = not not_h needs the
//   replacement of not_h found in the follow-up.
// AliasFollowUpRemovedWhen, AliasFollowUpRemovedWhenInit: when false is
//   removed, s keeps its start value as a parameter.

loadString("
model AliasFollowUpAux
  Boolean h(start = false, fixed = true);
  Boolean not_h = not h;
  Boolean c, u1, u2, y1, y2;
  Real x(start = 1, fixed = true);
equation
  c = time > 0.5;
  when c then
    h = true;
  end when;
  u1 = h;
  u2 = true;
  y1 = u1 and u2;
  y2 = y1 and u2;
  der(x) = if y2 then -x else -2*x;
end AliasFollowUpAux;

model AliasFollowUpRemovedWhen
  Boolean trig, e;
  Real s(start = 2, fixed = true);
  Real k, k2, p, q;
  Real x(start = 1, fixed = true);
equation
  e = false;
  trig = e;
  when trig then
    s = time;
  end when;
  k = 1.0;
  k2 = 2 * k - 1;
  p = k * s;
  q = k2 * p;
  der(x) = -q * x;
end AliasFollowUpRemovedWhen;

model AliasFollowUpRemovedWhenInit
  Boolean trig, e;
  Real s(start = 2, fixed = true);
  Real k, k2, p, q, y;
  Real x(start = 1, fixed = true);
equation
  e = false;
  trig = e;
  when trig then
    s = time;
  end when;
  k = 1.0;
  k2 = 2 * k - 1;
  p = k * s;
  q = k2 * p;
  y = q;
  der(x) = -y * x;
end AliasFollowUpRemovedWhenInit;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(AliasFollowUpAux); getErrorString();
// exp(-1.5)
val(x, 1.0);
simulate(AliasFollowUpRemovedWhen); getErrorString();
// exp(-2)
val(x, 1.0);
simulate(AliasFollowUpRemovedWhenInit); getErrorString();
val(x, 1.0);
