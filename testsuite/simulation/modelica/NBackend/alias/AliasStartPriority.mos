// name: AliasStartPriority
// keywords: NewBackend alias start confidence
// status: correct
//
// Selection of start values in alias sets by frontend confidence
// numbers per MLS 8.6.2 (ticket #5813).

loadString("
model StartPriority1 \"outer modifier beats inner start value\"
  model M
    Real x(start = 4.0);
    Real y(start = 5.0);
  equation
    x = y;
    der(x) = -x;
  end M;
  M m(x(start = 3.0));
end StartPriority1;

model StartPriority2 \"start = parameter follows the parameter's binding\"
  model M
    parameter Real p = 4.0;
    Real x(start = p);
    Real y(start = 5.0);
  equation
    x = y;
    der(x) = -x;
  end M;
  M m(p = 6.0);
end StartPriority2;

model StartPriority3 \"equal actual confidence: raw confidence breaks the tie\"
  model M
    parameter Real q = 1.0;
    Real x(start = q);
    Real y;
  equation
    x = y;
    der(x) = -x;
  end M;
  M m(q = 7.0, y(start = 3.0));
end StartPriority3;

model StartPriority4 \"type-induced start values rank by where the type is determined; a modifier always wins\"
  type Temperature = Real(start = 300);

  package BaseMedium
    type Temperature = StartPriority4.Temperature;
  end BaseMedium;

  package HotGas
    extends BaseMedium(Temperature(start = 1000));
  end HotGas;

  package NormalGas
    extends BaseMedium;
  end NormalGas;

  model M1 \"the medium redeclared at the top beats the generic type\"
    replaceable package Medium = BaseMedium;
    Temperature T1;
    Medium.Temperature T2;
  equation
    T1 = T2;
    der(T1) = -T1;
  end M1;

  model M2 \"a start modifier beats any type-induced start\"
    replaceable package Medium = BaseMedium;
    Temperature T1(start = 500);
    Medium.Temperature T2;
  equation
    T1 = T2;
    der(T1) = -T1;
  end M2;

  model M3 \"the redeclared medium wins even without a start modifier of its own\"
    replaceable package Medium1 = HotGas constrainedby BaseMedium;
    replaceable package Medium2 = HotGas constrainedby BaseMedium;
    Medium1.Temperature T1;
    Medium2.Temperature T2;
  equation
    T1 = T2;
    der(T1) = -T1;
  end M3;

  M1 m1(redeclare package Medium = HotGas);
  M2 m2(redeclare package Medium = HotGas);
  M3 m3(redeclare package Medium1 = NormalGas);
end StartPriority4;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(StartPriority1, stopTime=0.0, simflags="-output m.x,m.y"); getErrorString();
simulate(StartPriority2, stopTime=0.0, simflags="-output m.x,m.y"); getErrorString();
simulate(StartPriority3, stopTime=0.0, simflags="-output m.x,m.y"); getErrorString();
simulate(StartPriority4, stopTime=0.0, simflags="-output m1.T1,m1.T2,m2.T1,m2.T2,m3.T1,m3.T2"); getErrorString();

