// name: AliasIntegerToReal
// keywords: NewBackend, alias, integer, cast
// status: correct
//
// A Real variable that is equal to an Integer variable does not replace the
// Integer variable.

loadString("
package AliasIntegerToReal
  model Scalar
    Integer i;
    Real r;
  equation
    i = integer(3*time);
    r = i;
  end Scalar;

  model Array
    Integer i[2];
    Real r[2];
  equation
    i = {integer(3*time), 2};
    r = i;
  end Array;

  model When
    Integer i(start = 0, fixed = true);
    Real r;
    Real x(start = 0, fixed = true);
  equation
    when sample(0, 0.1) then
      i = pre(i) + 1;
    end when;
    r = i;
    der(x) = r;
  end When;
end AliasIntegerToReal;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(AliasIntegerToReal.Scalar); getErrorString();
val(r, 0.5); getErrorString();

simulate(AliasIntegerToReal.Array); getErrorString();
val(r[1], 0.5); val(r[2], 0.5); getErrorString();

simulate(AliasIntegerToReal.When); getErrorString();
val(x, 1.0); getErrorString();

