// name: LiteralArrayAlias
// keywords: NewBackend alias
// status: correct
//
// Elements of literal arrays in for-equations, scaled by a parameter or
// negated, are alias replacements of the whole array.

loadString("
model LiteralArrayAlias
  parameter Real k = 2;
  parameter Real c[3] = {1, 2, 3};
  Real a[3], b[3], x[3](each start = 1, each fixed = true);
equation
  for i in 1:3 loop
    a[i] = k * ({0.0, 1.0, -1.0})[i];
    b[i] = -c[i];
    der(x[i]) = a[i] * x[i] + b[i];
  end for;
end LiteralArrayAlias;
"); getErrorString();

setCommandLineOptions("--newBackend -d=dumprepl"); getErrorString();
simulate(LiteralArrayAlias, stopTime = 1); getErrorString();
val(x[1], 1);
val(x[2], 1);
val(x[3], 1);

