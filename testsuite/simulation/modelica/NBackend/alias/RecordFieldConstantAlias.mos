// name: RecordFieldConstantAlias
// keywords: NewBackend
// status: correct
//
// j*omega*L = Complex(0, omega)*L: the constant real parts of the function aliases are
// removed, also the ones that only become constant after a first alias removal. Otherwise
// the linear systems divide by them.

loadModel(Modelica, {"4.1.0"}); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(Modelica.Electrical.QuasiStatic.SinglePhase.Examples.MultipleResonance); getErrorString();
val(zi.i.re, 1.0);
val(zi.i.im, 1.0);

