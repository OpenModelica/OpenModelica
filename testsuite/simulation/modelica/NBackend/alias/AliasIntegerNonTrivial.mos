// name: AliasIntegerNonTrivial
// keywords: NewBackend, alias, integer
// status: correct
//
// An Integer variable that becomes a non-trivial alias (u = y - p) is an
// Integer algebraic variable in the simulation code, not a Real one.

loadString("
model AliasIntegerNonTrivial
  parameter Integer p = 5;
  Real r = 3*time;
  Integer i = integer(r);
  Integer u;
  Integer y;
equation
  u = i;
  y = u + p;
end AliasIntegerNonTrivial;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();

simulate(AliasIntegerNonTrivial); getErrorString();
val(y, 1.0); getErrorString();

