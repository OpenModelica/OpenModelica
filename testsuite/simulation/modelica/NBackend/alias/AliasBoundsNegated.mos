// name: AliasBoundsNegated
// keywords: NewBackend, alias, min, max
// status: correct
// suite: cSources
//
// The bounds of a negated alias are negated and swapped before they are merged
// into the bounds of the kept variable: y = -x with y in [-0.5, 2] gives x in [-2, 0.5],
// merged with the other bounds the kept variable is in [-1, 0.5].

loadString("
model AliasBoundsNegated
  Real x(min = -1, max = 5);
  Real y(min = -0.5, max = 2);
  Real z(min = -3, max = 3);
equation
  y = -x;
  z = x;
  x = 0.4*sin(time);
end AliasBoundsNegated;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(AliasBoundsNegated, stopTime = 1); getErrorString();
val(y, 1);
writeFile("bounds.log", "");
system("awk '/name = \"z\"/{f=1} f && /alias =/{print} f && /<Real/{print; exit}' AliasBoundsNegated_init.xml", "bounds.log"); readFile("bounds.log");

