// name: AliasCyclic8
// keywords: NewBackend, Alias, ASSC
// status: correct
// function: Testing Bareiss algorithm.

loadString("
  model AliasCyclic8
    Integer a, b, c, d;       // constant simple
  equation
    2002 = 2002*a + 2002*d;
    0 = 1001*b + 1001*c;
    -1001 = 1001*c + 1001*d;
    0 = 1001*b + 1001*a;
  end AliasCyclic8;
"); getErrorString();

setCommandLineOptions("--newBackend -d=dumprepl");
simulate(AliasCyclic8); getErrorString();
diffSimulationResults("AliasCyclic8_res.mat", "ReferenceFiles/AliasCyclic8_res.mat", "AliasCyclic8_diff.csv", 1e-8);

