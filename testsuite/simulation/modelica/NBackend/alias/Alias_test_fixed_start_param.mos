// name: Alias_test_fixed_start_param
// keywords: NewBackend, Alias
// status: correct
// function: Fixed start values that are syntactically different but not provably conflicting (literal vs. parameter binding) must only warn, not abort.

loadString("
  model FixedStartParam
    parameter Real p = 2;
    Real a(start = 2, fixed = true);
    Real b(start = p, fixed = true);
  equation
    a = b;
    der(a) = -a;
  end FixedStartParam;
"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(FixedStartParam, stopTime = 1); getErrorString();
val(a, 0.0);

// Result:
// true
// ""
// true
// ""
