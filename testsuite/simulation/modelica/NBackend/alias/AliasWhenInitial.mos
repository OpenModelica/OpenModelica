// name: AliasWhenInitial
// keywords: NewBackend
// status: correct
//
// z = u - 2.0 only appears after b is replaced. u replaces y, which is assigned in a
// when-equation that becomes an algorithm for the initialization, so u can only be
// replaced by a variable.

loadString("
model AliasWhenInitial
  Real y;
  Real u, b, z;
equation
  when {sample(0, 0.1), initial()} then
    y = time;
  end when;
  u = y;
  b = 2.0;
  z = u - b;
end AliasWhenInitial;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();
simulate(AliasWhenInitial); getErrorString();
val(z, 0.25);

// Result:
