// name: AliasCyclic7
// keywords: NewBackend, Alias, ASSC
// status: correct
// function: Testing Bareiss algorithm.

loadString("
  model AliasCyclic7
    Integer a, b, c, d;       // constant simple
  equation
    2 = 2*a + 2*d;
    0 = b + c;
    -1 = c + d;
    0 = b + a;
  end AliasCyclic7;
"); getErrorString();

setCommandLineOptions("--newBackend -d=dumprepl");
simulate(AliasCyclic7); getErrorString();
diffSimulationResults("AliasCyclic7_res.mat", "ReferenceFiles/AliasCyclic7_res.mat", "AliasCyclic7_diff.csv", 1e-8);

