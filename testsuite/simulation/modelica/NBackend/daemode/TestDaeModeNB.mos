// name: TestDaeModeNB
// keywords: NewBackend
// status: correct
// fixes ticket #13076

loadString("
model TestDaeModeNB
  Real x(start=1, fixed=true);
equation
  der(x) = x;
end TestDaeModeNB;
"); getErrorString();

setCommandLineOptions("--newBackend --daeMode"); getErrorString();

simulate(TestDaeModeNB); getErrorString();

val(x,0.33);
val(x,0.66);
val(x,1);

