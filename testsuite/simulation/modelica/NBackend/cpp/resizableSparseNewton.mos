// name: resizableSparseNewton
// keywords: NewBackend, Cpp, resizable, override, algebraic loop, sparsity pattern
// status: correct
// teardown_command: rm -rf rsnPairs* rsnRing* OMCpprsnPairs* OMCpprsnRing*
//
// Resizable algebraic loops in the C++ runtime: the sparsity pattern is
// computed for the size set with -override, Newton evaluates the Jacobian by
// column groups (colors) and factorizes it with KLU. The iteration variables
// are stored column major (Pairs) and couple neighbors (Ring).

setCommandLineOptions("--newBackend --simCodeTarget=Cpp --simCodeScalarize=false --resizableArrays"); getErrorString();

loadString("
package resizableSparseNewton
  model Pairs
    parameter Integer N = 4;
    Real x[N, 2];
  equation
    for i in 1:N loop
      x[i, 1] + 0.1*sin(x[i, 2]) = i*(1 + time);
      x[i, 2] + 0.2*cos(x[i, 1]) = 2*i*(1 + time);
    end for;
  end Pairs;
  model Ring
    parameter Integer N = 4;
    Real x[N];
  equation
    for i in 1:N loop
      x[i] + 0.1*sin(x[mod(i, N) + 1]) = i*(1 + time);
    end for;
  end Ring;
end resizableSparseNewton;
"); getErrorString();

buildModel(resizableSparseNewton.Pairs, stopTime = 1, fileNamePrefix = "rsnPairs"); getErrorString();
system("sh rsnPairs.sh -override N=30 -V nls=info > rsnPairs.log 2>&1 && grep -q 'sparse Jacobian with 120 non-zeros and 2 colors' rsnPairs.log");
buildModel(resizableSparseNewton.Ring, stopTime = 1, fileNamePrefix = "rsnRing"); getErrorString();
system("sh rsnRing.sh -override N=30 -V nls=info > rsnRing.log 2>&1 && grep -q 'sparse Jacobian with 60 non-zeros and 2 colors' rsnRing.log");

// the equations hold for the elements added with -override
abs(val(x[30,1], 1, "rsnPairs_res.mat") + 0.1*sin(val(x[30,2], 1, "rsnPairs_res.mat")) - 60) < 1e-8;
abs(val(x[30,2], 1, "rsnPairs_res.mat") + 0.2*cos(val(x[30,1], 1, "rsnPairs_res.mat")) - 120) < 1e-8;
abs(val(x[30], 1, "rsnRing_res.mat") + 0.1*sin(val(x[1], 1, "rsnRing_res.mat")) - 60) < 1e-8;
abs(val(x[17], 1, "rsnRing_res.mat") + 0.1*sin(val(x[18], 1, "rsnRing_res.mat")) - 34) < 1e-8;
// Result:
// true
// ""
// true
// ""
// {"rsnPairs", "rsnPairs_init.xml"}
// ""
// 0
// {"rsnRing", "rsnRing_init.xml"}
// ""
// 0
// true
// true
// true
// true
// endResult
