// name: bug_17335
// keywords: algorithm when if removeSimpleEquations
// status: correct
// teardown_command: rm -rf bug_17335_* output.log
//
// Inlining an if-statement with a constant condition must keep the
// statements before it and the order of the statements in the branch.
//

loadString("
model bug_17335_else
  discrete Real x(start=0, fixed=true);
  discrete Real y(start=0, fixed=true);
  Boolean TS = false;
  Real z;
equation
  z = y;
algorithm
  when sample(0, 0.25) then
    x := time;
    if TS then
      y := x;
    else
      y := -x;
    end if;
  end when;
end bug_17335_else;

model bug_17335_then
  discrete Real b(start=0, fixed=true);
  discrete Real c(start=0, fixed=true);
  Boolean TS = true;
  Real z;
equation
  z = c;
algorithm
  when sample(0, 0.25) then
    if TS then
      b := time;
      c := b + 1;
    else
      c := 0;
    end if;
  end when;
end bug_17335_then;
"); getErrorString();

simulate(bug_17335_else, stopTime=1); getErrorString();
val(x, 0.6);
val(y, 0.6);

simulate(bug_17335_then, stopTime=1); getErrorString();
val(b, 0.6);
val(c, 0.6);

