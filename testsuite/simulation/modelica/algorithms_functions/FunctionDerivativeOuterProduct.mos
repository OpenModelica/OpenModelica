// name: FunctionDerivativeOuterProduct
// keywords: differentiation, function, derivative, outerProduct, promote
// status: correct
//
// The frontend expands outerProduct(e, e) to promote(e, 2)*transpose(promote(e, 2)).
// h is differentiated from an equation and from the body of k.

loadString("
model OuterProduct
  function h
    input Real e[3];
    output Real y;
  protected
    Real T[3, 3];
  algorithm
    T := outerProduct(e, e);
    y := 0;
    for i in 1:3 loop
      y := y + T[i, i];
    end for;
  end h;

  function k
    input Real x;
    output Real y;
  algorithm
    y := 0;
    for i in 1:2 loop
      y := y + h({x, 1, 0});
    end for;
  end k;

  Real y1 = h({time, 1, 0});
  Real y2 = k(time);
  Real dy1 = der(y1) \"2*time\";
  Real dy2 = der(y2) \"4*time\";
end OuterProduct;
"); getErrorString();

simulate(OuterProduct, stopTime = 1); getErrorString();
val(dy1, 0.5);
val(dy2, 0.5);
