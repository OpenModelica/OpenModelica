// name:     WhenElseWhenNoOutputs
// keywords: when elsewhen algorithm
// status:   correct
// teardown_command: rm -rf WhenElseWhenNoOutputs_* WhenElseWhenNoOutputs.c WhenElseWhenNoOutputs.h WhenElseWhenNoOutputs.o WhenElseWhenNoOutputs.libs WhenElseWhenNoOutputs.makefile WhenElseWhenNoOutputs.log WhenElseWhenNoOutputs.json WhenElseWhenNoOutputs.exe WhenElseWhenNoOutputs output.log
//
// A when-elsewhen statement without outputs, whose conditions are not plain
// variables, in an algorithm section.
//

loadString("
model WhenElseWhenNoOutputs
  function pr
    input String s;
    external \"C\" ModelicaMessage(s) annotation(Include=\"#include \\\"ModelicaUtilities.h\\\"\");
  end pr;
  Real x(start = 0, fixed = true);
equation
  der(x) = 1;
algorithm
  when x > 0.3 then
    pr(\"a\\n\");
  elsewhen x > 0.5 then
    pr(\"b\\n\");
  end when;
end WhenElseWhenNoOutputs;
"); getErrorString();

simulate(WhenElseWhenNoOutputs, stopTime=1); getErrorString();
