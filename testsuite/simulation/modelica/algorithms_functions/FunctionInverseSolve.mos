// name: FunctionInverseSolve
// keywords: function, inverse, solve
// status: correct
// teardown_command: rm -rf FunctionInverseSolve.Test* _FunctionInverseSolve.Test* output.log
//
// An equation y = f(a, x) is solved for x with the inverse annotation of f
// instead of a nonlinear system.
//

loadFile("FunctionInverseSolve.mo"); getErrorString();

simulate(FunctionInverseSolve.Test, stopTime=1.0); getErrorString();
val(x, 0.0);
val(x, 1.0);
// no nonlinear system in the generated code
regexBool(readFile("FunctionInverseSolve.Test_info.json"), "non-linear");
getErrorString();

simulate(FunctionInverseSolve.Test2, stopTime=1.0); getErrorString();
val(x, 0.0);
val(x, 1.0);
regexBool(readFile("FunctionInverseSolve.Test2_info.json"), "non-linear");
getErrorString();

