// name:      zeroCoefficient
// keywords:  parameter evaluation, structural parameter, #17069
// status:    correct
//
// Parameters that make a coefficient an equation is solved with zero are
// evaluated, and setting a nonzero one to zero at run time gives an assert.

loadString("
package ZeroCoefficient
  model Inductor
    parameter Real L = 0.1;
    parameter Real R = 1;
    parameter Real V = 1;
    Real i, vL;
  equation
    L*der(i) = vL;
    V = vL + R*i;
  end Inductor;

  model ZeroInductor
    extends Inductor(L = 0);
  end ZeroInductor;

  model TwoInductors
    parameter Real L1 = 0.1;
    parameter Real L2 = 0;
    parameter Real R = 1;
    parameter Real V = 1;
    Real i1, i2, v1, v2;
  equation
    L1*der(i1) = v1;
    L2*der(i2) = v2;
    i1 = i2;
    V = v1 + v2 + R*i1;
  end TwoInductors;

  model DrivenInductor
    parameter Real L = 0;
    Real i, v;
  equation
    i = sin(time);
    L*der(i) = v;
  end DrivenInductor;
end ZeroCoefficient;
"); getErrorString();

simulate(ZeroCoefficient.ZeroInductor, stopTime = 0.1); getErrorString();
val(i, 0.1);
simulate(ZeroCoefficient.Inductor, stopTime = 0.1, simflags = "-override L=0"); getErrorString();
simulate(ZeroCoefficient.TwoInductors, stopTime = 0.1, simflags = "-override L2=0.1"); getErrorString();
val(i1, 0.1);
simulate(ZeroCoefficient.DrivenInductor, stopTime = 0.1, simflags = "-override L=2"); getErrorString();
val(v, 0.0);

