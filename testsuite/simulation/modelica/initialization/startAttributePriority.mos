// name:     startAttributePriority
// keywords: initialization alias start confidence
// status: correct
//
// Selection of start values in alias sets by frontend confidence
// numbers per MLS 8.6.2 (ticket #5813).

loadString("
model StartPriority1 \"outer modifier beats inner start value\"
  model M
    Real x(start = 4.0);
    Real y(start = 5.0);
  equation
    x = y;
    der(x) = -x;
  end M;
  M m(x(start = 3.0));
end StartPriority1;

model StartPriority2 \"start = parameter follows the parameter's binding\"
  model M
    parameter Real p = 4.0;
    Real x(start = p);
    Real y(start = 5.0);
  equation
    x = y;
    der(x) = -x;
  end M;
  M m(p = 6.0);
end StartPriority2;

model StartPriority3 \"equal actual confidence: raw confidence breaks the tie\"
  model M
    parameter Real q = 1.0;
    Real x(start = q);
    Real y;
  equation
    x = y;
    der(x) = -x;
  end M;
  M m(q = 7.0, y(start = 3.0));
end StartPriority3;
"); getErrorString();

// StartPriority1: m.x start set at top level (confidence 1) beats m.y's
// declaration-level start (confidence 2).
simulate(StartPriority1, stopTime=0.0, simflags="-output m.x,m.y"); getErrorString();

// StartPriority2: m.x's start = p where p is bound at top level, so its
// actual confidence (1) beats m.y's (2).
simulate(StartPriority2, stopTime=0.0, simflags="-output m.x,m.y"); getErrorString();

// StartPriority3: both starts have actual confidence 1 (q is bound at the
// top), but m.y's start attribute itself is set at the top (raw confidence
// 1 vs 2), so it wins the tie-break.
simulate(StartPriority3, stopTime=0.0, simflags="-output m.x,m.y"); getErrorString();

