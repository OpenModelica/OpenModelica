// name: homotopy8
// keywords: initialization, homotopy
// status: correct
// teardown_command: rm -rf initializationTests.homotopy8* _initializationTests.homotopy8* output.log
//
// The adaptive global approach with homotopy only in an explicitly solved
// equation, as in an MSL 4 Limiter outside any loop. The homotopy component
// then has lambda as its only unknown and no residual equations.
//

loadString("
within ;
package initializationTests
  model homotopy8
    Real x, y(start = 1, fixed = true);
  equation
    x = homotopy(exp(y) + 2, 3);
    der(y) = -x;
  end homotopy8;
end initializationTests;
"); getErrorString();

setCommandLineOptions("--homotopyApproach=adaptiveGlobal"); getErrorString();
simulate(initializationTests.homotopy8, startTime=0.0, stopTime=0.0); getErrorString();
res := OpenModelica.Scripting.readSimulationResult("initializationTests.homotopy8_res.mat", {time, x, y}, 2); getErrorString();

// Result:
// true
// ""
// true
