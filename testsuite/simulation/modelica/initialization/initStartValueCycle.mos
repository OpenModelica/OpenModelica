// name: initStartValueCycle
// keywords: initialization, start, sorting
// status: correct
// teardown_command: rm -rf InitStartValueCycle* _InitStartValueCycle* output.log
//
// The start value of x depends on x, but x is not solved iteratively. The
// initialization has to be solved in sequence
//   x := 2*p
//   x_start := f(x)
// without an algebraic loop that calls f with a guess for x.
//

loadString("
model InitStartValueCycle
  function f
    input Real x;
    output Real y;
  algorithm
    assert(x > 0.5, \"f called with x = \" + String(x));
    y := x/2;
  end f;

  parameter Real p = 1;
  parameter Real x_start(fixed = false);
  Real x(start = x_start, fixed = false);
initial equation
  x_start = f(x);
equation
  x = 2*p;
end InitStartValueCycle;
"); getErrorString();

simulate(InitStartValueCycle, stopTime=1.0); getErrorString();

val(x, 0.0);
val(x_start, 0.0);

// Result:
// true
// ""
// record SimulationResult
//     resultFile = "InitStartValueCycle_res.mat",
//     simulationOptions = "startTime = 0.0, stopTime = 1.0, numberOfIntervals = 500, tolerance = 1e-6, method = 'dassl', fileNamePrefix = 'InitStartValueCycle', options = '', outputFormat = 'mat', variableFilter = '.*', cflags = '', simflags = ''",
//     messages = "LOG_SUCCESS       | info    | The initialization finished successfully without homotopy method.
// LOG_SUCCESS       | info    | The simulation finished successfully.
// "
// end SimulationResult;
// "Warning: Initialization start-value cycle: the start attribute of 'x' depends, directly or transitively, on the variable itself. The start attribute defines the initial value of 'x' and therefore cannot be computed from it, so this start value cannot be used to initialize the variable (see Modelica Specification section 4.9.6). This is possibly a modeling error; if unintended, give 'x' a start value that does not depend on itself. Use the transformational debugger to inspect the dependency chain.
// "
// 2.0
// 1.0
// endResult
