// name:     InitialBindingPriority
// keywords: initialization, redundant equation, binding
// status:   correct
//
// Balancing removes redundant initial equations before bindings.
//
// The binding of the parameter p with fixed = false is kept, and the initial
// equation 2*p = 2 is removed.
//
// The frontend moves the binding of r to the initial equations, because it
// cannot split it. The rows of the initial equation r = f(1) are removed, not
// the rows of the binding.
//
// With use_Q_flow_nominal = false, WetCoilUARated has dummy initial equations
// for parameters that also have bindings. If a row of the binding of the
// record staWat is removed instead, staWat.T is solved from
// cpWat = cp(staWat), and cp of water is a constant.

loadString("
model UnfixedBindingPriority
  parameter Real p(fixed = false) = 1;
initial equation
  2*p = 2;
end UnfixedBindingPriority;
"); getErrorString();
loadString("
model RecordBindingPriority
  record R
    Real a;
    Real b;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r := R(x, 2*x);
  end f;
  parameter Real p(fixed = false, start = 1);
  parameter R r = f(p);
initial equation
  p = 1;
  r = f(1);
end RecordBindingPriority;
"); getErrorString();
setCommandLineOptions("-d=initialization"); getErrorString();

simulate(UnfixedBindingPriority, stopTime = 0); getErrorString();
val(p, 0.0);

simulate(RecordBindingPriority, stopTime = 0); getErrorString();
val(r.b, 0.0);

loadModel(Buildings, {"12.1.1"}); getErrorString();
loadString("
model WetCoilUARatedInit
  parameter Real Q_flow_nominal(fixed = false);
  parameter Real T_a1_nominal(fixed = false);
  parameter Real T_a2_nominal(fixed = false);
  parameter Real w_a2_nominal(start = 0.01, fixed = false);
  Buildings.Fluid.HeatExchangers.BaseClasses.WetCoilUARated UAFroRated(
    use_Q_flow_nominal = false,
    QTot_flow = Q_flow_nominal,
    UA = 300,
    r_nominal = 2/3,
    TAirIn = T_a2_nominal,
    X_wAirIn = w_a2_nominal/(1 + w_a2_nominal),
    TWatIn = T_a1_nominal,
    mAir_flow = 1,
    mWat_flow = 1);
end WetCoilUARatedInit;
"); getErrorString();

simulate(WetCoilUARatedInit, stopTime = 0, simflags = "-emit_protected"); getErrorString();
val(UAFroRated.UAAir, 0.0);
val(UAFroRated.UAWat, 0.0);
val(UAFroRated.cpWat, 0.0);

