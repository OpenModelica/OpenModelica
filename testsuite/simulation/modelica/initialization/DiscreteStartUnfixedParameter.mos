// name: DiscreteStartUnfixedParameter
// keywords: initialization, discrete, parameter, start
// status: correct
// teardown_command: rm -rf DiscreteStartUnfixedParameter_* DiscreteStartUnfixedParameter DiscreteStartUnfixedParameter.c DiscreteStartUnfixedParameter.o DiscreteStartUnfixedParameter.exe DiscreteStartUnfixedParameter.libs DiscreteStartUnfixedParameter.log DiscreteStartUnfixedParameter.makefile output.log
//
// The start value of a discrete variable can depend on parameters that are
// computed during the initialization (#5384).

loadString("
model DiscreteStartUnfixedParameter
  parameter Real p(fixed = false);
  parameter Integer n(fixed = false);
  discrete Real d(start = p);
  discrete Integer i(start = n);
  discrete Real e(start = p);
  Real y = delay(d, 0.2);
initial equation
  p = 0.5;
  n = 3;
  e = 4;
equation
  when time > 0.5 then
    d = 1;
    i = 1;
    e = 1;
  end when;
end DiscreteStartUnfixedParameter;
"); getErrorString();

simulate(DiscreteStartUnfixedParameter, stopTime = 0.1); getErrorString();
val(d, 0);
val(i, 0);
val(e, 0);
val(y, 0.1);

