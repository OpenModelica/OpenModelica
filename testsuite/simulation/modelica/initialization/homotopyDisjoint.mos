// name:     homotopyDisjoint
// keywords: initialization homotopy matching
// status:   correct
// teardown_command: rm -rf HomDisjoint* output.log
//
// A homotopy() initial equation whose actual and simplified expressions share
// no variable: the equation can only be solved for the variable of the actual
// expression (d), since the simplified one is gone at lambda = 1.
//

loadString("
model HomDisjoint
  parameter Real d(fixed = false, start = 0) \"offset, 0 in the actual problem\";
  Real h \"outlet enthalpy\";
  parameter Real hIn = 450e3;
  parameter Real hRef = 391e3 \"value imposed in the simplified problem\";
  Real x(start = 1, fixed = true);
initial equation
  0 = homotopy(d, 1e-3*(h - hRef));
equation
  h = hIn + d;
  der(x) = -x;
end HomDisjoint;
"); getErrorString();

simulate(HomDisjoint, stopTime=1); getErrorString();
val(d, 0);
val(h, 0);
