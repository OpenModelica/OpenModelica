// name:     TearingTieStartValue
// keywords: initialization, tearing, start value
// status:   correct
//
// The tearing heuristic rates d, V and p of the initial loop the same. The
// tearing variable is then p, the variable with a start value, and not the
// variable that comes first.

loadString("
package TieStartValue
  type Pressure = Real(start = 1e5, nominal = 1e5);

  function rho
    input Real p;
    output Real d;
  algorithm
    d := p / 1e5;
    annotation(Inline = false);
  end rho;

  model M
    Real V;
    Pressure p;
    Real d;
    parameter Real m = 1;
  equation
    V = m / d;
    d = rho(p);
    p = 1e5 * (1 + log(2 / V - 1));
  end M;
end TieStartValue;
"); getErrorString();

setCommandLineOptions("-d=dumpLoops"); getErrorString();
translateModel(TieStartValue.M); getErrorString();

