// name: initStartValueCycle2
// keywords: initialization, start, sorting
// status: correct
// teardown_command: rm -rf InitStartValueCycle2* _InitStartValueCycle2* output.log
//
// Models from https://github.com/modelica/ModelicaSpecification/issues/3918
// where the start attribute of x depends on x.
//

loadString("
package InitStartValueCycle2
  model CyclicStartAttribute
    parameter Real p(fixed = false);
    Real x(start = p);
  initial equation
    1 = p^2 + x^2;
  equation
    x = p + time;
  end CyclicStartAttribute;

  model ReverseStartAttribute
    parameter Real p(fixed = false);
    Real x(start = p);
  initial equation
    1 = p^2 + x^2;
  equation
    x = time;
  end ReverseStartAttribute;

  model CyclicStartAttribute2
    parameter Real p(fixed = false);
    Real x(start = p);
    parameter Integer n = 3;
  initial equation
    x = p;
  equation
    2 + time = x^n;
  end CyclicStartAttribute2;

  model InitFixedStartValueCycle
    parameter Real p(fixed = false);
    Real x(start = p, fixed = true);
  initial equation
    p = (x*x + 27)/12;
  equation
    der(x) = 1;
  end InitFixedStartValueCycle;
end InitStartValueCycle2;
"); getErrorString();

simulate(InitStartValueCycle2.CyclicStartAttribute, stopTime=1.0); getErrorString();
val(x, 0.0);
val(p, 0.0);
val(x, 1.0);

simulate(InitStartValueCycle2.ReverseStartAttribute, stopTime=1.0); getErrorString();
val(x, 0.0);
val(p, 0.0);
val(x, 1.0);

simulate(InitStartValueCycle2.CyclicStartAttribute2, stopTime=1.0); getErrorString();
val(x, 0.0);
val(p, 0.0);
val(x, 1.0);

simulate(InitStartValueCycle2.InitFixedStartValueCycle, stopTime=1.0); getErrorString();
val(x, 0.0);
val(p, 0.0);
val(x, 1.0);

