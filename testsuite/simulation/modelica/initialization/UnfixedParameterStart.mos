// name: UnfixedParameterStart
// keywords: initialization, parameter, start
// status: correct
// teardown_command: rm -rf UnfixedParameterStart_* UnfixedParameterStart UnfixedParameterStart.c UnfixedParameterStart.o UnfixedParameterStart.exe UnfixedParameterStart.libs UnfixedParameterStart.log UnfixedParameterStart.makefile output.log
//
// The start value of a parameter with fixed = false can depend on parameters
// that are computed during the initialization (#10980).

loadString("
model UnfixedParameterStart
  parameter Real p0(fixed = false);
  parameter Real q = 2*p0;
  parameter Real p(start = -7/q, fixed = false);
initial equation
  p0 = 3;
  p^3 = p;
end UnfixedParameterStart;
"); getErrorString();

simulate(UnfixedParameterStart, stopTime = 0); getErrorString();
val(q, 0);
val(p, 0);

// Result:
// true
