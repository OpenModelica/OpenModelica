// name: Issue18255
// keywords: initialization, fixed, start
// status: correct
//
// A variable with fixed = true and no start value starts at the default
// start value, not at a start value computed from the equations.

loadString("
model Issue18255
  Real x(start = 2), d(fixed = true);
equation
  d = der(x);
  der(x) = 1 - x;
end Issue18255;
"); getErrorString();

simulate(Issue18255, stopTime = 0.01); getErrorString();
{val(x, 0), val(d, 0)};

