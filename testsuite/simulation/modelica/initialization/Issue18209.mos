// name: Issue18209
// keywords: initialization, when, elsewhen, algorithm
// status: correct
//
// A discrete variable that only an inactive branch of a when-statement
// assigns keeps pre(v) at the initialization, also when the active
// branch comes first.

loadString("
model Issue18209
  discrete Integer n(start = 0, fixed = true);
  discrete Real t0(start = -1, fixed = true);
  discrete Integer m(start = 0, fixed = true);
  discrete Integer k(start = 0, fixed = true);
  discrete Integer p(start = 0, fixed = true);
  discrete Integer q(start = 0, fixed = true);
algorithm
  when initial() then
    t0 := time;
  elsewhen time > 0.5 then
    n := pre(n) + 1;
  end when;
algorithm
  when time > 0.5 then
    m := pre(m) + 1;
  elsewhen initial() then
    m := 5;
    k := 3;
  end when;
algorithm
  when initial() then
    p := 7;
  elsewhen time > 0.5 then
    p := pre(p) + 1;
    q := 2;
  end when;
end Issue18209;
"); getErrorString();

simulate(Issue18209, stopTime = 1); getErrorString();
{val(n, 0), val(t0, 0), val(m, 0), val(k, 0), val(p, 0), val(q, 0)};
{val(n, 1), val(t0, 1), val(m, 1), val(k, 1), val(p, 1), val(q, 1)};

