// name: ExternalProtectedArg
// status: correct
//
// Protected variables passed to external C functions. A variable is passed in
// the same way as an output (by pointer), a constant as an input (MLS 3.7,
// section 12.9.1).

loadString("
model ExternalProtectedArg
  function fill
    input Real u[:];
    output Real y[size(u, 1)];
  protected
    Integer n = size(u, 1);
  external \"C\" fillN(y, n) annotation(Include = \"static void fillN(double *y, int *n) {int i; for (i = 0; i < *n; i++) y[i] = i + 1; *n = -1;}\");
  end fill;

  function scale
    input Real x;
    output Real y;
  protected
    Real s = 2*x;
    Boolean b = x > 0;
    constant Integer k = 10;
  external \"C\" y = scaleBy(x, s, b, k) annotation(Include = \"static double scaleBy(double x, double *s, int *b, int k) {return x * *s + (*b ? k : -k);}\");
  end scale;

  Real y[3] = fill({time, time, time});
  Real z = scale(1 + time);
end ExternalProtectedArg;
"); getErrorString();
simulate(ExternalProtectedArg, stopTime = 1, numberOfIntervals = 1); getErrorString();
{val(y[1], 1), val(y[2], 1), val(y[3], 1)};
{val(z, 0), val(z, 1)};

