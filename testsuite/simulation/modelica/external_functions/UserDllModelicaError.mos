// name: UserDllModelicaError
// keywords: external functions, ModelicaUtilities, ModelicaError, shared library
// status: correct
// setup_command: case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) $OMC_NATIVE_CC -shared -o libUserDllModelicaError.dll UserDllModelicaError-lib.c -lpsapi;; *) $OMC_NATIVE_CC $OMC_NATIVE_CFLAGS -shared -o libUserDllModelicaError.so UserDllModelicaError-lib.c;; esac
// teardown_command: rm -rf libUserDllModelicaError.dll libUserDllModelicaError.so UserDllModelicaError.Test* output.log
// depends: UserDllModelicaError-lib.c
// suite: smoke
//
// Issue #14581: ModelicaError called at run time from a shared library must
// report its message and end the simulation, not crash it.
//

loadFile("UserDllModelicaError.mo"); getErrorString();
simulate(UserDllModelicaError.Test); getErrorString();

