// name:     ModelicaIOMatrix73
// keywords: ModelicaIO, writeRealMatrix, readRealMatrix, MAT v7.3, HDF5
// status:   correct
// suite:    hdf5
// teardown_command: rm -rf ModelicaIOMatrix73_* ModelicaIOMatrix73 ModelicaIOMatrix73.exe ModelicaIOMatrix73.mat ModelicaIOMatrix73.c ModelicaIOMatrix73.h ModelicaIOMatrix73.o ModelicaIOMatrix73.libs ModelicaIOMatrix73.log ModelicaIOMatrix73.makefile ModelicaIOMatrix73.wasm output.log
//
// MAT v7.3 is an HDF5 container, which ModelicaMatIO reads and writes only
// under HAVE_HDF5. Appending "N" reopens the file, a code path of its own.

loadModel(Modelica, {"4.0.0"}); getErrorString();
loadFile("ModelicaIOMatrix73.mo"); getErrorString();
simulate(ModelicaIOMatrix73, stopTime=1.0); getErrorString();
val(x, 1.0);
val(dims[1], 1.0);
val(dims[2], 1.0);

