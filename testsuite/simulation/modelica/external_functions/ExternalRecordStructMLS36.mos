// name: ExternalRecordStructMLS36
// status: correct
// depends: ExternalRecordStructMLS36.c
//
// Records with neither an Include nor a CStructTag annotation, as in MLS 3.6:
// the external code defines the struct, with the name of the record or with
// another name.

loadString("
package ExternalRecordStructMLS36
  record A
    Integer b;
  end A;

  record R
    Real x;
    Real z;
    A a1, a2;
  end R;

  record State
    Real p;
    Integer phase;
  end State;

  function read
    input R r;
    output Real y;
  external \"C\" y = mls36_read(r) annotation(Include = \"#include \\\"ExternalRecordStructMLS36.c\\\"\");
  end read;

  function write
    input Real t;
    output R r;
  external \"C\" mls36_write(t, r) annotation(Include = \"#include \\\"ExternalRecordStructMLS36.c\\\"\");
  end write;

  function state
    input State s;
    output Real y;
  external \"C\" y = mls36_state(s) annotation(Include = \"#include \\\"ExternalRecordStructMLS36.c\\\"\");
  end state;

  function setState
    input Real p;
    output State s;
  external \"C\" mls36_set_state(p, s) annotation(Include = \"#include \\\"ExternalRecordStructMLS36.c\\\"\");
  end setState;

  model M
    R w = write(time);
    Real yw = read(w);
    State s = setState(1 + time);
    Real ys = state(s);
  end M;
end ExternalRecordStructMLS36;
"); getErrorString();
simulate(ExternalRecordStructMLS36.M, stopTime = 1, numberOfIntervals = 1); getErrorString();
{val(w.x, 0), val(w.z, 0), val(w.a1.b, 0), val(w.a2.b, 0), val(yw, 0), val(yw, 1)};
{val(s.p, 0), val(s.phase, 0), val(ys, 0), val(ys, 1)};

