// name: newtonDiagnosticsKinsol
// keywords: nonlinear initialization newton diagnostics kinsol sparse Jacobian
// status: correct
//
// LOG_NLS_NEWTON_DIAGNOSTICS on a nonlinear system that KINSOL solves with
// its sparse symbolic Jacobian.

loadString("
model DiodeCircuit
  parameter Real i_s = 6.9144e-13;
  parameter Real v_t = 25e-3;
  parameter Real P = 10.7;
  parameter Real R = 1;
  parameter Integer N = 10;
  Real i(start = 0.9);
  Real v(start = 9.63);
  Real v_d(start = 0.63);
  Real v_[N];
equation
  i - i_s*(exp(v_d/v_t) - 1) = 0;
  v*i - P = 0;
  v - sum(v_) - v_d = 0;
  for j in 1:N loop
    v_[j] - R*i = 0;
  end for;
end DiodeCircuit;
"); getErrorString();

// No tearing, so that the nonlinear system has 13 unknowns and a sparse Jacobian.
setCommandLineOptions("--maxSizeNonlinearTearing=0 --postOptModules-=wrapFunctionCalls"); getErrorString();
echo(false);
res := simulate(DiodeCircuit, stopTime=1, numberOfIntervals=10, simflags="-nls=kinsol -lv=LOG_NLS_NEWTON_DIAGNOSTICS");
echo(true);
getErrorString();
abs(val(i, 0, "DiodeCircuit_res.mat") - 1) < 1e-7;
abs(val(v_d, 0, "DiodeCircuit_res.mat") - 0.7) < 1e-7;
abs(val(v, 0, "DiodeCircuit_res.mat") - 10.7) < 1e-7;

// Result:
// true
// ""
// true
// ""
// true
// ""
// true
// true
// true
// endResult
