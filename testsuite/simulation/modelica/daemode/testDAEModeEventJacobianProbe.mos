// name: testDAEModeEventJacobianProbe
// keywords: daeMode, events, IDA
// status: correct
// teardown_command: rm -f M M.* M_* output.log
//
// #17842: The event locates v less than a Jacobian perturbation below 0.5.
// shed must stay true after the event and v must stop.

setCommandLineOptions("--daeMode"); getErrorString();
loadString("
model M
  Real v(start = 1, fixed = true);
  Boolean shed;
equation
  shed = v < 0.5;
  der(v) = if shed then 0 else -1;
end M;
"); getErrorString();

simulate(M, stopTime = 1); getErrorString();
val(shed, 0.75);
val(v, 1.0);

