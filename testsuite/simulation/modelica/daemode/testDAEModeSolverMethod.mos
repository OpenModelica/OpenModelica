// name: testDAEModeSolverMethod
// keywords: daeMode, solver, auto
// status: correct
// teardown_command: rm -rf SolverMethod* output.log
//
// The default method auto chooses dassl, or ida for --daeMode. A method given
// explicitly is never replaced: --daeMode with dassl is an error. See #17727.

loadString("
model SolverMethod
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end SolverMethod;
"); getErrorString();

echo(false);
res := simulate(SolverMethod, simflags = "-lv=LOG_SOLVER");
messages := res.messages;
echo(true);
getErrorString();
res.simulationOptions;
regexBool(messages, "-s=auto chooses solver method dassl");
val(x, 1.0);

setCommandLineOptions("--daeMode"); getErrorString();

simulate(SolverMethod); getErrorString();
val(x, 1.0);

simulate(SolverMethod, method = "dassl"); getErrorString();

echo(false);
res := simulate(SolverMethod, method = "dassl", simflags = "-s=auto -lv=LOG_SOLVER");
messages := res.messages;
echo(true);
getErrorString();
regexBool(messages, "-s=auto chooses solver method ida");
val(x, 1.0);

