// name: illegalDerInput
// keywords: daeMode, input, derivative
// status: correct
// teardown_command: rm -rf illegalDerInput illegalDerInput_* illegalDerInput.c illegalDerInput.o illegalDerInput.makefile illegalDerInput.libs illegalDerInput.log output.log
//
// Derivatives of top-level inputs must be reported in --daeMode the same way
// as in the ODE mode instead of generating C code that does not compile.

loadString("
model illegalDerInput
  input Real u;
  output Real y;
equation
  y = der(u);
end illegalDerInput;
"); getErrorString();

buildModel(illegalDerInput); getErrorString();
setCommandLineOptions("--daeMode"); getErrorString();
buildModel(illegalDerInput); getErrorString();

