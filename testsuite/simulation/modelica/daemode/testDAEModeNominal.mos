// name: testDAEModeNominal
// keywords: daeMode nominal parameter
// status: correct
// teardown_command: rm -f DAEModeNominal* output.log
//
// In daeMode, nominal attributes that depend on parameters must be set at
// runtime, as without daeMode.

loadString("
model DAEModeNominal
  parameter Real UNom = 400e3;
  final parameter Real VBase = UNom/sqrt(3);
  Real x(start = 1, nominal = VBase);
  Real y(start = 1, nominal = VBase);
  Real z(start = 1, nominal = VBase);
equation
  x^2 + y^2 = 2*VBase^2;
  x - y = time;
  der(z) = x - z;
end DAEModeNominal;
"); getErrorString();

setCommandLineOptions("--daeMode"); getErrorString();
simulate(DAEModeNominal, stopTime=0.1, simflags="-lv=LOG_INIT_V"); getErrorString();

