// name: testDAEModeStateSetAndDummyStates
// keywords: daeMode, dummyDerivatives, index reduction, #8618
// status: correct
// teardown_command: rm -rf StateSetAndDummyStates* output.log
//
// One level of the state selection gives a static dummy state (b) and a state
// set ({vx, vy}). With --indexReductionMethod=dummyDerivatives, which
// --daeMode uses, both must become dummy states, else the system is
// over-determined.

loadString("
model StateSetAndDummyStates
  parameter Real L = 1, g = 9.81;
  Real x(start = 0.6, fixed = true), y(start = -0.8), vx(start = 0, fixed = true), vy, F;
  Real a(start = 1, fixed = true), b, w;
equation
  der(x) = vx;
  der(y) = vy;
  der(vx) = -F*x + 0.1*b;
  der(vy) = -F*y - g;
  x^2 + y^2 = L^2;
  der(a) = -a;
  b = sin(a);
  w = der(b);
end StateSetAndDummyStates;
"); getErrorString();

setCommandLineOptions("--daeMode"); getErrorString();
simulate(StateSetAndDummyStates, stopTime = 1); getErrorString();
val(x, 1.0);
val(y, 1.0);
val(w, 1.0);

setCommandLineOptions("--daeMode=false --indexReductionMethod=dummyDerivatives"); getErrorString();
simulate(StateSetAndDummyStates, stopTime = 1); getErrorString();
val(x, 1.0);
val(y, 1.0);
val(w, 1.0);

