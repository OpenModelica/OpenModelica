// name: testDAEModeTimeEventTinyStep
// keywords: daeMode, ida, time events
// status: correct
// teardown_command: rm -rf DAETinyStep* output.log
//
// `time > 0` has its time event at nextafter(0) = 4.9e-324. IDA extrapolates
// a step that short in --daeMode as well, so the time reaches the event.

loadString("
model DAETinyStep
  Real x(start = 1, fixed = true);
  Real y;
  Boolean b = time > 0;
equation
  der(x) = if b then y - x else 0;
  y^3 + y = x;
end DAETinyStep;
"); getErrorString();

setCommandLineOptions("--daeMode"); getErrorString();
simulate(DAETinyStep, stopTime = 1, method = "ida", simflags = "-alarm=60"); getErrorString();
val(x, 1.0);
// Result:
// true
// ""
// true
// ""
