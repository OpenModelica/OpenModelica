// name:     RecordStructs
// keywords: record codegen
// status: correct
// teardown_command: rm -rf RecordStructs.M* output.log
//
// A record declared with modifiers (record Recent = Wall(...)) has a struct of
// its own, and a record that only differs in its array sizes from another one
// is passed where that one is expected.
//

loadFile("RecordStructs.mo"); getErrorString();
simulate(RecordStructs.M, stopTime=0); getErrorString();
val(g, 0);
val(n, 0);

