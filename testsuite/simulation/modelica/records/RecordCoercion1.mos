// name:     RecordCoercion1.mos
// keywords: record coercion parameter binding constant replacement
// status:   correct
// teardown_command: rm -rf RecordCoercion1.M* output.log
//
// Passing a record where a different record type is expected builds a record
// expression from the elements of the record that was given. Those elements
// are not the target record's, so the target's declaration defaults must not
// be substituted for them. They were, whenever the binding was run through a
// replacement: dps came out as 1 + 10*2 = 21 instead of 5 + 10*6 = 65.

loadString("
package RecordCoercion1
  record Con
    Real a = 1.0;
    Real b = 2.0;
  end Con;

  record Geo \"the elements of Con, declared in a different order\"
    Real b = 6.0;
    Real a = 5.0;
  end Geo;

  function use
    input Con c;
    output Real y;
  algorithm
    y := c.a + 10.0 * c.b;
    annotation(Inline = false);
  end use;

  model M
    parameter Geo geometry;
    parameter Real dps = use(geometry);
    Real y = dps + time;
  end M;
end RecordCoercion1;
"); getErrorString();

simulate(RecordCoercion1.M, stopTime = 0.0); getErrorString();

val(dps, 0.0); getErrorString();

