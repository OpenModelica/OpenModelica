// name:     RecordNested1.mos
// keywords: record nested complex equation cse
// status:   correct
// teardown_command: rm -rf NRec.M* output.log
//
// The two identical calls are merged by CSE, which leaves a record equation
// whose left hand side is a record expression over the scalarized variables.
// Splitting it up paired the nested record NRec.Inner(s1.liq.phase, s1.liq.T)
// with the cref $TMP_NRec_Sat.liq and gave up on it:
//   SimCodeUtil.makeSES_SIMPLE_ASSIGN failed for: ...
//   Internal error No support of solving not real variables with a non-linear
//   solver
// The phase element makes the fallback to a non-linear system impossible, so
// the nested record has to be split up element-wise as well.

loadString("
package NRec
  record Inner
    Integer phase;
    Real T;
  end Inner;

  record Sat
    Real psat;
    Inner liq;
  end Sat;

  function setSat
    input Real p;
    output Sat s;
  algorithm
    s := Sat(p, Inner(if p > 2.0 then 2 else 1, 300.0 + p));
    annotation(Inline = false);
  end setSat;

  model M
    Real p = 1.0 + time;
    Sat s1;
    Sat s2;
    Real x;
  equation
    s1 = setSat(p);
    s2 = setSat(p);
    x = s1.liq.T + s2.liq.T + s1.liq.phase;
  end M;
end NRec;
"); getErrorString();

simulate(NRec.M, stopTime = 2.0); getErrorString();

val(x, 2.0); getErrorString();

// Result:
// true
// ""
// record SimulationResult
//     resultFile = "NRec.M_res.mat",
//     simulationOptions = "startTime = 0.0, stopTime = 2.0, numberOfIntervals = 500, tolerance = 1e-6, method = 'dassl', fileNamePrefix = 'NRec.M', options = '', outputFormat = 'mat', variableFilter = '.*', cflags = '', simflags = ''",
//     messages = "LOG_SUCCESS       | info    | The initialization finished successfully without homotopy method.
// LOG_SUCCESS       | info    | The simulation finished successfully.
// "
// end SimulationResult;
// ""
// 608.0
// ""
// endResult
