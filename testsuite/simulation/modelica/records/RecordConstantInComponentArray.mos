// name:     RecordConstantInComponentArray
// keywords: record constant array
// status:   correct
// teardown_command: rm -rf RecordConstantInComponentArray.NoMod* RecordConstantInComponentArray.ArrMod* RecordConstantInComponentArray.Nested* output.log
//
// A record with a constant element, modified per element of an array of
// components and passed to a function.
//

loadString("
package RecordConstantInComponentArray
  record R
    constant Integer n = 1;
    parameter Real c = 1;
  end R;

  function g
    input Real x;
    input R r;
    output Real y;
  algorithm
    y := r.c*x + r.n + sum(ones(r.n));
  end g;

  model Cell
    parameter R r;
    Real y = g(time, r);
  end Cell;

  model NoMod
    Cell cell[2];
  end NoMod;

  model ArrMod
    Cell cell[2](r(n = {2, 3}, c = {1, 2}));
  end ArrMod;

  model Nested
    NoMod a[2];
    ArrMod b;
  end Nested;
end RecordConstantInComponentArray;
"); getErrorString();

simulate(RecordConstantInComponentArray.NoMod, stopTime=1); getErrorString();
val(cell[1].y, 1);
val(cell[2].y, 1);
simulate(RecordConstantInComponentArray.ArrMod, stopTime=1); getErrorString();
val(cell[1].y, 1);
val(cell[2].y, 1);
simulate(RecordConstantInComponentArray.Nested, stopTime=1); getErrorString();
val(a[2].cell[1].y, 1);
val(b.cell[2].y, 1);
