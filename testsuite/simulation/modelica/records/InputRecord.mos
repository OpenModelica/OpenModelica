// name:     InputRecord
// keywords: record, #13524
// status:   correct
// cflags:   -d=newInst

loadString("
model InputRecord
  record R
    Real x;
  end R;
  input R u;
  output R y;
equation
  y = u;
end InputRecord;
"); getErrorString();

simulate(InputRecord); getErrorString();

