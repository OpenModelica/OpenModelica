// name:     Modelica.Mechanics.Rotational.Examples.HeatLosses
// keywords: simulation MSL Examples
// status: correct
// depends: Modelica.Mechanics.Rotational.Examples.HeatLosses_eqs_prof.json
// cflags: -d=-newInst
//
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica,{"4.1.0"});
setMatchingAlgorithm("PFPlusExt");
setIndexReductionMethod("dynamicStateSelection");
setDebugFlags("hpcom"); getErrorString();
setCommandLineOptions("+n=2 +hpcomScheduler=list +hpcomCode=pthreads"); getErrorString();
simulate(Modelica.Mechanics.Rotational.Examples.HeatLosses);
getErrorString();

// Not compared, they differ from the official MSL reference: oneWayClutch.stuck, oneWayClutch.startForward, lossyGear.mode, clutch.startBackward, clutch.mode, brake.startForward, brake.mode, bearingFriction.mode
res := OpenModelica.Scripting.compareSimulationResults("Modelica.Mechanics.Rotational.Examples.HeatLosses_res.mat",
  getEnvironmentVar("REFERENCEFILES")+"/msl41/Modelica.Mechanics.Rotational.Examples.HeatLosses.mat",
  "Modelica.Mechanics.Rotational.Examples.HeatLosses_diff.csv",0.01,0.0001,
{"clutch.phi_rel", "clutch.w_rel", "damper.phi_rel", "damper.w_rel", "elastoBacklash.phi_rel", "elastoBacklash.w_rel", "inertia5.phi", "inertia5.w", "oneWayClutch.phi_rel", "oneWayClutch.w_rel", "springDamper.phi_rel", "springDamper.w_rel", "bearingFriction.startBackward", "bearingFriction.startForward", "brake.startBackward", "clutch.startForward"});


