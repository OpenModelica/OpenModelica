// name:     Modelica.Electrical.Machines.Examples.SynchronousMachines.SMEE_LoadDump
// keywords: simulation MSL Examples
// status: correct
// suite: disabled
// With MSL 4.1 and dynamicStateSelection the machine currents deviate from the
// reference by more than 1 %; with the default state selection they match.
// cflags: -d=-newInst
//
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica,{"4.1.0"}); getErrorString();

setMatchingAlgorithm("PFPlusExt"); getErrorString();
setIndexReductionMethod("dynamicStateSelection"); getErrorString();
setDebugFlags("hpcom"); getErrorString();
setCommandLineOptions("+n=4 +hpcomScheduler=mcp"); getErrorString();
simulate(Modelica.Electrical.Machines.Examples.SynchronousMachines.SMEE_LoadDump); getErrorString();

res := OpenModelica.Scripting.compareSimulationResults("Modelica.Electrical.Machines.Examples.SynchronousMachines.SMEE_LoadDump_res.mat",
  getEnvironmentVar("REFERENCEFILES")+"/msl41/Modelica.Electrical.Machines.Examples.SynchronousMachines.SMEE_LoadDump.mat",
  "Modelica.Electrical.Machines.Examples.SynchronousMachines.SMEE_LoadDump_diff.csv",0.01,0.0001,
  {"smee.is[1]", "smee.idq_dr[1]", "smee.idq_sr[2]", "smee.lesigma.i", "speed.phi", "voltageController.I.y", "smee.idq_sr[1]", "smee.is[2]", "speed.w", "smee.idq_rr[2]"});


