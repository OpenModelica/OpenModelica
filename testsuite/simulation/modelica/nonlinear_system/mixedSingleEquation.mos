// name: mixedSingleEquation
// keywords: event, nonlinear, relation
// status: correct
//
// #18111: at an event, the relation on the iteration variable of a single
// nonlinear equation must be evaluated at the solution.
//

loadString("
model MixedSingleEquation1
  Real y;
  Real g = if time > 0.5 then 1 else -1;
equation
  y = (if y > 0 then 0.5*y else 0.25*y) + g;
end MixedSingleEquation1;

model MixedSingleEquation2
  Real x(start = 0, fixed = true);
  Real y;
  Real g = if x > 0.5 then 1 else -1;
equation
  der(x) = 1;
  y = (if y > 0 then 0.5*y else 0.25*y) + g;
end MixedSingleEquation2;
"); getErrorString();

simulate(MixedSingleEquation1, stopTime = 1); getErrorString();
val(y, 0.25); val(y, 0.75);
simulate(MixedSingleEquation2, stopTime = 1); getErrorString();
val(y, 0.25); val(y, 0.75);

