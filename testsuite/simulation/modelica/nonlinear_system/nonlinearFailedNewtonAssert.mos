// name: nonlinearFailedNewtonAssert
// keywords: NLS, newton, assert
// status: correct
// teardown_command: rm -f NewtonAssert* output.log
//
// For time > 0.5 the system has no real root, and every trial point with
// y < 0 asserts. The Newton solve must fail, not accept such a point (#18336).

loadString("
function newtonAssertRoot
  input Real x;
  output Real y;
algorithm
  y := x^0.763767;
end newtonAssertRoot;

model NewtonAssert
  Real y(start = 1);
  discrete Real k(start = 1, fixed = true);
equation
  newtonAssertRoot(y) + y^3 = k;
  when time > 0.5 then
    k = -5;
  end when;
end NewtonAssert;
"); getErrorString();
simulate(NewtonAssert, stopTime = 1, simflags = "-nls=newton"); getErrorString();

// Result:
