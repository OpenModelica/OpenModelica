// name: kinsolBoundStart
// keywords: kinsol constraints min
// status: correct
// teardown_command: rm -f KinsolBoundStart*
//
// x starts on its min bound up to rounding and the first Newton step points
// below it. KINSOL must not constrain x, and a stalled step with a large
// residual must not count as a solution.

loadString("
model KinsolBoundStart
  Real x(min = 0, start = 1e-30) annotation(__OpenModelica_tearingSelect = TearingSelect.always);
  Real y(start = 3) annotation(__OpenModelica_tearingSelect = TearingSelect.always);
equation
  y^2 + 1e-3*x = 4;
  x + x^3 = 2.1 - y;
end KinsolBoundStart;
"); getErrorString();

simulate(KinsolBoundStart, stopTime = 0, simflags = "-nls=kinsol"); getErrorString();
val(x, 0);
val(y, 0);

