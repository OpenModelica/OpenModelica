// name: timeInvariantLoops
// keywords: nonlinear system parameter time-invariant #1869 #1410
// status: correct
// teardown_command: rm -rf ConstLoop1869* ParamLoop1410*
//
// A nonlinear loop that depends on parameters only is solved in the
// initialization and at events, not at every output step.

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadString("
model ConstLoop1869
  Real x, y;
  function f_sin
    input Real x;
    output Real y;
  algorithm
    y := sin(x);
    pure(Modelica.Utilities.Streams.print(\"f_sin\", \"ConstLoop1869_calls.txt\"));
  end f_sin;
equation
  x = f_sin(y);
  y = cos(x);
  annotation(experiment(StopTime = 10, NumberOfIntervals = 100));
end ConstLoop1869;

model ParamLoop1410
  parameter Real p = 3;
  Real x = p*cos(x);
  Real T(start = 0, fixed = true);
equation
  der(T) = x - T;
  annotation(experiment(StopTime = 1));
end ParamLoop1410;
"); getErrorString();

writeFile("ConstLoop1869_calls.txt", ""); getErrorString();
simulate(ConstLoop1869); getErrorString();
sum(1 for l in strtok(readFile("ConstLoop1869_calls.txt"), "\n")) < 30;
val(x, 10); val(y, 10);

simulate(ParamLoop1410); getErrorString();
val(x, 1); val(T, 1);
simulate(ParamLoop1410, simflags="-override=p=2"); getErrorString();
val(x, 1); val(T, 1);
