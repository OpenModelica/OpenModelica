// name: negativeNominal
// keywords: nonlinear nominal scaling
// status: correct
// teardown_command: rm -f NegativeNominal* ZeroNominal*
//
// x starts at 0 and has a negative nominal, also one bound to a parameter.
// The solvers scale by the nominal, which must not give a scale factor of 0
// and an iteration variable of NaN. A nominal of 0 gives a warning.

loadString("
model NegativeNominal
  Real x(start = 0, nominal = -2);
equation
  x + x^3 = -10;
end NegativeNominal;
"); getErrorString();

simulate(NegativeNominal, stopTime = 0); getErrorString();
val(x, 0);
simulate(NegativeNominal, stopTime = 0, simflags = "-nls=hybrid"); getErrorString();
val(x, 0);

loadString("
model NegativeNominalParameter
  parameter Real p = -2;
  Real x(start = 0, nominal = p);
equation
  x + x^3 = -10;
end NegativeNominalParameter;
"); getErrorString();

simulate(NegativeNominalParameter, stopTime = 0, simflags = "-nls=kinsol"); getErrorString();
val(x, 0);

loadString("
model ZeroNominal
  parameter Real p = 0;
  Real x(start = 0, nominal = 0);
  Real y(start = 0, nominal = p);
equation
  x + x^3 = -10;
  y + y^3 = -10;
end ZeroNominal;
"); getErrorString();

simulate(ZeroNominal, stopTime = 0); getErrorString();
val(x, 0);
val(y, 0);

