// name: wrapFunctionCalls15
// keywords: cse, wrapFunctionCalls, lateInlineFunction, #14185
// status: correct
//
// A late-inlined tuple call (a, _, c) = (core(..)[1], core(..)[2], core(..)[3])
// with a zero-sized array output must not get $cse variables for the wildcard.

loadString("
package CSE
  model wrapFunctionCalls15
    function core
      input Real x;
      input Real xi[:];
      output Real a;
      output Real b[size(xi, 1)];
      output Real c;
    algorithm
      a := x;
      b := xi;
      c := 2*x;
      annotation(Inline=false);
    end core;

    function wrapper
      input Real x;
      input Real xi[:];
      output Real a;
      output Real b[size(xi, 1)];
      output Real c;
    algorithm
      (a, b, c) := core(x, xi);
      annotation(Inline=false, LateInline=true);
    end wrapper;

    Real a, c;
    Real b[0];
  equation
    (a, b, c) = wrapper(time, fill(0.5, 0));
  end wrapFunctionCalls15;
end CSE;
"); getErrorString();

setCommandLineOptions("-d=dumpCSE"); getErrorString();
simulate(CSE.wrapFunctionCalls15); getErrorString();

