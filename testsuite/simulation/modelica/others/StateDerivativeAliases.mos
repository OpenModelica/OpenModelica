// name: StateDerivativeAliases
// keywords: result file alias derivative state
// status: correct
// teardown_command: rm -f StateDerivativeAliases_* StateDerivativeAliases StateDerivativeAliases.c StateDerivativeAliases.exe StateDerivativeAliases.libs StateDerivativeAliases.log StateDerivativeAliases.makefile StateDerivativeAliases.o output.log
//
// The result file has der(y) and der(z) for the aliases y = x and z = -x of
// the state x, with the old and the new backend.

loadString("
model StateDerivativeAliases
  Real x(start = 1, fixed = true);
  Real y = x;
  Real z = -x;
equation
  der(x) = -x;
end StateDerivativeAliases;
"); getErrorString();

simulate(StateDerivativeAliases, variableFilter="der.y.|der.z."); getErrorString();
readSimulationResultVars("StateDerivativeAliases_res.mat", readParameters=false); getErrorString();
val(der(y), 1.0, "StateDerivativeAliases_res.mat"); getErrorString();
val(der(z), 1.0, "StateDerivativeAliases_res.mat"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
simulate(StateDerivativeAliases, variableFilter="der.y.|der.z."); getErrorString();
readSimulationResultVars("StateDerivativeAliases_res.mat", readParameters=false); getErrorString();
val(der(y), 1.0, "StateDerivativeAliases_res.mat"); getErrorString();
val(der(z), 1.0, "StateDerivativeAliases_res.mat"); getErrorString();

