// name: FilterSimulationResultsRemoveDescription
// keywords: filterSimulationResults removeDescription
// status: correct
// teardown_command: rm -f FilterSimulationResultsRemoveDescription_* FilterSimulationResultsRemoveDescription FilterSimulationResultsRemoveDescription.c FilterSimulationResultsRemoveDescription.exe FilterSimulationResultsRemoveDescription.libs FilterSimulationResultsRemoveDescription.log FilterSimulationResultsRemoveDescription.makefile FilterSimulationResultsRemoveDescription.o output.log
//
// A result file filtered with removeDescription=true reads back (#17958).

loadString("
model FilterSimulationResultsRemoveDescription
  parameter Real k = 2 \"a parameter\";
  Real x(start = 1, fixed = true) \"a state\";
equation
  der(x) = -k * x;
end FilterSimulationResultsRemoveDescription;
"); getErrorString();

simulate(FilterSimulationResultsRemoveDescription, stopTime=1.0, numberOfIntervals=10); getErrorString();
filterSimulationResults("FilterSimulationResultsRemoveDescription_res.mat", "FilterSimulationResultsRemoveDescription_f.mat", {"x", "k"}, removeDescription=true); getErrorString();
readSimulationResultVars("FilterSimulationResultsRemoveDescription_f.mat", readParameters=true, openmodelicaStyle=true); getErrorString();
{val(x, 1.0, "FilterSimulationResultsRemoveDescription_f.mat"), val(k, 1.0, "FilterSimulationResultsRemoveDescription_f.mat")}; getErrorString();

