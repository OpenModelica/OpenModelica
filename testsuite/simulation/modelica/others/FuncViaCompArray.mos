// name: FuncViaCompArray
// keywords: function lookup component array default argument
// status: correct
//
// Functions called via a component in an array of components, where the
// default arguments refer to the component: a plain default, a default
// modified on the function in the component, a record and a function pointer.

loadString("
package P
  function f
    input Real x;
    input Real k;
    input Real z = 0;
    output Real y = k * x + z;
  end f;

  record R
    parameter Real c = 1;
  end R;

  function h
    input Real x;
    input R r;
    output Real y = r.c * x;
  end h;

  partial function F
    input Real x;
    output Real y;
  end F;

  function apply
    input F fp;
    input Real x;
    output Real y = fp(x);
    annotation(Inline = false);
  end apply;

  model Obj
    parameter Real k = 1;
    parameter R r;
    function g = f(final k = k);
    function gr = h(final r = r);
  end Obj;

  model Cell
    parameter Real k = 1;
    parameter Real zc = 0;
    Obj obj(k = k, r(c = 2 * k), g(z = zc));
    Real y = obj.g(time);
    Real yr = obj.gr(time);
    Real yp = apply(function obj.g(), time);
  end Cell;

  model Test
    Cell cell[3](k = {1, 2, 3}, zc = {10, 20, 30});
  end Test;
end P;
"); getErrorString();

simulate(P.Test, stopTime = 1); getErrorString();
val(cell[1].y, 1); val(cell[2].y, 1); val(cell[3].y, 1);
val(cell[1].yr, 1); val(cell[2].yr, 1); val(cell[3].yr, 1);
val(cell[1].yp, 1); val(cell[2].yp, 1); val(cell[3].yp, 1);

