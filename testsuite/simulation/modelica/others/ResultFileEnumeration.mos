// name: ResultFileEnumeration
// keywords: result file enumeration Boolean type init xml
// status: correct
// teardown_command: rm -f ResultFileEnumeration_* ResultFileEnumeration ResultFileEnumeration.c ResultFileEnumeration.exe ResultFileEnumeration.libs ResultFileEnumeration.log ResultFileEnumeration.makefile ResultFileEnumeration.o output.log
//
// The init XML names the enumeration type of every enumeration variable and
// lists the literals of each type once, for scalars and for an array kept
// whole, so the runtime can type the signals of the result file (#14952).

loadString("
model ResultFileEnumeration
  type Mode = enumeration(Off \"switched off\", Heat, Cool);
  type Level = enumeration(Low, High);
  parameter Mode pm = Mode.Heat \"a parameter\";
  Mode m(start = Mode.Off, fixed = true) \"a mode\";
  Mode ma \"alias of m\";
  Level lv[2] \"used only in an array\";
  Boolean b \"a flag\";
  Integer i \"a counter\";
  Real x \"a real\";
equation
  when sample(0, 0.25) then
    m = if pre(m) == Mode.Cool then Mode.Off else if pre(m) == Mode.Off then Mode.Heat else Mode.Cool;
  end when;
  ma = m;
  lv = {if time < 0.5 then Level.Low else Level.High, Level.High};
  b = time > 0.4;
  i = integer(10*time);
  x = time;
end ResultFileEnumeration;
"); getErrorString();

simulate(ResultFileEnumeration, stopTime=1.0, numberOfIntervals=10, fileNamePrefix="ResultFileEnumeration_s"); getErrorString();
regex(readFile("ResultFileEnumeration_s_init.xml"), "<TypeDefinitions>.*</TypeDefinitions>");
regex(readFile("ResultFileEnumeration_s_init.xml"), "<Integer declaredType=\"Mode\" start=\"2\"");
regex(readFile("ResultFileEnumeration_s_init.xml"), "<Integer declaredType=\"Level\"");
{val(m, 0.3, "ResultFileEnumeration_s_res.mat"), val(ma, 0.3, "ResultFileEnumeration_s_res.mat"), val(pm, 0.3, "ResultFileEnumeration_s_res.mat"), val(lv[1], 0.9, "ResultFileEnumeration_s_res.mat"), val(b, 0.9, "ResultFileEnumeration_s_res.mat")};
// The literals follow data_2, where the readers do not look.
filterSimulationResults("ResultFileEnumeration_s_res.mat", "ResultFileEnumeration_f.mat", {"m", "lv[1]"}); getErrorString();
{val(m, 0.3, "ResultFileEnumeration_f.mat"), val(lv[1], 0.9, "ResultFileEnumeration_f.mat")};
simulate(ResultFileEnumeration, stopTime=1.0, numberOfIntervals=10, fileNamePrefix="ResultFileEnumeration_y", simflags="-mat_sync=3"); getErrorString();
diffSimulationResults("ResultFileEnumeration_y_res.mat", "ResultFileEnumeration_s_res.mat", "ResultFileEnumeration_diff", relTol=1e-12); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();
simulate(ResultFileEnumeration, stopTime=1.0, numberOfIntervals=10, fileNamePrefix="ResultFileEnumeration_a"); getErrorString();
regex(readFile("ResultFileEnumeration_a_init.xml"), "<TypeDefinitions>.*</TypeDefinitions>");
regex(readFile("ResultFileEnumeration_a_init.xml"), "<Dimension start=\"2\"/>[[:space:]]*<Integer declaredType=\"Level\"");
{val(m, 0.3, "ResultFileEnumeration_a_res.mat"), val(lv[1], 0.9, "ResultFileEnumeration_a_res.mat"), val(lv[2], 0.1, "ResultFileEnumeration_a_res.mat")};

