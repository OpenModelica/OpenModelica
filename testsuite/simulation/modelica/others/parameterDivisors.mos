// name:     parameterDivisors
// keywords: simulation division parameter
// status:   correct
// teardown_command: rm -rf ParamDiv ParamDiv.exe ParamDiv.c ParamDiv_* ParamDiv.libs ParamDiv.log ParamDiv.makefile output.log
//
// A divisor that only depends on parameters is checked once, after the
// parameter equation of b (#4871). p is only a divisor in an if-branch, so it
// can be zero. k has fixed = false, so the division by k keeps its own check.

loadString("
model ParamDiv
  parameter Real a = 2;
  parameter Real b = 3*a;
  parameter Real p = 0;
  parameter Real k(fixed = false);
  Real x(start = 1, fixed = true);
  Real y;
  Real z;
initial equation
  k = 2*a;
equation
  der(x) = -x/(a*b);
  y = if p > 0 then x/p else 0;
  z = x/k;
end ParamDiv;
"); getErrorString();

simulate(ParamDiv, stopTime = 1); getErrorString();
val(x, 1.0, "ParamDiv_res.mat");
val(z, 1.0, "ParamDiv_res.mat");
simulate(ParamDiv, stopTime = 1, simflags = "-override a=0"); getErrorString();
