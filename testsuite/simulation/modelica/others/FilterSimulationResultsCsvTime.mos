// name: FilterSimulationResultsCsvTime
// keywords: filterSimulationResults readSimulationResultVars readDerivatives csv time
// status: correct
// teardown_command: rm -f FilterSimulationResultsCsvTime.csv FilterSimulationResultsCsvTime_filtered.mat FilterSimulationResultsCsvTime_filtered.csv
//
// A CSV result file whose time column is called "Time", as in the MAP-LIB
// reference files, is filtered like one with a "time" column (#17793).
// readDerivatives=false leaves out der(x) and the Dymola form a.der(b) (#5028).

writeFile("FilterSimulationResultsCsvTime.csv", "\"Time\",\"x\",\"y\",\"der(x)\",\"a.der(b)\"\n0,1,10,2,0\n0.5,2,20,2,1\n1,3,30,2,2\n");
readSimulationResultVars("FilterSimulationResultsCsvTime.csv", readDerivatives=false); getErrorString();
filterSimulationResults("FilterSimulationResultsCsvTime.csv", "FilterSimulationResultsCsvTime_filtered.mat", {"y", "der(x)", "a.der(b)"}); getErrorString();
readSimulationResultVars("FilterSimulationResultsCsvTime_filtered.mat", readParameters=true, openmodelicaStyle=true); getErrorString();
readSimulationResultVars("FilterSimulationResultsCsvTime_filtered.mat", readDerivatives=false); getErrorString();
val(y, 0.5, "FilterSimulationResultsCsvTime_filtered.mat"); getErrorString();
filterSimulationResults("FilterSimulationResultsCsvTime.csv", "FilterSimulationResultsCsvTime_filtered.csv", {"x"}); getErrorString();
readFile("FilterSimulationResultsCsvTime_filtered.csv");

// Result:
// true
// {"Time", "x", "y"}
// ""
// true
// ""
// {"der(a.b)", "der(x)", "time", "y"}
// ""
// {"time", "y"}
// ""
// 20.0
// ""
// true
// ""
// "time,\"x\"
// 0,1
// 0.5,2
// 1,3
// "
// endResult
