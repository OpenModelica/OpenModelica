// name: CsvParameterAlias
// keywords: csv, alias, variableFilter, #7624
// status: correct
// teardown_command: rm -f CsvParameterAlias_* CsvParameterAlias CsvParameterAlias.exe CsvParameterAlias.c CsvParameterAlias.libs CsvParameterAlias.makefile CsvParameterAlias.log output.log
//
// A variable that is an alias of a parameter is a column of the .csv file.
// The parameters are not.

loadString("
model CsvParameterAlias
  parameter Real p = 2;
  parameter Integer n = 3;
  parameter Boolean b = true;
  Real x = time;
  Real y = p;
  Real z = -p;
  Integer m = n;
  Boolean c = not b;
end CsvParameterAlias;
"); getErrorString();
simulate(CsvParameterAlias, numberOfIntervals=1, outputFormat="csv", variableFilter="x|y|z|m|c"); getErrorString();
readFile("CsvParameterAlias_res.csv");

