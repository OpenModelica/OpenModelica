// name: DiffSimulationResultsAlgorithm
// keywords: diffSimulationResults algorithm rectangle
// status: correct
// teardown_command: rm -f DiffSimulationResultsAlgorithm_ref.csv DiffSimulationResultsAlgorithm_res.csv
//
// All tubes interpolate the result onto the reference points, so none sees
// the spike at 1.5. Near zero, the rectangle is wider than ellipse2014.

writeFile("DiffSimulationResultsAlgorithm_ref.csv", "time,x\n0,0\n1,0\n2,0\n3,0\n");
writeFile("DiffSimulationResultsAlgorithm_res.csv", "time,x\n0,0\n0.5,0\n1,1e-6\n1.5,1\n2,0\n3,0\n");
diffSimulationResults("DiffSimulationResultsAlgorithm_res.csv", "DiffSimulationResultsAlgorithm_ref.csv", ""); getErrorString();
diffSimulationResults("DiffSimulationResultsAlgorithm_res.csv", "DiffSimulationResultsAlgorithm_ref.csv", "", tube=OpenModelica.Scripting.TubeAlgorithm.rectangle); getErrorString();

// Result:
// true
// true
