// name:      nestedRecordOutput
// keywords:  evalConstFunc
// status:    correct
//
// Only o.c is constant, so evalFunc has to scalarize the remaining outputs of a
// nested record containing an array. The generated function used to keep the
// whole-record assignment while dropping the record variable, and collapsed all
// elements of o.i.b into a single output.
//

loadFile("nestedRecordOutput.mo"); getErrorString();
simulate(nestedRecordOutput, stopTime=1.0); getErrorString();

val(o.i.a, 1.0);
val(o.i.b[1], 1.0);
val(o.i.b[3], 1.0);
val(o.c, 1.0);
val(z, 1.0);

