loadModel(Modelica, {"4.1.0"}); getErrorString();
loadFile("asmaFlow.mo"); getErrorString();
simulate(asmaFlow); getErrorString();
val(aimc.flange.tau, 0);
val(aimc.inertiaRotor.flange_b.tau, 0);

