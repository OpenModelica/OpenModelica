// name: zeroJacobian
// status: correct
// teardown_command: rm -f ZeroLinearJacobian*
//
// The redundant initial equation gives a singular torn linear system whose
// Jacobian has no column equations.

loadString("
model ZeroLinearJacobian
  Real x;
  Real y;
initial equation
  y = x;
equation
  der(x) = 1 - x;
  y = x;
end ZeroLinearJacobian;
"); getErrorString();
simulate(ZeroLinearJacobian); getErrorString();
val(x, 0.0);
val(y, 1.0);

