// name: totalPivotResidual
// status: correct
// teardown_command: rm -f TotalPivotInf*
//
// c = 0 puts -inf into the torn linear system. The total pivot solver must
// fail and not accept the step of 0 that the -inf pivot gives (#18253).
// -d=-parameterDivisors removes the parameter check that finds c = 0 first.

loadString("
model TotalPivotInf
  parameter Real c = 1;
  parameter Real pAtm = 101325;
  Real d;
  Real p;
  Real pWin;
equation
  pWin = 0.5*c*d;
  p = pAtm + pWin;
  d = 1.2/101325*p;
end TotalPivotInf;
"); getErrorString();
setCommandLineOptions("-d=-parameterDivisors"); getErrorString();
simulate(TotalPivotInf, stopTime = 1, numberOfIntervals = 4, simflags = "-override=c=0"); getErrorString();
simulate(TotalPivotInf, stopTime = 1, numberOfIntervals = 4, simflags = "-override=c=0 -ls=totalpivot"); getErrorString();

