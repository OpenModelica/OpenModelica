// name: inlineArraySimplifyLoops
// keywords: simplifyLoops inline append
// status: correct
//
// simplifyLoops keeps a term in the loop when it uses a loop variable
// through its whole array, here the inlined output of f in sum(f(x)).
//

setCommandLineOptions("+inlineMethod=append +simplifyLoops=2"); getErrorString();
loadString("
model SumOfCall
  function f
    input Real[5] x;
    output Real[7] y;
  protected
    Real sumx = exp(-sqrt(sum(x)));
  algorithm
    y[1] := sumx^2;
    y[2] := 2*sumx^2;
    y[3] := 3*sumx^2;
    y[4] := 4*sumx^2;
    y[5] := 5*sumx^2;
    y[6] := 6*sumx^2;
    y[7] := 7*sumx^2;
    annotation(Inline=true);
  end f;

  Real y(fixed = true, start = 1);
  Real v(fixed = true, start = -1);
  Real a;
  Real[5] x;
equation
  x[1] = a + 2*sin(time) + 1;
  x[2] = a + sin(time) + 1;
  x[3] = a + 7*sin(time) + 1;
  x[4] = a + 2*sin(time) + 1;
  x[5] = x[3] + a + cos(a) + 6*sin(time) + 2;
  a = sum(f(x))/10;
  der(y) = cos(sum(f(x)))*der(v) + cos(time);
  der(v) = der(y)*2;
end SumOfCall;
"); getErrorString();
simulate(SumOfCall); getErrorString();
val(a, {0.0, 0.5, 1.0});
val(y, {0.0, 0.5, 1.0});

// Result:
// true
// ""
// true
