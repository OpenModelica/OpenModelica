// name: inlineSliceArgument
// keywords: inline, slice, subscript #18300
// status: correct
//
// A subscript in the body of an inlined function selects from the dimensions
// that the slices and whole dimensions of the argument leave.

loadString("
model inlineSliceArgument
  function swapRows
    input Real x[:, :];
    output Real y[size(x, 1), size(x, 2)];
  algorithm
    y := {x[2, :], x[1, :]};
    annotation(Inline = true);
  end swapRows;

  function swapColumns
    input Real x[:, :];
    output Real y[2, size(x, 1)];
  algorithm
    y := {x[:, 2], x[:, 1]};
    annotation(Inline = true);
  end swapColumns;

  function element21
    input Real x[:, :];
    output Real y = x[2, 1];
    annotation(Inline = true);
  end element21;

  function second
    input Real x[:];
    output Real y = x[2];
    annotation(Inline = true);
  end second;

  Real a[3, 3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}}*time;
  Real rows[2, 3] = swapRows(a[2:3, :]);
  Real columns[2, 2] = swapColumns(a[1:2, 2:3]);
  Real columns2[2, 2] = swapColumns(2*a[1:2, 2:3]);
  Real columns3[2, 2] = swapColumns({{1, 2, 3}, {4, 5, 6}}*time);
  Real e1 = element21(a[{3, 1}, :]);
  Real e2 = element21(2*a[2:3, :]);
  Real s1 = second(a[2, 1:3]);
  Real s2 = second(a[1:3, 3]);
end inlineSliceArgument;
"); getErrorString();

simulate(inlineSliceArgument, stopTime = 1.0); getErrorString();

// {{7, 8, 9}, {4, 5, 6}}
val(rows[1, 1], 1.0);
val(rows[1, 3], 1.0);
val(rows[2, 1], 1.0);
val(rows[2, 3], 1.0);
// {{3, 6}, {2, 5}}
val(columns[1, 1], 1.0);
val(columns[1, 2], 1.0);
val(columns[2, 1], 1.0);
val(columns[2, 2], 1.0);
// {{6, 12}, {4, 10}}
val(columns2[1, 1], 1.0);
val(columns2[1, 2], 1.0);
val(columns2[2, 1], 1.0);
val(columns2[2, 2], 1.0);
// {{2, 5}, {1, 4}}
val(columns3[1, 1], 1.0);
val(columns3[1, 2], 1.0);
val(columns3[2, 1], 1.0);
val(columns3[2, 2], 1.0);
// 1, 14, 5, 6
val(e1, 1.0);
val(e2, 1.0);
val(s1, 1.0);
val(s2, 1.0);

// Result:
// true
