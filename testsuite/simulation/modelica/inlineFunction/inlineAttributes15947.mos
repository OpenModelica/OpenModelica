// name: inlineAttributes15947
// keywords: inline attributes min max nominal unit
// status: correct
// teardown_command: rm -rf InlineAttr15947*
// cflags: -d=omedit
//
// Tests that function input/output attributes (min/max/nominal/unit) are not
// dropped when a function is inlined, in both the old and the new backend.
// The declared attributes are carried onto the model variables bound to the
// function inputs/outputs. See
// https://github.com/OpenModelica/OpenModelica/issues/15947

loadString("
function fin
  input  Real x(min = 5.0, max = 50.0, nominal = 10.0, unit = \"K\");
  output Real y(min = 1.0, max = 99.0, nominal = 20.0, unit = \"Pa\");
algorithm
  y := x * 2.0;
  annotation(Inline = true);
end fin;

function finI
  input  Integer xi(min = 2, max = 8);
  output Integer yi(min = 1, max = 20);
algorithm
  yi := xi * 2;
  annotation(Inline = true);
end finI;

model InlineAttr15947
  Real z, a;
  Integer zi, ai;
equation
  z = fin(a);
  a = 3.0 - time;
  zi = finI(ai);
  ai = integer(time) + 1;
end InlineAttr15947;
"); getErrorString();

// Each declared attribute should show up in the init file on the model
// variable bound to the function input/output, in both backends.

// old backend (default)
translateModel(InlineAttr15947); getErrorString();
readInitFile("InlineAttr15947_init.bin"); getErrorString();

// new backend
setCommandLineOptions("--newBackend=true"); getErrorString();
translateModel(InlineAttr15947); getErrorString();
readInitFile("InlineAttr15947_init.bin"); getErrorString();

// Result:
// true
// ""
// true
// ""
// "model InlineAttr15947
// sizes numberOfRealAlgebraicVariables=2 numberOfIntegerAlgebraicVariables=2 numberOfEventIndicators=1
// experiment startTime=0.0 stopTime=1.0 stepSize=0.002 tolerance=1e-6 solver=dassl outputFormat=mat variableFilter=\".*\"
// rAlg a Real continuous useNominal start=3.0 min=5.0 max=50.0 nominal=10.0 unit=\"K\"
// rAlg z Real continuous useNominal start=6.0 min=1.0 max=99.0 nominal=20.0 unit=\"Pa\"
// iAlg ai Integer discrete min=2 max=8
// iAlg zi Integer discrete min=1 max=20
// "
// ""
// true
// ""
// true
// ""
// "model InlineAttr15947
// sizes numberOfRealAlgebraicVariables=3 numberOfIntegerAlgebraicVariables=3 numberOfEventIndicators=1 numberOfFunctions=2
// experiment startTime=0.0 stopTime=1.0 stepSize=0.002 tolerance=1e-6 solver=dassl outputFormat=mat variableFilter=\".*\"
// rAlg a Real continuous useNominal hideResult=false min=5.0 max=50.0 nominal=10.0 unit=\"K\"
// rAlg $FUN_1 Real continuous hideResult=true
// rAlg z Real continuous useNominal hideResult=false min=1.0 max=99.0 nominal=20.0 unit=\"Pa\"
// iAlg $FUN_2 Integer discrete hideResult=true
// iAlg zi Integer discrete hideResult=false min=1 max=20
// iAlg ai Integer discrete hideResult=false min=2 max=8
// "
// ""
// endResult
