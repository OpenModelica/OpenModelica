loadModel(Modelica, {"4.1.0"}); getErrorString();
loadFile("Ticket4258a.mo"); getErrorString();
// The default linear solver can fail on a nearly singular system and print
// warnings that depend on the solver and the platform.
echo(false);
res := simulate(simple_BasicHX_water_gas);
messages := res.messages;
echo(true);
regexBool(messages, "The simulation finished successfully"); getErrorString();

