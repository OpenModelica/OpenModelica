// name:                nameClash.mos
// keywords:            spatialDistribution
// status:              correct
//
// Check if there is a name clash

loadString("
function spatialDistributionZeroCrossing
  input Integer index;
  input Integer rindex;
  input Real xPos;
  input Boolean dir;
  output Real y;
algorithm
  y := rindex;
  annotation(Inline = false);
end spatialDistributionZeroCrossing;

model M
  Real out0, out1, y;
equation
  (out0, out1) = spatialDistribution(sin(time), 0, time, true, {0.0, 1.0}, {0.0, 1.0});
  y = if spatialDistributionZeroCrossing(0, -1, time, true) > 0 then 1 else 2;
end M;"); getErrorString();

simulate(M, stopTime=0.0); getErrorString();
val(y, 0.0);

