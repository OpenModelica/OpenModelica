// name:                duplicateSpatialDistribution.mos
// keywords:            spatialDistribution
// status:              correct
// teardown_command:    rm -f DuplicateSpatialDistribution*
//
// Two equal spatialDistribution() calls must each get their own index (#17969).

loadString("
model DuplicateSpatialDistribution
  Real x(start = 0, fixed = true);
  Real a0, a1, b0, b1, c0, c1;
equation
  der(x) = 1;
  (a0, a1) = spatialDistribution(time, 0, x, true, {0, 1}, {0, 0});
  (b0, b1) = spatialDistribution(time, 0, x, true, {0, 1}, {0, 0});
  (c0, c1) = spatialDistribution(2*time, 0, x, true, {0, 1}, {0, 0});
end DuplicateSpatialDistribution;
"); getErrorString();

simulate(DuplicateSpatialDistribution, stopTime = 1.5); getErrorString();
{val(a1, 1.5), val(b1, 1.5), val(c1, 1.5)};

// Result:
// true
