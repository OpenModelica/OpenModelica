// name: HomotopyInFunction
// keywords: homotopy, function
// status: correct
//
// homotopy in a function body has the trivial implementation, homotopy(a, s) = a.
// h2 is differentiated.

loadString("
model HomotopyInFunction
  function h
    input Real x;
    output Real y;
  algorithm
    y := homotopy(x*x, x);
  end h;

  function h2
    input Real x;
    output Real y;
  algorithm
    y := 0;
    for i in 1:2 loop
      y := y + homotopy(x*x, x);
    end for;
  end h2;

  Real y = h(time);
  Real y2 = h2(time);
  Real dy2 = der(y2) \"4*time\";
end HomotopyInFunction;
"); getErrorString();

simulate(HomotopyInFunction, stopTime = 1); getErrorString();
val(y, 0.5);
val(dy2, 0.5);
