// name:     Delay
// keywords: builtin delay
// status: correct
// teardown_command: rm -rf Delay_* Delay Delay.exe Delay.cpp Delay.makefile Delay.libs Delay.log output.log
// cflags: -d=-newInst
//
// Test builtin function delay
// Expected values are sin(2.5)-1, cos(5), sin(4.99) and sin(3)
// There must be events at time 5.0, 5.01 (delay 0.01), 5.5 (delay 0.5) and 7.5 (delay 2.5)
//

loadString("
model Delay
  Real x;
  Real y;
  Real z;
  Real w;
equation
  x = delay(y+1, 2.5);                            // event at 2.5, 7.5
  y = if time < 5 then sin(time) else cos(time);  // event at 5.0
  z = delay(y, 0.01);                             // event at 0.01, 5.01
  w = delay(delay(y, 0.5), 1.5);                  // event at (0.5?,) 2.0, (5.5?,) 7.0
end Delay;
");
simulate(Delay, startTime=0, stopTime=10, simflags="-lv=LOG_EVENTS");
val(x, 5);        // sin(2.5) + 1.0
val(y, 5.0001);   // cos(5.0001)
val(z, 5);        // sin(4.99)
val(w, 5);        // sin(3)

// Result:
// true
