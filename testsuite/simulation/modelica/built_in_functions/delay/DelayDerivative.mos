// name:     DelayDerivative
// keywords: builtin delay derivative index reduction
// status:   correct
// teardown_command: rm -rf DelayDerivative1* DelayDerivative2* DelayDerivative3*
//
// der() of a delay() expression makes a new delay() call by differentiation.
// This call must get its own delay index, also when the delay time is a
// state and delay() makes a zero crossing, and also in DAE mode. With the
// placeholder index -1 the simulation crashed (#15532).

loadString("
model DelayDerivative1
  Real y = delay(time, 1);
  Real d = der(y);
end DelayDerivative1;

model DelayDerivative2
  Real y = delay(sin(time), 1, 2);
  Real d = der(y);
end DelayDerivative2;

model DelayDerivative3
  Real td(start = 0.5, fixed = true);
  Real y = if time < td then 0 else delay(time, td, 10);
  Real d = der(y);
equation
  der(td) = 0.1;
end DelayDerivative3;
"); getErrorString();

simulate(DelayDerivative1, stopTime = 2); getErrorString();
val(d, 1.5);
simulate(DelayDerivative2, stopTime = 2); getErrorString();
val(y, 1.5);
val(d, 1.5);
simulate(DelayDerivative3, stopTime = 2); getErrorString();
val(y, 1.5);
val(d, 1.5);
setCommandLineOptions("--daeMode"); getErrorString();
simulate(DelayDerivative3, stopTime = 2, fileNamePrefix = "DelayDerivative3_dae"); getErrorString();
val(y, 1.5);
val(d, 1.5);

