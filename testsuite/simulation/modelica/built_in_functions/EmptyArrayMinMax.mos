// name:     EmptyArrayMinMax
// keywords: min max empty array
// status: correct
// teardown_command: rm -rf EmptyArrayMinMax_* EmptyArrayMinMax EmptyArrayMinMax.exe EmptyArrayMinMax.c EmptyArrayMinMax.libs EmptyArrayMinMax.log output.log
//
// max of an empty Real array is the least finite Real and min the greatest.
//

loadString("
function extremes
  input Integer n;
  output Real mx;
  output Real mn;
protected
  Real x[n] = fill(1.0, n);
algorithm
  mx := max(x);
  mn := min(x);
end extremes;

model EmptyArrayMinMax
  discrete Integer n(start = 0, fixed = true);
  Real mx, mn;
equation
  when time > 0.5 then
    n = 2;
  end when;
  (mx, mn) = extremes(n);
end EmptyArrayMinMax;
"); getErrorString();
simulate(EmptyArrayMinMax, stopTime = 1); getErrorString();
val(mx, 0);
val(mn, 0);
val(mx, 1);
val(mn, 1);

// Result:
