// name: UnparsableDisplayUnit
// keywords: unit displayUnit
// status: correct
// teardown_command: rm -f UnparsableDisplayUnit_res.mat
//
// A display unit the unit parser rejects ("%", "Ah") has no conversion, and
// simulating the model reports no error.

loadString("
model UnparsableDisplayUnit
  Real soc(unit = \"1\", displayUnit = \"%\", start = 0, fixed = true);
  Real q(unit = \"C\", displayUnit = \"Ah\");
equation
  der(soc) = 0.1;
  q = 3600 * soc;
end UnparsableDisplayUnit;
"); getErrorString();
simulate(UnparsableDisplayUnit, stopTime = 1); getErrorString();
val(q, 1);
