// name: UnitCheck16
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
model UnitCheck16
  Real x(fixed=true, start=1);
equation
  der(x) = time;
end UnitCheck16;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(UnitCheck16); getErrorString();

