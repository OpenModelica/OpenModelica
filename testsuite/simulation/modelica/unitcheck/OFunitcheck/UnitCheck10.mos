// name: UnitCheck10
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck10
    Real V;
    Real A;
    Real S(unit = \"m/s\");
  equation
    A = 5.0;
    V = 8.0;
    S = V*A;
  end UnitCheck10;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck10); getErrorString();

