// name: UnitCheck6
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck6
    Real S(unit = \"m\");
    Real V;
    Real A(unit = \"m/s2\");
  equation
    der(S) = V;
    A = der(V);
    S = 5.0;
  end UnitCheck6;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck6); getErrorString();

