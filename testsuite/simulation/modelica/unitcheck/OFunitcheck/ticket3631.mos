// name: ticket3631
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model ticket3631
    Real x(final unit = \"\");
    Real y(final unit = \"\");
  equation
    x = time;
    x + y = sin(time);
  end ticket3631;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.ticket3631); getErrorString();

