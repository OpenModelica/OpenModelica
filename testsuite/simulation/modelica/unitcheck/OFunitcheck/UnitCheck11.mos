// name: UnitCheck11
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck11
    Real V;
    Real A(unit = \"m/s\");
    Real S(unit = \"m/s\");
  equation
    A = 5.0;
    V = 8.0;
    V = S*A;
  end UnitCheck11;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck11); getErrorString();

