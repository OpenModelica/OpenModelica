// name: UnitCheck12
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck12
    Real V;
    Real A;
    Real S(unit = \"m2\");
  equation
    A = 5.0;
    V = 8.0;
    S = V^2 + sqrt(A);
  end UnitCheck12;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck12); getErrorString();

