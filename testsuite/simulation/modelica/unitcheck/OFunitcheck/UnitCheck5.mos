// name: UnitCheck5
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck5
    Real S(unit=\"\");
    Real V(unit=\"m/s\");
    Real A;
  equation
    der(S) = V;
    A = der(V);
    S = 5.0;
  end UnitCheck5;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck5); getErrorString();

