// name: UnitCheck14
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck14
    Real A;
    Real V = 1;
    Real S;
  equation
    S = time;
    A = der(S);
  end UnitCheck14;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck14); getErrorString();

