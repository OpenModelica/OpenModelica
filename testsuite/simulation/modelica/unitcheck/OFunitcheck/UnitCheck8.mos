// name: UnitCheck8
// keywords: initialization
// status: correct
// cflags: -d=-newInst

loadString("
package unitCheckTests
  model UnitCheck8
    Real S(unit = \"s\");
    Real V;
    Real A(unit = \"m/s\");
  equation
    A = 5.0;
    V = 8.0;
    0 = V - A - S;
  end UnitCheck8;
end unitCheckTests;
"); getErrorString();

setCommandLineOptions("--unitChecking -d=dumpUnits"); getErrorString();
instantiateModel(unitCheckTests.UnitCheck8); getErrorString();

