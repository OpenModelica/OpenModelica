// name: DiscreteSelfLoop
// keywords: event iteration, discrete, algebraic loop
// status: correct
// teardown_command: rm -rf DiscreteLoops.* output.log
//
// A discrete variable that depends on itself, v = f(v), is solved by the
// event iteration, not as a Real nonlinear system (#2788).
//

loadString("
package DiscreteLoops
  type Requirement = enumeration(success, unknown, violated);

  model EnumLatch
    Requirement r(start = Requirement.unknown, fixed = true);
  equation
    r = if r == Requirement.success or (time > 0.3 and time < 0.6) then Requirement.success else Requirement.unknown;
  end EnumLatch;

  model BooleanLatch
    Boolean b(start = false, fixed = true);
  equation
    b = b or (time > 0.3 and time < 0.6);
  end BooleanLatch;

  model IntegerLatch
    Integer n(start = 0, fixed = true);
  equation
    n = if n == 10 or (time > 0.3 and time < 0.6) then 10 else 0;
  end IntegerLatch;
end DiscreteLoops;
"); getErrorString();

simulate(DiscreteLoops.EnumLatch); getErrorString();
val(r, 0.2); val(r, 0.8);
simulate(DiscreteLoops.BooleanLatch); getErrorString();
val(b, 0.2); val(b, 0.8);
simulate(DiscreteLoops.IntegerLatch); getErrorString();
val(n, 0.2); val(n, 0.8);

