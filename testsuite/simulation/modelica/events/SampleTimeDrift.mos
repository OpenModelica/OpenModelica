// name: SampleTimeDrift
// keywords: event, when, sample, #17591
// status: correct
// teardown_command: rm -rf SampleTimeDrift SampleTimeDrift.exe SampleTimeDrift.libs SampleTimeDrift.log SampleTimeDrift_* output.log
//
// The sample instants are start + k*interval, so they coincide with the time
// events at 1 and 1.6 instead of drifting a few ulps away from them.
//

loadString("
model SampleTimeDrift
  Integer n(start = 0, fixed = true);
equation
  when {sample(0, 0.1), time >= 1, time >= 1.6} then
    n = pre(n) + 1;
  end when;
end SampleTimeDrift;
"); getErrorString();

simulate(SampleTimeDrift, stopTime = 1.75); getErrorString();
val(n, 1.75);

