// name:     WhenIfStatements
// keywords: when if noretcall assert reinit elsewhen
// status:   correct
// teardown_command: rm -rf WhenIfStatements.IfCall* WhenIfStatements.Mixed* output.log
//
// Function calls, asserts, terminate and reinit inside if-equations of a
// when-equation, next to assignments and in an elsewhen chain.
//

loadString("
package WhenIfStatements
  function pr
    input String s;
    external \"C\" ModelicaMessage(s) annotation(Include=\"#include \\\"ModelicaUtilities.h\\\"\");
  end pr;

  model IfCall \"if with only calls in a when\"
    Real x = time;
    discrete Integer k(start = 0, fixed = true);
  equation
    when x > 0.5 then
      k = 1;
      if x > 0.7 then
        pr(\"late\\n\");
      else
        pr(\"early\\n\");
      end if;
    end when;
  end IfCall;

  model Mixed \"assignments, calls, assert, reinit, nested if and an elsewhen\"
    Real x(start = 0, fixed = true);
    discrete Integer k(start = 0, fixed = true);
    discrete Integer m(start = 0, fixed = true);
    parameter Boolean b = true;
  equation
    der(x) = 1;
    when x > 0.3 then
      m = 0;
      if x < 0.2 then
        k = 1;
        pr(\"never\\n\");
        terminate(\"never\");
      elseif b then
        k = 2;
        reinit(x, 0.35);
        if k > 0 then
          pr(\"nested\\n\");
        end if;
      else
        k = 3;
      end if;
    elsewhen x > 0.5 then
      k = 4;
      if x > 0.4 then
        assert(x > 0.45, \"x too small\");
        pr(\"second branch\\n\");
      end if;
      m = 1;
    end when;
  end Mixed;

  model Unbalanced \"an assignment missing in the else branch is an error, not an internal error\"
    discrete Real x(start = 0, fixed = true);
  equation
    when sample(0, 1) then
      if time >= 3 then
        x = 1;
      end if;
    end when;
  end Unbalanced;
end WhenIfStatements;
"); getErrorString();

simulate(WhenIfStatements.IfCall, stopTime=1); getErrorString();
val(k, 1);
simulate(WhenIfStatements.Mixed, stopTime=1); getErrorString();
val(k, 0.35);
val(x, 0.31);
val(k, 0.8);
val(m, 0.8);
translateModel(WhenIfStatements.Unbalanced); getErrorString();
