// name: noEventIfType
// keywords: noEvent, mod, #18112
// status: correct

loadString("
model noEventIfType
  Real x(start = 0, fixed = true);
  Real y;
  Integer i;
equation
  der(x) = 1;
  y = noEvent(if x > 10 then mod(x, 0.5) else x);
  i = noEvent(if x > 10 then integer(x) else 3);
end noEventIfType;
"); getErrorString();

simulate(noEventIfType, stopTime = 12); getErrorString();
val(y, 0.5);
val(y, 11.3);
val(i, 0.5);
val(i, 11.3);

