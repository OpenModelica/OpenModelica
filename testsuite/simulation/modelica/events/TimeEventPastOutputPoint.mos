// name:     TimeEventPastOutputPoint
// keywords: EventHandling, time events, cvode, ida
// status:   correct
// teardown_command: rm -rf timeEventPastGrid* output.log
//
// The time event of `time > 150` is at nextafter(150), just after the output
// point 150. CVODE and IDA stop on it, past the output point, and the event
// must fire there (#18410).

loadString("
model timeEventPastGrid
  Real x(start = 0, fixed = true);
equation
  der(x) = if time > 150 then 1 else 0;
end timeEventPastGrid;
"); getErrorString();

simulate(timeEventPastGrid, stopTime = 250, numberOfIntervals = 250, tolerance = 1e-5, method = "cvode", fileNamePrefix = "timeEventPastGrid_cvode", simflags = "-lv=LOG_EVENTS"); getErrorString();
val(x, 250, "timeEventPastGrid_cvode_res.mat");
simulate(timeEventPastGrid, stopTime = 250, numberOfIntervals = 250, tolerance = 1e-5, method = "ida", fileNamePrefix = "timeEventPastGrid_ida", simflags = "-lv=LOG_EVENTS"); getErrorString();
val(x, 250, "timeEventPastGrid_ida_res.mat");

