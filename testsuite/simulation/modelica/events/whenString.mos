// name: whenString
// keywords: event, when, String
// status: correct
// teardown_command: rm -rf WhenStringEquation* output.log
//
// String variables assigned in a when-equation, #18243
//

loadString("
model WhenStringEquation
  String s1;
  String s2;
equation
  when sample(0, 0.1) then
    s1 = String(time);
    s2 = String(time + 1);
  end when;
  when terminal() then
    print(\"s1 = \" + s1 + \", s2 = \" + s2 + \"\\n\");
  end when;
end WhenStringEquation;
"); getErrorString();

simulate(WhenStringEquation, stopTime = 0.25); getErrorString();

