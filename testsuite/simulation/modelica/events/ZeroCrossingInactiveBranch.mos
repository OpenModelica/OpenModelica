// name:     ZeroCrossingInactiveBranch
// keywords: events, zero crossing, parameter, if-expression
// status: correct
// teardown_command: rm -rf M_* M.* MNoEvent* MElse* MPlain* output.log
//
// A relation in a branch of an if-expression that a parameter deselects must not
// trigger events. Each event adds points to the output file.

loadString("
model M
  parameter Boolean p = false;
  Real x = sin(62.83185307179586*time);
  Boolean b;
  Real y(start = 0, fixed = true);
equation
  b = if p then x >= 0 else true;
  der(y) = if b then 1 else 0;
end M;

model MNoEvent
  parameter Boolean p = false;
  Real x = sin(62.83185307179586*time);
  Boolean b;
  Real y(start = 0, fixed = true);
equation
  b = if p then noEvent(x >= 0) else true;
  der(y) = if b then 1 else 0;
end MNoEvent;

model MElse
  parameter Boolean p = true;
  Real x = sin(62.83185307179586*time);
  Boolean b;
  Real y(start = 0, fixed = true);
equation
  b = if p then true else x >= 0;
  der(y) = if b then 1 else 0;
end MElse;

model MPlain
  parameter Boolean p = false;
  Real x = sin(62.83185307179586*time);
  Boolean b, c;
  Real y(start = 0, fixed = true);
equation
  c = x >= 0;
  b = if p then x >= 0 else true;
  der(y) = if c then 1 else 0;
end MPlain;
"); getErrorString();

simulate(MNoEvent, stopTime=1, numberOfIntervals=100, fileNamePrefix="M_noEvent"); getErrorString();
n := readSimulationResultSize("M_noEvent_res.mat");

simulate(M, stopTime=1, numberOfIntervals=100, fileNamePrefix="M_off"); getErrorString();
readSimulationResultSize("M_off_res.mat") == n;
val(y, 1, "M_off_res.mat");

simulate(M, stopTime=1, numberOfIntervals=100, simflags="-override=p=true", fileNamePrefix="M_on"); getErrorString();
readSimulationResultSize("M_on_res.mat") > n;
abs(val(y, 1, "M_on_res.mat") - 0.5) < 1e-6;

simulate(MElse, stopTime=1, numberOfIntervals=100, fileNamePrefix="M_else"); getErrorString();
readSimulationResultSize("M_else_res.mat") == n;
val(y, 1, "M_else_res.mat");

simulate(MElse, stopTime=1, numberOfIntervals=100, simflags="-override=p=false", fileNamePrefix="M_elseOn"); getErrorString();
readSimulationResultSize("M_elseOn_res.mat") > n;
abs(val(y, 1, "M_elseOn_res.mat") - 0.5) < 1e-6;

simulate(MPlain, stopTime=1, numberOfIntervals=100, fileNamePrefix="M_plain"); getErrorString();
readSimulationResultSize("M_plain_res.mat") > n;
abs(val(y, 1, "M_plain_res.mat") - 0.5) < 1e-6;

