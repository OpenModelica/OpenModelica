// name:      WhenElsewhenLoop
// keywords:  tearing, when, elsewhen
// status:    correct
//
// A when-equation with elsewhen in an algebraic loop can be solved for its
// left-hand side, so tearing does not select it as iteration variable (#18202).

loadString("
model WhenElsewhenLoop
  parameter Real R = 10;
  parameter Real Ron = 0.1;
  parameter Real Roff = 1e5;
  parameter Real Vth = 0.5;
  parameter Real Ith = 0.01;
  parameter Real Ismooth = 1e-3;
  Real vs = sin(2*3.141592653589793*time);
  Real i(start = 0);
  Real v;
  Integer state(start = 0, fixed = true);
equation
  when abs(v) > Vth and pre(state) == 0 then
    state = 1;
  elsewhen abs(i) < Ith and pre(state) == 1 then
    state = 0;
  end when;
  v = if state > 0 then Ismooth*Ron*tanh(i/Ismooth) + i*Ron else i*Roff;
  vs = v + R*i;
end WhenElsewhenLoop;
"); getErrorString();

simulate(WhenElsewhenLoop); getErrorString();
val(state, 0.05);
val(state, 0.25);
val(state, 0.49);
val(state, 0.55);
val(state, 0.75);
val(state, 0.99);
