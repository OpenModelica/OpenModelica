// name:      testParamFixedFalseDivision
// keywords:  tearing, linear, strictness, #17433
// status:    correct
//
// R_inv is a parameter with fixed = false, computed during initialization.
// Tearing must not divide by its zero elements.

loadString("
model testParamFixedFalseDivision
  record Rotation
    Real T[3,3];
  end Rotation;

  function inverse
    input Real T[3,3];
    output Rotation R;
  algorithm
    R := Rotation(transpose(T));
  end inverse;

  parameter Real T[3,3] = [1, 0, 0; 0, -1, 0; 0, 0, -1];
  parameter Rotation R_inv = inverse(T);
  Real f[3];
equation
  0 = 3 + time + R_inv.T[1,3]*f[1] + R_inv.T[2,3]*f[2] + R_inv.T[3,3]*f[3];
  0 = 2 + time + R_inv.T[1,2]*f[1] + R_inv.T[2,2]*f[2] + R_inv.T[3,2]*f[3];
  0 = 1 + time + R_inv.T[1,1]*f[1] + R_inv.T[2,1]*f[2] + R_inv.T[3,1]*f[3];
end testParamFixedFalseDivision;
"); getErrorString();

simulate(testParamFixedFalseDivision); getErrorString();
val(f[1], 0.5);
val(f[2], 0.5);
val(f[3], 0.5);

