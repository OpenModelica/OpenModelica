// name:     RemoveConstantsTearing
// keywords: tearing, removeConstants
// status:   correct
// teardown_command: rm -rf RemoveConstantsTearing_* RemoveConstantsTearing RemoveConstantsTearing.c RemoveConstantsTearing.o RemoveConstantsTearing.exe RemoveConstantsTearing.libs RemoveConstantsTearing.log RemoveConstantsTearing.makefile output.log
//
// removeConstants changes an equation of the torn loop. The simulation system
// keeps its tearing, since removeConstants runs before tearingSystem. With the
// old module order the tearing is discarded, which gives a warning (#10980).

loadString("
model RemoveConstantsTearing
  record R
    constant Real c = 0.5;
    Real p = 3;
  end R;
  function f
    input R r;
    input Real u;
    output Real v = r.c*sin(u);
  annotation(Inline = false);
  end f;
  parameter R r;
  Real x(start = 0.5), y(start = 0.5), z(start = 0.5);
equation
  x = f(r, y) + 0.1*time;
  y = cos(z);
  z = x^2;
end RemoveConstantsTearing;
"); getErrorString();

setCommandLineOptions("-d=backenddaeinfo"); getErrorString();
translateModel(RemoveConstantsTearing); getErrorString();

setCommandLineOptions("--defaultOptModulesOrdering=false --postOptModules=lateInlineFunction,wrapFunctionCalls,inlineArrayEqn,constantLinearSystem,simplifysemiLinear,removeSimpleEquations,simplifyComplexFunction,solveSimpleEquations,tearingSystem,inputDerivativesUsed,calculateStrongComponentJacobians,calculateStateSetsJacobians,symbolicJacobian,removeConstants,simplifyTimeIndepFuncCalls,simplifyAllExpressions,findZeroCrossings,collapseArrayExpressions"); getErrorString();
translateModel(RemoveConstantsTearing); getErrorString();

