// name:      testTimeIndepFuncDivision
// keywords:  tearing, linear, strictness, #13189
// status:    correct
//
// cp only depends on parameters, so the backend computes it during
// initialization. Its value f(0, 0.3) = 0 is known at compile time when the
// function call is evaluated. Tearing must not divide by it.

loadString("
model testTimeIndepFuncDivision
  function f
    input Real c0;
    input Real a;
    output Real c;
  algorithm
    c := c0*cos(a);
    annotation(Inline = false);
  end f;

  parameter Boolean use = false;
  parameter Real c0 = if use then 0.6 else 0;
  parameter Real a = 0.3;
  Real cp = f(c0, a);
  Real d;
  Real p;
  Real pWin;
  parameter Real pAtm = 101325;
equation
  pWin = 0.5*cp*d;
  p = pAtm + pWin;
  d = 1.2/101325*p;
end testTimeIndepFuncDivision;
"); getErrorString();

simulate(testTimeIndepFuncDivision); getErrorString();
val(d, 0.0);
val(d, 1.0);
val(p, 1.0);

