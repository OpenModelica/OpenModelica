// name: gbodeShorthands
// keywords: solver, gbode
// status: correct
// suite: gbode
// teardown_command: rm -f gbodeShorthands_*
//
// Each shorthand gives the same result as the gbode flags it stands for.

loadString("
model gbodeShorthands
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end gbodeShorthands;
"); getErrorString();
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "rungekutta", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=rungekutta"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"rungekutta"; a; a == b;
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "heun", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=heun"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"heun"; a; a == b;
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "impeuler", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=impl_euler"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"impeuler"; a; a == b;
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "trapezoid", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=trapezoid"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"trapezoid"; a; a == b;
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "imprungekutta", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=radauIA2"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"imprungekutta"; a; a == b;
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "irksco", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=trapezoid"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"irksco"; a; a == b;
echo(false);
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "rungekuttassc", fileNamePrefix = "gbodeShorthands_x"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=rungekuttaSsc"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"rungekuttassc"; a; a == b;
echo(false);

simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "rungekutta", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbctrl=const"); getErrorString();
a := val(x, 1, "gbodeShorthands_x_res.mat");
simulate(gbodeShorthands, stopTime = 1, numberOfIntervals = 10, method = "gbode", fileNamePrefix = "gbodeShorthands_x", simflags = "-gbm=rungekutta -gbctrl=const"); getErrorString();
b := val(x, 1, "gbodeShorthands_x_res.mat");
echo(true);
"rungekutta -gbctrl=const"; a; a == b;
echo(false);

