// name: CvodeEventUlpApart
// status: correct
// teardown_command: rm -rf CvodeEventUlpApart CvodeEventUlpApart.c CvodeEventUlpApart.o CvodeEventUlpApart.h CvodeEventUlpApart.libs CvodeEventUlpApart.log CvodeEventUlpApart.makefile CvodeEventUlpApart_*
//
// CVODE takes the step onto a time event a few ulp after another

loadString("
model CvodeEventUlpApart
  parameter Real tSwitch = 1 + 2.2e-16;
  Real x(start = 1, fixed = true);
  discrete Integer n(start = 0, fixed = true);
equation
  der(x) = if time >= tSwitch then -x else x;
  when sample(0, 0.5) then
    n = pre(n) + 1;
  end when;
end CvodeEventUlpApart;
"); getErrorString();
simulate(CvodeEventUlpApart, stopTime = 2, method = "cvode"); getErrorString();
val(x, 2.0);
val(n, 2.0);

