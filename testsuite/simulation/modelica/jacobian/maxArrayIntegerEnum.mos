// name: maxArrayIntegerEnum
// keywords: symbolic jacobian max min array Integer enumeration
// status: correct
// teardown_command: rm -rf MaxArrayIntegerEnum* linearized_model.mo
//
// #18217: max and min of an array variable and Integer() of an
// enumeration could not be differentiated.

loadString("
model MaxArrayIntegerEnum
  type E = enumeration(a, b, c);
  E e = if time < 0.5 then E.b else E.c;
  Real x[3](start = {1, 3, 2}, each fixed = true);
  Real v[3] = 2*x;
  Real y[1](each start = 4, each fixed = true);
  Real w[1] = 3*y;
equation
  der(x[1]) = -max(v);
  der(x[2]) = -min(v);
  der(x[3]) = -max(w)*Integer(e);
  der(y[1]) = -y[1];
end MaxArrayIntegerEnum;
"); getErrorString();

setCommandLineOptions("--generateDynamicJacobian=symbolic --generateSymbolicLinearization"); getErrorString();
linearize(MaxArrayIntegerEnum, stopTime = 0.0); getErrorString();
loadFile("linearized_model.mo"); getErrorString();
list(linearized_model);

