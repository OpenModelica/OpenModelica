// name: tupleWildcard
// keywords: symbolic jacobian tuple wildcard
// status: correct
// teardown_command: rm -f TupleWildcard*
//
// #18228: a tuple equation with an unused output gave an extra equation
// _ = ... in the symbolic Jacobian.

loadString("
model TupleWildcard
  function f
    input Real x;
    output Real a;
    output Real b;
  algorithm
    a := sin(x);
    b := x^2;
  end f;
  Real s(start = 0, fixed = true);
  Real w(start = 1, fixed = true);
  Real b;
equation
  (, b) = f(2*w);
  der(s) = f(w) - s;
  der(w) = -0.1*w + 0.05*s + 0.01*b;
end TupleWildcard;
"); getErrorString();

setCommandLineOptions("--generateDynamicJacobian=symbolic"); getErrorString();
simulate(TupleWildcard, simflags="-jacobian=symbolical"); getErrorString();
val(s, 1.0);
val(w, 1.0);

// Result:
// true
// ""
