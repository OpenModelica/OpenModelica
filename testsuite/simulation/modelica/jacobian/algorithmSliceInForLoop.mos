// name: algorithmSliceInForLoop
// keywords: symbolic jacobian algorithm for loop slice
// status: correct
// teardown_command: rm -f SliceInForLoop*
//
// #18004: the for-loop iterator is not the first subscript of the assigned
// slice.

loadString("
model SliceInForLoop
  Real x(start = 1, fixed = true);
  Real a[1, 2, 1];
algorithm
  for i in 1:2 loop
    a[1, i, :] := {x};
  end for;
equation
  der(x) = -sum(a);
end SliceInForLoop;
"); getErrorString();

setCommandLineOptions("--generateDynamicJacobian=symbolic"); getErrorString();
simulate(SliceInForLoop, simflags="-jacobian=symbolical"); getErrorString();
val(x, 1.0);

