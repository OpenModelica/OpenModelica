// name:     IfEquationZeroCrossing
// keywords: equation, if-equation, zero crossing
// status:   correct
// teardown_command: rm -rf ZeroCrossingInIfBranch* output.log
//
// A zero crossing in an if-equation branch occurs in the if-equation (#14332).

loadString("
model ZeroCrossingInIfBranch
  function f
    input Real t;
    output Real x[2];
  algorithm
    x := {sin(t), cos(t)};
  end f;
  parameter Boolean on = true;
  Boolean b = on;
  Real x[2], y, z;
equation
  if b then
    x = f(time);
    y = x[1] + x[2];
    z = if y > 0.5 then 1 else 0;
  else
    x = zeros(2);
    y = 0;
    z = 0;
  end if;
end ZeroCrossingInIfBranch;
"); getErrorString();

simulate(ZeroCrossingInIfBranch, stopTime = 3); getErrorString();
val(z, 1.0); getErrorString();
val(z, 2.5); getErrorString();

