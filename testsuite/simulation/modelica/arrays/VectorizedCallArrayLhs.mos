// name:     VectorizedCallArrayLhs
// keywords: vectorized call, array equation
// status:   correct
// teardown_command: rm -rf VectorizedCallArrayLhs VectorizedCallArrayLhs.exe VectorizedCallArrayLhs.c VectorizedCallArrayLhs_* VectorizedCallArrayLhs.makefile VectorizedCallArrayLhs.libs VectorizedCallArrayLhs.log output.log
//
// A vectorized call in an array equation where the left hand side is an array
// expression with an array variable as element.

loadString("
function foo
  input Real x;
  input Real x2[2];
  output Real y;
algorithm
  y := x + 1 + x2[1] + 2*x2[2];
end foo;

model VectorizedCallArrayLhs
  Real y[3];
equation
  {y} = foo(1, {{{1, 2}, {3, 4}, {5, 6}}});
end VectorizedCallArrayLhs;
"); getErrorString();

simulate(VectorizedCallArrayLhs, stopTime = 0); getErrorString();
val(y[1], 0);
val(y[2], 0);
val(y[3], 0);

