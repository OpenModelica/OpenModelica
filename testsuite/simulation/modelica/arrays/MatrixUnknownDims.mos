// name:     MatrixUnknownDims
// keywords: array, matrix #17177
// status:   correct
//
// matrix(A) requires size(A, i) = 1 for i > 2. Sizes not known until the
// function is called are checked when it is evaluated.

loadString("
package MatrixUnknownDims
  function f
    input Real A[:, :, :, :];
    output Real B[size(A, 1), size(A, 2)];
  algorithm
    B := matrix(A);
  end f;

  model Valid
    Real x[2, 2] = f({{{{time}}, {{2*time}}}, {{{3*time}}, {{4*time}}}});
  end Valid;

  model Invalid
    Real x[2, 2] = f(fill(time, 2, 2, 1, 3));
  end Invalid;

  model ConstValid
    constant Real c[2, 2] = f({{{{1}}, {{2}}}, {{{3}}, {{4}}}});
  end ConstValid;

  model ConstInvalid
    constant Real c[2, 2] = f(fill(1.0, 2, 2, 1, 3));
  end ConstInvalid;
end MatrixUnknownDims;
"); getErrorString();

instantiateModel(MatrixUnknownDims.Valid); getErrorString();
instantiateModel(MatrixUnknownDims.ConstValid); getErrorString();
instantiateModel(MatrixUnknownDims.ConstInvalid); getErrorString();
simulate(MatrixUnknownDims.Valid, stopTime = 1); getErrorString();
val(x[2, 1], 1.0);
simulate(MatrixUnknownDims.Invalid, stopTime = 1); getErrorString();

