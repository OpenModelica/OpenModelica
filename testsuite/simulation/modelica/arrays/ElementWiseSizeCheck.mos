// name:     ElementWiseSizeCheck
// keywords: array size
// status:   correct
//
// An element-wise operation on arrays whose sizes are not known at compile
// time checks that the sizes are equal. Arrays with the same declared size are
// not checked.
//

loadString("
package ElementWiseSizeCheck
  function f
    input Real a[:];
    input Real b[:];
    output Real y[size(a, 1)];
  algorithm
    y := a - b;
  end f;

  function g
    input Real a[:];
    input Integer n;
    output Real y[n];
  protected
    Real w1[n] = a[1:n];
    Real w2[n] = 2*a[1:n];
  algorithm
    y := w1 - w2;
  end g;

  model Equal
    Real y[2] = f({time, 2*time}, {1, 2});
  end Equal;

  model Same
    Real y[2] = g({time, 2*time, 3*time}, 2);
  end Same;

  model Different
    Real y[2] = f({time, 2*time}, {1, 2, 3});
  end Different;
end ElementWiseSizeCheck;
"); getErrorString();

simulate(ElementWiseSizeCheck.Equal); getErrorString();
val(y[2], 0.0);
simulate(ElementWiseSizeCheck.Different); getErrorString();
simulate(ElementWiseSizeCheck.Same); getErrorString();
val(y[2], 1.0);

