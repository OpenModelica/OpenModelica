// name:     VectorizedSizeCheck
// keywords: vectorization function size
// status:   correct
//
// A vectorized call in a function checks that the operands of an element-wise
// operation have the same size.
//

loadString("
package VectorizedSizeCheck
  function f
    input Real a[:];
    input Real b[:];
    output Real y;
  algorithm
    y := max(abs(a - b));
  end f;

  model Equal
    Real y = f({time, 2*time}, {1, 2});
  end Equal;

  model Different
    Real y = f({time, 2*time}, {1, 2, 3});
  end Different;
end VectorizedSizeCheck;
"); getErrorString();

simulate(VectorizedSizeCheck.Equal); getErrorString();
val(y, 0.0);
echo(false);
res := simulate(VectorizedSizeCheck.Different);
msgs := res.messages;
echo(true);
getErrorString();
regex(msgs, "\\[<interactive>.*different sizes: 2 and 3\\.", 1);

// Result:
// true
