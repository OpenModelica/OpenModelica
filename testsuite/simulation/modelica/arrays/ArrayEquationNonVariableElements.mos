// name:     ArrayEquationNonVariableElements
// keywords: array equation, function call, simplifyComplexFunction #1429
// status:   correct
//
// An array equation {e1, e2, ...} = f(...) where an element is not a variable
// is split into scalar equations, which are sorted and torn like any other.

loadString("
package ArrayEquationNonVariableElements
  function f
    input Real t;
    output Real y[2] = {sin(t), cos(t)};
  end f;

  function g
    input Real t;
    output Real y[2, 2] = {{sin(t), cos(t)}, {t, 1}};
  end g;

  function pointGravity
    input Real r[3];
    output Real g[3];
  protected
    Real k = 1;
    Real n[3];
  algorithm
    n := -r/sqrt(r*r);
    g := k/(r*r)*n;
  end pointGravity;

  model Particle
    parameter Real m = 1;
    Real r[3](start = {1, 1, 0}, each fixed = true);
    Real v[3](start = {0, 1, 0}, each fixed = true);
  equation
    der(r) = v;
    m*der(v) = m*pointGravity(r);
  end Particle;

  model Equations
    Real a[2], b[2], c[2], d[2], e[2], u[2], w[2], z[2, 2];
    Real x[2](each start = 0, each fixed = true);
  equation
    2*a = f(time);
    b + {time, time} = f(time);
    {c[1] + c[2], c[2]} = f(time);
    {d[1] + d[2], d[2] - d[1]} = f(time);
    f(time) = 2*e;
    f(time) = -u;
    -w = f(time);
    2*z = g(time);
    2*der(x) = f(time);
  end Equations;
end ArrayEquationNonVariableElements;
"); getErrorString();

simulate(ArrayEquationNonVariableElements.Particle, stopTime = 2); getErrorString();
val(r[1], 2.0);
val(r[2], 2.0);
val(v[1], 2.0);
val(v[2], 2.0);

simulate(ArrayEquationNonVariableElements.Equations, stopTime = 1); getErrorString();
val(a[1], 1.0);
val(b[2], 1.0);
val(c[1], 1.0);
val(c[2], 1.0);
val(d[1], 1.0);
val(d[2], 1.0);
val(e[2], 1.0);
val(u[2], 1.0);
val(w[1], 1.0);
val(z[1, 2], 1.0);
val(z[2, 1], 1.0);
val(x[1], 1.0);
val(x[2], 1.0);

// Result:
