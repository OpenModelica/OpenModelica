loadFile("FunctionArraySlices.mo"); getErrorString();
simulate(FunctionArraySlices, stopTime=1.0); getErrorString();
val(e[3,1], 1.0);
val(e[3,2], 1.0);
val(s, 1.0);
val(rows, 1.0);
val(cols, 1.0);
val(y[1], 1.0);
val(y[2], 1.0);
val(y[3], 1.0);
val(row[1], 0.25);
val(row[3], 0.25);
val(row[1], 1.0);
val(row[3], 1.0);

