loadModel(Modelica, {"4.1.0"}); getErrorString();
loadModel(ThermoSysPro, {"4.2.0"}); getErrorString();

simulate(ThermoSysPro.Examples.SimpleExamples.TestStodolaTurbine3, stopTime=1000); getErrorString();

res := OpenModelica.Scripting.compareSimulationResults(
"ThermoSysPro.Examples.SimpleExamples.TestStodolaTurbine3_res.mat",
getEnvironmentVar("REFERENCEFILES")+"/ThermoSysPro/ThermoSysPro.Examples.SimpleExamples.TestStodolaTurbine3.mat",
"ThermoSysPro.Examples.SimpleExamples.TestStodolaTurbine3_diff.csv",
0.01, 0.0001);

