// suite: disabled
//
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadModel(ThermoSysPro, {"4.2.0"}); getErrorString();

simulate(ThermoSysPro.Examples.SimpleExamples.TestSwitchValve, stopTime=100); getErrorString();

res := OpenModelica.Scripting.compareSimulationResults(
"ThermoSysPro.Examples.SimpleExamples.TestSwitchValve_res.mat",
getEnvironmentVar("REFERENCEFILES")+"/ThermoSysPro/ThermoSysPro.Examples.SimpleExamples.TestSwitchValve.mat",
"ThermoSysPro.Examples.SimpleExamples.TestSwitchValve_diff.csv",
0.01, 0.0001,
{"SwitchValve.Q"});

