//
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadModel(ThermoSysPro, {"4.2.0"}); getErrorString();

simulate(ThermoSysPro.Examples.SimpleExamples.TestJunctions2, stopTime=10); getErrorString();

res := OpenModelica.Scripting.compareSimulationResults(
"ThermoSysPro.Examples.SimpleExamples.TestJunctions2_res.mat",
getEnvironmentVar("REFERENCEFILES")+"/ThermoSysPro/ThermoSysPro.Examples.SimpleExamples.TestJunctions2.mat",
"ThermoSysPro.Examples.SimpleExamples.TestJunctions2_diff.csv",
0.01, 0.0001,
{"massFlowMultiplier.Ce.Q", "massFlowMultiplier.Cs.Q",
 "mixer2_1.Ce1.Q", "mixer2_1.Ce2.Q", "mixer2_1.Cs.Q",
 "mixer2_2.Ce1.Q", "mixer2_2.Ce2.Q", "mixer2_2.Ce3.Q", "mixer2_2.Cs.Q"});

