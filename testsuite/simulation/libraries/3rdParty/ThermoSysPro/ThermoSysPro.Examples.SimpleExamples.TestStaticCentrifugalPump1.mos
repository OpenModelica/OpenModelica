//
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadModel(ThermoSysPro, {"4.2.0"}); getErrorString();

simulate(ThermoSysPro.Examples.SimpleExamples.TestStaticCentrifugalPump1, stopTime=1000); getErrorString();

res := OpenModelica.Scripting.compareSimulationResults(
"ThermoSysPro.Examples.SimpleExamples.TestStaticCentrifugalPump1_res.mat",
getEnvironmentVar("REFERENCEFILES")+"/ThermoSysPro/ThermoSysPro.Examples.SimpleExamples.TestStaticCentrifugalPump1.mat",
"ThermoSysPro.Examples.SimpleExamples.TestStaticCentrifugalPump1_diff.csv",
0.01, 0.0001,
{"StaticCentrifugalPump1.Q",
 "StaticCentrifugalPump1.deltaH",
 "StaticCentrifugalPump1.deltaP"});

