//
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadModel(ThermoSysPro, {"4.2.0"}); getErrorString();

simulate(ThermoSysPro.Examples.SimpleExamples.TestStaticDrum2, stopTime=1000); getErrorString();

res := OpenModelica.Scripting.compareSimulationResults(
"ThermoSysPro.Examples.SimpleExamples.TestStaticDrum2_res.mat",
getEnvironmentVar("REFERENCEFILES")+"/ThermoSysPro/ThermoSysPro.Examples.SimpleExamples.TestStaticDrum2.mat",
"ThermoSysPro.Examples.SimpleExamples.TestStaticDrum2_diff.csv",
0.01, 0.0001,
{"StaticDrumTh1.Ce_eco.Q","StaticDrumTh1.Cs_purg.Q","StaticDrumTh1.Cs_sur.Q",
 "StaticDrumTh1.T","StaticDrumTh1.P","StaticDrumTh1.hv","StaticDrumTh1.hl",
 "StaticDrumTh1.Cth.W"});

