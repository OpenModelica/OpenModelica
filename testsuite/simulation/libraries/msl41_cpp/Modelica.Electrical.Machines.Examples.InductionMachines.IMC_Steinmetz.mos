referenceFileName := "Modelica.Electrical.Machines.Examples.AsynchronousInductionMachines.AIMC_Steinmetz";

modelTestingType := OpenModelicaModelTesting.Kind.VerifiedSimulation;
modelName := $TypeName(Modelica.Electrical.Machines.Examples.InductionMachines.IMC_Steinmetz);
compareVars :=
