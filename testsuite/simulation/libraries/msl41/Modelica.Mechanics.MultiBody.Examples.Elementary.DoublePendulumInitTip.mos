runScript("../common/ModelTestingDefaults.mos"); getErrorString();

packageVersion := "4.1.0";

modelTestingType := OpenModelicaModelTesting.Kind.VerifiedSimulation;
modelName := $TypeName(Modelica.Mechanics.MultiBody.Examples.Elementary.DoublePendulumInitTip);
// The double pendulum increases small errors. The reference is from DASSL with
// tolerance 1e-10; tolerance 1e-8 is necessary to agree with it at t = 5.
simflags := "-tolerance=1e-8";
compareVars :=
{
   "revolute1.phi",
   "revolute1.w",
   "revolute2.phi",
   "revolute2.w"
};

runScript(modelTesting);getErrorString();

