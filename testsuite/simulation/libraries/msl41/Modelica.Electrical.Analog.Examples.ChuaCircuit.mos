// name:     Modelica.Electrical.Analog.Examples.ChuaCircuit
// keywords: simulation MSL Examples
// status: correct
//
// Simulation Results
// Modelica Standard Library
//
// Chua's circuit is chaotic, so its trajectory over the model's 5e4 s is not
// reproducible and cannot be verified against a reference. The Modelica
// Association result for this model leaves the reference file here at t = 6307
// (C2.v), 6882 (L.i) and 7386 (C1.v), far outside the 1% tube, and by the stop
// time the two are unrelated. Testing a chaotic system wants an invariant of
// the attractor rather than a trajectory, which the model testing script has no
// way to express.
//

runScript("../common/ModelTestingDefaults.mos"); getErrorString();

packageVersion := "4.1.0";
referenceFile := "no-msl41-reference-file.mat"; // chaotic, not compared

modelTestingType := OpenModelicaModelTesting.Kind.SimpleSimulation;
diffAlgorithm := OpenModelicaModelTesting.DiffAlgorithm.diffSimulationResults;
modelName := $TypeName(Modelica.Electrical.Analog.Examples.ChuaCircuit);
compareVars :=
{
   "C1.v",
   "C2.v",
   "L.i"
};

runScript(modelTesting);getErrorString();

