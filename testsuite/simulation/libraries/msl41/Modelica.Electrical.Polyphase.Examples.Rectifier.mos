// MSL 4.0.0 renamed this model and reparameterized it (V, f, L, C and the initial
// conditions all changed), so the MSL 3.2.1 reference file no longer applies.
// Simulate the model without verifying it.

runScript("../common/ModelTestingDefaults.mos"); getErrorString();

packageVersion := "4.1.0";
referenceFileName := "Modelica.Electrical.MultiPhase.Examples.Rectifier";

modelTestingType := OpenModelicaModelTesting.Kind.SimpleSimulation;
modelName := $TypeName(Modelica.Electrical.Polyphase.Examples.Rectifier);
compareVars :=
{
   "cDC1.v",
   "cDC2.v",
   "supplyL.inductor[2].i",
   "supplyL.inductor[3].i"
};

runScript(modelTesting);getErrorString();

