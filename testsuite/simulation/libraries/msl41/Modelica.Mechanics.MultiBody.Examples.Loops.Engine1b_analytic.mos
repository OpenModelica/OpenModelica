// MSL 4 lowercased every component of this model (Inertia -> inertia, B1 -> b1,
// Crank1 -> crank1, ...), so not one variable of the MSL 3.2.1 reference file is
// left to compare against. Simulate the model without verifying it.

runScript("../common/ModelTestingDefaults.mos"); getErrorString();

packageVersion := "4.1.0";
referenceFile := "no-msl41-reference-file.mat";

modelTestingType := OpenModelicaModelTesting.Kind.SimpleSimulation;
modelName := $TypeName(Modelica.Mechanics.MultiBody.Examples.Loops.Engine1b_analytic);
compareVars :=
{
   "inertia.phi",
   "inertia.w"
};

runScript(modelTesting);getErrorString();

