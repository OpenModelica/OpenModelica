// status: correct

loadModel(Modelica, {"4.1.0"});
getErrorString();
echo(false);
fileName := getSourceFile(Modelica.Electrical.Spice3.Examples.Inverter);
s1 := readFile(fileName);
echo(true);
updateComponent(ground,Modelica.Electrical.Spice3.Basic.Ground,Modelica.Electrical.Spice3.Examples.Inverter,annotate=Placement(visible=true, transformation=transformation(origin={-4,-48}, extent={{-666,-10},{10,10}}, rotation=0)));
getErrorString();
echo(false);
s2 := listFile(Modelica.Electrical.Spice3);
print(getErrorString());
writeFile("old.mo", readFile(fileName));
s := diffModelicaFileListings(s1, s2, OpenModelica.Scripting.DiffFormat.plain);
echo(true);
if s == "" then
  print("Failed to merge strings!\n");
  print(getErrorString());
  exit(1);
end if;
writeFile("merged.mo", s);
writeFile("new.mo", s2);
getErrorString();
system("diff -uZ old.mo merged.mo | egrep -v '^(@@|---|[+][+][+])'")

