// name: DiffModelicaFileListings
// status: correct
//
// The merge itself is tested in OMCompiler/Compiler/OpenModelica.rs/openmodelica_modelica_diff.

echo(false);
s1 := "model M
  Real x(start = 1,
         fixed = true) \"x\"; // about x
  parameter Real p=1;
equation
  der(x) = -p*x;
annotation(Icon(graphics = {
    // the line
    Line(points = {{0, 0}, {10, 10}})
  }));
end M;
";
loadString(s1, "M.mo");
setElementModifierValue(M, x.start, $Code(=2));
addClassAnnotation(M, annotate=Icon(graphics = {Line(origin = {5, 5}, points = {{0, 0}, {10, 10}})}));
s2 := listFile(M);
echo(true);
print(diffModelicaFileListings(s1, s2, OpenModelica.Scripting.DiffFormat.plain));
print(diffModelicaFileListings(s1, s2, OpenModelica.Scripting.DiffFormat.color));
print(diffModelicaFileListings(s1, s2, OpenModelica.Scripting.DiffFormat.xml));
getErrorString();

