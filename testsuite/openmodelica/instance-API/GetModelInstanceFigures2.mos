// name: GetModelInstanceFigures2
// keywords:
// status: correct
// cflags: -d=newInst
//
//

loadString("
  model BouncingBall
    Real h;
    annotation(Documentation(figures = {
      Figure(title = \"Bouncing ball\", identifier = \"height\", preferred = true,
        plots = {Plot(curves = {Curve(y = h, legend = \"Height of ball\")})})}));
  end BouncingBall;");
getErrorString();

getModelInstanceAnnotation(BouncingBall, {"Documentation"}, prettyPrint=true);
getErrorString();

