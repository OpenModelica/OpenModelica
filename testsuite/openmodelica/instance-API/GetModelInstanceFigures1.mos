// name: GetModelInstanceFigures1
// keywords:
// status: correct
// cflags: -d=newInst
//
//

loadString("
  model BouncingBall
    Real h, v;
    annotation(Documentation(figures = {
      Figure(title = \"Bouncing ball\", identifier = \"height\", preferred = true,
        plots = {Plot(curves = {Curve(y = h, legend = \"Height of ball\"), Curve(y = v, legend = \"Velocity\", yAxis = YAxisSelection.Right, zOrder = 1)})})}));
  end BouncingBall;");
getErrorString();

getModelInstance(BouncingBall, prettyPrint=true);
getErrorString();

