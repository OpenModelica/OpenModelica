loadString("
  expandable connector Bus
  end Bus;

  model BouncingBall
    Bus bus;
    annotation(Documentation(figures = {
      Figure(plots = {Plot(curves = {Curve(y = bus.x, legend = \"bus.x\")})})}));
  end BouncingBall;");
getErrorString();

getModelInstance(BouncingBall, prettyPrint=true);
getErrorString();

