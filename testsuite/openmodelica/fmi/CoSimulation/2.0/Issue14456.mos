// name: Issue14456.mos
// keywords: fmu export and run
// status: correct
// teardown_command: rm -rf roomM370*.c roomM370*.h roomM370-tmp index.html roomM370.fmu roomM370_cs_systemCall.log roomM370_res.mat roomM370_info.json model_res.mat roomM370.log

setCommandLineOptions("--fmiFlags=s:cvode"); getErrorString();
loadFile("roomM370.mo"); getErrorString();
buildModelFMU(roomM370, version="2.0", fmuType="cs", platforms=["dynamic"]); getErrorString();

system(getInstallationDirectoryPath() + "/bin/OMSimulator roomM370.fmu --mode=cs --tolerance=1e-6 --stripRoot --suppressPath --tempDir=\"roomM370-tmp\"", "roomM370_cs_systemCall.log"); getErrorString();
readFile("roomM370_cs_systemCall.log"); getErrorString();


