// name:     FmuStepPastStopTime
// keywords: FMI 2.0 export Co-Simulation fmi2DoStep stopTime
// status:   correct
// teardown_command: rm -rf FmuStepPastStopTime.fmu FmuStepPastStopTime.log FmuStepPastStopTime_* FmuStepPastStopTime.fmutmp/
//
// The last step of t += 0.1 ends one ulp after the stop time 0.3 of
// fmi2SetupExperiment, which the FMU accepts. A step that ends later fails
// with an error, and the FMU logs why.

loadString("
model FmuStepPastStopTime
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end FmuStepPastStopTime;
"); getErrorString();
buildModelFMU(FmuStepPastStopTime, version = "2.0", fmuType = "cs", platforms = {"static"}); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" FmuStepPastStopTime.py FmuStepPastStopTime.fmu FmuStepPastStopTime_out.txt > FmuStepPastStopTime.log 2>&1"); getErrorString();
readFile("FmuStepPastStopTime_out.txt"); getErrorString();

// Result:
// true
// ""
// "FmuStepPastStopTime.fmu"
// "Notification: Building FMU for platform 'static' (1/1).
// Notification: Finished FMU for platform 'static' (1/1).
// "
// 0
// ""
// "doStep(0.0, 0.1): OK
// doStep(0.1, 0.1): OK
// doStep(0.2, 0.1): OK
// status 3: DoStep: The step from 0.3 with size 0.1 ends 0.1 after the stop time 0.3.
// doStep(0.30000000000000004, 0.1): fmi2DoStep failed with status 3 (error).
// "
// ""
// endResult
