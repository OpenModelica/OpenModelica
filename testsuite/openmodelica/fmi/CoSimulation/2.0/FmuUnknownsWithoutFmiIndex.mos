// name:     FmuUnknownsWithoutFmiIndex
// keywords: FMI 2.0 export ModelStructure InitialUnknowns daeMode
// status:   correct
// teardown_command: rm -rf FmuUnknownsWithoutFmiIndex.fmu FmuUnknownsWithoutFmiIndex.fmutmp/ FmuUnknownsWithoutFmiIndex.log FmuUnknownsWithoutFmiIndex_tmp.xml FmuUnknownsWithoutFmiIndex.xml
//
// A --daeMode FMU has no FMIDER Jacobian, so the ModelStructure is made
// without dependencies. The protected calculated parameter q is not exported
// with --fmiFilter=protected and must not be listed (it was index="0", #17881).

loadString("
model FmuUnknownsWithoutFmiIndex
  Real x(start = 1, fixed = true);
  parameter Real p = 1;
protected
  parameter Real q = 2*p;
equation
  der(x) = -q*x;
end FmuUnknownsWithoutFmiIndex;
"); getErrorString();
setCommandLineOptions("--simCodeTarget=C --daeMode --fmiFilter=protected"); getErrorString();
buildModelFMU(FmuUnknownsWithoutFmiIndex, version = "2.0", fmuType = "cs", platforms = {"static"}); getErrorString();
system("unzip -cqq FmuUnknownsWithoutFmiIndex.fmu modelDescription.xml > FmuUnknownsWithoutFmiIndex_tmp.xml"); getErrorString();
system("sed -n \"/<ModelStructure>/,/<\\/ModelStructure>/p\" FmuUnknownsWithoutFmiIndex_tmp.xml > FmuUnknownsWithoutFmiIndex.xml"); getErrorString();
readFile("FmuUnknownsWithoutFmiIndex.xml"); getErrorString();

