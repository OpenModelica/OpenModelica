// name: fmi_cs_daemode.mos
// keywords: FMI 2.0 3.0 export CoSimulation daeMode IDA
// status: correct
// teardown_command: rm -rf DaeModeWhenLoop* fmi_cs_daemode_*
//
// The Co-Simulation FMU of a --daeMode model integrates the residual form with
// IDA. The model is the one of fmi3_wasm_daemode.mos, which the ODE backend
// cannot translate. The FMUs, run by FMPy, give the result of the simulation,
// the event included. me_cs of FMI 2.0 exports Co-Simulation only: fmi-ls-dae
// needs FMI 3.0. So does me_cs of 2.0+3.0, whose modelDescription.xml is the
// FMI 2.0 one. A wasm target would export wasm FMUs, which also serve Model
// Exchange of FMI 2.0; fmi3_wasm_daemode*.mos test those.

loadFile("fmi3_wasm_daemode.mo"); getErrorString();
setCommandLineOptions(if regexBool(getEnvironmentVar("OPENMODELICA_TEST_SIMCODETARGET"), "^wasm") then "--simCodeTarget=C" else ""); getErrorString();

simulate(DaeModeWhenLoop, fileNamePrefix="fmi_cs_daemode_ref"); getErrorString();

buildModelFMU(DaeModeWhenLoop, version="2.0", fmuType="cs", fileNamePrefix="DaeModeWhenLoop2"); getErrorString();
buildModelFMU(DaeModeWhenLoop, version="3.0", fmuType="cs", fileNamePrefix="DaeModeWhenLoop3"); getErrorString();

system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py DaeModeWhenLoop2.fmu fmi_cs_daemode_2.csv 5.0 x y tSwitch"); getErrorString();
diffSimulationResults("fmi_cs_daemode_2.csv", "fmi_cs_daemode_ref_res.mat", "fmi_cs_daemode_diff2", vars={"x","y","tSwitch"}); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py DaeModeWhenLoop3.fmu fmi_cs_daemode_3.csv 5.0 x y tSwitch"); getErrorString();
diffSimulationResults("fmi_cs_daemode_3.csv", "fmi_cs_daemode_ref_res.mat", "fmi_cs_daemode_diff3", vars={"x","y","tSwitch"}); getErrorString();

buildModelFMU(DaeModeWhenLoop, version="2.0", fmuType="me_cs", fileNamePrefix="DaeModeWhenLoop_mecs"); getErrorString();
system("unzip -cqq DaeModeWhenLoop_mecs.fmu modelDescription.xml | grep -cE \"<(ModelExchange|CoSimulation)\""); getErrorString();
buildModelFMU(DaeModeWhenLoop, version="2.0+3.0", fmuType="me_cs", fileNamePrefix="DaeModeWhenLoop_both"); getErrorString();
system("unzip -cqq DaeModeWhenLoop_both.fmu modelDescription.xml | grep -cE \"<(ModelExchange|CoSimulation)\""); getErrorString();

