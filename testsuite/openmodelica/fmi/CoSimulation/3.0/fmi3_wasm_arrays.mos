// name: fmi3_wasm_arrays.mos
// keywords: FMI 3.0 export wasm array
// status: correct
// suite: wasm
// teardown_command: rm -rf fmi3_wasm_arrays.fmu fmi3_wasm_arrays.fmu.log fmi3_wasm_arrays_artifact plain_res.mat art_cs.mat d_cs* plain* om-wasm-include-*
//
// The FMI 3.0 modelDescription.xml lists the arrays x, der(x), y, p and q as one
// variable each; the wasm component serves such a value reference with all the
// array's values, as the C runtime does.

setCommandLineOptions("--simCodeTarget=wasm-jit"); getErrorString();
loadString("
package ArrPkg
  function f
    input Real[:] q;
    output Real[size(q, 1)] y;
  algorithm
    y := 2*q;
  end f;
  model M
    parameter Real q[3] = {1, 2, 3};
    parameter Real p[3] = f(q);
    Real x[3](start = {1, 2, 3}, each fixed = true);
    output Real y[3] = f(x);
  equation
    der(x) = -p .* x;
  end M;
end ArrPkg;
"); getErrorString();

simulate(ArrPkg.M, stopTime=1.0, numberOfIntervals=10, fileNamePrefix="plain"); getErrorString();

buildModelFMU(ArrPkg.M, fileNamePrefix="fmi3_wasm_arrays", fmuType="me_cs", version="3.0", platforms={"wasm"}); getErrorString();
simulate(ArrPkg.M, stopTime=1.0, numberOfIntervals=10, simflags="-s fmi3:cs -r=art_cs.mat", resimulateExecutable="fmi3_wasm_arrays.fmu"); getErrorString();

diffSimulationResults("art_cs.mat", "plain_res.mat", "d_cs", 1e-9, 1e-9);

