// name: fmi3_wasm_daemode_nores.mos
// keywords: FMI 3.0 export wasm Co-Simulation daeMode
// status: correct
// suite: wasm
// teardown_command: rm -rf DaeModeNoRes* nores_*.mat diff_nores* om-wasm-include-*
//
// A `--daeMode` model with no residual left for IDA. Its equations are only in
// evaluateDAEResiduals, so the FMU must evaluate that function and not the
// empty functionODE and functionAlgebraics.

setCommandLineOptions("--simCodeTarget=wasm-jit"); getErrorString();
loadFile("fmi3_wasm_daemode_nores.mo"); getErrorString();

simulate(DaeModeNoRes, fileNamePrefix="nores_plain"); getErrorString();
val(u, 1.0, "nores_plain_res.mat");
val(d, 1.0, "nores_plain_res.mat");
val(k, 1.0, "nores_plain_res.mat");

setCommandLineOptions("--fmuDirectory=true"); getErrorString();
buildModelFMU(DaeModeNoRes, fileNamePrefix="DaeModeNoRes", fmuType="me_cs", version="3.0", platforms={"wasm"}); getErrorString();

simulate(DaeModeNoRes, simflags="-r=nores_sim.mat", resimulateExecutable="DaeModeNoRes.fmu"); getErrorString();
simulate(DaeModeNoRes, simflags="-s fmi3:cs -r=nores_cs.mat", resimulateExecutable="DaeModeNoRes.fmu"); getErrorString();

diffSimulationResults("nores_sim.mat", "nores_plain_res.mat", "diff_nores_sim", 1e-6, 1e-6);
diffSimulationResults("nores_cs.mat", "nores_plain_res.mat", "diff_nores_cs", 1e-6, 1e-6);

