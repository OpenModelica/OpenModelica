// name: fmi_cs_output_no_der.mos
// keywords: FMI 2.0 3.0 export CoSimulation newBackend output
// status: correct
// teardown_command: rm -rf CsOutputNoDer* fmi_cs_output_no_der_*
//
// Only the old backend gives a cs FMU the output derivatives
// (introduceOutputRealDerivatives). The other FMUs must not declare or need
// them (#17892).

loadString("
model CsOutputNoDer
  Real x(start = 1, fixed = true);
  output Real y;
equation
  der(x) = -x;
  y = x + 1;
end CsOutputNoDer;
"); getErrorString();

simulate(CsOutputNoDer, stopTime = 1, fileNamePrefix = "fmi_cs_output_no_der_ref"); getErrorString();

setCommandLineOptions("--newBackend"); getErrorString();
buildModelFMU(CsOutputNoDer, version = "2.0", fmuType = "cs", fileNamePrefix = "CsOutputNoDer2", platforms = {"static"}); getErrorString();
buildModelFMU(CsOutputNoDer, version = "3.0", fmuType = "cs", fileNamePrefix = "CsOutputNoDer3", platforms = {"static"}); getErrorString();
system("unzip -p CsOutputNoDer2.fmu modelDescription.xml | grep -o \"maxOutputDerivativeOrder=.[0-9].\""); getErrorString();
system("unzip -p CsOutputNoDer3.fmu modelDescription.xml | grep -o \"maxOutputDerivativeOrder=.[0-9].\""); getErrorString();

system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py CsOutputNoDer2.fmu fmi_cs_output_no_der_2.csv 1.0 x y > fmi_cs_output_no_der_2.log 2>&1"); getErrorString();
diffSimulationResults("fmi_cs_output_no_der_2.csv", "fmi_cs_output_no_der_ref_res.mat", "fmi_cs_output_no_der_diff2", vars = {"x", "y"}); getErrorString();

setCommandLineOptions("--newBackend=false"); getErrorString();
buildModelFMU(CsOutputNoDer, version = "2.0", fmuType = "me_cs", fileNamePrefix = "CsOutputNoDer_mecs", platforms = {"static"}); getErrorString();
system("unzip -p CsOutputNoDer_mecs.fmu modelDescription.xml | grep -o \"maxOutputDerivativeOrder=.[0-9].\""); getErrorString();
buildModelFMU(CsOutputNoDer, version = "2.0", fmuType = "cs", fileNamePrefix = "CsOutputNoDer_cs", platforms = {"static"}); getErrorString();
system("unzip -p CsOutputNoDer_cs.fmu modelDescription.xml | grep -o \"maxOutputDerivativeOrder=.[0-9].\""); getErrorString();

