// name: fmi3_wasm_ls_manifest.mos
// keywords: FMI 3.0 export wasm fmi-ls-wasm manifest
// status: correct
// suite: wasm
// teardown_command: rm -rf LsManifest.fmu LsManifest.fmu.log om-wasm-include-*
//
// A wasm FMU declares fmi-ls-wasm, and the draft it follows, in the layered
// standard manifest.

setCommandLineOptions("--simCodeTarget=wasm-jit"); getErrorString();
loadString("model M Real x(start=1, fixed=true); equation der(x) = -x; end M;"); getErrorString();
buildModelFMU(M, fileNamePrefix="LsManifest", fmuType="cs", version="3.0", platforms={"wasm"}); getErrorString();
system("unzip -p LsManifest.fmu extra/org.modelica.fmi-ls-wasm/manifest.xml"); getErrorString();
