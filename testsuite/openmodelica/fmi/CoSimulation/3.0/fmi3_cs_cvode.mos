// name: fmi3_cs_cvode.mos
// keywords: FMI 3.0 export CoSimulation CVODE
// status: correct
// teardown_command: rm -rf fmi3_cs_cvode.fmu fmi3_cs_cvode.fmutmp/ fmi3_cs_cvode_res.mat fmi3_cs_cvode_fmpy.csv fmi3_cs_cvode_diff.*.csv fmi3_cs_cvode_info.json fmi3_cs_cvode_*.bin
//
// An FMI 3.0 Co-Simulation FMU with s:cvode gets the result of the simulation.

loadString("
model fmi3_cs_cvode
  Real x(start = 1, fixed = true);
  Real y(start = 0, fixed = true);
  discrete Real k(start = 1, fixed = true);
equation
  der(x) = -1000*(x - cos(time));
  der(y) = -k*y + x;
  when time > 0.55 then
    k = 3;
  end when;
end fmi3_cs_cvode;
"); getErrorString();
setCommandLineOptions("--fmiFlags=s:cvode"); getErrorString();

buildModelFMU(fmi3_cs_cvode, version="3.0", fmuType="cs"); getErrorString();
simulate(fmi3_cs_cvode, stopTime=1.0); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py fmi3_cs_cvode.fmu fmi3_cs_cvode_fmpy.csv 1.0 x y"); getErrorString();
diffSimulationResults("fmi3_cs_cvode_fmpy.csv", "fmi3_cs_cvode_res.mat", "fmi3_cs_cvode_diff", vars={"x","y"}); getErrorString();

