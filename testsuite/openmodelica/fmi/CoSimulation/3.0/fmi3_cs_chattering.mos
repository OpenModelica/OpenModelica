// name:     fmi3_cs_chattering
// keywords: FMI 2.0 3.0 export CoSimulation CVODE Euler chattering
// status:   correct
// teardown_command: rm -rf fmi3_cs_chattering*.fmu fmi3_cs_chattering*.fmutmp/ fmi3_cs_chattering*_info.json fmi3_cs_chattering.log fmi3_cs_chattering_out.txt
//
// A Co-Simulation FMU handles the events inside a step as the simulation
// does, which includes the detection of chattering: x chatters around 0
// from t = 0.5, with 1000 state events before t = 0.5000002.

loadString("
model fmi3_cs_chattering
  Real x(start = 1, fixed = true);
equation
  der(x) = if x > 0 then -2 else 2;
  annotation(experiment(StopTime = 1));
end fmi3_cs_chattering;
"); getErrorString();
setCommandLineOptions("--fmiFlags=s:cvode"); getErrorString();
buildModelFMU(fmi3_cs_chattering, version="2.0", fmuType="cs", fileNamePrefix="fmi3_cs_chattering2"); getErrorString();
buildModelFMU(fmi3_cs_chattering, version="3.0", fmuType="cs"); getErrorString();
setCommandLineOptions("--fmiFlags=s:euler"); getErrorString();
buildModelFMU(fmi3_cs_chattering, version="2.0", fmuType="cs", fileNamePrefix="fmi3_cs_chattering2_euler"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" fmi3_cs_chattering.py fmi3_cs_chattering2.fmu fmi3_cs_chattering.fmu fmi3_cs_chattering2_euler.fmu fmi3_cs_chattering_out.txt > fmi3_cs_chattering.log 2>&1"); getErrorString();
readFile("fmi3_cs_chattering_out.txt"); getErrorString();

