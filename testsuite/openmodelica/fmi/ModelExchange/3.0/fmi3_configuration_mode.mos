// name: fmi3_configuration_mode.mos
// keywords: FMI 3.0 export Configuration Mode structural parameter
// status: correct
// teardown_command: rm -rf ConfigMode.fmu ConfigMode.fmutmp/ ConfigMode_unzipped/ ConfigMode.log ConfigMode_info.json ConfigMode_FMU.libs ConfigMode_FMU.makefile ConfigMode_external_functions.json ConfigModeRust* ConfigModeDae*
//
// fmi3EnterConfigurationMode and fmi3ExitConfigurationMode. FMI 3.0 forbids
// entering Configuration Mode on an FMU without a structural parameter, so the C
// runtime and the Rust one on an ordinary model refuse it. A --daeMode FMU of
// --simCodeTarget=C+Rust has one, fmi-ls-dae's switch: Configuration Mode is open
// from Instantiated only and sets the switch, and everything but debug logging,
// Reset and FreeInstance is refused in between.

loadString("
model ConfigMode
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end ConfigMode;

model ConfigModeRust = ConfigMode;

model ConfigModeDae
  Real x(start = 1, fixed = true);
  Real y;
equation
  der(x) = -y;
  y + 0.5*y^3 = x;
end ConfigModeDae;
"); getErrorString();
setCommandLineOptions("--simCodeTarget=C"); getErrorString();
buildModelFMU(ConfigMode, version="3.0", fmuType="me_cs"); getErrorString();
system("python3 fmi3ConfigurationMode.py ConfigMode > ConfigMode.log 2>&1"); getErrorString();
readFile("ConfigMode.log"); getErrorString();

setCommandLineOptions("--simCodeTarget=C+Rust"); getErrorString();
buildModelFMU(ConfigModeRust, version="3.0", fmuType="me_cs"); getErrorString();
system("python3 fmi3ConfigurationMode.py ConfigModeRust > ConfigModeRust.log 2>&1"); getErrorString();
readFile("ConfigModeRust.log"); getErrorString();

setCommandLineOptions("--daeMode"); getErrorString();
buildModelFMU(ConfigModeDae, version="3.0", fmuType="me"); getErrorString();
system("python3 fmi3ConfigurationMode.py ConfigModeDae > ConfigModeDae.log 2>&1"); getErrorString();
readFile("ConfigModeDae.log"); getErrorString();

