// name: fmi3_configuration_mode.mos
// keywords: FMI 3.0 export Configuration Mode structural parameter
// status: correct
// teardown_command: rm -rf ConfigMode.fmu ConfigMode.fmutmp/ ConfigMode_unzipped/ ConfigMode.log ConfigMode_info.json ConfigMode_FMU.libs ConfigMode_FMU.makefile ConfigMode_external_functions.json
//
// fmi3EnterConfigurationMode and fmi3ExitConfigurationMode of the C runtime: open
// from Instantiated only, and everything but debug logging, Reset and
// FreeInstance is refused in between. The model has no structural parameter, so
// the calling sequence works for an FMU without one, which the spec says an
// importer must not ask of it.

setCommandLineOptions("--simCodeTarget=C"); getErrorString();
loadString("
model ConfigMode
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end ConfigMode;
"); getErrorString();
buildModelFMU(ConfigMode, version="3.0", fmuType="me_cs"); getErrorString();
system("python3 fmi3ConfigurationMode.py ConfigMode > ConfigMode.log 2>&1"); getErrorString();
readFile("ConfigMode.log"); getErrorString();

