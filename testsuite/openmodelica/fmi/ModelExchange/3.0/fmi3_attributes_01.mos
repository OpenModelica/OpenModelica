// name: fmi3_attributes_01.mos
// keywords: FMI 3.0 export
// status: correct
// teardown_command: rm -rf fmi3_attributes_01.fmu fmi3_attributes_01.xml fmi3_attributes_01_tmp.xml fmi3_attributes_01.fmutmp/ fmi3_attributes_01_res.mat fmi3_attributes_01_fmpy.csv fmi3_attributes_01_diff.*.csv fmi3_attributes_01_info.json fmi3_attributes_01.log fmi3_attributes_01_*.bin index.html fmi3_attributes_01_FMU.libs fmi3_attributes_01_FMU.makefile fmi3_attributes_01_external_functions.json resources

setCommandLineOptions("-d=newInst"); getErrorString();

// The states z, v, w and u test the FMI 3.0 initial and start attributes
// (#17636). z and v are not fixed, so they are initial="approx" with the default
// and the literal start. w and u start at the parameter a, which has no literal
// value in modelDescription.xml, so they are initial="calculated" without a
// start, fixed or not.
loadString("
model fmi3_attributes_01
  Real x(start=1.0);
  output Real y;
  parameter Real a = 2.0;
  Real z;
  Real v(start=1.5, fixed=false);
  Real w(start=a, fixed=true);
  Real u(start=a, fixed=false);
initial equation
  z = 3.0;
  v = 4.0;
  u = 5.0;
equation
  der(x) = -a*x;
  y = 2*x + a;
  der(z) = -z;
  der(w) = -w;
  der(v) = -v;
  der(u) = -u;
end fmi3_attributes_01;
"); getErrorString();

buildModelFMU(fmi3_attributes_01, version="3.0", fmuType="me"); getErrorString();

// unzip to console, quiet, extra quiet
system("unzip -cqq fmi3_attributes_01.fmu modelDescription.xml > fmi3_attributes_01_tmp.xml"); getErrorString();
system("sed -n \"/<ModelVariables>/,/<\\/ModelVariables>/p\" fmi3_attributes_01_tmp.xml > fmi3_attributes_01.xml"); getErrorString();
readFile("fmi3_attributes_01.xml"); getErrorString();

system("sed -n \"/<ModelStructure>/,/<\\/ModelStructure>/p\" fmi3_attributes_01_tmp.xml > fmi3_attributes_01.xml"); getErrorString();
readFile("fmi3_attributes_01.xml"); getErrorString();

// Validate the exported FMU with an independent FMI importer: simulate the
// model in OpenModelica, simulate the FMU with FMPy, and check that the FMU
// reproduces OpenModelica's own (non-FMU) simulation results.
simulate(fmi3_attributes_01, stopTime=1.0); getErrorString();
// Which interpreter can import fmpy is a property of the machine, not of the
// test, so rtest hands it over in FMPY_TOOL; python3 is the default. Kept as one
// expression so the script prints nothing extra.
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py --set-states fmi3_attributes_01.fmu fmi3_attributes_01_fmpy.csv 1.0 x y z w v u"); getErrorString();
diffSimulationResults("fmi3_attributes_01_fmpy.csv", "fmi3_attributes_01_res.mat", "fmi3_attributes_01_diff", vars={"x","y","z","w","v","u"}); getErrorString();

