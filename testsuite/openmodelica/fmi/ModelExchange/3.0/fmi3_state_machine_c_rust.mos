// name: fmi3_state_machine_c_rust.mos
// keywords: FMI 3.0 export state machine illegal call sequence
// status: correct
// teardown_command: rm -rf SmBase.fmu SmBase.fmutmp/ SmBase_unzipped/ SmClocked.fmu SmClocked.fmutmp/ SmClocked_unzipped/ SmEvents.fmu SmEvents.fmutmp/ SmEvents_unzipped/ StateMachineRust.log SmBase_* SmClocked_*
//
// fmi3_state_machine.mos on the Rust simulation runtime: the same calls, the same
// states, the same output as the C runtime.

setCommandLineOptions("--simCodeTarget=C+Rust"); getErrorString();
loadString("
model SmBase
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end SmBase;

model SmClocked
  Real x(start = 0, fixed = true);
  Real xd;
equation
  xd = sample(x, Clock(0.1));
  der(x) = 1.0 - x;
end SmClocked;

model SmEvents
  parameter Real p = 1;
  Real x(start = 1, fixed = true);
  discrete Real y(start = 0, fixed = true);
equation
  der(x) = -p * x;
  when x < 0.5 then
    y = time;
  end when;
end SmEvents;
"); getErrorString();
buildModelFMU(SmBase, version="3.0", fmuType="me_cs"); getErrorString();
buildModelFMU(SmClocked, version="3.0", fmuType="se"); getErrorString();
buildModelFMU(SmEvents, version="3.0", fmuType="me_cs"); getErrorString();
system("python3 fmi3StateMachine.py SmBase SmClocked SmEvents > StateMachineRust.log 2>&1"); getErrorString();
readFile("StateMachineRust.log"); getErrorString();

