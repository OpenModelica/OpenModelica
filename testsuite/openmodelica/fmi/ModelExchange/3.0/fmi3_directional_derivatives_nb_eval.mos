setCommandLineOptions("--newBackend --simCodeTarget=C.old -d=-disableDirectionalDerivatives"); getErrorString();
loadFile("DirectionalParameters.mo"); getErrorString();
buildModelFMU(DirectionalParameters, version="3.0", fmuType="me"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../check_fmi3_directional_derivatives_fmpy.py DirectionalParameters.fmu default-parameters"); getErrorString();
setCommandLineOptions("-d=fmiDirectionalParameters --simCodeScalarize=false"); getErrorString();
buildModelFMU(DirectionalParameters, version="3.0", fmuType="me"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../check_fmi3_directional_derivatives_fmpy.py DirectionalParameters.fmu parameters"); getErrorString();
setCommandLineOptions("--simCodeScalarize=true"); getErrorString();
buildModelFMU(DirectionalParameters, version="3.0", fmuType="me"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../check_fmi3_directional_derivatives_fmpy.py DirectionalParameters.fmu parameters"); getErrorString();

