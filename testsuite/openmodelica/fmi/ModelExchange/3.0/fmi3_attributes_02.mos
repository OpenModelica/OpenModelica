// name: fmi3_attributes_02.mos
// keywords: FMI 3.0 export
// status: correct
// teardown_command: rm -rf fmi3_attributes_02.fmu fmi3_attributes_02.xml fmi3_attributes_02_tmp.xml fmi3_attributes_02.fmutmp/ fmi3_attributes_02_info.json fmi3_attributes_02.log fmi3_attributes_02_*.bin index.html fmi3_attributes_02_FMU.libs fmi3_attributes_02_FMU.makefile fmi3_attributes_02_external_functions.json resources
//
// #17636, without the dependency analysis: a state that is not initial="exact"
// is an InitialUnknown, also the fixed state w with a start expression.

setCommandLineOptions("-d=newInst,disableFMIDependency"); getErrorString();

loadString("
model fmi3_attributes_02
  parameter Real a = 2.0;
  Real x(start=1.0, fixed=true);
  Real w(start=a, fixed=true);
  Real z;
initial equation
  z = 3.0;
equation
  der(x) = -a*x;
  der(w) = -w;
  der(z) = -z;
end fmi3_attributes_02;
"); getErrorString();

buildModelFMU(fmi3_attributes_02, version="3.0", fmuType="me"); getErrorString();

system("unzip -cqq fmi3_attributes_02.fmu modelDescription.xml > fmi3_attributes_02_tmp.xml"); getErrorString();
system("sed -n \"/<ModelVariables>/,/<\\/ModelVariables>/p\" fmi3_attributes_02_tmp.xml > fmi3_attributes_02.xml"); getErrorString();
readFile("fmi3_attributes_02.xml"); getErrorString();

system("sed -n \"/<ModelStructure>/,/<\\/ModelStructure>/p\" fmi3_attributes_02_tmp.xml > fmi3_attributes_02.xml"); getErrorString();
readFile("fmi3_attributes_02.xml"); getErrorString();

