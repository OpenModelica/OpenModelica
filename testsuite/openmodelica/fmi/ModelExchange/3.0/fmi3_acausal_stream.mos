// name: fmi3_acausal_stream.mos
// keywords: FMI 3.0 export Model Exchange daeMode fmi-ls-dae acausal terminals stream
// status: correct
// teardown_command: rm -rf Volume.fmu Sink.fmu Volume_* Sink_* Volume.* Sink.* AcausalStream_*
//
// Stream connectors of an acausal component exported with --fmuAcausalComponent
// (#17664). inStream of a stream variable of a top-level connector becomes the
// variable 'inStream(port.h_outflow)', with the placeholder residual
//   0 = OpenModelica.Internal.inStreamResidual('inStream(port.h_outflow)', port.h_outflow, "port.h_outflow")
// which still means inStream(port.h_outflow) = port.h_outflow, the inStream of an
// unconnected connector. An importer replaces it by the mixing rule of the
// connection set. The extension manifest names it as a StreamResidual, and the
// terminal pairs the stream variable with its inStream variable in a
// TerminalStreamMemberVariable. In the Sink the inStream variable is an alias of hIn.

setCommandLineOptions("--simCodeTarget=C+Rust --daeMode --fmuAcausalComponent"); getErrorString();
loadFile("fmi3_acausal_stream.mo"); getErrorString();

instantiateModel(AcausalStream.Volume); getErrorString();

buildModelFMU(AcausalStream.Volume, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq Volume.fmu extra/org.openmodelica.fmi-ls-dae-acausal/fmi-ls-manifest.xml | grep Residual | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq Volume.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml | grep -E \"Algebraic|Residual\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq Volume.fmu modelDescription.xml | grep -oE \"<Float64 name=.[^ ]*inStream[^ ]* valueReference=.[0-9]+.\""); getErrorString();
system("unzip -cqq Volume.fmu terminalsAndIcons/terminalsAndIcons.xml | grep -E \"Terminal\" | sed \"s/^ *//\""); getErrorString();

buildModelFMU(AcausalStream.Sink, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq Sink.fmu extra/org.openmodelica.fmi-ls-dae-acausal/fmi-ls-manifest.xml | grep Residual | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq Sink.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml | grep -E \"Algebraic|Residual\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq Sink.fmu modelDescription.xml | grep -E \"inStream\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq Sink.fmu terminalsAndIcons/terminalsAndIcons.xml | grep -E \"TerminalStream\" | sed \"s/^ *//\""); getErrorString();

