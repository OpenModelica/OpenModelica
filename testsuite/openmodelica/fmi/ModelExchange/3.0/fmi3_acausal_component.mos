// name: fmi3_acausal_component.mos
// keywords: FMI 3.0 export Model Exchange daeMode fmi-ls-dae acausal terminals
// status: correct
// teardown_command: rm -rf RC.fmu Source.fmu RC_* Source_* RC.* Source.* AcausalComponent_*
//
// An acausal component exported with --fmuAcausalComponent, to be connected
// through its connectors after it is compiled (#17664). A flow variable of a
// top-level connector gets the placeholder residual
//   0 = OpenModelica.Internal.connectorResidual(flow, {potentials}, "flow")
// instead of flow = 0, so it stays a residual of the fmi-ls-dae system and the
// connector variables stay unknowns of the importer. The extension manifest under
// extra/org.openmodelica.fmi-ls-dae-acausal/ names those residuals, and the
// terminals group the connector variables.
//
// Without the placeholder neither component can be exported: the RC is short one
// equation, and in the Source, which has no states, the causalized DAE mode turns
// every equation into an assignment. In the Source n.i becomes an alias of -p.i,
// which is why the residual of n names its flow by the name argument.

setCommandLineOptions("--simCodeTarget=C+Rust --daeMode --fmuAcausalComponent"); getErrorString();
loadFile("fmi3_acausal_component.mo"); getErrorString();

buildModelFMU(AcausalComponent.RC, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq RC.fmu extra/org.openmodelica.fmi-ls-dae-acausal/fmi-ls-manifest.xml > AcausalComponent_RC_acausal.xml"); getErrorString();
readFile("AcausalComponent_RC_acausal.xml"); getErrorString();
system("unzip -cqq RC.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml | grep -E \"Algebraic|Residual\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq RC.fmu modelDescription.xml | grep -oE \"<Float64 name=.p[.][a-z]. valueReference=.[0-9]+.\""); getErrorString();
system("unzip -cqq RC.fmu terminalsAndIcons/terminalsAndIcons.xml | grep -E \"Terminal \" | sed \"s/^ *//\""); getErrorString();

buildModelFMU(AcausalComponent.Source, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq Source.fmu extra/org.openmodelica.fmi-ls-dae-acausal/fmi-ls-manifest.xml | grep ConnectorResidual | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq Source.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml | grep -E \"Algebraic|Residual\" | sed \"s/^ *//\""); getErrorString();

