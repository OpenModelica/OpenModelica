// name: fmi3_arrays_scalarized.mos
// keywords: FMI 3.0 export array
// status: correct
// teardown_command: rm -rf fmi3_arrays_scalarized.fmu fmi3_arrays_scalarized.xml fmi3_arrays_scalarized_tmp.xml fmi3_arrays_scalarized.fmutmp/ fmi3_arrays_scalarized_res.mat fmi3_arrays_scalarized_fmpy.csv fmi3_arrays_scalarized_diff.*.csv fmi3_arrays_scalarized_info.json fmi3_arrays_scalarized.log fmi3_arrays_scalarized_FMU.libs fmi3_arrays_scalarized_FMU.makefile fmi3_arrays_scalarized_external_functions.json fmi3_arrays_scalarized_*.bin index.html resources
//
// The default backend scalarizes arrays, but the FMI 3.0 modelDescription.xml
// lists an array whose elements are all exported, contiguous and alike as one
// variable with <Dimension> children (SimCodeUtil.fmi3ArrayGroups): the state x
// with its derivative, the outputs y, the parameter p bound to a function call
// (kept as one variable by the frontend, #7512) and q. z's elements differ in
// min and stay scalar; a is a scalar.

loadString("
package ArrPkg
  function f
    input Real[:] q;
    output Real[size(q, 1)] y;
  algorithm
    y := 2*q;
  end f;
  model M
    parameter Real q[3] = {1, 2, 3};
    parameter Real p[3] = f(q);
    parameter Real a = 0.5;
    Real x[3](start = {1, 2, 3}, each fixed = true, each unit = \"m\");
    output Real y[3] = f(x);
    Real z[2](min = {-1, -2}) = {2*x[1], a*x[2]};
  equation
    der(x) = -p .* x;
  end M;
end ArrPkg;
"); getErrorString();

buildModelFMU(ArrPkg.M, fileNamePrefix="fmi3_arrays_scalarized", version="3.0", fmuType="me"); getErrorString();

system("unzip -cqq fmi3_arrays_scalarized.fmu modelDescription.xml > fmi3_arrays_scalarized_tmp.xml"); getErrorString();
system("sed -n \"/<ModelVariables>/,/<\\/ModelVariables>/p\" fmi3_arrays_scalarized_tmp.xml > fmi3_arrays_scalarized.xml"); getErrorString();
readFile("fmi3_arrays_scalarized.xml"); getErrorString();

system("sed -n \"/<ModelStructure>/,/<\\/ModelStructure>/p\" fmi3_arrays_scalarized_tmp.xml > fmi3_arrays_scalarized.xml"); getErrorString();
readFile("fmi3_arrays_scalarized.xml"); getErrorString();

// The array variables are read and written through their one value reference.
simulate(ArrPkg.M, stopTime=1.0, fileNamePrefix="fmi3_arrays_scalarized"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py fmi3_arrays_scalarized.fmu fmi3_arrays_scalarized_fmpy.csv 1.0 x[1] x[3] y[2] z[2]"); getErrorString();
diffSimulationResults("fmi3_arrays_scalarized_fmpy.csv", "fmi3_arrays_scalarized_res.mat", "fmi3_arrays_scalarized_diff", vars={"x[1]","x[3]","y[2]","z[2]"}); getErrorString();

