// name: fmi3_c_daemode_me.mos
// keywords: FMI 3.0 export Model Exchange daeMode fmi-ls-dae
// status: correct
// teardown_command: rm -rf DaeModeMeC* DaeModeMeEvent* fmi3_c_daemode_me_*
//
// A `--daeMode` model exported as a native Model Exchange FMU, through
// fmi-ls-dae. The FMU is an ordinary ODE FMU until the importer sets the
// structural parameter the manifest names, and a DAE FMU after: the importer
// then owns the states, their derivatives and the algebraic variables, sets
// them like any other variable, and reads the residuals back.
//
// The value references of the switch and the residuals follow the event
// indicators, the same numbers the wasm target assigns (fmi3_wasm_daemode_me).
// FMPy runs the FMU in both modes (fmi3_daemode_me.py with fixed steps). In
// DaeModeMeEvent the event changes y, which the second when condition reads:
// the event iteration must solve for y again.

setCommandLineOptions("--fmiSources=true"); getErrorString();
loadFile("fmi3_c_daemode_me.mo"); getErrorString();

buildModelFMU(DaeModeMeC, version="3.0", fmuType="me"); getErrorString();

system("unzip -cqq DaeModeMeC.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml > DaeModeMeC_lsdae.xml"); getErrorString();
readFile("DaeModeMeC_lsdae.xml"); getErrorString();

system("unzip -cqq DaeModeMeC.fmu modelDescription.xml > DaeModeMeC_md.xml"); getErrorString();
system("grep -E \"_D_daeMode|_D_DAEres\" DaeModeMeC_md.xml | sed \"s/^ *//\""); getErrorString();

system("unzip -cqq DaeModeMeC.fmu sources/DaeModeMeC_FMU.c | grep \"compiledInDAEMode\" | sed \"s/^ *//\""); getErrorString();

simulate(DaeModeMeC, fileNamePrefix="fmi3_c_daemode_me_ref"); getErrorString();
val(x, 1.0); val(y, 1.0); val(z, 1.0);

// ODE mode
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" ../../simulate_fmu_fmpy.py DaeModeMeC.fmu fmi3_c_daemode_me_ode.csv 1.0 x y z w bump"); getErrorString();
diffSimulationResults("fmi3_c_daemode_me_ode.csv", "fmi3_c_daemode_me_ref_res.mat", "fmi3_c_daemode_me_diff", vars={"x","y","z","w","bump"}); getErrorString();

// DAE mode
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" fmi3_daemode_me.py DaeModeMeC.fmu dae 1.0 1000 x y z"); getErrorString();

loadFile("fmi3_daemode_me_event.mo"); getErrorString();
simulate(DaeModeMeEvent, fileNamePrefix="fmi3_c_daemode_me_event"); getErrorString();
val(cnt, 1.0); val(y, 1.0);
buildModelFMU(DaeModeMeEvent, version="3.0", fmuType="me"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" fmi3_daemode_me.py DaeModeMeEvent.fmu ode 1.0 1000 cnt y"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" fmi3_daemode_me.py DaeModeMeEvent.fmu dae 1.0 1000 cnt y"); getErrorString();

