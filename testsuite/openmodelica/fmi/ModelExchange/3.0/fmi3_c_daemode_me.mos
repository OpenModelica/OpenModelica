// name: fmi3_c_daemode_me.mos
// keywords: FMI 3.0 export Model Exchange daeMode fmi-ls-dae
// status: correct
// teardown_command: rm -rf DaeModeMeC.fmu DaeModeMeC.log DaeModeMeC_FMU.* DaeModeMeC_info.json DaeModeMeC_external_functions.json DaeModeMeC_md.xml DaeModeMeC_lsdae.xml
//
// A --daeMode model exported as a Model Exchange FMU by the C target, through
// fmi-ls-dae. The FMU is an ordinary ODE FMU until the importer sets the
// structural parameter the manifest names, and a DAE FMU after: the importer
// then owns the states, their derivatives and the algebraic variables, sets
// them like any other variable, and reads the residuals back.
//
// The value references of the switch and the residuals follow the event
// indicators, the same numbers the wasm target assigns (fmi3_wasm_daemode_me).
//

loadFile("fmi3_c_daemode_me.mo"); getErrorString();
buildModelFMU(DaeModeMeC, version="3.0", fmuType="me"); getErrorString();

system("unzip -cqq DaeModeMeC.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml > DaeModeMeC_lsdae.xml"); getErrorString();
readFile("DaeModeMeC_lsdae.xml"); getErrorString();

system("unzip -cqq DaeModeMeC.fmu modelDescription.xml > DaeModeMeC_md.xml"); getErrorString();
system("grep -E \"_D_daeMode|_D_DAEres\" DaeModeMeC_md.xml | sed \"s/^ *//\""); getErrorString();

