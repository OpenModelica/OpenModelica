// name: fmi_attributes_26.mos
// status: correct
// teardown_command: rm -rf fmi_attributes_26.fmu fmi_attributes_26.log fmi_attributes_26.xml fmi_attributes_26_tmp.xml fmi_attributes_26.fmutmp/ fmi_attributes_26_info.json
//
// rad in <BaseUnit>, and Hz as display unit of rad/s (#13298)

setCommandLineOptions("-d=newInst,-disableDirectionalDerivatives,fmuExperimental");
getErrorString();

loadString("
model fmi_attributes_26
  Real phi(unit = \"rad\", displayUnit = \"deg\", start = 0, fixed = true);
  Real omega(unit = \"rad/s\", displayUnit = \"Hz\");
  Real speed(unit = \"rad/s\", displayUnit = \"rpm\");
  Real w(unit = \"rad/s\", displayUnit = \"1/s\");
  Real f(unit = \"Hz\");
  Real k(unit = \"1/s\", displayUnit = \"Hz\");
equation
  der(phi) = omega;
  omega = 6.283185307179586;
  speed = omega;
  w = omega;
  f = 1;
  k = f;
end fmi_attributes_26;
"); getErrorString();

buildModelFMU(fmi_attributes_26); getErrorString();

system("unzip -cqq fmi_attributes_26.fmu modelDescription.xml > fmi_attributes_26_tmp.xml"); getErrorString();
system("sed -n \"/<UnitDefinitions>/,/<\\/UnitDefinitions>/p\" fmi_attributes_26_tmp.xml > fmi_attributes_26.xml"); getErrorString();
readFile("fmi_attributes_26.xml"); getErrorString();
system("grep \"<Real\" fmi_attributes_26_tmp.xml > fmi_attributes_26.xml"); getErrorString();
readFile("fmi_attributes_26.xml"); getErrorString();

