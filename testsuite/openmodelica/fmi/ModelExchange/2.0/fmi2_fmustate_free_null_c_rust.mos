// name:     fmi2_fmustate_free_null_c_rust
// keywords: FMI 2.0 export FMU state NULL Rust
// status:   correct
// teardown_command: rm -rf fmi2_fmustate_free_null_c_rust.fmu fmi2_fmustate_free_null_c_rust.fmutmp/ fmi2_fmustate_free_null_c_rust.log
//
// fmi2FreeFMUstate must ignore a NULL pointer (FMI 2.0.5, 2.1.8),
// C+Rust runtime.
setCommandLineOptions("--simCodeTarget=C+Rust"); getErrorString();
loadString("
model fmi2_fmustate_free_null_c_rust
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end fmi2_fmustate_free_null_c_rust;
"); getErrorString();
buildModelFMU(fmi2_fmustate_free_null_c_rust, version = "2.0", fmuType = "me"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" fmi2_fmustate_free_null_c_rust.py fmi2_fmustate_free_null_c_rust.fmu > fmi2_fmustate_free_null_c_rust.log 2>&1"); getErrorString();
readFile("fmi2_fmustate_free_null_c_rust.log"); getErrorString();
