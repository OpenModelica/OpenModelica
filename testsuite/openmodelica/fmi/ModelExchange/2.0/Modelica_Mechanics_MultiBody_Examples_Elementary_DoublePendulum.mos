// name:     DoublePendulum
// keywords: DoublePendulum FMI-Export FMI-Import
// status: correct
// teardown_command: rm -rf Modelica.Mechanics.MultiBody.Examples.Elementary.DoublePendulum.* Modelica.Mechanics.MultiBody.Examples.Elementary.DoublePendulum_* binaries sources modelDescription.xml DoublePendulum.fmu DoublePendulum_me_FMU.mo DoublePendulum.lib* DoublePendulum.so DoublePendulum.dll DoublePendulum_*.c DoublePendulum_*.h DoublePendulum_*.o DoublePendulum_*.json documentation resources DoublePendulum.log DoublePendulum_*.bin
// cflags: -d=-newInst
// Simulation Results
// Modelica Standard Library
//

loadModel(Modelica, {"4.1.0"});
simulate(Modelica.Mechanics.MultiBody.Examples.Elementary.DoublePendulum,stopTime=3.0);
getErrorString();

val(revolute1.phi, 0);
val(revolute1.phi, 1);
val(revolute1.phi, 2);
val(revolute1.phi, 3);

val(revolute2.phi, 0);
val(revolute2.phi, 1);
val(revolute2.phi, 2);
val(revolute2.phi, 3);

buildModelFMU(Modelica.Mechanics.MultiBody.Examples.Elementary.DoublePendulum, version="2.0");
getErrorString();
importFMU("DoublePendulum.fmu");
getErrorString();
setCommandLineOptions("--allowNonStandardModelica=reinitInAlgorithms");
getErrorString();
loadFile("DoublePendulum_me_FMU.mo");
getErrorString();
simulate(DoublePendulum_me_FMU,stopTime=3.0,simflags="-mei=50");
getErrorString();

val(revolute1_phi, 0);
val(revolute1_phi, 1);
val(revolute1_phi, 2);
val(revolute1_phi, 3);

val(revolute2_phi, 0);
val(revolute2_phi, 1);
val(revolute2_phi, 2);
val(revolute2_phi, 3);

