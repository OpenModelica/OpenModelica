//
// The unit of der(x) is the unit of x divided by s, in the unit symbols of x (#18092)

loadString("
model derivativeUnits
  Real x01(unit = \"rad\", start = 0, fixed = true);
  Real x02(unit = \"rad/s\", start = 0, fixed = true);
  Real x03(unit = \"deg\", start = 0, fixed = true);
  Real x04(unit = \"rpm\", start = 0, fixed = true);
  Real x05(unit = \"kg\", start = 0, fixed = true);
  Real x06(unit = \"m\", start = 0, fixed = true);
  Real x07(unit = \"1\", start = 0, fixed = true);
  Real x08(unit = \"degC\", start = 0, fixed = true);
  Real x09(unit = \"degF\", start = 0, fixed = true);
  Real x10(unit = \"W/(m2.K)\", start = 0, fixed = true);
  Real x11(unit = \"1/s\", start = 0, fixed = true);
  Real x12(unit = \"s\", start = 0, fixed = true);
  Real x13(unit = \"kg/m3\", start = 0, fixed = true);
  Real x14(unit = \"ms\", start = 0, fixed = true);
  Real x15(unit = \"A.s\", start = 0, fixed = true);
  Real x16(unit = \"1/min\", start = 0, fixed = true);
  Real x17(unit = \"J\", start = 0, fixed = true);
  Real x18(unit = \"m.s-1\", start = 0, fixed = true);
  Real x19(unit = \"g/cm3\", start = 0, fixed = true);
  Real x20(unit = \"kW.h\", start = 0, fixed = true);
  Real x21(unit = \"Pa\", start = 0, fixed = true);
equation
  der(x01) = 1; der(x02) = 1; der(x03) = 1; der(x04) = 1; der(x05) = 1; der(x06) = 1; der(x07) = 1;
  der(x08) = 1; der(x09) = 1; der(x10) = 1; der(x11) = 1; der(x12) = 1; der(x13) = 1; der(x14) = 1;
  der(x15) = 1; der(x16) = 1; der(x17) = 1; der(x18) = 1; der(x19) = 1; der(x20) = 1; der(x21) = 1;
end derivativeUnits;
"); getErrorString();

buildModelFMU(derivativeUnits); getErrorString();

system("unzip -cqq derivativeUnits.fmu modelDescription.xml | grep -B3 \"derivative=\" | grep \"name=\\|<Real\" > derivativeUnits.txt"); getErrorString();
readFile("derivativeUnits.txt"); getErrorString();

