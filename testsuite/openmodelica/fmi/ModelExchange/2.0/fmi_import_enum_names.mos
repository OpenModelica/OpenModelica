// name:     fmi_import_enum_names
// keywords: FMI 2.0 3.0 import enumeration item name quoted identifier
// status:   correct
// teardown_command: rm -rf ImportEnum2* ImportEnum3* output.log
//
// FMI allows any string as the name of an enumeration item, for example
// "Option 1". importFMU must write a name that is not a valid Modelica
// identifier as a quoted identifier, in the type and in the mapping
// function, else the wrapper does not parse. A valid name stays unchanged,
// also a quoted identifier such as 'q r', which OpenModelica itself exports.
//

system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" fmi_import_enum_names.py"); getErrorString();

// FMI 2.0
importFMU("ImportEnum2.fmu"); getErrorString();
system("sed -n -e \"/type Option = enumeration/,/);/p\" -e \"/outType := /p\" ImportEnum2_me_FMU.mo > ImportEnum2_enum.txt"); getErrorString();
readFile("ImportEnum2_enum.txt");
loadFile("ImportEnum2_me_FMU.mo"); getErrorString();
translateModel(ImportEnum2_me_FMU); getErrorString();

// FMI 3.0
importFMU("ImportEnum3.fmu"); getErrorString();
system("sed -n -e \"/type Option = enumeration/,/);/p\" -e \"/outType := /p\" ImportEnum3_me_FMU.mo > ImportEnum3_enum.txt"); getErrorString();
readFile("ImportEnum3_enum.txt");
loadFile("ImportEnum3_me_FMU.mo"); getErrorString();
translateModel(ImportEnum3_me_FMU); getErrorString();

