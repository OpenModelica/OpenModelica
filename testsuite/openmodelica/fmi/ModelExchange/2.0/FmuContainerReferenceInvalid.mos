  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
end FmuContainerReferenceInvalid;
"); getErrorString();
buildModelFMU(FmuContainerReferenceInvalid, version = "2.0", fmuType = "me", platforms = {"x86_64-linux-gnu docker run ghcr.io/openmodelica/crossbuild:v1.28.0;touch$IFS/tmp/FmuContainerReferenceInvalid"}); getErrorString();
regularFileExists("/tmp/FmuContainerReferenceInvalid");

