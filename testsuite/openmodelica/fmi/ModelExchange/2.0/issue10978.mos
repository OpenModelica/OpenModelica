// name:     issue10978
// keywords: fmi assert null threadData
// status: correct
// teardown_command: rm -rf issue10978.fmu issue10978_me_FMU* output.log binaries sources modelDescription.xml resources issue10978.log issue10978_info.json
// cflags: -d=-newInst

loadString("
model issue10978
  Real x(start=1, fixed=true);
  String s;
equation
  der(x) = 0;
  s = String(x, format=\"n\");
end issue10978;
"); getErrorString();

buildModelFMU(issue10978, version="2.0"); getErrorString();
importFMU("issue10978.fmu"); getErrorString();
setCommandLineOptions("--allowNonStandardModelica=reinitInAlgorithms"); getErrorString();
loadFile("issue10978_me_FMU.mo"); getErrorString();
simulate(issue10978_me_FMU); getErrorString();

