// name:     cppruntime_constcast
// keywords: cpp runtime external const cast integer array
// status:   correct
// teardown_command: rm -rf cppruntime_constcast.fmu cppruntime_constcast_systemCall.log cppruntime_constcast_res.mat/ cppruntime_constcast-tmp/
// cflags: -d=-newInst
//
// The C++ code generator wraps input Integer array arguments with
// ConstArray().getData() which returns const int*. External C
// functions (e.g. ModelicaRandom_xorshift128plus) expect non-const
// int*, causing compilation errors.
//
// This test verifies that const_cast is applied in the generated
// code, allowing C++ FMUs with external C functions taking Integer
// arrays as inputs to compile and produce correct results.
//
// See #13060

loadModel(Modelica, {"4.0.0"}); getErrorString();
loadString("
  model cppruntime_constcast
    Integer state[Modelica.Math.Random.Generators.Xorshift128plus.nState];
    discrete Real r;
  initial equation
    pre(state) = Modelica.Math.Random.Generators.Xorshift128plus.initialState(42, 42);
  equation
    when sample(0, 0.1) then
      (r, state) = Modelica.Math.Random.Generators.Xorshift128plus.random(pre(state));
    end when;
  end cppruntime_constcast;
"); getErrorString();

setCommandLineOptions("+simCodeTarget=Cpp"); getErrorString();
buildModelFMU(cppruntime_constcast, version="2.0", fmuType="me", platforms={"static"}); getErrorString();

system(getInstallationDirectoryPath() + "/bin/OMSimulator cppruntime_constcast.fmu --intervals=2 --stopTime=0.2 --resultFile=\"cppruntime_constcast_res.mat\" --suppressPath=true --tempDir=\"cppruntime_constcast-tmp\"", "cppruntime_constcast_systemCall.log"); getErrorString();
readFile("cppruntime_constcast_systemCall.log");

val(r, 0.05, "cppruntime_constcast_res.mat");
val(r, 0.15, "cppruntime_constcast_res.mat");


