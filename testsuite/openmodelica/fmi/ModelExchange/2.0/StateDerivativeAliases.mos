// name:     StateDerivativeAliases
// keywords: FMI 2.0 FMI 3.0 export alias derivative state
// status:   correct
// teardown_command: rm -rf StateDerivativeAliases.fmu StateDerivativeAliases.fmutmp/ StateDerivativeAliases.log StateDerivativeAliases_* StateDerivativeAliases.xml StateDerivativeAliases3.xml
//
// der(y) and der(z) for the aliases y = x and z = -x of the state x: in FMI 2.0
// with the valueReference of der(x), in FMI 3.0 as an <Alias> of der(x).

loadString("
model StateDerivativeAliases
  Real x(start = 1, fixed = true);
  Real y = x;
  Real z = -x;
equation
  der(x) = -x;
end StateDerivativeAliases;
"); getErrorString();

buildModelFMU(StateDerivativeAliases, version="2.0+3.0", fmuType="me"); getErrorString();
system("unzip -cqq StateDerivativeAliases.fmu modelDescription.xml | sed -n \"/<ModelVariables>/,/<\\/ModelVariables>/p\" > StateDerivativeAliases.xml"); getErrorString();
readFile("StateDerivativeAliases.xml"); getErrorString();
system("unzip -cqq StateDerivativeAliases.fmu modelDescription.fmi3.xml | sed -n \"/<ModelVariables>/,/<\\/ModelVariables>/p\" > StateDerivativeAliases3.xml"); getErrorString();
readFile("StateDerivativeAliases3.xml"); getErrorString();

