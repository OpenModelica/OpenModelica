// name:     FmuSparseSolvers
// keywords: fmu export sparse klu kinsol
// status:   correct
// teardown_command: rm -rf binaries sources resources modelDescription.xml SparseSystems.fmu SparseSystems_* SparseSystems.*
//
// An FMU solves sparse linear and non-linear systems with KLU and KINSOL, as
// the simulation does, and gets the same result.

loadString("
model SparseSystems
  parameter Integer n = 40;
  Real x(start = 1, fixed = true);
  Real y[n];
  output Real y1 = y[1];
  Real z[n](each start = 1);
  output Real zn = z[n];
equation
  der(x) = -x + 0.01*(y[n] + z[n]);
  -3*y[1] + y[2] = x;
  for i in 2:n-1 loop
    y[i-1] - 3*y[i] + y[i+1] = sin(time);
  end for;
  y[n-1] - 3*y[n] = time;
  z[1]^3 + 4*z[1] - z[2] = x;
  for i in 2:n-1 loop
    z[i]^3 + 4*z[i] - z[i-1] - z[i+1] = 1;
  end for;
  z[n]^3 + 4*z[n] - z[n-1] = cos(time);
end SparseSystems;
"); getErrorString();
setCommandLineOptions("--tearingMethod=minimalTearing"); getErrorString();

simulate(SparseSystems); getErrorString();
x0 := val(x, 1.0);
y0 := val(y1, 1.0);
z0 := val(zn, 1.0);

buildModelFMU(SparseSystems, version="2.0", fmuType="me"); getErrorString();
importFMU("SparseSystems.fmu"); getErrorString();
setCommandLineOptions("--allowNonStandardModelica=reinitInAlgorithms"); getErrorString();
loadFile("SparseSystems_me_FMU.mo"); getErrorString();
simulate(SparseSystems_me_FMU); getErrorString();
abs(val(x, 1.0) - x0) < 1e-8;
abs(val(y1, 1.0) - y0) < 1e-8;
abs(val(zn, 1.0) - z0) < 1e-8;

