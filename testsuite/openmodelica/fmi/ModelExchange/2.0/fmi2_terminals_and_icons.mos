// name: fmi2_terminals_and_icons.mos
// keywords: FMI 2.0 export terminalsAndIcons terminals icon
// status: correct
// teardown_command: rm -rf Term2.fmu Term2.fmutmp/ Term2.log Term2_info.json Term2_FMU.libs Term2_FMU.makefile Term2_me_FMU* Term2_term.xml binaries sources documentation modelDescription.xml model.png terminalsAndIcons resources
//
// FMI 2.0.4 takes the optional directory terminalsAndIcons from FMI 3.0 (#18168).
// fmiVersion is "3.0", the FMI version that defines the file (FMI 3.0, 2.4.9).
// The terminal members are the FMI 2.0 scalar variables. Members must be inputs,
// outputs or parameters, so the acausal p and the connector of sub get no terminal.
// FMI Library rejects that fmiVersion in an FMI 2.0 FMU, so the import ignores
// what it reports on the file.

setCommandLineOptions("--allowNonStandardModelica=reinitInAlgorithms"); getErrorString();

loadString("
connector In = input Real annotation(Icon(graphics = {
  Polygon(points = {{-100,100},{100,0},{-100,-100}}, lineColor = {0,0,127}, fillColor = {0,0,127}, fillPattern = FillPattern.Solid)}));
connector Out = output Real annotation(Icon(graphics = {
  Polygon(points = {{-100,100},{100,0},{-100,-100}}, lineColor = {0,0,127}, fillColor = {255,255,255}, fillPattern = FillPattern.Solid)}));
connector Bus
  input Real a[2];
  input Real b;
end Bus;
connector Pin
  Real v;
  flow Real i;
end Pin;
model Sub
  Bus bus;
  output Real z = bus.a[1];
end Sub;

model Term2
  In u annotation(Placement(transformation(extent = {{-120,-10},{-100,10}})));
  Out y annotation(Placement(transformation(extent = {{100,-10},{120,10}})));
  Bus bus;
  Pin p;
  Sub sub(bus(a = {1, 2}, b = 3));
  Real x(start = 1, fixed = true);
equation
  der(x) = u + bus.a[1] + bus.a[2] + bus.b + sub.z - x;
  y = x;
  p.v = x;
  annotation(Icon(coordinateSystem(extent = {{-100,-100},{100,100}}), graphics = {
    Rectangle(extent = {{-100,-100},{100,100}}, lineColor = {0,0,127}, fillColor = {255,255,255}, fillPattern = FillPattern.Solid)}));
end Term2;
"); getErrorString();

buildModelFMU(Term2, version = "2.0", fmuType = "me"); getErrorString();

system("unzip -cqq Term2.fmu terminalsAndIcons/terminalsAndIcons.xml > Term2_term.xml"); getErrorString();
readFile("Term2_term.xml"); getErrorString();
system("unzip -Z1 Term2.fmu | grep -E \"^(model.png|terminalsAndIcons/.+)$\" | sort"); getErrorString();

importFMU("Term2.fmu"); getErrorString();
loadFile("Term2_me_FMU.mo"); getErrorString();
simulate(Term2_me_FMU, stopTime = 1.0); getErrorString();

