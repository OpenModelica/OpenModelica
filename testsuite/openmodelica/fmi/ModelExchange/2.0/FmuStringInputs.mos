// name:     FmuStringInputs
// keywords: FMI 2.0 FMI 3.0 export input String Boolean setString
// status:   correct
// teardown_command: rm -rf FmuStringInputs.fmu FmuStringInputs3.fmu FmuStringInputs*.fmutmp/ FmuStringInputs.log FmuStringInputs_* FmuStringInputs3_* FmuStringInputs FmuStringInputs.c FmuStringInputs.o FmuStringInputs.makefile FmuStringInputs.libs
//
// String and Boolean inputs in a simulation and in FMUs (#5113).

loadString("
model FmuStringInputs
  input String s(start = \"init\");
  input Boolean b(start = false);
  output String t;
  output Boolean nb;
  output Boolean isInit;
  Real x(start = 1, fixed = true);
equation
  der(x) = -x;
  t = s + (if b then \" on\" else \" off\");
  nb = not b;
  isInit = s == \"init\";
end FmuStringInputs;
"); getErrorString();
simulate(FmuStringInputs, stopTime = 0.1, simflags = "-override=s=abc"); getErrorString();
val(isInit, 0.1);
buildModelFMU(FmuStringInputs, version = "2.0", fmuType = "me_cs", platforms = {"static"}); getErrorString();
buildModelFMU(FmuStringInputs, version = "3.0", fmuType = "me_cs", fileNamePrefix = "FmuStringInputs3", platforms = {"static"}); getErrorString();
system("unzip -cqq FmuStringInputs3.fmu modelDescription.xml | grep \"<String\" > FmuStringInputs_strings.txt"); getErrorString();
readFile("FmuStringInputs_strings.txt"); getErrorString();
system("\"" + (if getEnvironmentVar("FMPY_TOOL") == "" then "python3" else getEnvironmentVar("FMPY_TOOL")) + "\" FmuStringInputs.py FmuStringInputs.fmu FmuStringInputs3.fmu FmuStringInputs_values.txt > FmuStringInputs.log 2>&1"); getErrorString();
readFile("FmuStringInputs_values.txt"); getErrorString();

