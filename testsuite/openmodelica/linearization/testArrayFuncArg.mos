// name: testArrayFuncArg
// keywords: linearization sparsity array function argument
// status: correct
// teardown_command: rm -rf ArrayFuncArg* linearized_model.mo
//
// The sparsity pattern failed with "BackendDAEUtil.adjacencyMatrix
// failed" when an array of states is a function argument.

loadString("
model ArrayFuncArg
  function f
    input Real u[:];
    output Real y;
  algorithm
    y := u[1]*u[2] + u[3];
  end f;
  Real x[3](start = {1, 3, 2}, each fixed = true);
  Real m = f(x);
equation
  der(x[1]) = -m;
  der(x[2]) = -x[2];
  der(x[3]) = -x[3];
end ArrayFuncArg;
"); getErrorString();

setCommandLineOptions("--generateSymbolicLinearization"); getErrorString();
linearize(ArrayFuncArg, stopTime = 0.0); getErrorString();
loadFile("linearized_model.mo"); getErrorString();
list(linearized_model);

