// name:     Pendulum linearization with csvInput
// keywords: linearization, csvInput, inputs
// status:   correct
// teardown_command: rm -rf Pendulum_* Pendulum.csv Pendulum.mat Pendulum.c Pendulum.o Pendulum.exe Pendulum.log Pendulum.bat Pendulum.makefile Pendulum.libs output.log linearized_model.* linearized_model_* linearized_model
//
// Regression test for a bug where the input operating point (u0) reported by
// linearize() did not reflect the value -csvInput actually drove the model
// with at the linearization point -- it came out as the input's declared
// default (0) instead of the csvInput-driven value (10), even though the
// simulation itself (and its result file) used the correct value throughout.
//

loadString("
model Pendulum
  Real phi(start=3.14, fixed=true);
  Real omega(start=0, fixed=true);
  input Real u1;
  input Real u2;
  output Real y1;
  output Real y2;
  parameter Real l = 1.2;
  parameter Real g = 9.81;
equation
  der(phi) = omega + u2;
  der(omega) = -g/l * sin(phi);
  y1 = y2 + 0.5*omega;
  y2 = phi + u1;
end Pendulum;
"); getErrorString();

writeFile("Pendulum.csv", "time,u1,u2,end
0.0,10.0,0.0,0
1.0,10.0,0.0,0
"); getErrorString();

setCommandLineOptions("--linearizationDumpLanguage=modelica"); getErrorString();
linearize(Pendulum, simflags="-csvInput=Pendulum.csv -l=0.02"); getErrorString();
readFile("linearized_model.mo");


