// name:     testFunctionStatementDiff
// keywords: differentiation linearization function algorithm
// status:   correct
// teardown_command: rm -rf DiffFunctionStatements* output.log linearized_model*
//
// The derivative of an assignment that reads its own target must be
// computed before the assignment, and Integer variables have no derivative.
// f(x) = x^3, so A = -3*x^2 = -12.

loadString("
model DiffFunctionStatements
  function f
    input Real x;
    output Real y;
  protected
    Integer n = 3;
  algorithm
    y := 1;
    for i in 1:n loop
      y := y*x;
    end for;
    annotation(Inline=false);
  end f;
  Real x(start=2, fixed=true);
equation
  der(x) = -f(x);
end DiffFunctionStatements;
");
getErrorString();

setCommandLineOptions("--generateSymbolicLinearization");
getErrorString();
linearize(DiffFunctionStatements, stopTime=0);
getErrorString();
loadFile("linearized_model.mo");
list(linearized_model);
getErrorString();

