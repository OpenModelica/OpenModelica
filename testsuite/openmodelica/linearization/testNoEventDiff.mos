// name:     testNoEventDiff
// keywords: differentiation linearization noEvent function
// status:   correct
// teardown_command: rm -rf noEventDiffTest* output.log linearized_model*
//
// Symbolic differentiation of noEvent in a function body, #18016.
//

loadString("
model noEventDiffTest
  function f
    input Real x;
    input Real m;
    output Real y;
  protected
    Real ma;
  algorithm
    ma := noEvent(abs(m));
    y := ma * x;
    annotation(Inline = false);
  end f;
  parameter Real m = -50;
  Real x(start = 1, fixed = true);
equation
  der(x) = -f(x, m);
end noEventDiffTest;
");
getErrorString();

setCommandLineOptions("--generateSymbolicLinearization");
linearize(noEventDiffTest, stopTime=0.0);
getErrorString();

loadFile("linearized_model.mo");
list(linearized_model);

