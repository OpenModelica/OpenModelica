// name:     testNlsInitFailure.mos
// keywords: kinsol nls initialization assert
// status: correct
// teardown_command: rm -rf testNlsFail* output.log
// cflags: -d=-newInst
//
// An initial system with no real solution: eliminating y leaves x^2 = -32/9.
// The retry ladder gives up, the generated functionDAE throws, and C's
// initializeModel reports the throw that reached it. Only the verdict is
// checked - the iterates the ladder walks through are not reproducible.
//
loadString("
model testNlsFail
  Real x(start = 1, nominal = 2.3);
  Real y(start = 1, nominal = 1.2);
  Real z(start = 1, nominal = 2.1);
  Real s(start = 1, fixed = true, nominal = 1);
equation
  x^2 + 3 * y - 5 * z^2 = 1;
  y + 2 * z^2 - x^2 = 1;
  1e-6 * x^2 - 3 * y = s;

  der(s) = x;
end testNlsFail;
"); getErrorString();

simulate(testNlsFail,
         simflags="-nls=experimental-kinsol",
         startTime=0,
         stopTime=0); getErrorString();

// Result:
// true
// ""
// record SimulationResult
//     resultFile = "",
//     simulationOptions = "startTime = 0.0, stopTime = 0.0, numberOfIntervals = 500, tolerance = 1e-6, method = 'dassl', fileNamePrefix = 'testNlsFail', options = '', outputFormat = 'mat', variableFilter = '.*', cflags = '', simflags = '-nls=experimental-kinsol'",
