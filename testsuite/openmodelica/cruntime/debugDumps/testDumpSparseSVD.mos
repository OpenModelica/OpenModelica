// name:     testDumpSparseSVD.mos
// keywords: kinsol jacobian sparse svd dumps
// status: correct
// teardown_command: rm -rf testDumpSVD* output.log
// cflags: -d=-newInst
//
// Test flag LOG_NLS_SVD and -svdCount to detect equations / variables that cause poorly conditioned Jacobians.
//
// Three 2x2 systems, each solved by the first KINSol() call, so every dumped
// matrix is a Jacobian at a start point and not at one some retry ladder
// wandered to. How nearly parallel a pair's two equations are sets the
// conditioning: xc/zc are 1e-6 apart (cond ~ 5e6), xb/zb 1e-3 (cond ~ 5e3).
// xa/ya/za is torn, so the eqn_simcode_indices offset is covered too. der(s)
// reads all three so they share functionODE and are solved in the same order by
// every target.
//
// No "fairly"/"very ill-conditioned" matrix here: sigma_max is capped at sqrt(2)
// by the row equilibration, so cond > 1e8 needs a sigma_min the normal equations
// cannot resolve however tight -svdTol is, and it does not reproduce. -svdTol is
// passed at a value both targets already converge past, to cover the flag.
//
loadString("
model testDumpSVD
  Real xa(start = 1.2, nominal = 1.3);
  Real ya(start = 1.0, nominal = 1.1);
  Real za(start = 0.8, nominal = 0.9);
  Real xb(start = 1.2, nominal = 1.0);
  Real zb(start = 0.8, nominal = 1.0);
  Real xc(start = 1.2, nominal = 1.0);
  Real zc(start = 0.8, nominal = 1.0);
  Real s(start = 1, fixed = true, nominal = 1);
equation
  ya = xa * za;
  xa^2 + za^2 + ya = 2 + s;
  xa^2 + 1.001 * za^2 + ya = 2.001 + s;

  xb^2 + zb^2 = 1 + s;
  xb^2 + 1.001 * zb^2 = 1.001 + s;

  xc^2 + zc^2 = 1 + s;
  xc^2 + 1.000001 * zc^2 = 1.000001 + s;

  der(s) = xa + xb + xc;
end testDumpSVD;
"); getErrorString();

simulate(testDumpSVD,
         simflags="-lv=LOG_NLS_SVD -svdCount=1 -svdSigma=1e-8 -svdTol=1e-10 -nls=experimental-kinsol",
         startTime=0,
         stopTime=0); getErrorString();

