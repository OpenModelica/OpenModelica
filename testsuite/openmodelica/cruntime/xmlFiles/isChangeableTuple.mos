// name: isChangeableTuple
// keywords: xml, init, changeable value, tuple
// status: correct
// cflags: -d=omedit

loadString("
model isChangeableTuple
  Real x,y1,y2;
protected
  function f
    input Real x;
    output Real y1;
    output Real y2;
  algorithm
    y1 := x + x;
    y2 := x*x;
  end f;
equation
  x = 2;
  (y1, y2) = f(x);
end isChangeableTuple;
"); getErrorString();

translateModel(isChangeableTuple); getErrorString();
readInitFile("isChangeableTuple_init.bin"); getErrorString();

