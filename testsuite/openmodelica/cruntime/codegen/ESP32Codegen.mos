// name: ESP32Codegen
// keywords: codegen ESP32 embedded ESP-IDF
// status: correct
// teardown_command: rm -rf ESP32Model_esp32
//
// Checks the ESP-IDF project generated by --simCodeTarget=ESP32.
//

loadString("
model ESP32Model
  parameter Real tau = 0.5;
  Real x(start = 1.0, fixed = true);
  Real y;
equation
  der(x) = -x/tau;
  y = 2*x;
end ESP32Model;
"); getErrorString();

setCommandLineOptions("--simCodeTarget=ESP32"); getErrorString();

translateModel(ESP32Model, startTime = 0.0, stopTime = 1.0, numberOfIntervals = 100); getErrorString();

readFile("ESP32Model_esp32/main/ESP32Model_model.h");
readFile("ESP32Model_esp32/main/ESP32Model_model.c");
readFile("ESP32Model_esp32/main/CMakeLists.txt");
readFile("ESP32Model_esp32/CMakeLists.txt");
readFile("ESP32Model_esp32/sdkconfig.defaults");
// main.c and README.md are only checked for existence, they do not depend on
// the model beyond its name.
regularFileExists("ESP32Model_esp32/main/main.c");
regularFileExists("ESP32Model_esp32/README.md");

// Result:
// true
// ""
// true
// ""
// true
