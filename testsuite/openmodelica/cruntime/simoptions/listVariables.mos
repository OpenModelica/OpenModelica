// name: listVariables
// keywords: -listVariables -override
// status: correct
// teardown_command: rm -rf ListVariables* listVariables_override.txt
//
// The simulation executable prints its variables as JSON.

loadString("
package P
  type E = enumeration(a, b, c);
  model ListVariables
    parameter Real k(unit = \"m\", min = 0, max = 10) = 0.5 \"gain \\\"k\\\"\";
    parameter Integer n = 3;
    parameter Boolean b = true;
    parameter String s = \"text\";
    parameter E e = E.b;
    parameter Real p[2] = {1, 2};
    parameter Real q = 2*k;
    input Real u;
    output Real y;
    Real x(start = 1, fixed = true);
    Real w = x annotation(HideResult = true);
  protected
    Real z;
  equation
    der(x) = -k*x + u;
    y = x;
    z = 2*y;
  end ListVariables;
end P;
"); getErrorString();

buildModel(P.ListVariables, fileNamePrefix = "ListVariables"); getErrorString();
writeFile("listVariables_override.txt", "n=4\n"); getErrorString();

echo(false);
r := simulate(P.ListVariables, fileNamePrefix = "ListVariables", resimulateExecutable = "ListVariables", simflags = "-listVariables -override=k=2,s=new,b=false,q=7 -overrideFile=listVariables_override.txt");
s := r.messages;
s := stringReplace(s, getVersion(), "<version>");
echo(true);
print(s);

