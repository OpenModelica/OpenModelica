// name:     testIDAnoEquidistantTimeEvent
// keywords: ida, noEquidistantTimeGrid, time event
// status: correct
//
// Each internal IDA step must not count as reaching the time event (#17330).
//
loadString("
model testIDAnoEquidistantTimeEvent
  Real x(start = 1, fixed = true);
  discrete Real k(start = 1, fixed = true);
equation
  der(x) = -k*x;
  when time >= 0.5 then
    k = 2;
  end when;
end testIDAnoEquidistantTimeEvent;"); getErrorString();
simulate(testIDAnoEquidistantTimeEvent, stopTime=1.0, method="ida", simflags="-noEquidistantTimeGrid"); getErrorString();
readSimulationResultSize("testIDAnoEquidistantTimeEvent_res.mat") < 100;
val(k, 0.25);
val(k, 0.75);
abs(val(x, 1.0) - exp(-1.5)) < 1e-5;

