// name: lssMinSize
// status: correct

loadString("
model M
  Real x[3](each start = 0);
equation
  sin(time+1)*x[1] + x[2] + 2*x[3] = time;
  x[1] - cos(time)*x[2] + x[3] = 1;
  x[1] + x[2] + (3+time)*x[3] = 2;
end M;
"); getErrorString();

simulate(M, simflags="-lssMinSize=0"); getErrorString();
val(x[1], 1.0);
val(x[2], 1.0);
val(x[3], 1.0);
simulate(M, simflags="-ls=lapack -lssMinSize=0"); getErrorString();

