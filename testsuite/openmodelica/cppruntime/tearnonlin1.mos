// name:     Tearnonlin1
// keywords: events
// status: correct
// teardown_command: rm -rf  tearnonlin1_res.csv
//
// Algebraic loop
//

setCommandLineOptions("--simCodeTarget=Cpp"); getErrorString();

loadFile("tearnonlin1.mo"); getErrorString();
simulate(tearnonlin1, method="dassl",stopTime=3.0, tolerance=1e-10, numberOfIntervals=400,outputFormat="csv"); getErrorString();

