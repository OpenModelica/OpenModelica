// name: arrayMatrixTest
// keywords: array matrix
// status: correct
// teardown_command: rm -f *ArrayMatrix.*
//
// matrix(A) of an argument whose trailing sizes are only known at runtime.

setCommandLineOptions("+simCodeTarget=Cpp");

loadString("
package ArrayMatrix
  function f
    input Real A[:, :, :, :];
    output Real B[size(A, 1), size(A, 2)];
  algorithm
    B := matrix(A);
  end f;

  model Valid
    Real x[2, 2] = f({{{{time}}, {{2*time}}}, {{{3*time}}, {{4*time}}}});
  end Valid;

  model Invalid
    Real x[2, 2] = f(fill(time, 2, 2, 1, 3));
  end Invalid;
end ArrayMatrix;
");
getErrorString();

simulate(ArrayMatrix.Valid, stopTime = 1);
getErrorString();
val(x[2, 1], 1.0);

echo(false);
res := simulate(ArrayMatrix.Invalid, stopTime = 1);
messages := res.messages;
echo(true);
getErrorString();
regexBool(messages, "Invalid dimension 4 of argument to matrix, expected dimension size 1 but got 3");

// Result:
// true
// true
