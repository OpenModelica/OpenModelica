// name: mslElectricalSensorsTest
// keywords: array subscript const complex
// status: correct
// teardown_command: rm -f *TestSensors*

setCommandLineOptions("+simCodeTarget=Cpp");

loadModel(Modelica, {"4.1.0"}); getErrorString();

simulate(Modelica.Electrical.QuasiStatic.Polyphase.Examples.TestSensors);
val(currentQuasiRMSSensor.I, 0.1);
getErrorString();

