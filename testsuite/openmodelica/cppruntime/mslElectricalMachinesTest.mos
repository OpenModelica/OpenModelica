setCommandLineOptions("+simCodeTarget=Cpp");

loadModel(Modelica, {"4.1.0"}); getErrorString();

simulate(Modelica.Electrical.Machines.Examples.Transformers.IMC_Transformer);
val(currentQuasiRMSSensor.I, 2.5);
val(aimc.wMechanical, 2.5);
val(aimc.tauElectrical, 2.5);
getErrorString();

