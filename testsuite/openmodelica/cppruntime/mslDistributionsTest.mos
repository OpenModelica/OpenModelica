// name: mslDistributionsTest
// keywords: pre array const
// status: correct
// teardown_command: rm -f *NoiseExamples*

setCommandLineOptions("+simCodeTarget=Cpp");

loadModel(Modelica, {"4.1.0"}); getErrorString();

simulate(Modelica.Blocks.Examples.Noise.Distributions);
val(truncatedNormalNoise_y, 2.0);
val(uniformNoise_y, 2.0);
getErrorString();

