// name:     NB_ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.VDI2048Example_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_Outputs.csv ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_Inputs.csv ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_Correlation_Inputs.csv ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_Reconciled_Sx.csv ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_Reconciled_tmp.mo ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_AuxiliaryConditions.html ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_IntermediateEquations.html ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_relatedBoundaryConditionsEquations.html ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_debug.txt ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_iterationVars.txt ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_NonReconcilcedVars.txt Reconciled_ModelicaDataReconciliationSimpleTests_Models_VDI2048_VDI2048Example.mo ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.VDI2048.VDI2048Example_Outputs.csv");
getErrorString();

