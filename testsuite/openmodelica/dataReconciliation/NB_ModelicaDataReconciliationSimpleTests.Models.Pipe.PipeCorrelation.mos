// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Pipe.PipeCorrelation ModelicaDataReconciliationSimpleTests.Models.Pipe.PipeCorrelation_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Pipe_PipeCorrelation.mo ModelicaDataReconciliationSimpleTests.Models.Pipe.PipeCorrelation.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Pipe.PipeCorrelation, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Pipe.PipeCorrelation, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

echo(false);
res := simulate(ModelicaDataReconciliationSimpleTests.Models.Pipe.PipeCorrelation, simflags=simFlags);
echo(true);
res.resultFile;
regexBool(res.messages, "solveSystemFstar\\(\\) Failed");
echo(false); getErrorString(); echo(true);

