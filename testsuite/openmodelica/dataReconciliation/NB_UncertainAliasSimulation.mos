// name:     NB_UncertainAliasSimulation
// keywords: data reconciliation, uncertain, alias, #14866
// status:   correct
// teardown_command: rm -rf UncertainAliasSimulation.Plain UncertainAliasSimulation.Plain.* UncertainAliasSimulation.Plain_* Reconciled_UncertainAliasSimulation_Plain.mo UncertainAliasSimulation.Refine UncertainAliasSimulation.Refine.* UncertainAliasSimulation.Refine_* Reconciled_UncertainAliasSimulation_Refine.mo UncertainAliasSimulation.html
//
// The uncertain attribute is only meant for data reconciliation. Without it
// enabled, uncertain=Uncertainty.refine must not change which alias variable
// is kept, so both models must iterate on a with start = 1.

setCommandLineOptions("--newBackend");
getErrorString();

loadString("
package UncertainAliasSimulation
  model Plain
    Real a(start = 1);
    Real b(start = 2);
  equation
    a = b;
    a^3 + b = 3 + time;
  end Plain;
  model Refine
    Real a(start = 1);
    Real b(start = 2, uncertain = Uncertainty.refine);
  equation
    a = b;
    a^3 + b = 3 + time;
  end Refine;
end UncertainAliasSimulation;
"); getErrorString();

setCommandLineOptions("-d=iterationVars"); getErrorString();
translateModel(UncertainAliasSimulation.Plain); getErrorString();
translateModel(UncertainAliasSimulation.Refine); getErrorString();

// Result:
// endResult
