// name:     NB_TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3
// keywords: extraction algorithm
// status:   correct
// The expected result records a known failure, not the correct output. Update it when
// the model starts working, see https://github.com/OpenModelica/OpenModelica/issues/15384
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3 TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3_* Reconciled_TSP_DataReconciliationSimpleTests_Models_Pipe_TSP_Pipe3.mo TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

// How the simulation fails depends on the runtime (C or wasm-jit), so only
// record that it fails: resultFile stays empty until the model works.
echo(false);
res := simulate(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe3, simflags=simFlags);
echo(true);
res.resultFile;
echo(false); getErrorString(); echo(true);

