// name:     NB_TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3 TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3_* Reconciled_TSP_DataReconciliationSimpleTests_Models_FourFlows_TSP_FourFlows3.mo TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3.html
//
// TODO: fails because of a loop in the jacobian F, like Splitter5e. SET-S contains
// an algebraic loop with the iteration variable
//   volumeB1.Cs2.Q
// whose derivative is a linear system inside the jacobian F. The new backend cannot
// generate it yet and the simulation fails with "residual function pointer is
// invalid". See the TODO at createJacobian in NBDataReconciliation.mo.

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3, simflags=simFlags);
getErrorString();

readFile("TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows3_Outputs.csv");
getErrorString();

// Result:
// endResult
