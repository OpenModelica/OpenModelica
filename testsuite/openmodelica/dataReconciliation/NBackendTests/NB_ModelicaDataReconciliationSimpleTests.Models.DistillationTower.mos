// name:     NB_ModelicaDataReconciliationSimpleTests.Models.DistillationTower
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.DistillationTower ModelicaDataReconciliationSimpleTests.Models.DistillationTower_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_DistillationTower.mo ModelicaDataReconciliationSimpleTests.Models.DistillationTower.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(ModelicaDataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.DistillationTower, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.DistillationTower, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.DistillationTower, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.DistillationTower_Outputs.csv");
getErrorString();

