// name:     NB_TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5 TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5_* Reconciled_TSP_DataReconciliationSimpleTests_Models_FourFlows_TSP_FourFlows5.mo TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5.html
//
// TODO: fails in the initialization of the reconciled system with
//   NBTearing.mo:1143: Internal error UnorderedMap.getSafe failed because the key did not exist.
//   Internal error NBInitialization.main failed to apply modules!
// The extraction algorithm and its verification succeed, the failure comes later in
// the new backend.

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5, simflags=simFlags);
getErrorString();

readFile("TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows5_Outputs.csv");
getErrorString();

