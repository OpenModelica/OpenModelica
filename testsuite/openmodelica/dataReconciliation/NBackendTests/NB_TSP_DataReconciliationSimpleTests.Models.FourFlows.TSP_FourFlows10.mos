// name:     NB_TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10 TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10_* Reconciled_TSP_DataReconciliationSimpleTests_Models_FourFlows_TSP_FourFlows10.mo TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10, simflags=simFlags);
getErrorString();

// The reconciled values differ in the 6th digit between compilers, only check
// that the reconciliation wrote its results.
regularFileExists("TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows10_Outputs.csv");
getErrorString();

// Result:
// endResult
