// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4 ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Splitter_Splitter4.mo ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(ModelicaDataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter4_Outputs.csv");
getErrorString();

// Result:
// endResult
