// name:     NB_TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8 TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8_* Reconciled_TSP_DataReconciliationSimpleTests_Models_Pipe_TSP_Pipe8.mo TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8.html
//
// TODO: fails because of a loop in the jacobian F, like Splitter5e. SET-S contains
// an algebraic loop whose derivative is a linear system inside the jacobian F. The
// new backend cannot generate it yet and the simulation fails with "residual
// function pointer is invalid". See the TODO at createJacobian in
// NBDataReconciliation.mo.
// The old backend fails too, with the assert "incorrect fluid number" in
// ThermoSysPro.Properties.Fluid.derTemperature_derP_derh.

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

// How the simulation fails depends on the runtime (C or Rust), so only
// record that it fails: resultFile stays empty until the model works.
echo(false);
res := simulate(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe8, simflags=simFlags);
echo(true);
res.resultFile;
getErrorString();

// Result:
// endResult
