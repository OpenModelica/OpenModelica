// name:     NB_TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12 TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12_* Reconciled_TSP_DataReconciliationSimpleTests_Models_Pipe_TSP_Pipe12.mo TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12.html
//
// TODO: the simulation of the reconciled system fails at initialization:
//   Solving non-linear system 8 failed at time=0.
// The extraction algorithm and its verification succeed.
// Both backends report Condition 2-Failed (ill-posed problem).

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12, simflags=simFlags);
getErrorString();

readFile("TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe12_Outputs.csv");
getErrorString();

