// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5 ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Pipe_Pipe5.mo ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(ModelicaDataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe5_Outputs.csv");
getErrorString();

