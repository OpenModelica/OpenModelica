// the model starts working, see https://github.com/OpenModelica/OpenModelica/issues/15384
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows2 TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows2_* Reconciled_TSP_DataReconciliationSimpleTests_Models_FourFlows_TSP_FourFlows2.mo TSP_DataReconciliationSimpleTests.Models.FourFlows.TSP_FourFlows2.html
