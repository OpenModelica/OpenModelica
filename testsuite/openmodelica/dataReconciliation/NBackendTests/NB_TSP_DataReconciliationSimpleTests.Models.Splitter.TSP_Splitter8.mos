// name:     NB_TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8
// keywords: extraction algorithm
// status:   correct
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8 TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8_* Reconciled_TSP_DataReconciliationSimpleTests_Models_Splitter_TSP_Splitter8.mo TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8.html
//
// TODO: fails in NSimCode because a tuple equation is not solved:
//   NSimStrongComponent.Block.createEquation failed with status Solve.UNPROCESSED for
//   (staticDrum1.lsat, staticDrum1.vsat) = ThermoSysPro.Properties.WaterSteam.IF97.Water_sat_P(staticDrum1.P)
// The extraction algorithm and its verification succeed, the failure comes later in
// the new backend.
// The old backend fails too, with a division by zero at initialization, the divisor
// is singularPressureLoss3.deltaP.

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadModel(TSP_DataReconciliationSimpleTests, {"4.0.0"});
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8, simflags=simFlags);
getErrorString();

readFile("TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter8_Outputs.csv");
getErrorString();

// Result:
// endResult
