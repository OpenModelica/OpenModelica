// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.Splitter5d_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Splitter_Splitter5d.mo ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5d_Outputs.csv");
getErrorString();

