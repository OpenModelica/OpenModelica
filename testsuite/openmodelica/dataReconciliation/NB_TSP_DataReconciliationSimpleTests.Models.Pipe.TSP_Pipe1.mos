// name:     NB_TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1
// keywords: extraction algorithm
// status:   correct
// depends: ./TSP_DataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.TSP_Pipe1_Inputs.csv
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1 TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1_* Reconciled_TSP_DataReconciliationSimpleTests_Models_Pipe_TSP_Pipe1.mo TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("TSP_DataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1, simflags=simFlags);
getErrorString();

readFile("TSP_DataReconciliationSimpleTests.Models.Pipe.TSP_Pipe1_Outputs.csv");
getErrorString();

