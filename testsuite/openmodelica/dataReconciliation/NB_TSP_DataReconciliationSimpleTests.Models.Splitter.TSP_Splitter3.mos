// name:     NB_TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3
// keywords: extraction algorithm
// status:   correct
// depends: ./TSP_DataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.TSP_Splitter3_Inputs.csv
// teardown_command: rm -rf TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3 TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3_* Reconciled_TSP_DataReconciliationSimpleTests_Models_Splitter_TSP_Splitter3.mo TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("TSP_DataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3, simflags=simFlags);
getErrorString();

readFile("TSP_DataReconciliationSimpleTests.Models.Splitter.TSP_Splitter3_Outputs.csv");
getErrorString();

