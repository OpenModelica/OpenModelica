// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.Splitter5_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5 ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Splitter_Splitter5.mo ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5_Outputs.csv");
getErrorString();

