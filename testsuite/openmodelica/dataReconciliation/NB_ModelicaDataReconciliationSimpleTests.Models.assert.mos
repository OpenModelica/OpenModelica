// name:     NB_ModelicaDataReconciliationSimpleTests.Models.assert
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/model_assert_DR.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.assert ModelicaDataReconciliationSimpleTests.Models.assert_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_assert.mo ModelicaDataReconciliationSimpleTests.Models.assert.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.assert, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.assert, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.assert, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.assert_Outputs.csv");
getErrorString();

