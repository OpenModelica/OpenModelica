// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.Pipe6_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6 ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Pipe_Pipe6.mo ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe6_Outputs.csv");
getErrorString();

