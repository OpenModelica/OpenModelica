// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.Splitter5e_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Splitter_Splitter5e.mo ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter5e_Outputs.csv");
getErrorString();

