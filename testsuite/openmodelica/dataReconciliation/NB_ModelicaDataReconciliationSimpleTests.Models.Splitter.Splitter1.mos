// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.Splitter1_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1 ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Splitter_Splitter1.mo ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Splitter.Splitter1_Outputs.csv");
getErrorString();

