// name:     NB_ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2
// keywords: extraction algorithm
// status:   correct
// depends: ./ModelicaDataReconciliationSimpleTests/resources/NewDataReconciliationSimpleTests.Pipe2_Inputs.csv
// teardown_command: rm -rf ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2 ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2_* Reconciled_ModelicaDataReconciliationSimpleTests_Models_Pipe_Pipe2.mo ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2.html

setCommandLineOptions("--newBackend");
getErrorString();

setCommandLineOptions("--preOptModules+=dataReconciliation");
getErrorString();
loadFile("ModelicaDataReconciliationSimpleTests/package.mo");
getErrorString();

AnnotationNamedModifiers:=getAnnotationNamedModifiers(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2, "__OpenModelica_simulationFlags");

simFlags:="-reconcile ";
for i in 1:size(AnnotationNamedModifiers, 1) loop
  simFlags:=simFlags+ " -"+AnnotationNamedModifiers[i]+"="+getAnnotationModifierValue(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2, "__OpenModelica_simulationFlags", AnnotationNamedModifiers[i]);
end for;
print("simFlags: "+simFlags);

simulate(ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2, simflags=simFlags);
getErrorString();

readFile("ModelicaDataReconciliationSimpleTests.Models.Pipe.Pipe2_Outputs.csv");
getErrorString();

