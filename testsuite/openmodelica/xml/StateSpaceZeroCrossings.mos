// name: StateSpaceZeroCrossings
// keywords: xml, dump, zero crossing, #2730
// status: correct
// teardown_command: rm -f ZcEqIds.xml
//
// The equation ids of a zero crossing refer to the sorted equations, also
// when the model has more than one system and an algebraic loop.

loadString("
model ZcEqIds
  Real x(start = 1, fixed = true);
  Real y, w, u, v(start = 1);
  Boolean b;
equation
  w = 2*time;
  b = time > 0.5;
  der(x) = if x > 0.3 then -x else 0;
  u + v = w;
  u - sin(v) = 1;
  y = if u > 1.2 then 1 else 0;
end ZcEqIds;
"); getErrorString();
dumpXMLDAE(ZcEqIds, translationLevel = "stateSpace"); getErrorString();
readFile("ZcEqIds.xml");
