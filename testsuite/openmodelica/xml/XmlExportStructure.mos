// name: XmlExportStructure
// keywords: xml, #2717, #3120, #4024, #4025
// status: correct
// teardown_command: rm -f XmlEx.xml XmlEx.part.xml
//
// The XML export writes record constructors, record fields of function
// results, subscripted names, algebraic loops and when-statements as
// well-formed XML.

loadString("
model XmlEx
  record R
    Real a;
    Real b;
  end R;
  function f
    input Real x;
    output R r;
  algorithm
    r := R(x, 2*x);
  end f;
  R r, q[2];
  Real x(start = 1, fixed = true);
  Real y, w, z(start = 1);
algorithm
  when time > 0.5 then
    r := R(1, 2);
  elsewhen time > 0.8 then
    r := R(3, 4);
  end when;
equation
  q[1] = R(x, 2*x);
  q[2] = R(r.a, 3*x);
  der(x) = -x;
  y = f(x).b;
  w = y + q[2].b;
  z + sin(z) = w;
end XmlEx;
"); getErrorString();
setCommandLineOptions("--postOptModules-=wrapFunctionCalls"); getErrorString();
translateModelXML(XmlEx); getErrorString();
system("sed -n '/<equ:DynamicEquations>/,/<\\/equ:DynamicEquations>/p;/<fun:Algorithm>/,/<\\/fun:Algorithm>/p' XmlEx.xml > XmlEx.part.xml"); getErrorString();
readFile("XmlEx.part.xml");
