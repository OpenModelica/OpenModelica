// name:   ConvertMessage1
// status: correct
// depends: scripts

loadString("
  package ConvertMessage1
    model M
      A.B.C c;
      A.B b(x = 1.0);
      Real x = A.B.x;
    equation
      x = fn(A.B.x);
    end M;
  end ConvertMessage1;
");

runConversionScript(ConvertMessage1, "scripts/ConvertMessage1.mos");
getErrorString();

