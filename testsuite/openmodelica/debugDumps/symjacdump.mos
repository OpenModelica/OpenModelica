loadString("
model testSymjacdump \"testsuite/simulation/modelica/nonlinear_system/nlsTestPackage.mo: model problem6\"
  parameter Integer N = 5;
  parameter Real h = 1/(N+1);
  Real x[N](each start=0.5);
equation
  x[1] = x[N];
  for k in 2:N-1 loop
    0 = -x[k-1] + 2*x[k] -x[k+1] + (h^2/2)*(x[k]+k*h+1)^2;
  end for;
  x[N] = 0;
end testSymjacdump;
"); getErrorString();

setDebugFlags("symjacdump,NLSanalyticJacobian"); getErrorString();
buildModel(testSymjacdump); getErrorString();

