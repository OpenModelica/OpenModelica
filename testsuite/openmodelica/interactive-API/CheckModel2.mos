// name: CheckModel2
// keywords:
// status: correct
//

loadString("
  model M
    outer Real y;
    Real x = \"error\";
  end M;
");

checkModel(M);
checkModel(M); // Check again to make sure earlier errors aren't counted.
getErrorString();

