// name: getClassDiagram1
// keywords: UML, class diagram, PlantUML, #16938
// status: correct
//
// Tests getClassDiagram with PlantUML: extends with modifiers, a class extends
// of a replaceable function, a replaceable package and the redeclare of it in
// a modifier, the depth and showModifiers arguments, a class that doesn't
// exist and a format that doesn't.

loadString("package R
  partial package PartialMedium
    constant Integer nX = 1;
    replaceable function h
      input Real x;
      output Real y = x;
    end h;
  end PartialMedium;
  package Water
    extends PartialMedium(nX = 2);
    redeclare function extends h
    algorithm
      y := 2*x;
    end h;
  end Water;
  model Pipe
    replaceable package Medium = PartialMedium;
    Real z[Medium.nX] = fill(Medium.h(1), Medium.nX);
  end Pipe;
  model System
    Pipe p(redeclare package Medium = Water);
  end System;
end R;
", "getClassDiagram1.mo"); getErrorString();

getClassDiagram(R.System); getErrorString();
// Only the class and its base classes.
getClassDiagram(R.Pipe, depth = 0); getErrorString();
getClassDiagram(R.Water, showModifiers = false); getErrorString();
getClassDiagram(R.NoSuchClass); getErrorString();
getClassDiagram(R.System, format = "svg"); getErrorString();

