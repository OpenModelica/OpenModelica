loadString("
  block B
    input Real u1;
    input Real u2;
    output Real y;
    parameter Real k1 = 1.0;
    parameter Real k2 = 1.0;
  equation
    y = k1*u1 + k2*u2;
  end B;

  model M
    B b;
  end M;
");

checkModel(M);
getErrorString();

