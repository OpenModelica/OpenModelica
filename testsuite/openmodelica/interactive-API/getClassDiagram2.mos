// name: getClassDiagram2
// keywords: UML, class diagram, PlantUML, #16938
// status: correct
//
// Tests getClassDiagram with a chain of class extends, a redeclared class
// that doesn't extend the class it replaces, a replaceable component with a
// constraining class, component arrays, protected elements, a class-level
// redeclare, imports and the exclude argument, which doesn't apply to the
// class itself.

loadString("package P
  package Icons
    partial model Icon end Icon;
  end Icons;
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  partial model Base
    extends Icons.Icon;
    replaceable partial model Law
      input Real u;
      output Real y;
    end Law;
    replaceable model Law2 = Law;
    Pin pins[2];
  protected
    parameter Real k = 1;
  end Base;
  model Linear
    extends Base(k = 2);
    redeclare model extends Law
    equation
      y = k*u;
    end Law;
  end Linear;
  model Linear2
    extends Linear;
    redeclare model extends Law
    end Law;
    redeclare model Law2
      input Real u;
      output Real y = u;
    end Law2;
  end Linear2;
  model Law3
    extends Base.Law;
  equation
    y = u;
  end Law3;
  partial model Holder
    replaceable model Other = Base.Law;
  end Holder;
  model User
    import P.Linear2;
    extends Holder;
    replaceable Linear2 l constrainedby Base;
    redeclare model Other = Law3;
  end User;
end P;
", "getClassDiagram2.mo"); getErrorString();

getClassDiagram(P.User, depth = 2); getErrorString();
getClassDiagram(P.User, depth = 2, exclude = {"P.Icons", "P.Pin"}); getErrorString();
// The class itself is shown even if it's excluded.
getClassDiagram(P.Icons.Icon, exclude = {"P.Icons"}); getErrorString();

