// name: getDefinitionAt1
// keywords: def-use, go to definition, #16931
// status: correct
//
// Tests getDefinitionAt, the definition of the name at a position in a file.

writeFile("getDefinitionAt1.mo", "package T
  package I
    block SO
      output Real y;
    end SO;
    block Base
      extends T.I.SO;
      parameter Real offset = 0;
    end Base;
  end I;
  block St
    extends T.I.Base;
  equation
    y = offset + time;
    assert(y > -1, \"y too small\");
  end St;
  partial package PM
    replaceable record TS
    end TS;
    replaceable partial model BP
      Real p;
    end BP;
  end PM;
  partial package PMM
    extends PM;
    redeclare replaceable record extends TS
      Real p;
      Real X;
    end TS;
  end PMM;
  package MA
    extends PMM;
    redeclare record extends TS
    end TS;
    redeclare model extends BP
      Real phase;
    end BP;
    function g
      input TS state;
      output Real x = state.X;
    end g;
    model Ext
      extends BP;
    equation
      phase = p;
    end Ext;
  end MA;
  record Data
    Real a = 1;
  end Data;
  record MoreData
    extends Data;
    Real b = 2;
  end MoreData;
  model Cell
    replaceable parameter Data data;
  end Cell;
  model Stack
    extends Cell(redeclare MoreData data);
    Real c[2] = {data.a, data.b} .* {1, 2};
  end Stack;
  package LF
    extends PM(redeclare record TS = MoreData);
    function mk
      output TS s = TS(a = 3, b = 4);
    end mk;
  end LF;
  class Table
    extends ExternalObject;
    function constructor
      input String fileName;
      output Table t;
      external \"C\" t = openTable(fileName);
    end constructor;
    function destructor
      input Table t;
      external \"C\" closeTable(t);
    end destructor;
  end Table;
  model UseTable
    import T.{Table, Data};
    parameter Table t = Table(fileName = \"x.txt\");
    Data d;
  end UseTable;
end T;
");
loadFile("getDefinitionAt1.mo"); getErrorString();

// A component used in an equation, inherited through two extends.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 14, 9), cd() + "/", "");
// A component inherited from the base class of the base class.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 14, 5), cd() + "/", "");
// The parts of a qualified name.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 12, 13), cd() + "/", "");
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 12, 17), cd() + "/", "");
// The declared name of a component: no use.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 8, 24), cd() + "/", "");
// The name after end.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 16, 8), cd() + "/", "");
// A component of a record only found in the class a replaceable record is redeclared as.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 40, 29), cd() + "/", "");
// Only found in the type a replaceable component is redeclared with: a candidate.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 60, 31), cd() + "/", "");
// A named argument of the constructor of an external object.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 82, 31), cd() + "/", "");
// A name in a group import.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 81, 15), cd() + "/", "");
// Whitespace: nothing.
stringReplace(getDefinitionAt("getDefinitionAt1.mo", 14, 3), cd() + "/", "");
getErrorString();
deleteFile("getDefinitionAt1.mo");

