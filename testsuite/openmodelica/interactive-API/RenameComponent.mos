// name:     RenameComponent
// keywords: renameComponent
// status:   correct
//
// Checks that renameComponent updates the references to the renamed
// component in other classes.
//

loadString("
package P
  model T
    parameter Real x = 1;
    Real y = x;
    Real z;
  equation
    der(z) = x;
    annotation(Icon(graphics = {Text(extent = {{0, 0}, {1, 1}}, textString = \"%x and %{x} but %%x and %xy\"),
      Rectangle(extent = DynamicSelect({{0, 0}, {1, 1}}, {{0, 0}, {x, x}}))}));
  end T;
  model U extends T(x = 2); Real w = x; end U;
  model V T t(x = 3); Real y = t.x; T ta[2](each x = 4); Real z = ta[1].x; end V;
  model W V v(t(x = 5)); Real q = v.t.x; end W;
  model X = T(x = 6);
  model H Real x; Real y = x; end H;
end P;
"); getErrorString();
renameComponent(P.T, x, x2); getErrorString();
list(P); getErrorString();

loadString("
package Q
  connector Pin Real v; flow Real i; end Pin;
  model Comp Pin p; Pin n; equation p.i + n.i = 0; end Comp;
  model Circ Comp c1, c2; equation connect(c1.p, c2.n); end Circ;
  function f input Real x; output Real y = x; end f;
  model F Real a = f(x = 1); end F;
  record R Real x; end R;
  model G R r = R(x = 1); Real s = r.x; end G;
  package K constant Real c = 1; model M Real y = c; end M; end K;
  model L import Q.K.c; Real y = c; end L;
  model Base replaceable Real x = 1 annotation(choices(choice(redeclare Real x = 2))); end Base;
  model D extends Base; redeclare Real x = 3; end D;
  model E Base b(redeclare Real x = 4); end E;
end Q;
"); getErrorString();
renameComponent(Q.Comp, p, pa); getErrorString();
renameComponent(Q.f, x, u); getErrorString();
renameComponent(Q.R, x, xx); getErrorString();
renameComponent(Q.K, c, c2); getErrorString();
renameComponent(Q.Base, x, x2); getErrorString();
list(Q); getErrorString();
renameComponent(Q.NoSuchClass, x, y); getErrorString();
renameComponent(Q.H, nosuch, y); getErrorString();

