// Tests the syntax errors getProbeTree returns for a file that doesn't parse.

writeFile("getProbeTree2.mo", "model S
  Real x
equation
  x = 1;
end S;
");
getErrorString();
print(getProbeTree("getProbeTree2.mo")); getErrorString();

