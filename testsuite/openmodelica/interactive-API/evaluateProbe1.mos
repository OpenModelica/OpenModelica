// name: evaluateProbe1
// keywords: probe tree, CodeProber
// status: correct
//
// Tests evaluateProbe with the properties of the source and the frontend.

writeFile("evaluateProbe1.mo", "package EP
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  model R
    parameter Real r = 2;
    Pin p, n;
  equation
    p.v - n.v = r*p.i;
    p.i + n.i = 0;
  end R;
  model G
    Pin p;
  equation
    p.v = 0;
  end G;
  model B
    R r1(r = 3), r2;
    G gnd;
  equation
    connect(r1.n, r2.p);
    connect(r2.n, gnd.p);
    connect(r1.p, r2.x);
    r1.p.v = sin(time);
  end B;
end EP;
");
getErrorString();
loadFile("evaluateProbe1.mo"); getErrorString();
// The file, its classes and the unresolved r2.x and its checkModel error.
print(evaluateProbe("evaluateProbe1.mo", "0", "topClasses")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0", "errors")); getErrorString();
// The r in r*p.i: what it refers to, the declaration as a node, and its role.
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.3.4", "text")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.3.4", "definition")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.3.4", "role")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.3.4", "hover")); getErrorString();
// The declaration of r: its uses as nodes and as arrows.
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.1", "definition")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.1", "uses")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.2.1", "useArrows")); getErrorString();
// Model B: the classes it uses, checkModel and the flat model.
print(evaluateProbe("evaluateProbe1.mo", "0.0.4", "dependsOn")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.4", "checkModel")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0.0.2", "flatModelica")); getErrorString();
// What isn't a node or a property of the node.
print(evaluateProbe("evaluateProbe1.mo", "0.7", "text")); getErrorString();
print(evaluateProbe("evaluateProbe1.mo", "0", "cCode")); getErrorString();

