// name: Obfuscation6
// keywords:
// status: correct
// cflags: -d=newInst
// teardown_command: rm -rf P.Test* output.log
//
// Checks that the public components of an encrypted class that the access
// level does not show are obfuscated too, #17938.
//

loadString("
package P
  connector RealInput = input Real;
  connector RealOutput = output Real;

  block Gain
    parameter Real k \"gain\";
    RealInput u;
    RealOutput y;
  equation
    y = k*u;
  end Gain;

  model Secret \"default access is Access.documentation\"
    parameter Real g \"visible gain\";
    RealInput u \"visible input\";
    RealOutput y \"visible output\";
    Gain gain(k = g) annotation(Placement(transformation(extent = {{-10, -10}, {10, 10}})));
    Real s \"secret variable\";
  equation
    gain.u = u;
    s = sin(gain.y);
    y = s;
  end Secret;

  model SecretDiagram
    parameter Real g;
    RealInput u;
    RealOutput y;
    Gain gain(k = g) annotation(Placement(transformation(extent = {{-10, -10}, {10, 10}})));
    Real s \"secret variable\";
  equation
    gain.u = u;
    s = sin(gain.y);
    y = s;
    annotation(Protection(access = Access.diagram));
  end SecretDiagram;

  model Test
    Secret c1(g = 2);
    SecretDiagram c2(g = 3);
  equation
    c1.u = time;
    c2.u = c1.y;
    annotation(Protection(access = Access.nonPackageText));
  end Test;
end P;
", "P.moc"); getErrorString();

simulate(P.Test, stopTime = 0.1); getErrorString();
readSimulationResultVars("P.Test_res.mat"); getErrorString();

