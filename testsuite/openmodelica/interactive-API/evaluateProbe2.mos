// name: evaluateProbe2
// keywords: probe tree, CodeProber
// status: correct
//
// Tests evaluateProbe with the properties of the translation of a model.

writeFile("evaluateProbe2.mo", "package EQ
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  model R
    parameter Real r = 2;
    Pin p, n;
  equation
    p.v - n.v = r*p.i;
    p.i + n.i = 0;
  end R;
  model V
    Pin p, n;
  equation
    p.v - n.v = sin(time);
    p.i + n.i = 0;
  end V;
  model G
    Pin p;
  equation
    p.v = 0;
  end G;
  model B
    V src;
    R r1(r = 3), r2;
    G gnd;
  equation
    connect(src.p, r1.p);
    connect(r1.n, r2.p);
    connect(r2.n, src.n);
    connect(src.n, gnd.p);
  end B;
end EQ;
");
getErrorString();
loadFile("evaluateProbe2.mo"); getErrorString();
// The parameter r of R in the translation of B.
print(evaluateProbe("evaluateProbe2.mo", "0.0.2.1", "simVariables", "EQ.B")); getErrorString();
// The equation p.v - n.v = r*p.i of R: its simulation equations (their C functions are in evaluateProbe4).
print(evaluateProbe("evaluateProbe2.mo", "0.0.2.3", "simEquations", "EQ.B")); getErrorString();
print(evaluateProbe("evaluateProbe2.mo", "0.0.2.3", "hover", "EQ.B")); getErrorString();
// Without a context model, the model the node is in is translated, and a package has none.
print(evaluateProbe("evaluateProbe2.mo", "0.0.5.2.1", "flatDeclarations")); getErrorString();
print(evaluateProbe("evaluateProbe2.mo", "0.0.5.4", "connectionEquations")); getErrorString();
print(evaluateProbe("evaluateProbe2.mo", "0.0.5", "translationMessages")); getErrorString();
print(evaluateProbe("evaluateProbe2.mo", "0.0.1", "simEquations")); getErrorString();

// Result:
