// name: OverrideStringValue.mos
// keywords: -overrideFile
// status: correct
// teardown_command: rm -rf QuotedOverride* quotedOverride.txt
//
// A value in double quotes is a Modelica string literal. See issue #3962.
//

loadString("
model QuotedOverride
  parameter String s = \"s\";
  parameter String t = \"t\";
  parameter Real p = 1;
initial algorithm
  assert(false, \"s=\" + s + \", t=\" + t + \", p=\" + String(p), AssertionLevel.warning);
end QuotedOverride;
"); getErrorString();

writeFile("quotedOverride.txt", "s=\"a,b! \\\"c\\\" \\\\ d\"\nt=\"x\",p=3\n"); getErrorString();
simulate(QuotedOverride, stopTime=0, simflags="-overrideFile=quotedOverride.txt"); getErrorString();

// Result:
// true
// ""
// true
// ""
