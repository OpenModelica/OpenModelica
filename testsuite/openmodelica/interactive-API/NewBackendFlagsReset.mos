//   Real x[1](start = 1.0);
//   Real x[2](start = 1.0);
// equation
//   der(x[1]) = -x[1];
//   der(x[2]) = -x[2];
// end NBFlagsResetModel;
// "
// ""
// true
// ""
// true
// ""
// {"-d=nonfScalarize"}
