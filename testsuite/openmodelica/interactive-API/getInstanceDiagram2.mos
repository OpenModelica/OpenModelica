// name: getInstanceDiagram2
// keywords: UML, instance diagram, #17181
// status: correct
//
// Tests getInstanceDiagram with connections: connectors are lines in the box
// of their instance and connect equations are associations between the boxes
// of the components they connect, or the model's own box; depth, exclude,
// showConnections = false and nested instances.

loadString("package C
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  model R
    parameter Real r = 1;
    Pin p, n;
  equation
    p.v - n.v = r*p.i;
    p.i + n.i = 0;
  end R;
  model Two
    parameter Real r = 10;
    R r1(r = r), r2(r = 2*r);
    Pin a, b;
  equation
    connect(a, r1.p);
    connect(r1.n, r2.p);
    connect(r2.n, b);
  end Two;
  model Top
    Two t(r = 5);
    R load;
  equation
    connect(t.b, load.p);
    connect(load.n, t.a);
  end Top;
end C;", "C.mo"); getErrorString();
getInstanceDiagram(C.Top); getErrorString();
getInstanceDiagram(C.Top, depth = 2); getErrorString();
getInstanceDiagram(C.Top, depth = 2, exclude = {"C.R"}, showConnections = false); getErrorString();

