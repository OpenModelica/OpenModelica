// name: getDefUseChains1
// keywords: def-use, #16931
// status: correct
//
// Tests getDefUseChains with an inherited component used in the derived class,
// a qualified import and a name used both qualified and unqualified.
// The model is written to a file since the positions are found in its source.

writeFile("getDefUseChains1.mo", "package P
  constant Real c = 2;
  model Base
    Real x(start = c);
  end Base;
  model M
    extends Base;
    import P.c;
    Real y;
  equation
    der(x) = -c*x;
    y = 2*x + P.c;
  end M;
end P;
");
loadFile("getDefUseChains1.mo"); getErrorString();

// The chains of everything used or declared in P.M, compact, written to a file.
getDefUseChains(P.M, fileName = "getDefUseChains1.json");
stringReplace(readFile("getDefUseChains1.json"), cd() + "/", ""); getErrorString();

// Only the chain of the inherited component, which is used in P.M.
stringReplace(getDefUseChains(P.Base.x, prettyPrint = true), cd() + "/", ""); getErrorString();

// P.c is used as c through the import and as P.c.
stringReplace(getDefUseChains(P.c, prettyPrint = true), cd() + "/", ""); getErrorString();

deleteFile("getDefUseChains1.mo"); deleteFile("getDefUseChains1.json");

// Result:
// true
// true
