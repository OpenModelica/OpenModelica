// name: getClassDiagram3
// keywords: UML, class diagram, draw.io, #16938
// status: correct
//
// Tests getClassDiagram with the draw.io format, where the text is escaped
// twice (HTML in XML), the links of the classes and of the lines in them to
// the lines of the elements in the file, with the names of the components,
// and writing to a file.

loadString("package D
  partial model Base
    parameter Real k = 1 \"Gain\";
    parameter Boolean b = k < 2 and k > 0 \"Escaped\";
    Real x;
  end Base;
  model Part
    Real y;
  end Part;
  model M
    extends Base(k = 2);
    Part parts[3](each y = 1);
  end M;
end D;
", "getClassDiagram3.mo"); getErrorString();

getClassDiagram(D.M, format = "drawio"); getErrorString();
getClassDiagram(D.M, "getClassDiagram3.puml"); getErrorString();
readFile("getClassDiagram3.puml"); getErrorString();

