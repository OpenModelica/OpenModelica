loadString("
  package TestCheckAll
    model A
      parameter Modelica.Units.SI.Voltage V = 10;
    end A;
    encapsulated model B
     parameter Modelica.Units.SI.Current A = 5;
    end B;
    model C
      parameter Modelica.Units.SI.Voltage V = 10;
    end C;
    annotation(uses(Modelica(version = \"4.1.0\")));
  end TestCheckAll;
");

checkAllModelsRecursive(TestCheckAll);
getErrorString();

