// name: getDefUseChains5
// keywords: def-use, #16931
// status: correct
//
// Tests getDefUseChains with the constructs that MSL 4.1.0 needs: class
// extends and redeclares of replaceable classes and components, extends of a
// class in the same package by its full name, external objects, group imports
// and element-wise operators.

writeFile("getDefUseChains5.mo", "package T
  package I
    block SO
      output Real y;
    end SO;
    block Base
      extends T.I.SO;
      parameter Real offset = 0;
    end Base;
  end I;
  block St
    extends T.I.Base;
  equation
    y = offset + time;
    assert(y > -1, \"y too small\");
  end St;
  partial package PM
    replaceable record TS
    end TS;
    replaceable partial model BP
      Real p;
    end BP;
  end PM;
  partial package PMM
    extends PM;
    redeclare replaceable record extends TS
      Real p;
      Real X;
    end TS;
  end PMM;
  package MA
    extends PMM;
    redeclare record extends TS
    end TS;
    redeclare model extends BP
      Real phase;
    end BP;
    function g
      input TS state;
      output Real x = state.X;
    end g;
    model Ext
      extends BP;
    equation
      phase = p;
    end Ext;
  end MA;
  record Data
    Real a = 1;
  end Data;
  record MoreData
    extends Data;
    Real b = 2;
  end MoreData;
  model Cell
    replaceable parameter Data data;
  end Cell;
  model Stack
    extends Cell(redeclare MoreData data);
    Real c[2] = {data.a, data.b} .* {1, 2};
  end Stack;
  package LF
    extends PM(redeclare record TS = MoreData);
    function mk
      output TS s = TS(a = 3, b = 4);
    end mk;
  end LF;
  class Table
    extends ExternalObject;
    function constructor
      input String fileName;
      output Table t;
      external \"C\" t = openTable(fileName);
    end constructor;
    function destructor
      input Table t;
      external \"C\" closeTable(t);
    end destructor;
  end Table;
  model UseTable
    import T.{Table, Data};
    parameter Table t = Table(fileName = \"x.txt\");
    Data d;
  end UseTable;
end T;
");
loadFile("getDefUseChains5.mo"); getErrorString();

// Inherited through a base class that extends a class of the same package by its full name.
getDefUseChains(T.I.Base.offset, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();
// Inherited through a class extends of a class extends.
getDefUseChains(T.PM.BP.p, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();
// A component of a record the class extends of a class extends adds.
getDefUseChains(T.PMM.TS.X, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();
// Of the type a replaceable component is redeclared with, a candidate, also as a named argument.
getDefUseChains(T.MoreData.b, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();
// A named argument of the constructor of an external object.
getDefUseChains(T.Table.constructor.fileName, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();
// Used in a group import.
getDefUseChains(T.Table, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();
// time and the level of assert are not names to look up.
getDefUseChains(T.St, fileName = "getDefUseChains5.json");
stringReplace(readFile("getDefUseChains5.json"), cd() + "/", ""); getErrorString();

deleteFile("getDefUseChains5.mo"); deleteFile("getDefUseChains5.json");

