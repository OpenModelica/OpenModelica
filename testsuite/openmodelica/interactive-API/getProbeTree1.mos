// name: getProbeTree1
// keywords: probe tree, CodeProber
// status: correct
//
// Tests getProbeTree, the nodes of a file with their spans and properties.

writeFile("getProbeTree1.mo", "package PT
  type Voltage = Real;
  import PT.Voltage;
  partial model Base
    parameter Real k = 2, j = 1;
  end Base;
  model M
    extends Base(k = 3);
    Voltage v;
  equation
    if k > 1 then
      v = k*time;
    else
      v = j;
    end if;
  algorithm
    for i in 1:2 loop
      assert(v < 10, \"too large\");
    end for;
  end M;
end PT;
");
getErrorString();
loadFile("getProbeTree1.mo"); getErrorString();
print(getProbeTree("getProbeTree1.mo", prettyPrint = true)); getErrorString();

// A file that doesn't parse has no tree, only its errors (their wording is in getProbeTree2).
writeFile("getProbeTree1b.mo", "model S
  Real x
equation
  x = 1;
end S;
");
getErrorString();
regexBool(getProbeTree("getProbeTree1b.mo"), "\"root\":null, \"errors\":\\[\\{\"severity\":\"error\", \"lineStart\":3,"); getErrorString();

