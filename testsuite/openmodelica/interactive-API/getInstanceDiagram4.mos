// name: getInstanceDiagram4
// keywords: UML, instance diagram, arrays, #17181
// status: correct
//
// Tests getInstanceDiagram with expandArrays = true: a box per element of an
// array of components, with the values of that element, both from a binding of
// the whole array (k = {1, p}) and from bindings in the class that use other
// parameters of the element (v); and a connection between two elements.

loadString("package Q
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  model A
    parameter Real k = 2;
    parameter Real v[2] = {k, 2*k};
    Pin p, n;
  end A;
  model T
    parameter Real p = 3;
    A arr[2](k = {1, p});
    A m[2, 2](each k = 4);
  equation
    connect(arr[1].n, arr[2].p);
  end T;
end Q;", "Q.mo"); getErrorString();
getInstanceDiagram(Q.T); getErrorString();
getInstanceDiagram(Q.T, expandArrays = true); getErrorString();

