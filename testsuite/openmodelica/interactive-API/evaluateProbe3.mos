// name: evaluateProbe3
// keywords: probe tree, CodeProber
// status: correct
//
// Tests evaluateProbe with the model instance, the BLT and the state selection.

writeFile("evaluateProbe3.mo", "package SP
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  model R
    parameter Real r = 2;
    Pin p, n;
  equation
    p.v - n.v = r*p.i;
    p.i + n.i = 0;
  end R;
  model C
    parameter Real c = 1;
    Real v(start = 1);
    Pin p, n;
  equation
    v = p.v - n.v;
    c*der(v) = p.i;
    p.i + n.i = 0;
  end C;
  model G
    Pin p;
  equation
    p.v = 0;
  end G;
  model B \"two capacitors in parallel: only one of them is a state\"
    R r1;
    C c1, c2(v(stateSelect = StateSelect.prefer));
    G gnd;
  equation
    connect(r1.p, c1.p);
    connect(c1.p, c2.p);
    connect(r1.n, gnd.p);
    connect(c1.n, gnd.p);
    connect(c2.n, gnd.p);
  end B;
end SP;
");
getErrorString();
loadFile("evaluateProbe3.mo"); getErrorString();
// The getModelInstance JSON of the connector.
print(evaluateProbe("evaluateProbe3.mo", "0.0.1", "modelInstance")); getErrorString();
// The blocks of B: the capacitor equations are in a torn linear system.
print(evaluateProbe("evaluateProbe3.mo", "0.0.5", "blt")); getErrorString();
// The block the equation c*der(v) = p.i of C is in, in the translation of B.
print(evaluateProbe("evaluateProbe3.mo", "0.0.3.5", "bltBlock", "SP.B")); getErrorString();
// c2.v is the state, c1.v a dummy state equal to it.
print(evaluateProbe("evaluateProbe3.mo", "0.0.5", "stateSelection")); getErrorString();
print(evaluateProbe("evaluateProbe3.mo", "0.0.3.2", "stateSelection", "SP.B")); getErrorString();

