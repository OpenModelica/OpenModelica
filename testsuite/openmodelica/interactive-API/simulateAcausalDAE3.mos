// name: simulateAcausalDAE3
// keywords: acausal DAE separate compilation homotopy
// status: correct
// suite: cSources
//
// A separately compiled component whose actual equation does not converge
// from the start values: the combined initialization continues from the
// simplified equation of homotopy() to the actual one. The result is compared
// with the monolithic simulation.
//

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadString("
model ExpDiode
  extends Modelica.Electrical.Analog.Interfaces.OnePort;
  parameter Real Ids = 1e-12;
  parameter Real Vt = 0.025;
  parameter Real Rlin = 0.1;
equation
  i = homotopy(actual = Ids*(exp(v/Vt) - 1), simplified = v/Rlin);
end ExpDiode;

model DiodeStitch
  Modelica.Electrical.Analog.Sources.ConstantVoltage V(V = 10);
  Modelica.Electrical.Analog.Basic.Resistor R1(R = 1);
  ExpDiode D;
  Modelica.Electrical.Analog.Basic.Resistor R2(R = 10);
  Modelica.Electrical.Analog.Basic.Capacitor C1(C = 0.01, v(start = 0, fixed = true));
  Modelica.Electrical.Analog.Basic.Ground G;
equation
  connect(V.p, R1.p);
  connect(R1.n, D.p);
  connect(D.n, G.p);
  connect(V.p, R2.p);
  connect(R2.n, C1.p);
  connect(C1.n, G.p);
  connect(V.n, G.p);
end DiodeStitch;
"); getErrorString();

echo(false);
ref := simulate(DiodeStitch, fileNamePrefix = "DiodeStitch_ref");
res := simulateAcausalDAE(DiodeStitch);
refMsg := ref.messages;
resMsg := res.messages;
getErrorString();
echo(true);
regexBool(refMsg, "The simulation finished successfully");
regexBool(resMsg, "homotopy continuation reached lambda = 1");
regexBool(resMsg, "wrote combined_res.mat \\(501 points\\)");
diffSimulationResults("combined_res.mat", "DiodeStitch_ref_res.mat", "DiodeStitch_diff", relTol = 1e-3,
  vars = {"D.v", "D.i", "R1.i", "C1.v", "R2.i"}); getErrorString();

// Result:
// true
// ""
// true
// ""
// true
// true
// true
// true
// (true, {})
// ""
// endResult
