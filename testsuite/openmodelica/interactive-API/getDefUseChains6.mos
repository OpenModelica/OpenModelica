// name: getDefUseChains6
// keywords: def-use, lookup, #16964
// status: correct
//
// Tests that the def-use walker finds the same classes as the lookup of the
// new frontend (-d=checkUsedElementsLookup) for inherited classes, imports in
// an encapsulated package, a class referring to itself, a function called
// through a component, a class extends and classes redeclared in the modifier
// of an extends.

setCommandLineOptions("-d=checkUsedElementsLookup"); getErrorString();
loadString("package L
  package Types
    type Temp = Real(unit = \"K\");
    type Press = Real(unit = \"Pa\");
    record Props
      Real a = 1;
    end Props;
  end Types;

  partial package PartialMedium
    replaceable record FluidConstants
      Real mw = 1;
    end FluidConstants;
    replaceable function h
      input Real x;
      output Real y = x;
    end h;
    constant Integer nX = 1;
  end PartialMedium;

  partial package PartialMixtureMedium
    extends PartialMedium(redeclare replaceable record FluidConstants = Types.Props);
    constant FluidConstants fc;
  end PartialMixtureMedium;

  package Water
    extends PartialMedium(nX = 2);
    redeclare function extends h
    algorithm
      y := 2*x;
    end h;
    constant FluidConstants fc;
  end Water;

  encapsulated package Enc
    import L.Types;
    import L.Types.{Temp, Press};
    import P = L.Types.Press;
    import L.Types.*;
    model M
      Types.Temp t;
      Temp t2;
      P p;
      Props r;
    end M;
  end Enc;

  model World
    function gravity
      input Real z;
      output Real g = 9.81*z;
    end gravity;
  end World;

  model Body
    World world;
    Real g = world.gravity(1);
  end Body;

  model Self
    parameter Integer n = 1;
    model Inner
      Types.Temp t;
    end Inner;
    Inner i;
    Self.Inner i2;
    L.Self.Inner i3;
  end Self;

  partial model Base
    replaceable package Medium = PartialMedium;
    Types.Temp t0;
  end Base;

  model Derived
    extends Base(redeclare package Medium = Water);
    Medium.FluidConstants c;
    Types.Press p;
    Real y = Medium.h(1);
  end Derived;
end L;
", "L.mo"); getErrorString();

getDefUseChains(L, fileName = "getDefUseChains6.json"); getErrorString();
// FluidConstants is the class redeclared in the modifier of the extends, not the inherited one.
getDefUseChains(L.PartialMixtureMedium, fileName = "getDefUseChains6.json");
readFile("getDefUseChains6.json"); getErrorString();

deleteFile("getDefUseChains6.json");

// Result:
// true
// ""
// true
// ""
// "getDefUseChains6.json"
