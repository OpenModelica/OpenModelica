// name: readSimulationResult1
// keywords:
// status: correct
//
// Checks that readSimulationResult can handle nested der().
//

loadString("
connector RealInput = input Real;
connector RealOutput = output Real;

block Der
  RealInput u;
  RealOutput y;
equation
  y = der(u);
end Der;

block Filter
  RealInput u;
  RealOutput y;
  RealOutput[3] x;
  Real[4] uu;
initial equation
  der(x) = zeros(3);
equation
  der(x) = x - uu[1:3];
  uu = {u, x[1], x[2], x[3]};
  y = uu[4];
end Filter;

model M
  RealOutput step_y = 0.1 + (if time < 0.1 then 0 else 1);
  Filter filter;
  Der der1;
  Der der2;
  Der der3;
equation
  connect(step_y, filter.u);
  connect(filter.y, der1.u);
  connect(der1.y, der2.u);
  connect(der2.y, der3.u);
end M;
");
getErrorString();

simulate(M);
getErrorString();
readSimulationResult("M_res.mat", {filter.x[1], der(filter.x[2]), der(der(filter.x[3])), der(der(der(filter.x[3])))});
getErrorString();

