// name: getDependencyGraph1
// keywords: def-use, dependency graph, #16931
// status: correct
//
// Tests getDependencyGraph: the uses of a class are the classes it extends,
// the classes of its components, the classes that declare the constants and
// components it uses and the candidates of replaceable classes. The hash of a
// class leaves out its nested classes, comments and whitespace.

writeFile("getDependencyGraph1.mo", "package G
  constant Real k = 2;
  package I
    model Base
      parameter Real p = k;
    end Base;
  end I;
  partial package PM
    replaceable function f
      input Real x;
      output Real y = x;
    end f;
  end PM;
  package M
    extends PM;
    redeclare function extends f
    algorithm
      y := 2*x;
    end f;
  end M;
  model Top
    extends I.Base;
    replaceable package Medium = PM;
    Real z = Medium.f(p);
  end Top;
  model Use
    Top t(redeclare package Medium = M);
  end Use;
end G;
");
loadFile("getDependencyGraph1.mo"); getErrorString();
stringReplace(getDependencyGraph(G, prettyPrint = true), cd() + "/", ""); getErrorString();

// Only whitespace and comments change in G, and the binding of p in G.I.Base:
// only the hash of G.I.Base changes.
writeFile("getDependencyGraph1.mo", "package G  // the package
  constant Real k=2;
  package I
    model Base
      parameter Real p = 2*k;
    end Base;
  end I;
  partial package PM
    replaceable function f
      input Real x;
      output Real y = x;
    end f;
  end PM;
  package M
    extends PM;
    redeclare function extends f
    algorithm
      y := 2*x;
    end f;
  end M;
  model Top
    extends I.Base;
    replaceable package Medium = PM;
    Real z = Medium.f(p);
  end Top;
  model Use
    Top t(redeclare package Medium = M);
  end Use;
end G;
");
clear(); loadFile("getDependencyGraph1.mo"); getErrorString();
getDependencyGraph(G, fileName = "getDependencyGraph1.json");
stringReplace(readFile("getDependencyGraph1.json"), cd() + "/", ""); getErrorString();

deleteFile("getDependencyGraph1.mo"); deleteFile("getDependencyGraph1.json");

