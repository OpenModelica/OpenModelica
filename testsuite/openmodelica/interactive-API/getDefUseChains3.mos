// name: getDefUseChains3
// keywords: def-use, #16931
// status: correct
//
// Tests getDefUseChains with a replaceable package, the classes it's redeclared
// as (candidates), a class extends, a renaming import and a name used both in
// the dimensions and in the binding of a component.

writeFile("getDefUseChains3.mo", "package R
  partial package PartialMedium
    constant Integer nX = 1;
    replaceable function h
      input Real x;
      output Real y = x;
    end h;
  end PartialMedium;
  package Water
    extends PartialMedium(nX = 2);
    redeclare function extends h
    algorithm
      y := 2*x;
    end h;
  end Water;
  model Pipe
    replaceable package Medium = PartialMedium;
    Real z[Medium.nX] = fill(Medium.h(1), Medium.nX);
  end Pipe;
  model System
    import W = R.Water;
    Pipe p(redeclare package Medium = W);
    Integer n = W.nX;
    Real q = R.Water.h(2);
  end System;
end R;
");
loadFile("getDefUseChains3.mo"); getErrorString();

// The class extends, its x and y are the ones of the function it extends.
// Medium.h in Pipe is R.Water.h if Medium is redeclared as R.Water, a candidate.
stringReplace(getDefUseChains(R.Water.h, prettyPrint = true), cd() + "/", ""); getErrorString();
// The dimension comes before the binding.
stringReplace(getDefUseChains(R.PartialMedium.nX, prettyPrint = true), cd() + "/", ""); getErrorString();
// Used through the renaming import.
getDefUseChains(R.Water, fileName = "getDefUseChains3.json");
stringReplace(readFile("getDefUseChains3.json"), cd() + "/", ""); getErrorString();

deleteFile("getDefUseChains3.mo"); deleteFile("getDefUseChains3.json");

