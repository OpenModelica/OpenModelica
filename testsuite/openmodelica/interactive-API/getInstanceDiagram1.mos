// name: getInstanceDiagram1
// keywords: UML, instance diagram, #17181
// status: correct
//
// Tests getInstanceDiagram: a box per instance with the values its parameters
// have in it, as written and evaluated (a1.k from the modifier, a2.k the
// default, each on an array of instances), inherited parameters, no variables
// and no protected elements unless showProtected = true, in the three formats.

loadString("package P
  model Base
    parameter Real k = 2;
  protected
    parameter Real h = 1;
  end Base;
  model A
    extends Base;
    parameter Real g = 2*k;
    Real x(start = 1, fixed = true);
  equation
    der(x) = -k*x;
  end A;
  model T
    parameter Real p = 3;
    A a1(k = p);
    A a2;
    A arr[2](each k = 7);
  end T;
end P;", "P.mo"); getErrorString();
getInstanceDiagram(P.T); getErrorString();
getInstanceDiagram(P.T, format = "mermaid"); getErrorString();
getInstanceDiagram(P.T, format = "drawio", depth = 0); getErrorString();
getInstanceDiagram(P.T, showProtected = true); getErrorString();

