// name: getClassDiagram4
// keywords: UML, class diagram, Mermaid, #16938
// status: correct
//
// Tests getClassDiagram with the Mermaid format: the characters Mermaid reads
// as syntax are escaped (a member ending with ) would be a method, braces end
// the class, ~ is a generic type, : starts a label and # an escape), and
// partial classes, arrays and nested classes, which Mermaid can't draw, so
// they are linked to their class.

loadString("package D
  partial model Base
    parameter Real k = 1 \"Gain\";
    parameter String s = \"#1: ~2~\";
    parameter Real c[:] = {1, 2};
    parameter Boolean b = k < 2 and k > 0;
    Real x = sin(k);
  end Base;
  model Part
    Real y;
  end Part;
  model M
    extends Base(k = 2);
    Part parts[3](each y = 1);
    replaceable model P = Part;
    model Inner
      Real z;
    end Inner;
    Inner i;
  end M;
end D;
", "getClassDiagram4.mo"); getErrorString();

getClassDiagram(D.M, format = "mermaid"); getErrorString();
getClassDiagram(D.M, format = "mermaid", showModifiers = false); getErrorString();

