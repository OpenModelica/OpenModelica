// name: getDefUseChains2
// keywords: def-use, #16931
// status: correct
//
// Tests getDefUseChains with modifiers, named arguments, a component that
// shadows a package constant, enumeration literals, connect equations and
// iterators with the same name.

writeFile("getDefUseChains2.mo", "package Q
  type E = enumeration(a, b);
  constant Real k = 3;
  function f
    input Real u;
    input Real gain = 1;
    output Real y;
  algorithm
    y := gain*u;
    for i in 1:2 loop
      y := y + i;
    end for;
  end f;
  connector Pin
    Real v;
    flow Real i;
  end Pin;
  model Res
    parameter Real R = 1;
    Pin p, n;
  equation
    p.v - n.v = R*p.i;
    p.i + n.i = 0;
  end Res;
  model Top
    parameter Real k = 2 \"shadows Q.k\";
    parameter E e = E.b;
    Res r1(R = k), r2(R = Q.k);
    Real w = f(u = 2, gain = k);
  equation
    connect(r1.n, r2.p);
  end Top;
  model Iter
    Real a[3];
    Real b[3] = {i*k for i in 1:3};
    Real s = sum(a[i] for i in 1:3);
  equation
    for i in 1:3 loop
      a[i] = i;
    end for;
  end Iter;
end Q;
");
loadFile("getDefUseChains2.mo"); getErrorString();

// Used as modifiers.
stringReplace(getDefUseChains(Q.Res.R, prettyPrint = true), cd() + "/", ""); getErrorString();
// Used as a named argument.
stringReplace(getDefUseChains(Q.f.gain, prettyPrint = true), cd() + "/", ""); getErrorString();
// k in Q.Top is Q.Top.k, in Q.Iter it's Q.k.
stringReplace(getDefUseChains(Q.Top.k, prettyPrint = true), cd() + "/", ""); getErrorString();
stringReplace(getDefUseChains(Q.k, prettyPrint = true), cd() + "/", ""); getErrorString();
// An enumeration literal.
stringReplace(getDefUseChains(Q.E.b, prettyPrint = true), cd() + "/", ""); getErrorString();
// Used in equations and a connect equation.
stringReplace(getDefUseChains(Q.Res.p, prettyPrint = true), cd() + "/", ""); getErrorString();
// Each i is its own iterator.
getDefUseChains(Q.Iter, fileName = "getDefUseChains2.json", scope = Q.Iter);
stringReplace(readFile("getDefUseChains2.json"), cd() + "/", ""); getErrorString();
getDefUseChains(Q.f, fileName = "getDefUseChains2.json", scope = Q.f);
stringReplace(readFile("getDefUseChains2.json"), cd() + "/", ""); getErrorString();

deleteFile("getDefUseChains2.mo"); deleteFile("getDefUseChains2.json");

