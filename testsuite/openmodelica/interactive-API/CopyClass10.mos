// name:     CopyClass10
// keywords:
// status:   correct
// cflags:   -d=newInst
//

loadString("
  package P
    model A
      Real x;
    end A;

    model B
      A a;
    end B;
  end P;

  package P2
    package P
    end P;
  end P2;
");

copyClass(P.B, "B", P2);
getErrorString();
list(P2);

