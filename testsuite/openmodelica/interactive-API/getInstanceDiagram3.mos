// name: getInstanceDiagram3
// keywords: UML, instance diagram, #17181
// status: correct
//
// Tests getInstanceDiagram on an MSL model, writing it to a file, and the
// errors of an unknown format and an unknown class.

loadModel(Modelica, {"4.1.0"}); getErrorString();
loadString("model M
  Modelica.Blocks.Sources.Constant c(k = 1);
  Modelica.Blocks.Math.Gain g(k = 2);
equation
  connect(c.y, g.u);
end M;", "M.mo"); getErrorString();
getInstanceDiagram(M, fileName = "getInstanceDiagram3.puml"); getErrorString();
readFile("getInstanceDiagram3.puml");
getInstanceDiagram(M, format = "svg"); getErrorString();
getInstanceDiagram(NoSuchModel); getErrorString();

