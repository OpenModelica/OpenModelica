// name: getDefUseChains4
// keywords: def-use, #16931
// status: correct
//
// Tests getDefUseChains with a class that isn't in a file, a name that
// isn't found, the scope argument and classes that don't exist.

loadString("package E
  constant Real c = 1;
  model A
    Real x = c + undefinedName;
  end A;
  model B
    Real y = c;
  end B;
end E;
", "getDefUseChains4.mo"); getErrorString();

// Without the source the uses have the span of what they're used in.
getDefUseChains(E.A, prettyPrint = true); getErrorString();
// Only the uses in E.B.
getDefUseChains(E.c, scope = E.B); getErrorString();
getDefUseChains(E.NoSuchClass); getErrorString();
getDefUseChains(NoSuchPackage.C); getErrorString();

