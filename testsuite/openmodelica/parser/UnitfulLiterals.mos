// name: UnitfulLiterals
// keywords: Modelica 3.7 unitful literal
// status: correct
//
// Implicit unit conversion of unitful literals in binding equations and
// start/min/max/nominal modifiers.
//

loadString("
type Length = Real(unit = \"m\");
type Temp = Real(unit = \"K\") annotation(absoluteValue = true);
type TempDiff = Temp annotation(absoluteValue = false);

model A
  Real x(unit = \"m\");
end A;

model UnitfulLiterals
  Real x(unit = \"m\") = -5'cm';
  Real y(unit = \"m\") = 0'cm' - 5'cm';
  Real w = 5'cm';
  Length l = 2'km';
  Real s(unit = \"m\", start = 2'km', min = -1'km', max = 3000'mm', nominal = 1'cm');
  Real v(unit = \"m/s\") = 36'km/h';
  Real tC(unit = \"degC\") = 20'degC';
  Real tKAbs(unit = \"K\") = 20'degC' annotation(absoluteValue = true);
  Real tKRel(unit = \"K\") = 20'degC' annotation(absoluteValue = false);
  Temp t = -20'degC';
  TempDiff dt = 5'degC';
  A a(x = 3'cm');
  A as[2](each x = 4'mm');
  Real f(unit = \"degC\") = 212'degF' annotation(absoluteValue = true);
  Real tK(unit = \"K\") = 20'degC';
  Real z(unit = \"m\") = 5's';
  Real u(unit = \"m\") = 5'foo';
end UnitfulLiterals;
"); getErrorString();
instantiateModel(UnitfulLiterals); getErrorString();

