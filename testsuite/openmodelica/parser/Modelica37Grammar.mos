// name: Modelica37Grammar
// keywords: Modelica 3.7 grammar
// status: correct
//
// Parses, unparses and instantiates the syntax added in Modelica 3.7:
// unitful literals, (exp).name and der(x) := exp.
//

loadString("
record R
  Real a;
  Real b;
end R;

function f
  input Real x;
  output R r = R(x, 2*x);
end f;

model Modelica37Grammar
  parameter Real g(unit = \"m/s2\") = 9.81'm/s2';
  parameter Real l(unit = \"m\") = -2'm';
  parameter Integer n = 3 '1';
  R r = R(1, 2);
  R rs[2] = {R(1, 2), R(3, 4)};
  Real y = (f(time)).b;
  Real z = (r).a;
  Real w[2] = (rs).b;
  Real v = (rs[2]).a;
end Modelica37Grammar;

model DerAssign
  Real x(start = 1, fixed = true);
algorithm
  der(x) := -x;
end DerAssign;
"); getErrorString();
list(Modelica37Grammar); getErrorString();
list(DerAssign); getErrorString();
instantiateModel(Modelica37Grammar); getErrorString();

loadString("
model TupleDot
  Real x = (1, 2).a;
end TupleDot;
"); getErrorString();

loadString("
model MissingElement
  Real x = (f(1.0)).c;
end MissingElement;
"); getErrorString();
instantiateModel(MissingElement); getErrorString();

