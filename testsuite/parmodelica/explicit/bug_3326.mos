// name: bug_3326
// status: correct

setCommandLineOptions("-g=ParModelica"); getErrorString();
setDefaultOpenCLDevice(0); // 0 = auto-select a device with double precision support
loadFile("bug_3326.mo"); getErrorString();
simulate(oclTest.M, stopTime=1, numberOfIntervals=2); getErrorString();
val(groupId[3], 0);
val(localId[2], 0);
val(err, 0);

