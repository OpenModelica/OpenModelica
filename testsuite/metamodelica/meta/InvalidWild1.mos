// name: InvalidWild1
// cflags: -g=MetaModelica -d=-newInst
// status: correct
// suite: metamodelica

loadString("
  function test
    input Real x;
    output Real y = x;
  end test;

  function test2
  protected
    Real x;
  algorithm
    x := test(_);
  end test2;
"); getErrorString();

test2(); getErrorString();

