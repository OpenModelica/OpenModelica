checkModel(PlanarMechanicsForTesting.Examples.TestIdealWheel); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.TestDryFrictionWheel); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.TestSlipBasedWheel); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.SingleTrackWithEngine); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.SimpleCarWithDifferentialGear); getErrorString();

