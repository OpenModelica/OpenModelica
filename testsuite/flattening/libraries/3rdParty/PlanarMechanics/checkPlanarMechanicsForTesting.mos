loadModel(Modelica); getErrorString();
loadFile("PlanarMechanicsForTesting.mo"); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.FreeBody); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.Pendulum); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.DoublePendulum); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.CounterSpin); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.CraneCrab); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.ControlledCraneCrab); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.InvertedCraneCrab); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.WheelBasedCranCrab); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.PistonEngine); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.PistonEngine_DynamicStateSelection); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.KinematicLoop); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.KinematicLoop_DynamicStateSelection); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.TestIdealWheel); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.TestDryFrictionWheel); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.TestSlipBasedWheel); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.SingleTrackWithEngine); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.SimpleCarWithDifferentialGear); getErrorString();

