checkModel(PlanarMechanicsForTesting.Examples.PistonEngine); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.PistonEngine_DynamicStateSelection); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.KinematicLoop); getErrorString();
