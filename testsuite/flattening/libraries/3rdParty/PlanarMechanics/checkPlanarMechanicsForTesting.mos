loadModel(Modelica); getErrorString();
loadFile("PlanarMechanicsForTesting.mo"); getErrorString();

checkModel(PlanarMechanicsForTesting.Examples.FreeBody); getErrorString();
checkModel(PlanarMechanicsForTesting.Examples.Pendulum); getErrorString();
