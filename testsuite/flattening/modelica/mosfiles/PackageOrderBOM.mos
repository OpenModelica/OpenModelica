// name: PackageOrderBOM
// status: correct
// depends: OrderBOM
// depends: OnlyBOM
//
// Tests that a byte order mark in package.order is ignored with a warning.
//

loadFile("OrderBOM/package.mo"); getErrorString();
getClassNames(OrderBOM); getErrorString();
loadFile("OnlyBOM/package.mo"); getErrorString();
getClassNames(OnlyBOM); getErrorString();

