// name: ConnectorBalance8
// keywords: connector
// status: correct
// cflags: -d=newInst
//
// Checks that the connector balance checking can handle unevaluable dimensions.
//

loadString("
  connector C
    parameter Integer n(fixed = false);
    Real e;
    flow Real f;
    stream Real s[n];
  end C;

  model M
    C c;
  end M;
");
getErrorString();

checkModel(M);
getErrorString();

// Result:
// true
// ""
// "Check of M completed successfully.
// The model has 1 equation(s) and 2 + c.n variables(s).
// 1 of these are trivial equation(s).
// The global balance of the model depends on parameters with no default values."
// ""
// endResult
