// name: CheckPartialFunctionCall1
// keywords:
// status: correct
// cflags: -d=newInst
//
//

loadString("
  partial function f
    input Real x;
    output Real y;
  end f;

  model M
    Real x = f(time);
  end M;
");
getErrorString();

checkModel(M);
getErrorString();

