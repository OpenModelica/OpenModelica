// name:     ExternalObjectSize1
// keywords: external object
// cflags:   -d=newInst
// status:   correct
//
// description: External object in extended class

loadString("
  class EO
    extends ExternalObject;

    function constructor
      output EO e;
      external \"C\" e = init();
    end constructor;

    function destructor
      input EO e;
      external \"C\" deinit(e);
    end destructor;
  end EO;

  model M
    EO e1 = EO();
    EO e2[1] = {e1};
  end M;
");

checkModel(M);

// Result:
// true
// "Check of M completed successfully.
// The model is globally balanced with 0 equation(s) and variable(s).
// 0 of these are trivial equation(s)."
// endResult
