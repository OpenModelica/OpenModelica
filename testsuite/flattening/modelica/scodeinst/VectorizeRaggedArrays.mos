// name: VectorizeRaggedArrays
// keywords: vectorize, component array, ragged
// status: correct
// Vectorized component arrays whose elements have arrays of different sizes.

loadString("
model RaggedEnd
  model Layer
    parameter Integer n;
    Real T[n];
    Real Q[n + 1];
  equation
    for i in 1:n loop
      der(T[i]) = Q[i] - Q[i + 1];
    end for;
    Q[1] = 1;
    Q[end] = T[end];
  end Layer;
  Layer lay[2](n = {2, 3});
end RaggedEnd;

model RaggedIfStart
  type Temp = Real(start = 288.15);
  model Layer
    parameter Integer n;
    parameter Boolean s;
    Temp T[n](start = if s then cat(1, {1.0}, {1.0 + i for i in 2:n}) else {2.0 + i for i in 1:n});
  equation
    for i in 1:n loop
      der(T[i]) = -T[i];
    end for;
  end Layer;
  Layer lay[2](n = {2, 3}, s = {true, false});
end RaggedIfStart;

model RaggedNested
  model Layer
    parameter Integer n;
    Real T[n](each start = 1);
  equation
    for i in 1:n loop
      der(T[i]) = -T[i];
    end for;
  end Layer;
  model Wall
    parameter Integer nLay;
    parameter Integer nn[nLay];
    Layer lay[nLay](n = nn);
  end Wall;
  Wall w[2](nLay = {2, 3}, nn = {{2, 3}, {1, 2, 2}});
end RaggedNested;
"); getErrorString();
setCommandLineOptions("--newBackend"); getErrorString();

instantiateModel(RaggedEnd); getErrorString();
instantiateModel(RaggedIfStart); getErrorString();
instantiateModel(RaggedNested); getErrorString();

