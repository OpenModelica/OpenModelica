// name:     WarnNonStandardModelica.mos
// keywords: non-standard Modelica extensions
// status:   correct
//
// --warnNonStandardModelica turns the errors that --allowNonStandardModelica
// removes into warnings that name the option.
//

loadFile("WarnNonStandardModelica.mo"); getErrorString();
setCommandLineOptions("--warnNonStandardModelica"); getErrorString();
instantiateModel(WarnNonStandardModelica.RealEquality) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.ReinitInAlgorithm) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.ProtectedAccess) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.TopLevelOuter) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.UnbalancedConnector) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.ImplicitStart); getErrorString();
instantiateModel(WarnNonStandardModelica.ConditionalContext) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.EnumerationAsInteger) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.IntegerAsEnumeration) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.MultipleExternal) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.StringOfIntegerLiteral); getErrorString();
instantiateModel(WarnNonStandardModelica.IntegerAsEnumerationOutOfRange); getErrorString();
instantiateModel(WarnNonStandardModelica.EnumerationAsIntegerDimensions); getErrorString();
instantiateModel(WarnNonStandardModelica.IntegerAsEnumerationMatrix); getErrorString();
// --allowNonStandardModelica takes precedence.
setCommandLineOptions("--allowNonStandardModelica=realEquality,protectedAccess"); getErrorString();
instantiateModel(WarnNonStandardModelica.RealEquality) <> ""; getErrorString();
instantiateModel(WarnNonStandardModelica.ProtectedAccess) <> ""; getErrorString();

