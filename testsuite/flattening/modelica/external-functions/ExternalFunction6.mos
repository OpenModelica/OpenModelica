// name:     ExternalFunction6
// keywords: external function, Include
// status:   correct
// teardown_command: rm -f ExternalFunction6_*
//
// Calls an external function that is a macro defined in an Include
// annotation.
//

loadFile("ExternalFunction6.mo"); getErrorString();
simulate(ExternalFunction6); getErrorString();
val(i, 0);

