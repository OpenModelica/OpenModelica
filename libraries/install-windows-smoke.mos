// Installs just the Modelica Standard Library version the Windows testsuite
// smoke set needs (see .CI/common.groovy's installWindowsSmokeLibrary() and
// testsuite/openmodelica/fmi/CoSimulation/2.0/issue10523.mos, the one test in
// the smoke suite that calls loadModel(Modelica)). Everything else in the
// smoke set runs against nothing but omc itself.
//
// Unlike libraries/index.mos and install-index.mos, this does not build the
// matrix of historical MSL versions the Linux suite tests against, and there
// is no shared package cache wired up for Windows agents (env.LIBRARIES is a
// Unix path, /cache/omlibrary) for installPackage() to use instead of the
// network -- so keep this to the one package the smoke set actually needs.
//
// Run with the current directory set to libraries/, same as index.mos:
//   cd libraries && omc install-windows-smoke.mos

setEnvironmentVar("HOME", OpenModelica.Scripting.cd());
setEnvironmentVar("APPDATA", OpenModelica.Scripting.cd());
setModelicaPath(OpenModelica.Scripting.cd() + "/.openmodelica/libraries/");
echo(false);
OpenModelica.Scripting.mkdir(".openmodelica");
if not OpenModelica.Scripting.mkdir(".openmodelica/libraries/") then
  print("\nmkdir failed\n");
  print(getErrorString());
  exit(1);
end if;
if not installPackage(Modelica, "4.1.0+maint.om", exactMatch=true) then
  print("Modelica 4.1.0+maint.om failed.\n");
  print(getErrorString());
  exit(1);
else
  print("Installed: Modelica 4.1.0+maint.om\n");
end if;
